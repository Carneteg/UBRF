dist/
# `node_modules/` med snedstreck matchar bara en KATALOG. En symlänk med
# samma namn — den man gör i ett git worktree för att slippa installera
# om beroendena — är ingen katalog, gled därför förbi ignoreringen och
# gick att checka in. Den hamnade i d340b8f och gjorde CI:s arbetsträd
# smutsigt: checkouten la tillbaka en symlänk till en sökväg som inte
# finns på runnern, npm ersatte den med en riktig katalog, och
# `git status --porcelain` såg en raderad SPÅRAD fil. Utan snedstreck
# matchas både katalog och symlänk, på alla nivåer.
node_modules

# Tillfälliga provskript. Speltestning körs med Playwright-snuttar som
# skrivs, körs och slängs — de är inte projektfiler och ska aldrig
# hamna i historiken. Mönstren täcker både agenternas scratch_*.mjs och
# de punktprefixade snuttar som används här.
scratch_*.mjs
scratch_*.js
.[a-z]*.js

# Byggda testfiler
roblox/tests/.build/

# Studio-paketet är en hopfogning av filer som redan ligger i repot.
roblox/buildings/.studio/
__pycache__/

# Screenshot-pack (Visual Fidelity Gate, #80) är CI-artifact, aldrig incheckat här
qa/screenshot-pack/
