	<Item class="ServerScriptService" referent="RBX26">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Script" referent="RBX27">
			<Properties>
				<string name="Name">Horse</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Serverns start. Håll den tom på logik — den ska bara starta tjänsterna
	i rätt ordning, så att det syns var något går fel.
]]

local SparService = require(script.SparService)
local HorseService = require(script.HorseService)
local StallService = require(script.StallService)
local GameplayService = require(script.GameplayService)
local DorrService = require(script.DorrService)
local Preflight = require(script.Preflight)

--[[ Ordningen är ett beroende, inte en smaksak: GameplayService registrerar
     sin uppsittningsgrind i HorseService och läser tilldelad HorseId ur
     StallService, så båda måste vara igång först.

     SparService ligger FÖRST sedan #161, och det är också ett beroende:
     StallService.tilldela frågar efter spelarens hästminnen för att inte
     dela ut en häst som vilar för en skada, och GameplayService läser
     passnumret för att veta om det är första dagen.

     MEN ORDNINGEN HÄR ÄR INTE EN BARRIÄR, och sedan #162 blockerare 1
     låtsas den inte vara det. Den bestämmer bara i vilken ordning
     anslutningarna görs. `SparService.ladda` yieldar i sitt `GetAsync`,
     och Roblox kör varje `PlayerAdded`-anslutning på egen tråd — så en
     tjänst som kopplade signalen själv startade mitt i läsningen, hur
     sent den än startades.

     Därför finns nu exakt EN `PlayerAdded`-lyssnare i servern, i
     SparService, och StallService/GameplayService hänger på
     `SparService.efterLaddning`. Startordningen nedan avgör i vilken
     ordning de hookarna körs, och det beroendet gäller fortfarande. ]]
--[[ ══ VÄRLDEN FÖRST ═══════════════════════════════════════════════════

	Blockerare i #162: Roblox-sidan hade två halvor som aldrig möttes. Det
	inklistrade Studio-paketet byggde anläggningen men innehöll ingen rad ur
	`roblox/src/`; Rojo-projektet mappade gameplay men INTE `Anlaggningen`,
	så en fullständig synk byggde ingen anläggning alls. Det fanns alltså
	ingen väg som gav värld och gameplay i samma place — och därför testade
	Tobias miljö + QA-panel i tron att det var First Playable.

	Här möts de. Världen byggs innan tjänsterna startar, av samma
	`Anlaggningen.luau` som paketet använder, och den ordningen är ett
	beroende: `StallService` sätter sin boxmarkör i den byggda modellen och
	`DorrService` letar dörrblad i den. Utan värld först får båda ingenting
	att arbeta på, och det ska då SYNAS i outputen. ]]
local function byggVarlden(): boolean
	local sss = game:GetService("ServerScriptService")
	local varld = sss:FindFirstChild("Varld")
	local byggare = varld and varld:FindFirstChild("Anlaggningen")
	if not byggare then
		warn("[Horse] ServerScriptService.Varld.Anlaggningen saknas — "
			.. "ingen anläggning byggs. Det här är INTE en First Playable-build.")
		return false
	end
	--[[ Modulen bygger för sin verkan när den requiras. ]]
	require(byggare)
	return true
end

local varldenFinns = byggVarlden()

SparService.start()
HorseService.start()
StallService.start()
GameplayService.start()
DorrService.start()
print("[Horse] Servern igång")

--[[ Preflight SIST: den mäter det färdiga läget, inte avsikten. ]]
Preflight.kor(varldenFinns)
]]></ProtectedString>
			</Properties>
			<Item class="ModuleScript" referent="RBX28">
				<Properties>
					<string name="Name">DorrService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Dörrarna som gameplay.

	Blockerare i #162, funnen av Tobias i Studio: han stod vid den vita
	dörren, på den gula markören, och kom inte in. Ingenting hände och ingen
	interaktion syntes.

	Två orsaker, och båda var verkliga:

	  1. Fasaden byggdes som fyra hela väggar och öppningarna MÅLADES på
	     utsidan som 6 cm tunna paneler. Väggen bakom dörren kolliderade.
	     Det är rättat i `Anlaggningen.luau` — fasaden byggs som segment med
	     luckor där dörrarna redan står.
	  2. Ingen dörr hade någon interaktion. `ProximityPrompt` fanns på exakt
	     två ställen i hela runtime: en per häst (`InteractionController`) och
	     en vid boxen (`StallService`). Dörrarna hade `Mot`/`Text` som ingen
	     läste — de attributen är webbens scenbyte, och webbens scenbyte hör
	     inte hit: Roblox-anläggningen är EN sammanhängande place, så att gå
	     in är att gå igenom en öppning, inte att teleporteras.

	Den här tjänsten gör det andra: varje dörrblad som `Anlaggningen` märkt
	med `UBRFDorr` får en prompt, och dörren öppnas och stängs faktiskt.

	Ingen geometri flyttas. Bladet svänger runt sin egen gångjärnskant och
	går tillbaka exakt dit det stod — det stängda läget sparas vid start och
	är det enda som skrivs tillbaka.
]]

local DorrService = {}

local OPPEN_VINKEL = 85         -- grader; 90 låter bladet ligga i väggens liv
local RACKVIDD = 8              -- m, som boxens prompt i StallService
local M = 3                     -- studs per meter, som BuildKit.M

--[[ Det stängda läget per blad. En tabell och inte ett attribut: läget ska
	inte kunna följa med en kopierad del in i en annan session och där gälla
	som sanning. ]]
local stangt: { [BasePart]: CFrame } = {}
local oppna: { [BasePart]: boolean } = {}

local function anlaggning(): Instance?
	local folder = workspace:FindFirstChild("Anläggning")
	return folder
end

--[[ Gångjärnet ligger i bladets ena lodräta kant. Vilken kant spelar ingen
	roll för framkomligheten, och att välja den låga änden längs väggens egen
	axel är förutsägbart — det är samma axel `Anlaggningen` byggde bladet i. ]]
local function gangjarn(blad: BasePart): (CFrame, Vector3)
	local langs = blad:GetAttribute("Langs")
	local halv = ((blad:GetAttribute("Bredd") :: number) or 1) * M / 2
	local lokal = if langs == "X" then Vector3.new(-halv, 0, 0) else Vector3.new(0, 0, -halv)
	return stangt[blad] * CFrame.new(lokal), lokal
end

local function satt(blad: BasePart, vidoppen: boolean)
	local gang, lokal = gangjarn(blad)
	if vidoppen then
		blad.CFrame = gang * CFrame.Angles(0, math.rad(OPPEN_VINKEL), 0) * CFrame.new(-lokal)
	else
		blad.CFrame = stangt[blad]
	end
	--[[ Kollisionen är hela poängen: en öppen dörr man inte kan gå igenom är
		samma fel som förut, bara med en animation på. ]]
	blad.CanCollide = not vidoppen
	oppna[blad] = vidoppen
end

local function textFor(blad: BasePart): string
	local etikett = blad:GetAttribute("Etikett")
	local byggnad = blad:GetAttribute("Byggnad")
	if typeof(etikett) == "string" and etikett ~= "" then
		return etikett
	end
	return if typeof(byggnad) == "string" then byggnad else "Dörr"
end

local function rustaDorr(blad: BasePart)
	if stangt[blad] then return end
	stangt[blad] = blad.CFrame
	oppna[blad] = false
	blad.CanCollide = true

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "DorrPrompt"
	prompt.ActionText = "Öppna"
	prompt.ObjectText = textFor(blad)
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = RACKVIDD
	--[[ Utan siktlinjekrav: bladet står i sin egen lucka och skymmer sig
		själv från vissa vinklar, och då försvann prompten där man faktiskt
		står — vilket är just det Tobias råkade ut för. ]]
	prompt.RequiresLineOfSight = false
	prompt.Parent = blad

	prompt.Triggered:Connect(function()
		local nu = not oppna[blad]
		satt(blad, nu)
		prompt.ActionText = if nu then "Stäng" else "Öppna"
	end)
end

--[[ Alla dörrblad i den byggda anläggningen. Attributet sätts av
	`Anlaggningen.byggOppning` för de öppningar man GÅR IGENOM — fönster och
	öppningar med bröstning får det inte, och ska inte ha en prompt. ]]
function DorrService.dorrar(): { BasePart }
	local ut = {}
	local rot = anlaggning()
	if not rot then return ut end
	for _, d in ipairs(rot:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("UBRFDorr") == true then
			table.insert(ut, d)
		end
	end
	return ut
end

function DorrService.start()
	local funna = DorrService.dorrar()
	if #funna == 0 then
		--[[ Fail loud, inte tyst: en place utan byggd anläggning är precis
			det läge blockeraren handlade om, och då ska det stå i outputen
			och inte upptäckas av en människa framför en dörr som inte
			öppnas. ]]
		warn("[Dörr] Anläggningen är inte byggd — ingen dörr fick interaktion. "
			.. "First Playable kräver att världen byggs före tjänsterna.")
		return
	end
	for _, blad in ipairs(funna) do
		rustaDorr(blad)
	end
	print(("[Dörr] %d dörrar fick interaktion"):format(#funna))
end

-- För preflight och specar: går dörren att öppna, och släpper den igenom?
function DorrService.provaOppna(blad: BasePart): boolean
	if not stangt[blad] then return false end
	satt(blad, true)
	local gick = blad.CanCollide == false
	satt(blad, false)
	return gick and blad.CanCollide == true
end

return DorrService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX29">
				<Properties>
					<string name="Name">GameplayService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[ GAMEPLAYSERVICE — skötseln och passet, server-auktoritativt.

	Gate G01 skiva S2b byggde förberedelsen. #161 gör den till gameplay och
	lägger dagen runt den. Loopen är hela vägen:

	    Hälsa → Visitera → Rykta → Gör i ordning → Led → Sitt upp
	      → rid → sitt av → eftervård → passet räknas → spara → ny dag

	Ansvarsfördelningen är hela poängen med filen:

	  · `SparService` äger det varaktiga lagret och varje skrivning.
	  · `StallService` äger vilken kanonisk `HorseId` spelaren fått.
	  · `Preparation` äger förberedelsens regler — momenten, ordningen,
	    fyndet och välfärdsstoppet. Ren logik, provas utan Studio.
	  · `Pass` äger dagen efter uppsittningen — eftervården och när ett
	    pass får räknas.
	  · `HorseService` äger uppsittning, avsittning och ridningen. Den här
	    filen sitter uppsittning ALDRIG själv; den registrerar ett villkor
	    via `setMountGate`.
	  · Den här filen äger BINDNINGEN: vilken modell i världen som är den
	    tilldelade identiteten, avstånden, och tidpunkterna.

	Klienten får aldrig flytta fram förberedelsen. Den skickar en avsikt
	("jag vill krafsa vänster fram") och får hela sanningen tillbaka.
	Skälet är inte fusk i ett familjespel — det är att två klienter annars
	kan tro olika saker om samma häst, och då är det inte längre servern
	som håller loopen. Samma regel gäller passet och sparningen: det finns
	ingen väg in där en klient skickar ett tillstånd.
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Core = require(ReplicatedStorage.HorseCore)
local Preparation = require(ReplicatedStorage.HorseCore.Preparation)
local Pass = require(ReplicatedStorage.HorseCore.Pass)
local Sparning = require(ReplicatedStorage.HorseCore.Sparning)
local Net = Core.Networking

local HorseService = require(script.Parent.HorseService)
local StallService = require(script.Parent.StallService)
local SparService = require(script.Parent.SparService)

local GameplayService = {}

local TAG = "Horse"

--[[ Så nära man måste stå för att få göra ett steg. Servern äger talet;
	klienten får inte skicka med sitt eget avstånd.

	Stod först på 16 med kommentaren att man ryktar NÄRMARE än man sitter upp
	— men `MountRange` är 14, så talet sa raka motsatsen till kommentaren.
	Senior review fällde motsägelsen på #61.

	12 studs är valt: faktiskt närmare än uppsittningens 14, och samma tal som
	den tidigare S2-specen använde. Game feel avgörs i Studio, inte här. ]]
local STEG_RACKVIDD = 12

--[[ Hur många pass en häst vilar efter ett rapporterat fynd. Talet är
	litet med flit: en familjespelare ska märka att hästen är borta ur
	rotationen nästa gång, inte förlora henne i en vecka. ]]
local VILA_PASS = 2

local state: { [Player]: Preparation.State } = {}
local passState: { [Player]: Pass.State } = {}
local bunden: { [Player]: Model } = {}

--[[ Ett strikt växande serienummer per spelare. Varje vy servern skickar —
	spontan sync eller svar på handskakningen — bär sitt nummer, så att
	klienten kan kasta en gammal vy som råkar komma sist. Krav 10. ]]
local revision: { [Player]: number } = {}

local function nastaRev(player: Player): number
	revision[player] = (revision[player] or 0) + 1
	return revision[player]
end

--[[ ── Bindningen ──────────────────────────────────────────────────── ]]

--[[ Modellen vars `HorseId` är EXAKT den tilldelade, och som ingen annan
	spelare redan är bunden till.

	Ingen närmast-häst-fallback. Att binda närmaste Horse-taggade modell är
	frestande — det gör att något alltid händer — men det gör också att
	spelaren gör i ordning fel individ utan att få veta det. Hellre
	`waiting_model`. ]]
local function hittaModell(player: Player, hastId: string): Model?
	--[[ Kandidaterna samlas här; VALET görs i Preparation. Tjänsten har med
		flit ingen egen kopia av villkoret — se modulens kommentar. ]]
	local kandidater = {}
	for _, modell in CollectionService:GetTagged(TAG) do
		if modell:IsA("Model") then
			table.insert(kandidater, { id = modell:GetAttribute("HorseId"), modell = modell })
		end
	end
	local upptagna = {}
	for annan, m in pairs(bunden) do
		if annan ~= player then upptagna[m] = true end
	end
	return Preparation.valjModell(kandidater, hastId, upptagna) :: Model?
end

local function status(player: Player): string
	local s = state[player]
	if not s then return Preparation.STATUS.VANTAR_MODELL end
	--[[ Välfärdsstoppet läses FÖRE ritten. En spelare som stoppat arbetet
		sitter inte upp, men om hon på något sätt ändå gjorde det ska HUD:en
		säga varför hästen inte arbetar — inte "du rider". ]]
	if s.stoppad then return Preparation.STATUS.STOPPAD end
	if HorseService.horseOf(player) then return Preparation.STATUS.RIDER end
	if not bunden[player] then return Preparation.STATUS.VANTAR_MODELL end
	return if Preparation.redo(s) then Preparation.STATUS.REDO else Preparation.STATUS.FORBEREDER
end

local function vyFor(player: Player)
	return Preparation.vy(state[player], status(player), nastaRev(player))
end

--[[ Spontan sanning till ägaren. Den kan gå förlorad om klienten ännu inte
	anslutit sin listener — en RemoteEvent köas inte åt en framtida
	lyssnare — och det är precis därför `PreparationHello` finns. Att bara
	FireClient härifrån var felet senior review fällde: en klient som
	anslöt sent startade utan hästId, steg och ready-state. ]]
local function skicka(player: Player)
	Net.get("PreparationSync"):FireClient(player, vyFor(player))
end

local function skickaPass(player: Player)
	Net.get("PassSync"):FireClient(player, Pass.vy(passState[player], nastaRev(player)))
end

--[[ Passnumret för dagen som börjar. Ur sparningen, alltså serverns tal.

	Faller sparningen är talet 1, och det betyder "första dagen" — vilket
	gör dagen FRI FRÅN FYND. Det är avsiktligt fail-safe åt spelarens håll
	i just den här frågan: ett datalagerfel ska inte kunna hitta på en
	skada som sedan inte går att spara bort. ]]
local function passnummer(player: Player): number
	local save = SparService.save(player)
	return if save then Sparning.aktuelltPass(save) else 1
end

--[[ Försök binda identiteten till en modell. Anropas vid ankomst och varje
	gång en Horse-taggad modell dyker upp — en rigg som strömmas in eller
	byggs senare ska fångas upp utan att spelaren gör om något. ]]
function GameplayService.bind(player: Player): Model?
	local hastId = StallService.hastIdFor(player)
	if not hastId then return nil end

	if not state[player] or state[player].hastId ~= hastId then
		state[player] = Preparation.nyState(hastId, passnummer(player))
		--[[ Passet skapas samtidigt som förberedelsen, och `passId` sätts
			EN gång här. Räknades det om vid avslutet vore kvittot i
			`Sparning.registreraPass` värdelöst — se `Pass.byggId`. ]]
		passState[player] = Pass.nyState(hastId,
			Pass.byggId(player.UserId, hastId, passnummer(player)))
		bunden[player] = nil
	end

	local modell = hittaModell(player, hastId)
	if modell then
		bunden[player] = modell
	else
		bunden[player] = nil
	end
	skicka(player)
	skickaPass(player)
	return modell
end

--[[ ── Stegen ──────────────────────────────────────────────────────── ]]

local function avstandOk(player: Player, modell: Model): boolean
	local karaktar = player.Character
	local rot = karaktar and karaktar:FindFirstChild("HumanoidRootPart")
	if not (rot and rot:IsA("BasePart")) then return false end
	local pivot = modell.PrimaryPart or modell:FindFirstChildWhichIsA("BasePart")
	if not pivot then return false end
	return (rot.Position - pivot.Position).Magnitude <= STEG_RACKVIDD
end

--[[ Allt som gäller FÖRE ett skötselmoment får göras: att spelaren har en
	häst, att hon står vid rätt modell, och att modellen finns.

	Bruten ut ur `moment` för att `svara` behöver exakt samma prövning. Låg
	den bara i `moment` gick fyndsvaret att skicka från andra sidan gården. ]]
local function narvaro(player: Player): (boolean, string?)
	local s = state[player]
	if not s then
		return false, "Du har ingen tilldelad häst"
	end
	local modell = bunden[player]
	if not modell then
		--[[ Prova en gång till: riggen kan ha dykt upp sedan sist. ]]
		modell = GameplayService.bind(player)
		if not modell then
			return false, "Din häst finns inte i världen än"
		end
	end
	if not avstandOk(player, modell) then
		return false, "Du står för långt bort"
	end
	return true, nil
end

--[[ Ett skötselmoment. ENDA vägen framåt i förberedelsen sedan #161.

	Den gamla `GameplayService.utfor(player, fasId)` — ett tryck, en hel
	fas avbockad — finns inte längre, och det är hela poängen med skivan:
	den var en checklista, och en klient som fick kvittera en fas kunde
	kvittera alla på fem anrop. Nu går varje steg framåt genom ett moment
	som `Preparation` prövar mot ordning, avstånd, individ och välfärd. ]]
function GameplayService.moment(player: Player, fasId: string, momentId: string): (boolean, string?)
	if typeof(fasId) ~= "string" or typeof(momentId) ~= "string" then
		return false, "Ogiltigt steg"
	end
	local naravaro_ok, skal = narvaro(player)
	if not naravaro_ok then
		return false, skal
	end
	local s = state[player]

	local ok, avslag = Preparation.utforMoment(s, fasId, momentId, s.hastId)
	skicka(player)
	return ok, avslag
end

--[[ Svaret på ett fynd. Rätt svar stoppar arbetet, sparar hästens vila och
	räknar passet — spelaren gjorde precis det momentet lär ut, och ska inte
	förlora dagen på det. ]]
function GameplayService.svara(player: Player, svarId: string): (boolean, string?)
	if typeof(svarId) ~= "string" then
		return false, "Ogiltigt svar"
	end
	local naravaro_ok, skal = narvaro(player)
	if not naravaro_ok then
		return false, skal
	end
	local s = state[player]

	local ok, avslag = Preparation.svaraFynd(s, svarId)
	if ok then
		--[[ Skadan skrivs INNAN passet räknas. Faller skrivningen har vi
			hellre en sparad skada utan pass än ett pass utan skada: det
			första kostar spelaren en dag, det andra sätter en halt häst i
			arbete i morgon. ]]
		local save = SparService.save(player)
		if save then
			Sparning.satSkada(save, s.hastId, VILA_PASS,
				(s.fynd and s.fynd or nil) :: any)
		end
		local p = passState[player]
		if p then
			Pass.vidValfardsstopp(p)
			GameplayService.avslutaPass(player)
		end
	end
	skicka(player)
	skickaPass(player)
	return ok, avslag
end

--[[ ── Passet ──────────────────────────────────────────────────────── ]]

function GameplayService.eftervard(player: Player, momentId: string): (boolean, string?)
	if typeof(momentId) ~= "string" then
		return false, "Ogiltigt steg"
	end
	local p = passState[player]
	if not p then
		return false, "Du har inget pass igång"
	end
	--[[ Eftervården kräver samma närvaro som skötseln: man tar av sadeln
		vid hästen, inte från läktaren. ]]
	local naravaro_ok, skal = narvaro(player)
	if not naravaro_ok then
		return false, skal
	end

	local ok, avslag = Pass.utfor(p, momentId)
	if ok and Pass.farAvsluta(p) then
		GameplayService.avslutaPass(player)
	end
	skickaPass(player)
	return ok, avslag
end

--[[ Avslutar och RÄKNAR passet. Fail-closed genom `Pass.farAvsluta`, och
	idempotent genom `Sparning.registreraPass`:

	  · en dubbel serverhändelse (avslut + utloggning i samma sekund) ger
	    ETT pass, för kvittot `passId` är detsamma,
	  · en misslyckad skrivning lämnar passet oräknat i lagret men markerar
	    det INTE som räknat i minnet, så nästa försök tar det igen.

	Ordningen minne → lager är vald åt spelarens håll: `markeraRaknat`
	sätts först efter att skrivningen gick fram. ]]
function GameplayService.avslutaPass(player: Player): (boolean, string?)
	local p = passState[player]
	if not p then
		return false, "Du har inget pass igång"
	end
	local ok, skal = Pass.farAvsluta(p)
	if not ok then
		return false, skal
	end

	local save = SparService.save(player)
	if not save then
		return false, "Sparningen är inte igång"
	end

	--[[ Räkningen görs i minnesbilden först, så att `skriv` har något att
		slå ihop. Går skrivningen inte fram ligger den kvar och följer med
		nästa gång — kvittot gör det ofarligt. ]]
	local nytt = Sparning.registreraPass(save, p.passId, os.time())
	if nytt then
		Sparning.raknaNerVila(save)
		--[[ Relationen växer av att ha gjort dagen färdigt, inte av att ha
			ridit. Det är samma värdering som resten av loopen: ansvaret är
			innehållet. Talet är litet — en relation byggs över veckor. ]]
		Sparning.hojRelation(save, p.hastId, 0.04)
		Sparning.markeraForstaDagen(save, p.hastId)
	end

	local skrevs = SparService.skriv(player)
	if skrevs or not SparService.kanSpara(player) then
		--[[ Antingen skrevs det, eller så kan den här sessionen ändå inte
			spara (läsfel eller framtida sparfil). I båda fallen är passet
			klart för spelaren; i det andra får hon veta det genom
			`SparService.anmarkning`. Att låta passet hänga oavslutat i en
			session som ALDRIG kan spara vore att låsa henne i eftervården. ]]
		Pass.markeraRaknat(p)
	end

	skicka(player)
	skickaPass(player)
	return true, nil
end

--[[ ── Uppsittningsgrinden ─────────────────────────────────────────── ]]

--[[ Registreras i `HorseService`. Körs FÖRE all uppsittningslogik, så en
	oförberedd spelare aldrig hinner bli monterad och sedan kastas av. ]]
function GameplayService.farSittaUpp(player: Player, modell: Model): (boolean, string?)
	local s = state[player]
	--[[ Krav 6 och 7 avgörs av regeln, inte här. Kvar i tjänsten är bara
		det instansnära: att modellen dessutom är den vi FAKTISKT bundit,
		så att två modeller med samma id aldrig kan bli utbytbara. ]]
	local ok, skal = Preparation.provaModell(s, modell:GetAttribute("HorseId"))
	if not ok then
		return false, skal
	end
	if bunden[player] ~= modell then
		return false, "Det är inte din häst"
	end
	--[[ Passet får bara börja en gång. Ett andra `tryMount` på samma dag —
		efter en avsittning — ska inte nollställa eftervården. ]]
	local p = passState[player]
	if p and p.lage ~= Pass.LAGE.FORE then
		return false, "Du har redan ridit idag"
	end
	return true, nil
end

--[[ ── Livscykel ───────────────────────────────────────────────────── ]]

local function glom(player: Player)
	state[player] = nil
	passState[player] = nil
	bunden[player] = nil
	revision[player] = nil
end

function GameplayService.start()
	HorseService.setMountGate(GameplayService.farSittaUpp)

	--[[ Uppsittningen och avsittningen driver passets läge. De hakas på
		`HorseService` i stället för att `GameplayService` skulle lyssna på
		remoten: allt som monterar en ryttare går genom `tryMount`, och en
		krok på fjärranropet hade missat varje annan väg in. ]]
	HorseService.setRiderHook(function(player: Player, sitter: boolean)
		local p = passState[player]
		if not p then return end
		if sitter then
			Pass.vidUppsittning(p)
		else
			Pass.vidAvsittning(p)
		end
		skicka(player)
		skickaPass(player)
	end)

	Net.get("PreparationMoment").OnServerInvoke = function(player, fasId, momentId)
		return GameplayService.moment(player, fasId, momentId)
	end
	Net.get("PreparationSvar").OnServerInvoke = function(player, svarId)
		return GameplayService.svara(player, svarId)
	end
	Net.get("PassMoment").OnServerInvoke = function(player, momentId)
		return GameplayService.eftervard(player, momentId)
	end

	--[[ `PreparationStep` finns kvar i nätkontraktet men gör inget mer än
		att säga ifrån. Att ta bort den helt hade gjort att en klient från
		en äldre version tyst fick nil tillbaka och stod och väntade; nu får
		den ett begripligt nej. Fasen går inte att kvittera den vägen — det
		är hela ändringen i #161. ]]
	Net.get("PreparationStep").OnServerInvoke = function(_player, _fasId)
		return false, "Skötseln görs moment för moment nu — uppdatera klienten."
	end

	--[[ Handskakningen. Klienten anropar den FÖRST efter att den anslutit sin
		`PreparationSync`-listener, och får hela nuläget i retur. Det gör
		starttillståndet deterministiskt oavsett vem som hann först.

		Svaret bär samma revision som en spontan sync, så om en nyare sync
		hinner före svaret kastar klienten svaret i stället för att backa. ]]
	Net.get("PreparationHello").OnServerInvoke = function(player)
		if not state[player] then
			GameplayService.bind(player)
		end
		--[[ Passvyn skickas som en egen sync i samma andetag. Utan den
			startade en klient som anslöt mitt i eftervården utan att veta
			att det fanns en eftervård — samma hål som handskakningen
			byggdes för att täta på förberedelsen. ]]
		skickaPass(player)
		return vyFor(player)
	end

	--[[ Flaggan är serverns svar på "är loopen igång". Klienten läser den
		och visar ingen uppsittningsprompt förrän den är sann. Sätts SIST i
		start(), så att den aldrig är sann innan grinden är registrerad. ]]

	--[[ BINDNINGEN HÄNGER PÅ BARRIÄREN (#162 blockerare 1). Kopplade den
		här filen `PlayerAdded` själv kunde `bind()` köras medan saven ännu
		var nil, och då föll `passnummer()` till 1 — alltså "första dagen",
		med en dag fri från fynd — för en spelare som hade tio pass bakom
		sig. Hooken körs efter att läsningen returnerat.

		Registreringsordningen ger beroendet: `StallService` hookar först
		(init.server startar den före), så `hastIdFor` har ett svar när
		bindningen sker. ]]
	SparService.efterLaddning(function(player)
		GameplayService.bind(player)
		player.CharacterAdded:Connect(function()
			GameplayService.bind(player)
		end)
	end)
	--[[ Ingen `GetPlayers()`-loop här heller (#162 re-review): den band mot
		ett `passnummer()` som föll till 1 när saven ännu var nil.
		`efterLaddning` kör hooken direkt för dem som redan är redo. ]]
	Players.PlayerRemoving:Connect(glom)

	--[[ En rigg som kommer in senare ska plockas upp av den som väntar på
		henne. Det är krav 2: `waiting_model` ska läka av sig själv. ]]
	CollectionService:GetInstanceAddedSignal(TAG):Connect(function(inst)
		if not inst:IsA("Model") then return end
		for _, player in Players:GetPlayers() do
			if not bunden[player] then
				GameplayService.bind(player)
			end
		end
	end)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(inst)
		for player, m in pairs(bunden) do
			if m == inst then
				bunden[player] = nil
				skicka(player)
			end
		end
	end)

	ReplicatedStorage:SetAttribute("G01Enabled", true)
	print("[Gameplay] Skötseln och passet igång")
end

function GameplayService.stateFor(player: Player): Preparation.State?
	return state[player]
end

function GameplayService.passFor(player: Player): Pass.State?
	return passState[player]
end

function GameplayService.modellFor(player: Player): Model?
	return bunden[player]
end

function GameplayService.statusFor(player: Player): string
	return status(player)
end

return GameplayService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX30">
				<Properties>
					<string name="Name">HorseService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	HorseService — serverns auktoritet.

	Servern äger: vem som rider vad, om uppsittning får ske, uthålligheten,
	och hästarnas beständiga statistik. Den äger INTE bildruta-för-bildruta-
	positionen — den ligger hos ryttarens klient via nätverksägarskap, för
	annars går det inte att rida responsivt med Roblox latens.

	Det klienten skickar in valideras: tempo mot hästens tak, position mot
	rimlig förflyttning. Fusk ger en tillrättaläggning, inte en kick — det
	här är ett familjespel, inte en tävlingsserver.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local Core = require(game:GetService("ReplicatedStorage").HorseCore)
local Types = require(game:GetService("ReplicatedStorage").HorseCore.Types)
local Config, Gaits, RigAdapter, Net = Core.Config, Core.Gaits, Core.RigAdapter, Core.Networking
local Svar, RidKanon = Core.Svar, Core.RidKanon
--[[ Stallet äger den kanoniska hästdatan; HorseService läser den för att
     binda rätt individ till rätt ridkänsla (blocker 1). ]]
local Stallet = require(game:GetService("ReplicatedStorage").Stallet)

local HorseService = {}

export type Session = {
	rig: Types.Rig,
	stats: { [string]: any },
	rider: Player?,
	--[[ ENERGIN ÄR DEN ENDA TRÖTTHETSSANNINGEN (senior re-review #87).
	     0–1, samma storhet och samma kanon som klientens `loco.energi`
	     och webbens `s.energi`. `Stamina`-attributet och StaminaSync är
	     dess presentation i 0–MaxStamina, inget eget tillstånd. ]]
	energi: number,
	lastExertion: number,
	lastSync: number,
	lastPosition: Vector3,
}

local sessions: { [Model]: Session } = {}
local byRider: { [Player]: Model } = {}

local TAG = "Horse"

--[[ ── Registrering ────────────────────────────────────────────────── ]]

local function register(model: Model)
	if sessions[model] then return end

	local rig, err = RigAdapter.build(model)
	if not rig then
		warn(("[Horse] %s kunde inte registreras: %s"):format(model:GetFullName(), err or "okänt fel"))
		return
	end

	-- Configuration-blocken skapas om de saknas, så att allt går att skruva
	-- i Studio i stället för att ligga dolt i kod.
	local function ensure(name: string): Configuration
		local existing = model:FindFirstChild(name)
		if existing and existing:IsA("Configuration") then
			return existing
		end
		local c = Instance.new("Configuration")
		c.Name = name
		c.Parent = model
		return c
	end
	rig.stats = rig.stats or ensure("HorseStats")
	rig.gaitConfig = rig.gaitConfig or ensure("GaitConfig")
	rig.animConfig = rig.animConfig or ensure("AnimationConfig")

	--[[ ── DEN TILLDELADE HÄSTENS EGNA VÄRDEN (blocker 1) ─────────────
	     Modellens `HorseId` är den kanoniska identiteten, och hästens
	     spelvärden ur UBRFSpelData skrivs på HorseStats FÖRE
	     writeDefaults. Ordningen är hela poängen:

	       ett attribut som redan finns   någon satte det i Studio → vinner
	       kanon                          skrivs här om det saknas
	       Config.STATS default           writeDefaults fyller resten

	     Först skrev jag kanonen EFTER writeDefaults och lät `Config.attr`
	     avgöra. Det gick inte: writeDefaults hade just stämplat sina
	     defaultvärden på samma Configuration, så "någon satte det i
	     Studio" gick inte att skilja från "vi skrev standardvärdet för en
	     millisekund sedan" — och varje häst red som `skolhast` ändå.
	     Uppmätt, inte resonerat: provet i forberedelse.spec sa
	     `crokino → skolhast`.

	     Utan det här ledet nådde profilerna aldrig ridcontrollern. ]]
	do
		local id = model:GetAttribute("HorseId")
		local kanon = if type(id) == "string" then Stallet.statsFor(id) else nil
		if kanon then
			local c = rig.stats :: Configuration
			for nyckel, varde in kanon do
				if varde ~= nil and c:GetAttribute(nyckel) == nil then
					c:SetAttribute(nyckel, varde)
				end
			end
		end
	end

	Config.writeDefaults(rig.stats :: Configuration, Config.STATS)
	Config.writeDefaults(rig.gaitConfig :: Configuration, Config.MOVEMENT)

	local stats = Config.resolveStats(rig.stats)

	-- Humanoiden ställs in en gång. AutoRotate av: vi äger vridningen, annars
	-- snurrar hästen som ett fordon mot rörelseriktningen.
	local hum = rig.humanoid
	if hum then
		hum.AutoRotate = false
		hum.UseJumpPower = true
		hum.JumpPower = Config.MOVEMENT.JumpPower * (0.7 + 0.6 * stats.JumpStrength)
		hum.WalkSpeed = 0
		hum.BreakJointsOnDeath = false
		hum.RequiresNeck = false
		hum.HipHeight = Config.attr(rig.gaitConfig, "HipHeight", hum.HipHeight)
	end

	sessions[model] = {
		rig = rig,
		stats = stats,
		rider = nil,
		--[[ Utgångsläget ur kanonen (senior re-review #87, blocker 2).
		     Stod som 1 — en utvilad häst som webben aldrig satte upp på;
		     där börjar energin i dagsformen. ]]
		energi = Svar.startEnergi(),
		lastExertion = 0,
		lastSync = os.clock(),
		lastPosition = rig.root.Position,
	}

	model:SetAttribute("Registered", true)
	model:SetAttribute("Gait", "halt")
	model:SetAttribute("Stamina", stats.MaxStamina)
end

--[[ Provkrokar. `register` är lokal med flit — produktionen registrerar
     via CollectionService — men blocker 1 kräver ett prov som går genom
     den RIKTIGA registreringen och läser de stats hästen faktiskt fick.
     Krokarna kallar samma kod, de duplicerar den inte. ]]
function HorseService._registerForProv(model: Model)
	register(model)
end
function HorseService._statsFor(model: Model): { [string]: any }?
	local session = sessions[model]
	return if session then session.stats else nil
end

local function unregister(model: Model)
	local session = sessions[model]
	if not session then return end
	if session.rider then
		byRider[session.rider] = nil
	end
	sessions[model] = nil
end

--[[ ── Uppsittning ─────────────────────────────────────────────────── ]]

local function seatCFrame(session: Session): CFrame
	return RigAdapter.saddleCFrame(session.rig)
end

local function setRider(session: Session, player: Player?)
	local previous = session.rider
	session.rider = player

	if previous then
		byRider[previous] = nil
	end
	if player then
		byRider[player] = session.rig.model
	end

	session.rig.model:SetAttribute("RiderUserId", if player then player.UserId else 0)

	--[[ Nätverksägarskapet går till ryttaren så att rörelsen simuleras där
	     inputen finns. Utan det ligger en halv sekunds fördröjning i varje
	     styrutslag och hästen känns som en båt. ]]
	local ok = pcall(function()
		session.rig.root:SetNetworkOwner(player)
	end)
	if not ok then
		warn("[Horse] Kunde inte sätta nätverksägare (ankrad eller ej fysisk del?)")
	end

	Net.get("MountChanged"):FireAllClients(session.rig.model, player)

	--[[ Aviseringen sist, när allt annat är gjort: kroken ska se ett
		färdigt tillstånd, inte ett halvt. ]]
	local hook = riderHook
	if hook then
		if previous and previous ~= player then
			local ok, fel = pcall(hook, previous, false)
			if not ok then warn("[Horse] ryttarkroken (av) kastade: " .. tostring(fel)) end
		end
		if player then
			local ok, fel = pcall(hook, player, true)
			if not ok then warn("[Horse] ryttarkroken (upp) kastade: " .. tostring(fel)) end
		end
	end
end

--[[ Förberedelsegrinden.

	`HorseService` är fortfarande ENDA uppsittningsauktoritet — den här kroken
	flyttar inte beslutet, den låter `GameplayService` lägga till ett villkor
	framför det. Skälet att den ligger här och inte i fjärranropet: allt som
	monterar en ryttare går genom `tryMount`, och en grind som bara satt på
	`MountRequest` hade gått att gå runt genom vilken annan väg som helst in
	i den här filen.

	Ingen grind registrerad = ingen förändring. Hästsystemet ska gå att köra
	utan G01-loopen, annars kan movement-specarna inte prova det ensamt. ]]
local mountGate: ((Player, Model) -> (boolean, string?))? = nil

function HorseService.setMountGate(gate: ((Player, Model) -> (boolean, string?))?)
	mountGate = gate
end

--[[ RYTTARKROKEN (#161).

	`GameplayService` behöver veta NÄR någon satt sig upp eller av, för att
	driva passets läge — och den behöver veta det för VARJE väg in och ut,
	inte bara för `MountRequest`. En krok på fjärranropet hade missat
	karaktärens död, respawn, utloggning och en modell som tas bort ur
	världen, och just de fallen är de som lämnar ett pass hängande.

	Den ligger därför i `setRider`, som är den enda punkt all uppsittning
	och avsittning faktiskt passerar — exakt samma resonemang som gjorde
	att `mountGate` sitter i `tryMount` och inte på remoten.

	Kroken får INTE avgöra något. Den är en avisering, inte en grind; ett
	fel i den ska inte kunna hindra en avsittning, och därför är anropet
	inkapslat i pcall. En spökryttare som sitter kvar för att en HUD
	kastade vore värre än en HUD som visar fel. ]]
local riderHook: ((Player, boolean) -> ())? = nil

function HorseService.setRiderHook(hook: ((Player, boolean) -> ())?)
	riderHook = hook
end

function HorseService.tryMount(player: Player, model: Model): (boolean, string?)
	if mountGate then
		local tillaten, skal = mountGate(player, model)
		if not tillaten then
			return false, skal or "Hästen är inte färdig att sitta upp på"
		end
	end

	local session = sessions[model]
	if not session then
		return false, "Hästen är inte registrerad"
	end
	if session.rider then
		return false, "Hästen är redan upptagen"
	end
	if byRider[player] then
		return false, "Du rider redan"
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then
		return false, "Ingen karaktär"
	end

	local range = Config.attr(session.rig.gaitConfig, "MountRange", 14)
	if (root.Position - session.rig.root.Position).Magnitude > range then
		return false, "För långt bort"
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false, "Ingen levande karaktär"
	end

	--[[ Sitsen sköter fastsättningen. En Seat väljs framför en handgjord
	     Weld för att Roblox då hanterar frånkoppling vid död, respawn och
	     utloggning åt oss — de tre fallen som annars lämnar spökryttare. ]]
	local seat = session.rig.seat
	if seat then
		seat:Sit(humanoid)
	else
		character:PivotTo(seatCFrame(session))
		local weld = Instance.new("WeldConstraint")
		weld.Name = "HorseMount"
		weld.Part0 = root
		weld.Part1 = session.rig.root
		weld.Parent = root
		humanoid.PlatformStand = true
	end

	setRider(session, player)
	return true, nil
end

function HorseService.dismount(player: Player): boolean
	local model = byRider[player]
	if not model then return false end
	local session = sessions[model]
	if not session then return false end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if session.rig.seat and session.rig.seat.Occupant == humanoid then
		session.rig.seat:Sit(nil)
	end
	if character then
		local root = character:FindFirstChild("HumanoidRootPart")
		if root then
			local weld = root:FindFirstChild("HorseMount")
			if weld then weld:Destroy() end
			-- Sätt av åt vänster, som man gör i verkligheten.
			local side = session.rig.root.CFrame * CFrame.new(-4.5, 0, 0)
			character:PivotTo(CFrame.new(side.Position + Vector3.new(0, 3, 0)))
		end
	end
	if humanoid then
		humanoid.PlatformStand = false
	end

	setRider(session, nil)
	return true
end

--[[ ── Uthållighet ─────────────────────────────────────────────────── ]]

local function stepStamina(session: Session, dt: number)
	local stats = session.stats
	local gaitR = session.rig.model:GetAttribute("Gait") or "halt"

	--[[ ── EN TRÖTTHETSSANNING (senior re-review #87, blocker 3) ───────
	     Här fanns förut en EGEN uthållighetsmodell: `Gaits.stamina` per
	     gångart, egen återhämtningsfördröjning och en egen skala 0–100.
	     Samtidigt räknade klienten G02-B:s `energi` med kanonens tal och
	     lät den styra framåtbjudning och svarstid. Två trötthetsmodeller
	     på samma häst: den ena kunde göra henne segare, den andra sänka
	     gångartstaket — och de kunde säga olika saker samtidigt.

	     Nu är ENERGIN den enda sanningen, med servern som auktoritet och
	     klienten som prediktion. Dräneringen är kanonens `energiTakt`,
	     alltså exakt samma tal som webben och klienten räknar med.

	     `Gaits.stamina` läses inte längre. Taket är kvar som eget
	     PRODUKTBEGREPP — en trött häst rullar ned en gångart av sig
	     själv — men det drivs nu av samma energi och inte av en andra
	     modell. Det är skillnaden mellan två begrepp och två sanningar. ]]
	local webbGangart = "halt"
	for w, r in RidKanon.MOTSVARIGHET do
		if r == gaitR then webbGangart = w end
	end
	--[[ Uthålligheten (Endurance) skalar takten: en seg häst tär
	     långsammare och hämtar sig fortare. Det är samma roll statet hade
	     i den gamla modellen, nu på kanonens kurva. ]]
	local takt = Svar.energiTakt(webbGangart, 0, stats)
	local skala = if takt < 0 then 1 / (0.6 + 0.9 * stats.Endurance)
		else (0.6 + 0.9 * stats.Endurance)
	session.energi = math.clamp(session.energi + takt * skala * dt, 0, 1)
	if takt < 0 then session.lastExertion = os.clock() end

	--[[ Uthålligheten tvingar aldrig fram ett stopp. Den sänker taket, och
	     hästen rullar ned en gångart av sig själv. Det är läsbart för
	     spelaren och känns som en trött häst, inte som en tom bensintank. ]]
	local ceiling = Gaits.SPELBAR_TOPP
	if session.energi < Config.STAMINA.LowThreshold then
		local t = session.energi / Config.STAMINA.LowThreshold
		local floorIndex = Gaits.index(Config.STAMINA.FloorGait)
		local topIndex = Gaits.index(Gaits.SPELBAR_TOPP)
		ceiling = Gaits.byIndex(math.floor(floorIndex + (topIndex - floorIndex) * t + 0.5))
	end

	local visad = session.energi * stats.MaxStamina
	session.rig.model:SetAttribute("Stamina", math.floor(visad))
	session.rig.model:SetAttribute("GaitCeiling", ceiling)

	if session.rider then
		--[[ Fjärde argumentet är energin i sin KANONISKA skala 0–1.
		     Klienten sätter sin prediktion till den; de tre första är
		     presentationen, som Debug redan visar. ]]
		Net.get("StaminaSync"):FireClient(session.rider, visad, stats.MaxStamina,
			ceiling, session.energi)
	end
end

--[[ ── Validering av det klienten påstår ────────────────────────────── ]]

local function onStateSync(player: Player, gait: string, speed: number)
	local model = byRider[player]
	if not model then return end
	local session = sessions[model]
	if not session then return end
	if typeof(gait) ~= "string" or typeof(speed) ~= "number" then return end
	if not Gaits.BY_NAME[gait] then return end
	if speed ~= speed or speed < -3 or speed > 15 then return end   -- NaN och orimligt

	local ceiling = session.rig.model:GetAttribute("GaitCeiling") or Gaits.SPELBAR_TOPP
	if Gaits.index(gait) > Gaits.index(ceiling) then
		gait = ceiling
	end

	session.rig.model:SetAttribute("Gait", gait)
	session.rig.model:SetAttribute("Speed", speed)
	session.lastSync = os.clock()
end

--[[ ── Livscykel ───────────────────────────────────────────────────── ]]

function HorseService.start()
	Net.init()

	for _, model in CollectionService:GetTagged(TAG) do
		if model:IsA("Model") then register(model) end
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(function(inst)
		if inst:IsA("Model") then register(inst) end
	end)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(inst)
		if inst:IsA("Model") then unregister(inst :: Model) end
	end)

	Net.get("MountRequest").OnServerInvoke = function(player, model)
		if typeof(model) ~= "Instance" or not model:IsA("Model") then
			return false, "Ogiltig häst"
		end
		return HorseService.tryMount(player, model)
	end
	Net.get("DismountRequest").OnServerInvoke = function(player)
		return HorseService.dismount(player)
	end
	Net.get("StateSync").OnServerEvent:Connect(onStateSync)

	Players.PlayerRemoving:Connect(function(player)
		HorseService.dismount(player)
	end)

	--[[ En loop för alla hästar, inte en per häst. Uthålligheten behöver
	     inte 60 Hz — fyra gånger i sekunden räcker och kostar nästan inget
	     även med hundra hästar i världen. ]]
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 0.25 then return end
		local step = accumulator
		accumulator = 0
		for _, session in sessions do
			stepStamina(session, step)
		end
	end)
end

function HorseService.sessionFor(model: Model): Session?
	return sessions[model]
end

function HorseService.horseOf(player: Player): Model?
	return byRider[player]
end

return HorseService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX31">
				<Properties>
					<string name="Name">Preflight</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	FIRST_PLAYABLE_PREFLIGHT — grinden som ska vara grön innan någon
	människa lägger tid på fysisk acceptans.

	Bakgrund (#162, arbetsordern 15:37): vi fångade ett integrationsfel med
	en människa i Studio i stället för med en maskin. Miljöpaketet gick att
	köra och såg rätt ut, men First Playable-runtime låg inte i samma build.
	Symptomen blev fel spawn och en dörrmarkör utan interaktion.

	Preflighten mäter därför BUILDEN, inte källkoden: finns delarna verkligen
	i den place som körs, och hänger kedjan ihop? Ett grönt CI säger ingenting
	om det, för CI kör aldrig en place.

	FAIL CLOSED: saknas något skrivs `FIRST_PLAYABLE_PREFLIGHT: FAIL` med vad
	som saknas, och `ReplicatedStorage.UBRFPreflight` sätts till false.
	QA-listan säger då STOPP. Frånvaro av ett PASS är inte ett PASS.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local StarterPlayer = game:GetService("StarterPlayer")

local Preflight = {}

type Rad = { namn: string, ok: boolean, detalj: string? }

local function rad(ut: { Rad }, namn: string, ok: boolean, detalj: string?)
	table.insert(ut, { namn = namn, ok = ok, detalj = detalj })
end

local function finns(foralder: Instance?, namn: string): boolean
	return foralder ~= nil and foralder:FindFirstChild(namn) ~= nil
end

--[[ Buildens identitet. Skrivs av tools/bygg-place.py som en modul i
	ReplicatedStorage. Saknas den vet vi inte vad som testas, och då är det
	inte ett PASS — det var hela poängen med punkt 9. ]]
local function buildIdentitet(): (string, string)
	local m = ReplicatedStorage:FindFirstChild("UBRFBuild")
	if not m or not m:IsA("ModuleScript") then return "OKÄND", "OKÄND" end
	local ok, data = pcall(require, m)
	if not ok or typeof(data) ~= "table" then return "OKÄND", "OKÄND" end
	local d = data :: any
	return tostring(d.sha or "OKÄND"), tostring(d.miljo_sha or d.sha or "OKÄND")
end

function Preflight.matningar(varldenFinns: boolean): { Rad }
	local ut: { Rad } = {}

	--[[ 1. Paketkompletthet. ]]
	local horse = ServerScriptService:FindFirstChild("Horse")
	local klient = StarterPlayer:FindFirstChild("StarterPlayerScripts")
	rad(ut, "1a ReplicatedStorage/HorseCore", finns(ReplicatedStorage, "HorseCore"))
	for _, namn in ipairs({ "UBRFSpelData", "UBRFSkotsel", "UBRFSpel", "Stallet", "UBRFKomplex" }) do
		rad(ut, "1b ReplicatedStorage/" .. namn, finns(ReplicatedStorage, namn))
	end
	rad(ut, "1c ServerScriptService/Horse (server-runtime)", horse ~= nil)
	rad(ut, "1d StarterPlayerScripts/Horse (client-runtime)",
		klient ~= nil and finns(klient, "Horse"))
	rad(ut, "1e ServerScriptService/Varld/Anlaggningen (världsbyggaren)",
		finns(ServerScriptService:FindFirstChild("Varld"), "Anlaggningen"))
	rad(ut, "1f anläggningen är byggd", varldenFinns and workspace:FindFirstChild("Anläggning") ~= nil)

	--[[ 2. Spawnkontrakt: exakt EN avsedd spawn, och den ska stå vid rätt
		dörr. En QA-/legacy-spawn får inte vinna. ]]
	local spawnar = {}
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("SpawnLocation") then table.insert(spawnar, d) end
	end
	local egna = 0
	for _, s in ipairs(spawnar) do
		if s:GetAttribute("UBRFStart") == true then egna += 1 end
	end
	rad(ut, "2a exakt en First Playable-spawn", egna == 1,
		("%d UBRFStart av %d SpawnLocation totalt"):format(egna, #spawnar))
	rad(ut, "2b ingen annan SpawnLocation vinner", #spawnar == egna,
		("%d SpawnLocation totalt"):format(#spawnar))
	local start = nil
	for _, s in ipairs(spawnar) do
		if s:GetAttribute("UBRFStart") == true then start = s end
	end
	rad(ut, "2c spawnen står vid stallets entrédörr",
		start ~= nil and start:GetAttribute("MotDorr") == "stall N dorrgul",
		start and tostring(start:GetAttribute("MotDorr")) or "ingen spawn")

	--[[ 3. Dörrkontrakt: verklig interaktion, inte en gul markör. ]]
	local okDorr, DorrService = pcall(function()
		return require((ServerScriptService :: any).Horse.DorrService)
	end)
	local dorrar = if okDorr then (DorrService :: any).dorrar() else {}
	rad(ut, "3a dörrblad med interaktion finns", #dorrar > 0, ("%d st"):format(#dorrar))
	local medPrompt = 0
	for _, blad in ipairs(dorrar) do
		if blad:FindFirstChildOfClass("ProximityPrompt") then medPrompt += 1 end
	end
	rad(ut, "3b varje dörrblad har en prompt", #dorrar > 0 and medPrompt == #dorrar,
		("%d prompt av %d dörrar"):format(medPrompt, #dorrar))
	--[[ Att den GÅR ATT ÖPPNA och släpper igenom, inte bara att den finns. ]]
	local oppnadeOk = 0
	if okDorr then
		for _, blad in ipairs(dorrar) do
			if (DorrService :: any).provaOppna(blad) then oppnadeOk += 1 end
		end
	end
	rad(ut, "3c dörren öppnas och släpper igenom", #dorrar > 0 and oppnadeOk == #dorrar,
		("%d av %d"):format(oppnadeOk, #dorrar))

	--[[ 4. Jack-kontrakt. Identiteten LÄSES ur den delade sanningen —
		`Stallet.FORSTA_DAGEN_HAST`, samma konstant som `tools/kolla-forstadagen.py`
		håller i synk mellan webben och Roblox. Att leta på namnet "Jack" hade
		varit ett eget påhitt: hästen heter "Blackrock Jack" i datan, och
		`hastar` är dessutom en uppslagstabell och ingen lista, så en
		namnsökning hade tystnat grön utan att mäta något. ]]
	local okStall, Stallet = pcall(function()
		return require((ReplicatedStorage :: any).Stallet)
	end)
	local okData, Spel = pcall(function()
		return require((ReplicatedStorage :: any).UBRFSpelData)
	end)
	local forstaId = if okStall then tostring((Stallet :: any).FORSTA_DAGEN_HAST) else nil
	rad(ut, "4a första dagens häst är utpekad i Stallet", forstaId ~= nil and forstaId ~= "nil",
		tostring(forstaId))

	local hast = nil
	if okData and forstaId and typeof(Spel) == "table" then
		hast = ((Spel :: any).hastar or {})[forstaId]
	end
	rad(ut, "4b hästen finns i speldatan", hast ~= nil,
		if hast then tostring((hast :: any).namn) else "hittades inte")

	--[[ 4c: att hon har en box med världskoordinater. Att gången DIT är fri
		mäts inte här — det kräver karaktär och fysik, och står som
		`Physical not tested` i rapporten i stället för att gissas grönt. ]]
	local box = nil
	if okStall and forstaId then
		local okBox, b = pcall(function() return (Stallet :: any).boxFor(forstaId) end)
		if okBox then box = b end
	end
	rad(ut, "4c hästens box har världskoordinater",
		box ~= nil and (box :: any).varld ~= nil,
		if box and (box :: any).varld
			then ("x %.1f y %.1f"):format((box :: any).varld.x, (box :: any).varld.y)
			else "ingen box")

	--[[ 7. Klient/UI verkligen i builden, inte bara i repot. ]]
	local horseKlient = klient and klient:FindFirstChild("Horse")
	for _, namn in ipairs({ "KontrollHjalp", "TouchControls", "Input", "PreparationController" }) do
		rad(ut, "7 StarterPlayerScripts/Horse/" .. namn, finns(horseKlient, namn))
	end

	--[[ 8. Persistens: att vägen kan initieras. Utan API-åtkomst i Studio
		ska det bli en tydlig VARNING och aldrig ett falskt PASS — därför
		mäts bara att tjänsten finns och svarar, inte att den lyckas skriva. ]]
	rad(ut, "8 SparService finns i builden", finns(horse, "SparService"))

	return ut
end

function Preflight.kor(varldenFinns: boolean)
	local sha, miljo = buildIdentitet()
	print(("FIRST_PLAYABLE_SHA=%s"):format(sha))
	print(("FIRST_PLAYABLE_MILJO_SHA=%s"):format(miljo))

	local matt = Preflight.matningar(varldenFinns)
	local fel = {}
	for _, r in ipairs(matt) do
		if r.ok then
			print(("  OK   %s%s"):format(r.namn, if r.detalj then "  " .. r.detalj else ""))
		else
			table.insert(fel, r.namn)
			warn(("  SAKNAS  %s%s"):format(r.namn, if r.detalj then "  " .. r.detalj else ""))
		end
	end

	--[[ Okänd build är ett fel i sig: då vet ingen vad som testades. ]]
	if sha == "OKÄND" then
		table.insert(fel, "9 build-identitet (ReplicatedStorage.UBRFBuild)")
		warn("  SAKNAS  9 build-identitet — går inte att veta vilken head som testas")
	end

	local flagga = ReplicatedStorage:FindFirstChild("UBRFPreflight")
	if not flagga then
		flagga = Instance.new("BoolValue")
		flagga.Name = "UBRFPreflight"
		flagga.Parent = ReplicatedStorage
	end
	;(flagga :: BoolValue).Value = #fel == 0

	if #fel == 0 then
		print("FIRST_PLAYABLE_PREFLIGHT: PASS")
	else
		warn(("FIRST_PLAYABLE_PREFLIGHT: FAIL — %d saknas: %s")
			:format(#fel, table.concat(fel, ", ")))
		warn("STOPP: det här är inte en First Playable-build. Fortsätt INTE "
			.. "med fysisk acceptans; rapportera raderna ovan.")
	end
end

return Preflight
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX32">
				<Properties>
					<string name="Name">SparService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[ SPARSERVICE — Roblox varaktiga lager. Litet, versionsstämplat, serverägt.

	Före #161 fanns inget `DataStoreService` någonstans i `roblox/`. PR #154
	lämnade kroken — `StallService.hastminnen` returnerade nil med
	kommentaren *"den dagen ett DataStore läggs till är det HÄR det
	hämtas"* — och det här är den dagen.

	── ANSVARSGRÄNSEN ───────────────────────────────────────────────

	`Sparning.luau` äger SCHEMAT, migrationen och idempotensen. Den här
	filen äger NYCKELN, nätverket, retryn och felen — allt som kräver en
	riktig Roblox-server och därför inte går att fälla i bänken. Den
	uppdelningen är hela skälet till att sparlogiken går att prova alls:
	reglerna provas i `skotselpass.spec.luau`, det här lagret provas mot en
	stubbad `DataStoreService` som kan fås att fela på begäran.

	── SERVERN ÄGER VARJE SKRIVNING ─────────────────────────────────

	Det finns INGEN RemoteFunction som tar emot ett saveobjekt. Klienten
	kan inte skicka något som skrivs, varken helt eller delvis; den kan
	bara utföra spelhandlingar som servern själv värderar. Det är
	uttryckligen kravet i #161 och det är också det enda sättet att göra
	progressionen värd något.

	── FAIL-SAFE, ALDRIG FAIL-OPEN ──────────────────────────────────

	Tre fel kan hända, och de behandlas OLIKA:

	  1. Läsningen faller (nätet, throttling, utility ner).
	     → spelaren får en SESSIONSAVE som inte skrivs tillbaka.
	       Hon kan spela. Hon får inga pass räknade. Att i stället ge
	       henne en tom save och spara den hade RADERAT hennes framsteg
	       för att nätet hackade i tre sekunder.

	  2. Raden är skriven av en NYARE version (`framtida`).
	     → samma sak: spela ja, skriv nej. En gammal server ska inte
	       skriva över en nyare sparfil den inte förstår.

	  3. Skrivningen faller.
	     → retry med backoff. Håller den inte får passet stå kvar
	       oräknat i minnet; nästa avslut försöker igen. Ingen krasch,
	       och ingen gratis progression.

	`kanSpara` är den enda flaggan som styr, och den är fail-CLOSED: den
	sätts sant först när en läsning faktiskt lyckats.

	── UpdateAsync, INTE SetAsync ───────────────────────────────────

	Skrivningen går genom `UpdateAsync` och slår ihop med det som redan
	står. Två servrar (spelaren i två platser, eller en snabb rejoin under
	en shutdown) kan annars skriva över varandras pass. Sammanslagningen
	är `Sparning.migrera` på den lagrade raden följt av samma
	`registreraPass` — kvittona gör den operationen idempotent, så en
	sammanslagning aldrig kan dubbelräkna.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sparning = require(ReplicatedStorage.HorseCore.Sparning)

local SparService = {}

--[[ Namnet bär schemaversionen. En framtida `v2` som INTE är
	bakåtkompatibel byter butik i stället för att riskera att tolka gamla
	rader fel — `Sparning.migrera` klarar de kompatibla stegen, butiksbytet
	finns för de andra. ]]
local BUTIK = "UBRF_Spelare_v1"
local NYCKEL = "spelare_%d"

local FORSOK = 3
local BACKOFF = { 1, 2, 4 }

local butik: any = nil
local sparade: { [Player]: Sparning.Save } = {}
local kanSpara: { [Player]: boolean } = {}
local anmarkning: { [Player]: string? } = {}
--[[ Sant medan en skrivning pågår för spelaren. Två samtidiga
	`UpdateAsync` på samma nyckel throttlas av Roblox och kan dessutom
	komma i fel ordning; den här flaggan gör att avslut + utloggning inte
	blir två skrivningar i luften samtidigt. ]]
local skriver: { [Player]: boolean } = {}
--[[ Revisionen vi LÄSTE. Skrivningen jämför lagrets rad mot den här: är
	lagret nyare har någon annan hunnit skriva, och då avbryter vi i stället
	för att slå ihop. Se `rev` i Sparning. ]]
local laddadRev: { [Player]: number } = {}
-- Identiteten gör ett sent nätverkssvar ogiltigt när sessionen avslutas.
local laddningar: { [Player]: {} } = {}

--[[ Studio utan API-åtkomst, och alla lokala prov, ska INTE krascha på
	rad ett. `GetDataStore` kastar då, och resultatet är nil — vilket
	`kanSpara` redan hanterar som "spela, men spara inte". ]]
local function hamtaButik(): any
	if butik then return butik end
	local ok, b = pcall(function()
		return DataStoreService:GetDataStore(BUTIK)
	end)
	if ok and b then
		butik = b
	else
		warn("[Spar] Inget datalager tillgängligt — sessionen sparas inte. "
			.. tostring(b))
	end
	return butik
end

local function nyckelFor(player: Player): string
	return NYCKEL:format(player.UserId)
end

--[[ Retry med backoff runt ett anrop som får kasta. Returnerar
	(ok, resultat, sistaFelet). Väntar INTE efter sista försöket — det är
	bara en sekund innan spelaren får sitt svar, utan att någon vinner
	något på den. ]]
local function medRetry(vad: string, fn: () -> any): (boolean, any, string?)
	local sistaFel: string? = nil
	for i = 1, FORSOK do
		local ok, resultat = pcall(fn)
		if ok then
			return true, resultat, nil
		end
		sistaFel = tostring(resultat)
		warn(("[Spar] %s misslyckades (försök %d/%d): %s"):format(vad, i, FORSOK, sistaFel))
		if i < FORSOK then
			task.wait(BACKOFF[i] or 4)
		end
	end
	return false, nil, sistaFel
end

--[[ ── LÄSNINGEN ──────────────────────────────────────────────────── ]]

function SparService.ladda(player: Player, fortfarandeAktuell: (() -> boolean)?): Sparning.Save
	local b = hamtaButik()
	if not b then
		sparade[player] = Sparning.tom()
		laddadRev[player] = 0
		kanSpara[player] = false
		anmarkning[player] = "inget datalager"
		return sparade[player]
	end

	local ok, rad = medRetry("läsning av " .. player.Name, function()
		return b:GetAsync(nyckelFor(player))
	end)
	-- Läsningen kan ha yieldat förbi PlayerRemoving. Publicera då inget
	-- tillstånd, inte heller en sessionsave efter ett sent läsfel.
	if fortfarandeAktuell and not fortfarandeAktuell() then
		return Sparning.tom()
	end

	if not ok then
		--[[ FALL 1 i filhuvudet. Sessionssave, ingen skrivning. ]]
		sparade[player] = Sparning.tom()
		laddadRev[player] = 0
		kanSpara[player] = false
		anmarkning[player] = "läsfel"
		warn(("[Spar] %s spelar utan sparning — läsningen gick inte igenom."):format(player.Name))
		return sparade[player]
	end

	local save, notering = Sparning.migrera(rad)
	sparade[player] = save
	laddadRev[player] = save.rev
	anmarkning[player] = notering

	if notering == "framtida" then
		--[[ FALL 2. En nyare sparfil vi inte förstår skrivs inte över. ]]
		kanSpara[player] = false
		warn(("[Spar] %s har en sparfil från en nyare version — sessionen sparas inte."):format(player.Name))
	elseif notering == "trasig" then
		--[[ Raden fanns men gick inte att läsa. Vi startar från noll — men
			vi SKRIVER, för annars kan spelaren aldrig komma vidare. Noll
			pass är fail-safe: en trasig rad ger aldrig progression. ]]
		kanSpara[player] = true
		warn(("[Spar] %s hade en oläsbar sparfil — startar om från noll pass."):format(player.Name))
	else
		kanSpara[player] = true
	end
	return save
end

function SparService.save(player: Player): Sparning.Save?
	return sparade[player]
end

function SparService.kanSpara(player: Player): boolean
	return kanSpara[player] == true
end

function SparService.anmarkning(player: Player): string?
	return anmarkning[player]
end

--[[ ── SKRIVNINGEN ────────────────────────────────────────────────── ]]

--[[ Den längsta av två vilor, nil-säkert. Används BARA på konfliktvägen i
	`skriv`, där en annan server hunnit skriva efter vår läsning och ingen
	av de två vilorna kan visas vara färskast.

	`nil` är inte "noll pass kvar" utan "ingen skada", och den förlorar mot
	en riktig skada: att låta en okänd session läka en häst vore att gissa
	åt fel håll. ]]
local function langstaVila(a: Sparning.Skada?, b: Sparning.Skada?): Sparning.Skada?
	if not a then return b end
	if not b then return a end
	return if b.passKvar > a.passKvar then b else a
end

--[[ `andra` får ändra den save som ligger i datalagret. Den körs INUTI
	`UpdateAsync` och kan därför köras om av Roblox — den måste vara
	idempotent, och det är precis vad `Sparning.registreraPass` garanterar.

	Returnerar sant när skrivningen gick fram. ]]
function SparService.skriv(player: Player, andra: ((Sparning.Save) -> ())?): boolean
	local minnet = sparade[player]
	if not minnet then return false end
	if not kanSpara[player] then
		return false
	end
	local b = hamtaButik()
	if not b then return false end
	if skriver[player] then
		--[[ En skrivning är redan i luften. Att köa en till på samma nyckel
			ger throttling och kan dessutom landa i fel ordning. Ändringen
			ligger kvar i minnet och går med nästa skrivning. ]]
		return false
	end
	skriver[player] = true

	--[[ Sätts inne i callbacken när skrivningen måste avbrytas. Läses efter
		anropet: `UpdateAsync` kastar inte när transformatorn returnerar nil,
		så utan flaggan hade `skriv` svarat sant om en skrivning som aldrig
		blev av. ]]
	local konflikt: string? = nil

	local ok = select(1, medRetry("skrivning för " .. player.Name, function()
		return b:UpdateAsync(nyckelFor(player), function(gammal)
			--[[ Slå ihop med det som faktiskt står i lagret, inte med det vi
				råkade läsa vid inloggningen. Mellan då och nu kan en annan
				server ha skrivit. ]]
			local bas, notering = Sparning.migrera(gammal)

			--[[ FYND 2 I OMREVIEWEN AV caac3f5: anteckningen kastades här.
				Läsningen behandlade `framtida` som icke-skrivbar, men den
				här callbacken konverterade en framtida rad till en TOM v1
				och slog in vår gamla session i den. Filhuvudets utfästelse
				gällde alltså bara inloggningen.

				Att returnera nil ur transformatorn AVBRYTER skrivningen och
				lämnar det lagrade värdet orört. Det är rätt utgång: en
				gammal server ska inte röra en sparfil den inte förstår. ]]
			if notering == "framtida" then
				konflikt = "framtida sparfil i lagret"
				return nil
			end

			--[[ REVISIONEN, OCH VAD DEN BETYDER FÖR VILAN.

				Står lagret på samma revision som vi läste har ingen annan
				skrivit sedan dess. Då ÄR minnet den senaste sanningen, och
				minnet äger vilan — inklusive att den räknats ner eller
				tagit slut. Det är fynd 1, och nedräkningen hänger på det.

				Står lagret HÖGRE har någon annan server skrivit efter vår
				läsning. Vi basar då om på den FÄRSKA raden (`bas` kommer
				ur `gammal`, alltså det som faktiskt ligger där nu) och slår
				bara ihop det som är monotont: kvitton, passtal, relation
				och första dagen. Ingen av dem kan sänka något.

				För vilan finns ingen monoton väg, och därför gissar vi inte
				åt spelarens håll: den LÄNGSTA vinner på konfliktvägen. Att
				korta en vila på en gissning vore att släppa ut en halt
				häst; att förlänga den kostar ett pass.

				RUNDA 4, P1: den här grenen AVBRÖT tidigare skrivningen. Det
				bevarade den färska skadan men lämnade `laddadRev` orörd och
				`kanSpara` sann, så nästa skrivning läste samma högre rev mot
				samma gamla `laddadRev` och avbröt igen — sessionen låg fast
				och trodde ändå att den sparade. Ombaseringen nedan är
				begränsad till ETT försök inne i samma `UpdateAsync`: läs
				färskt, slå ihop, skriv en gång. Ingen omkörningsslinga.

				Det som INTE basas om är den framtida raden ovan. Där
				förstår vi inte schemat, och då är avbrottet rätt utgång. ]]
			local last = laddadRev[player] or 0
			local nyare = bas.rev > last
			if nyare then
				warn(("[Spar] %s: lagret är revision %d, vi läste %d — basar om på den färska raden.")
					:format(player.Name, bas.rev, last))
			end

			--[[ Progressionen tas ur den HÖGSTA av de två: en gammal server
				ska aldrig kunna sänka ett passtal. Kvittona slås ihop, och
				det är de som gör sammanslagningen idempotent. ]]
			for id, nar in pairs(minnet.passId) do
				if bas.passId[id] == nil then
					bas.passId[id] = nar
					bas.pass += 1
				end
			end
			if minnet.pass > bas.pass then bas.pass = minnet.pass end

			bas.forstaDagen.klar = bas.forstaDagen.klar or minnet.forstaDagen.klar
			bas.forstaDagen.hastId = bas.forstaDagen.hastId or minnet.forstaDagen.hastId

			for id, m in pairs(minnet.hastar) do
				local fanns = bas.hastar[id]
				if not fanns then
					bas.hastar[id] = { relation = m.relation, skada = m.skada }
				else
					fanns.relation = math.max(fanns.relation, m.relation)
					if nyare then
						--[[ KONFLIKTVÄGEN: någon annan skrev efter vår
							läsning, och vi vet inte vems vila som är
							färskast. Den LÄNGSTA vinner. Regeln är gjord åt
							hästens håll, inte åt spelarens: en vila som
							blir ett pass för lång kostar en dag, en vila
							som kortas på en gissning sätter en halt häst i
							arbete.

							Vår egen nedräkning kan alltså gå förlorad just
							den här gången. Det är avsiktligt och ofarligt —
							nästa pass räknar ner igen från den rad vi nu
							basat om på. ]]
						fanns.skada = langstaVila(fanns.skada, m.skada)
					else
						--[[ MINNET ÄGER VILAN, rakt av — inte "längsta
							vinner". Ingen annan har skrivit sedan vi läste;
							minnet ÄR den senaste sanningen, och det gäller
							lika mycket när skadan räknats ner till 1 som
							när den tagit slut helt.

							Den gamla regeln ("längsta vilan vinner", alltid)
							var välmenad — den skulle hindra en gammal server
							från att korta en färsk skada — men den gjorde
							nedräkningen omöjlig: lagrets 2 slog minnets 1,
							och `sparade[player] = bas` skrev tillbaka 2 i
							minnet också. Hästen vilade för evigt. Nu gäller
							den bara där osäkerheten finns. ]]
						fanns.skada = m.skada
					end
				end
			end

			if andra then andra(bas) end

			--[[ Ny revision, räknad från den rad som FAKTISKT ligger i
				lagret — inte från den vi läste. Basar vi om måste vi hamna
				förbi den andra serverns revision, annars skulle nästa
				skrivning se en konflikt som inte finns.

				Nästa skrivning från den här sessionen jämför mot den, och en
				annan server som läste tidigare ser att lagret hunnit före. ]]
			bas.rev = math.max(bas.rev, last) + 1
			laddadRev[player] = bas.rev

			--[[ Minnet uppdateras till det sammanslagna, så att nästa
				skrivning utgår från samma sanning som lagret. ]]
			sparade[player] = bas
			return Sparning.tillRad(bas)
		end)
	end))

	skriver[player] = false
	if konflikt then
		--[[ Ingenting skrevs, och det var avsiktligt. Framstegen ligger kvar
			i minnet. Den framtida sparfilen gör dessutom sessionen
			icke-skrivbar tills spelaren kommer in på en server som förstår
			schemat — samma beslut som läsningen redan tar. ]]
		if konflikt == "framtida sparfil i lagret" then
			kanSpara[player] = false
			anmarkning[player] = "framtida"
		end
		warn(("[Spar] %s sparades INTE: %s. Inget skrevs över.")
			:format(player.Name, konflikt))
		return false
	end
	if not ok then
		warn(("[Spar] %s kunde inte sparas nu. Framstegen ligger kvar i minnet "
			.. "och försöks igen."):format(player.Name))
	end
	return ok
end

--[[ ── BARRIÄREN: LADDNINGEN ÄR KLAR ─────────────────────────────
	#162 blockerare 1. `ladda()` yieldar i `GetAsync`. Roblox startar varje
	`PlayerAdded`-anslutning på EGEN TRÅD, så en tjänst som kopplar samma
	signal själv körs medan läsningen fortfarande är i luften — mot en save
	som är nil. Det gav tre konkreta fel: `StallService.hastminnen` svarade
	nil och en häst som vilade för en skada kunde tilldelas,
	`GameplayService.passnummer` föll till 1 och därmed "första dagen", och
	startordningen i `init.server.luau` såg ut att skydda mot det utan att
	göra det.

	Startordning är inte en barriär. Den bestämmer i vilken ordning
	anslutningarna GÖRS, inte att den första blir KLAR först.

	Lösningen är att ta bort de andra anslutningarna helt. Det finns nu EN
	`PlayerAdded`-lyssnare i hela servern, den här, och den kör sina
	registrerade hookar efter att läsningen returnerat. Hookarna körs i
	registreringsordning, alltså samma ordning som `init.server.luau`
	startar tjänsterna — StallService före GameplayService, vilket är det
	beroende som redan gällde.

	Fail-safe-vägen är oförändrad: `ladda()` returnerar ALLTID en save, även
	när läsningen faller (då en sessionsave med `kanSpara = false`). Hookarna
	körs alltså alltid, och en spelare vars datalager är nere får en häst och
	kan rida. En barriär som väntade på en save som aldrig kommer hade bytt
	ett race mot en låsning. ]]
local efterLaddning: { (Player, Sparning.Save) -> () } = {}

--[[ REDO = laddningen har nått ett SLUTLÄGE för den här spelaren.

	Slutläge betyder inte "lyckades". Både en lyckad läsning och varje
	fail-safe-utgång (inget datalager, läsfel, framtida version, trasig rad)
	är slutlägen: `ladda()` returnerar alltid en save, och efter den finns
	inget mer att vänta på. Att låta ett läsfel lämna spelaren "inte redo"
	hade bytt racet mot en låsning, och #162 är uttrycklig om att en
	misslyckad laddning ska bli spelbar med `kanSpara = false`.

	Flaggan är publik därför att den är en GRIND: varje väg som tilldelar
	eller binder ska fråga den först, inte gissa utifrån startordning. ]]
local redo: { [Player]: boolean } = {}

function SparService.redo(player: Player): boolean
	return redo[player] == true
end

--[[ Registrera en hook som körs när en spelares laddning nått slutläge.

	KÖR OCKSÅ FÖR DEM SOM REDAN ÄR REDO. Det är hela skillnaden mot
	re-reviewen av `2a8938e`: där hade StallService och GameplayService egna
	`GetPlayers()`-loopar i sina `start()` för att fånga spelare som redan
	var inne — och de looparna gick förbi barriären. En spelare kan ha
	anlänt medan SparService läste, och då är hennes laddning fortfarande i
	luften när nästa tjänst startar.

	Nu finns ingen sådan loop. Registreringen är själv återhämtningen: är
	spelaren redo körs hooken direkt, är hon inte redo körs den när
	laddningen landar. Ett ställe, ingen väg runt. ]]
function SparService.efterLaddning(fn: (Player, Sparning.Save) -> ())
	table.insert(efterLaddning, fn)
	for _, player in Players:GetPlayers() do
		if redo[player] and sparade[player] then
			local ok, fel = pcall(fn, player, sparade[player])
			if not ok then
				warn(("[Spar] en efterLaddning-hook föll för %s: %s")
					:format(player.Name, tostring(fel)))
			end
		end
	end
end

--[[ Läs först, kör hookarna sedan. Varje hook körs i sin egen `pcall`: en
	tjänst som faller ska inte hindra nästa från att komma igång, och den
	spelare vars tilldelning strular ska inte också bli utan bindning.

	`redo` sätts FÖRE hookarna. Ordningen spelar roll: en hook — eller ett
	`MinHast`-anrop som kommer in medan hookarna körs — ska se ett slutfört
	slutläge, inte halva sanningen. ]]
local function laddaOchStarta(player: Player)
	local laddning = {}
	laddningar[player] = laddning
	local function aktuell(): boolean
		return laddningar[player] == laddning
	end
	local save = SparService.ladda(player, aktuell)
	if not aktuell() then return end
	redo[player] = true
	for _, fn in ipairs(efterLaddning) do
		if not aktuell() then return end
		local ok, fel = pcall(fn, player, save)
		if not ok then
			warn(("[Spar] en efterLaddning-hook föll för %s: %s")
				:format(player.Name, tostring(fel)))
		end
	end
end

local function glom(player: Player)
	laddningar[player] = nil
	sparade[player] = nil
	kanSpara[player] = nil
	anmarkning[player] = nil
	skriver[player] = nil
	redo[player] = nil
	laddadRev[player] = nil
end

--[[ ── LIVSCYKEL ──────────────────────────────────────────────────── ]]

function SparService.start()
	-- Registrera städningen innan även startens GetPlayers-läsningar kan yielda.
	Players.PlayerRemoving:Connect(function(player)
		laddningar[player] = nil
		redo[player] = nil
		SparService.skriv(player)
		glom(player)
	end)
	--[[ DEN ENDA `PlayerAdded`-lyssnaren i servern. Se barriären ovan. ]]
	Players.PlayerAdded:Connect(laddaOchStarta)
	for _, player in Players:GetPlayers() do
		laddaOchStarta(player)
	end

	if not RunService:IsStudio() then
		game:BindToClose(function()
			for _, player in Players:GetPlayers() do
				SparService.skriv(player)
			end
		end)
	end

	print("[Spar] Datalagret igång (" .. BUTIK .. ")")
end

--[[ Provkrokar. `ladda` och `skriv` är publika och provas direkt; de här
	finns för att en spec ska kunna nollställa mellan fall utan att gå
	genom PlayerRemoving respektive utan att starta en ny server.

	`_glomButikForProv` glömmer den CACHADE butiken. Cachen är rätt i
	produktion — `GetDataStore` ska inte anropas per spelare — men den gör
	att fallet "Studio utan API-åtkomst" inte går att prova efter ett
	lyckat fall i samma process, och det fallet måste gå att prova. ]]
function SparService._glomForProv(player: Player)
	glom(player)
end

function SparService._glomButikForProv()
	butik = nil
end

--[[ Glömmer de registrerade `efterLaddning`-hookarna. I produktion körs
	`start()` en gång per server och registret ska växa monotont; i bänken
	körs det en gång per provblock, och då lade block två på sig block
	ettas hookar. Det syntes som en dubblerad tilldelningsrad — alltså
	precis den sorts brus som gör att ett prov inte längre mäter det det
	påstår. ]]
function SparService._glomHookarForProv()
	efterLaddning = {}
end

return SparService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX33">
				<Properties>
					<string name="Name">StallService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[ STALLSERVICE — din häst, och skylten vid hennes box.

	Gate G01, första skivan. Före det här mötte en Roblox-spelare en
	hästMODELL: HorseStats stod på "Namnlös" av rasen "Warmblood", medan de
	sjutton riktiga UBRF-hästarna bara fanns i webbversionens JS.

	Tjänsten gör tre saker och inget mer:
	  1. tilldelar spelaren en häst vid ankomsten,
	  2. sätter en ProximityPrompt vid hennes box,
	  3. svarar på frågan "vilken är min häst" över nätet.

	Reglerna ligger i ReplicatedStorage.Stallet, som är ren logik och provas
	i roblox/tests/spel.spec.luau utan Studio. Den här filen är bara
	instanserna. Den uppdelningen finns för att regler ska gå att falsifiera
	härifrån; en ProximityPrompt går inte.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Stallet = require(ReplicatedStorage.Stallet)
local Sparning = require(ReplicatedStorage.HorseCore.Sparning)
local SparService = require(script.Parent.SparService)

local StallService = {}

local M = 3          -- studs per meter, samma som BuildKit.M
local ANLAGGNING = "Anläggning"

local tilldelade: { [Player]: any } = {}
local markorer: { [Player]: Model } = {}

--[[ Anläggningens bas. Byggskriptet lägger allt relativt PrimaryPart, så
	utan den vet vi inte var i världen stallet står. Saknas den är
	anläggningen inte byggd — säg det rakt ut i stället för att lägga en
	skylt i origo och låta någon leta. ]]
local function bas(): CFrame?
	local modell = workspace:FindFirstChild(ANLAGGNING)
	local ubrf = modell and modell:FindFirstChild("UBRF")
	return ubrf and ubrf.PrimaryPart and ubrf.PrimaryPart.CFrame or nil
end

local function taBortMarkor(player: Player)
	local m = markorer[player]
	if m then
		m:Destroy()
		markorer[player] = nil
	end
end

--[[ Skylten vid boxen. Osynlig och genomsläpplig — den är bara en bärare
	för prompten, inte något att gå in i. ]]
local function satMarkor(player: Player, dagens: any): Model?
	local b = bas()
	if not b then
		warn("[Stallet] Anläggningen är inte byggd — ingen boxmarkör satt.")
		return nil
	end

	local modell = Instance.new("Model")
	modell.Name = "Boxmarkor_" .. player.Name

	local del = Instance.new("Part")
	del.Name = "Box"
	del.Anchored = true
	del.CanCollide = false
	del.CanQuery = false
	del.Transparency = 1
	del.Size = Vector3.new(1, 2, 1)
	del.CFrame = b * CFrame.new(dagens.box.varld.x * M, 1 * M, dagens.box.varld.y * M)
	del.Parent = modell

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "BoxPrompt"
	prompt.ActionText = "Titta in"
	prompt.ObjectText = dagens.namn .. " står här"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.Parent = del

	prompt.Triggered:Connect(function(spelare)
		if spelare ~= player then return end
		--[[ Ingen egen text hittas på: beskrivningen är ordagrann från
			ubrf.se/hastar och foderraden kommer ur samma delade data. ]]
		print(("[Stallet] %s — %s, %s. %s"):format(
			dagens.namn, dagens.ras, dagens.typ, dagens.besk))
		if dagens.foder then
			print(("[Stallet] Foder: %d kg hö, kraftfoder %s. %s"):format(
				dagens.foder.ho, tostring(dagens.foder.kraft), dagens.foder.notis))
		end
	end)

	modell.PrimaryPart = del
	modell.Parent = workspace
	return modell
end

--[[ Vilka identiteter som redan är utdelade till någon som är inne.

	Nyckeln är hästens id, inte spelaren: frågan reservationen ställer är
	"står någon redan i den här boxen", inte "har den här spelaren en häst". ]]
local function upptagnaHastar(utom: Player?): { [string]: boolean }
	local ut = {}
	for player, dagens in pairs(tilldelade) do
		if player ~= utom and dagens and dagens.id then
			ut[dagens.id] = true
		end
	end
	return ut
end

--[[ Spelarens sparade hästminnen, i webbens form: `{ [id] = { skada = … } }`.

	EN ENDA PLATS ATT KOPPLA IN ETT MINNE, och sedan #161 är den inkopplad.
	PR #154 lämnade den som `return nil` med noten *"den dagen ett DataStore
	läggs till är det HÄR det hämtas — inte genom att sprida läsningar ut i
	tilldelningen"*. Den dagen är nu, och noten höll: det blev en rad.

	Formen konverteras inte. `Sparning.hastminnen` returnerar exakt den
	tabell `Stallet.vilandeHastar` redan läser, som i sin tur är webbens
	form i `src/ryttare.js`. En översättning här hade blivit en tredje
	sanning om samma sak.

	Faller läsningen ur datalagret är saven tom och mängden blir tom — och
	det är rätt fail-läge för just den här frågan: en spelare som inte kan
	nå sin sparfil ska kunna rida, inte nekas häst. Skadan går ändå inte
	förlorad, för `SparService` skriver inte över en sparfil den inte kunde
	läsa. ]]
function StallService.hastminnen(player: Player): { [string]: any }?
	local save = SparService.save(player)
	return save and Sparning.hastminnen(save) or nil
end

function StallService.tilldela(player: Player)
	--[[ Reservationen görs HÄR och inte i Stallet: modulen äger regeln, den
		här filen äger vem som faktiskt är inloggad. Skickas ingen upptagen-
		lista får två spelare med UserId som skiljer 33 samma häst. ]]
	--[[ VÄLFÄRDEN GÅR GENOM SAMMA CHOKE POINT som reservationen (#153 fix 1).
		En häst som vilar för en skada ska aldrig kunna tilldelas, och den
		regeln hör hemma här där tilldelningen faktiskt sker — inte spridd
		över anropskedjan, vilket var precis hur webbens spärr gick att
		kringgå på tre ställen.

		MINNET ÄR INKOPPLAT sedan #161: `hastminnen()` läser spelarens
		sparfil ur `SparService`, så spärren utlöses nu i drift och inte
		bara i provet. (Fram till #161 stod här att inget `DataStoreService`
		fanns i `roblox/` och att mängden därför alltid var tom — det är
		inte längre sant, och en kommentar som säger motsatsen om koden är
		värre än ingen kommentar.)

		Att mängden är riktig kräver att saven är LÄST när den här raden
		körs. Det är vad barriären i `SparService.efterLaddning` finns för;
		se `start()` längst ned. ]]
	local vilande = Stallet.vilandeHastar(StallService.hastminnen(player))

	--[[ FÖRSTA DAGEN ÄR JACK (#162 blockerare 3). Regeln låg tidigare bara
		i webbens `scenes.js`; på Roblox valde rotationen fritt, så en ny
		spelare kunde få vilken häst som helst.

		Önskan skickas till samma `dagensHast` som allt annat och passerar
		därmed både reservationen och välfärdsspärren — se `tilldelaLedig`.
		Vilar Jack blir svaret nil och spelaren får vänta; ingen ersättare
		delas ut bakom regelns rygg.

		Saven kan vara en SESSIONSAVE om läsningen föll. Då ser dagen ut som
		en första dag, och det är samma avsiktliga fail-safe som
		`GameplayService.passnummer` redan har: ett datalagerfel ska inte
		hitta på progression. Följden är att en återvändande spelare med
		trasigt datalager får Jack i stället för sin rotationshäst — sämre
		än rätt, bättre än att hennes riktiga pass skrivs över. ]]
	local save = SparService.save(player)
	local onskad = if save ~= nil and Sparning.forstaDagen(save)
		then Stallet.FORSTA_DAGEN_HAST else nil

	local dagens = Stallet.dagensHast(player.UserId, upptagnaHastar(player),
		vilande, onskad)
	if not dagens then
		if onskad then
			warn(("[Stallet] Första dagen skulle ridits på %s, men hon är "
				.. "upptagen eller vilar. %s får vänta."):format(
				tostring(onskad), player.Name))
		else
			warn("[Stallet] Ingen häst kunde tilldelas " .. player.Name
				.. " — hela stallet är upptaget eller vilar. Spelaren får vänta.")
		end
		tilldelade[player] = nil
		taBortMarkor(player)
		return nil
	end
	tilldelade[player] = dagens
	taBortMarkor(player)
	local m = satMarkor(player, dagens)
	if m then markorer[player] = m end

	print(("[Stallet] %s rider %s idag — box %d, rad %s, gång %s."):format(
		player.Name, dagens.namn, dagens.box.nummer, dagens.box.rad, dagens.box.gang))
	return dagens
end

function StallService.hastFor(player: Player)
	return tilldelade[player]
end

--[[ Den kanoniska identiteten, och inget annat. GameplayService binder på
	det här id:t — aldrig på namn, box eller närmaste modell. ]]
function StallService.hastIdFor(player: Player): string?
	local dagens = tilldelade[player]
	return dagens and dagens.id or nil
end

function StallService.start()
	local fraga = Instance.new("RemoteFunction")
	fraga.Name = "MinHast"
	fraga.Parent = ReplicatedStorage
	fraga.OnServerInvoke = function(player)
		--[[ Klienten får FRÅGA, aldrig bestämma. Samma regel som
			uppsittningen redan följer.

			OCH DEN FÅR INTE FRÅGA FÖRBI BARRIÄREN (#162 re-review). Ett
			tidigt anrop hit — klienten är uppe innan läsningen landat —
			gjorde en tilldelning mot `save == nil`, alltså exakt det som
			blockerare 1 stängde på `PlayerAdded`-vägen. Är laddningen inte
			i slutläge finns inget svar att ge ännu.

			`nil` är rätt svar och inte en förlust: hooken i
			`SparService.efterLaddning` tilldelar så fort läsningen landar,
			så nästa fråga får hästen. Att i stället VÄNTA här hade hållit
			en RemoteFunction öppen över ett nätverksanrop. ]]
		if tilldelade[player] then return tilldelade[player] end
		if not SparService.redo(player) then
			return nil
		end
		return StallService.tilldela(player)
	end

	--[[ TILLDELNINGEN HÄNGER PÅ BARRIÄREN, INTE PÅ `PlayerAdded` (#162
		blockerare 1). Kopplade den här filen signalen själv kördes den på
		egen tråd medan `SparService.ladda` fortfarande yieldade i sitt
		`GetAsync` — och då svarade `hastminnen()` nil, välfärdsmängden blev
		tom, och en häst som vilade för en skada kunde tilldelas. Provet
		"ingen häst är tilldelad innan saven laddat" i skotselpass.spec
		mätte upp exakt det.

		`SparService.efterLaddning` körs efter att läsningen returnerat,
		också när den föll — så en spelare utan datalager får fortfarande
		en häst. ]]
	SparService.efterLaddning(function(player)
		StallService.tilldela(player)
	end)
	--[[ HÄR STOD EN `GetPlayers()`-LOOP, och den var ett hål (#162
		re-review). Kommentaren påstod att "deras save är redan läst av
		SparService, så det finns inget fönster här". Det var fel: en
		spelare kan ha anlänt medan SparService läste, och då är hennes
		laddning fortfarande i luften när den här tjänsten startar — loopen
		tilldelade då mot `save == nil` och gick förbi hela barriären.

		Återhämtningen ligger nu i `efterLaddning` självt, som kör hooken
		direkt för alla som redan ÄR redo. Ett ställe, ingen väg runt. ]]
	Players.PlayerRemoving:Connect(function(player)
		taBortMarkor(player)
		tilldelade[player] = nil
	end)

	print("[Stallet] Igång")
end

return StallService
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX34">
			<Properties>
				<string name="Name">Varld</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX35">
				<Properties>
					<string name="Name">BuildKit</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- BuildKit: små, förutsägbara byggstenar för UBRF-byggnader.
-- Alla mått i METER. 1 m = 3 studs. Origo för en byggnad = SV-hörnet på marknivå.
-- Körs i Studio via MCP run_code; klistras in före byggnadsskriptet (eller lagras som ModuleScript i ServerStorage.BuildKit).

local BuildKit = {}
BuildKit.M = 3 -- studs per meter

local function studs(m: number): number return m * BuildKit.M end

local function newPart(model: Model, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

-- Skapar/ersätter modellen. origin = världsposition för SV-hörnet (studs), rotY i grader.
function BuildKit.newBuilding(name: string, origin: Vector3, rotY: number?, meta: {[string]: any}?): (Model, CFrame)
	local folder = workspace:FindFirstChild("Anläggning") or Instance.new("Folder")
	folder.Name = "Anläggning"; folder.Parent = workspace
	local old = folder:FindFirstChild(name); if old then old:Destroy() end
	local model = Instance.new("Model"); model.Name = name; model.Parent = folder
	local root = newPart(model, "Root", Vector3.new(1, 0.2, 1), CFrame.new(origin) * CFrame.Angles(0, math.rad(rotY or 0), 0), Color3.new(1,1,1))
	root.Transparency = 1; root.CanCollide = false
	model.PrimaryPart = root
	for k, v in pairs(meta or {}) do model:SetAttribute(k, v) end
	return model, root.CFrame
end

-- Box i lokala meter-koordinater: x,z = SV-hörn, y = golvnivå; w=bredd(X), h=höjd(Y), d=djup(Z)
function BuildKit.box(model: Model, base: CFrame, name: string, x: number, y: number, z: number, w: number, h: number, d: number, color: Color3, material: Enum.Material?): Part
	local size = Vector3.new(studs(w), studs(h), studs(d))
	local cf = base * CFrame.new(studs(x + w/2), studs(y + h/2), studs(z + d/2))
	return newPart(model, name, size, cf, color, material)
end

-- Vägg längs X (facing = "S"/"N") eller längs Z ("W"/"E"). t = tjocklek.
function BuildKit.wall(model: Model, base: CFrame, name: string, x: number, z: number, length: number, height: number, t: number, along: "X"|"Z", color: Color3, material: Enum.Material?): Part
	if along == "X" then
		return BuildKit.box(model, base, name, x, 0, z, length, height, t, color, material)
	else
		return BuildKit.box(model, base, name, x, 0, z, t, height, length, color, material)
	end
end

-- Hål i vägg (fönster/dörr) görs enklast genom att lägga en Part med annan färg "utanpå" väggen: tydligt i tecknad stil.
-- x,z = position längs väggen (m), sill = höjd över mark, w,h = storlek, depth = hur mycket den sticker ut.
function BuildKit.opening(model: Model, base: CFrame, name: string, x: number, z: number, sill: number, w: number, h: number, along: "X"|"Z", side: number, color: Color3, material: Enum.Material?): Part
	local depth = 0.06
	if along == "X" then
		return BuildKit.box(model, base, name, x, sill, z + (side > 0 and 0 or -depth), w, h, depth, color, material or Enum.Material.Glass)
	else
		return BuildKit.box(model, base, name, x + (side > 0 and 0 or -depth), sill, z, depth, h, w, color, material or Enum.Material.Glass)
	end
end

function BuildKit.window(model: Model, base: CFrame, x: number, z: number, sill: number, w: number, h: number, along: "X"|"Z", side: number, frameColor: Color3)
	local frame = BuildKit.opening(model, base, "Fönsterkarm", x - 0.08, z, sill - 0.08, w + 0.16, h + 0.16, along, side, frameColor, Enum.Material.SmoothPlastic)
	local glass = BuildKit.opening(model, base, "Glas", x, z, sill, w, h, along, side * 2, Color3.fromRGB(170, 205, 225), Enum.Material.Glass)
	glass.Transparency = 0.3
end

function BuildKit.door(model: Model, base: CFrame, name: string, x: number, z: number, w: number, h: number, along: "X"|"Z", side: number, color: Color3)
	return BuildKit.opening(model, base, name, x, z, 0, w, h, along, side, color, Enum.Material.SmoothPlastic)
end

-- Sadeltak över fotavtryck (x,z,w,d) med takfot på höjd eaveH, lutning pitchDeg, nock längs "X" eller "Z", överhäng i meter.
function BuildKit.gableRoof(model: Model, base: CFrame, x: number, z: number, w: number, d: number, eaveH: number, pitchDeg: number, ridgeAlong: "X"|"Z", overhang: number, color: Color3, material: Enum.Material?)
	local span = (ridgeAlong == "X") and d or w   -- spännvidd tvärs nocken
	local len  = (ridgeAlong == "X") and w or d   -- längd längs nocken
	local half = span / 2 + overhang
	local rise = half * math.tan(math.rad(pitchDeg))
	local thick = 0.15
	local slope = math.sqrt(half*half + rise*rise)
	local cx, cz = x + w/2, z + d/2
	for _, s in ipairs({ -1, 1 }) do
		local p = Instance.new("Part")
		p.Name = "Takfall"; p.Anchored = true
		p.Color = color; p.Material = material or Enum.Material.SmoothPlastic
		p.Size = Vector3.new(studs(len + 2*overhang), studs(thick), studs(slope))
		local rot = (ridgeAlong == "X") and CFrame.Angles(math.rad(pitchDeg) * -s, 0, 0)
			or CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(math.rad(pitchDeg) * -s, 0, 0)
		local offX = (ridgeAlong == "X") and 0 or s * half / 2
		local offZ = (ridgeAlong == "X") and s * half / 2 or 0
		p.CFrame = base * CFrame.new(studs(cx + offX), studs(eaveH + rise/2), studs(cz + offZ)) * rot
		p.Parent = model
	end
	-- Gavelspetsar (triangel av två WedgeParts)
	local function gable(pos: number)
		for _, s in ipairs({ -1, 1 }) do
			local wdg = Instance.new("WedgePart")
			wdg.Name = "Gavelspets"; wdg.Anchored = true
			wdg.Color = model:GetAttribute("GavelFarg") or color
			wdg.Material = Enum.Material.SmoothPlastic
			wdg.Size = Vector3.new(studs(0.2), studs(rise - overhang * math.tan(math.rad(pitchDeg))), studs(span/2))
			local yaw = (ridgeAlong == "X") and (s > 0 and 0 or math.rad(180)) or (s > 0 and math.rad(90) or math.rad(-90))
			local lx = (ridgeAlong == "X") and pos or cx + s * span/4
			local lz = (ridgeAlong == "X") and cz + s * span/4 or pos
			wdg.CFrame = base * CFrame.new(studs(lx), studs(eaveH + wdg.Size.Y/BuildKit.M/2), studs(lz)) * CFrame.Angles(0, yaw, 0)
			wdg.Parent = model
		end
	end
	if ridgeAlong == "X" then gable(x + 0.1); gable(x + w - 0.1) else gable(z + 0.1); gable(z + d - 0.1) end
	return rise
end

-- Staket: stolpar + två reglar mellan punkterna (lokala meter).
function BuildKit.fence(model: Model, base: CFrame, x1: number, z1: number, x2: number, z2: number, height: number, color: Color3)
	local dx, dz = x2 - x1, z2 - z1
	local len = math.sqrt(dx*dx + dz*dz)
	local n = math.max(1, math.floor(len / 2.5))
	local yaw = math.atan2(-dz, dx)
	for i = 0, n do
		local t = i / n
		BuildKit.box(model, base, "Stolpe", x1 + dx*t - 0.06, 0, z1 + dz*t - 0.06, 0.12, height, 0.12, color, Enum.Material.Wood)
	end
	for _, hy in ipairs({ height * 0.55, height * 0.95 }) do
		local p = Instance.new("Part"); p.Name = "Regel"; p.Anchored = true; p.Color = color; p.Material = Enum.Material.Wood
		p.Size = Vector3.new(studs(len), studs(0.1), studs(0.05))
		p.CFrame = base * CFrame.new(studs(x1 + dx/2), studs(hy), studs(z1 + dz/2)) * CFrame.Angles(0, yaw, 0)
		p.Parent = model
	end
end

-- Sätter Studio-kameran i ögonhöjd på ett sätt som matchar ett foto: stå på (x,z) i lokala meter, titta mot (tx,tz).
--[[ Siktmalet lag forut fast pa 2.5 m. Det gor det omojligt att titta UPP,
	och takstommen i ridhuset gar bara att bedoma underifran. aimH ar darfor
	valbar; utan den beter sig anropet exakt som forut. ]]
function BuildKit.cameraLike(base: CFrame, x: number, z: number, tx: number, tz: number, eyeH: number?, aimH: number?)
	local cam = workspace.CurrentCamera
	local from = base * CFrame.new(studs(x), studs(eyeH or 1.6), studs(z))
	local to = base * CFrame.new(studs(tx), studs(aimH or 2.5), studs(tz))
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = CFrame.lookAt(from.Position, to.Position)
end

return BuildKit
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX36">
				<Properties>
					<string name="Name">Geometri</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Ren geometri över anläggningen: inga Roblox-anrop, inga Instance, ingen
-- rendering. Bara de uträkningar som måste betyda samma sak på båda
-- plattformarna — var en öppning sitter i en fasad, och hur brant ett tak är.
--
-- Den ligger separat just för att den ska gå att MÄTA utanför Studio.
-- roblox/tests/geometri.spec.luau kör den mot samma tal som webbspelet räknar
-- fram ur src/site.js. Ligger de i samma fil som partbygget går de inte att
-- testa, och då är pariteten ett påstående i stället för ett mätvärde.
--
-- Måtten i meter. Origo i sydväst, +x öster, +y norr — samma som src/site.js.

local Geometri = {}

export type Rekt = { x: number, y: number, w: number, h: number }

-- Fasadens p0 → p1, medurs sett utifrån. EXAKT samma konvention som `vagg` i
-- src/site.js. u i en öppning mäts från p0 längs den riktningen; ändras den
-- ena måste den andra ändras med, och specen fäller det annars.
function Geometri.vagg(r: Rekt, sida: string): (number, number, number, number)
	if sida == "S" then return r.x, r.y, r.x + r.w, r.y
	elseif sida == "E" then return r.x + r.w, r.y, r.x + r.w, r.y + r.h
	elseif sida == "N" then return r.x + r.w, r.y + r.h, r.x, r.y + r.h
	elseif sida == "W" then return r.x, r.y + r.h, r.x, r.y
	end
	error("okänd sida: " .. tostring(sida))
end

-- Utåtriktad normal för en fasad.
function Geometri.normal(sida: string): (number, number)
	if sida == "S" then return 0, -1
	elseif sida == "N" then return 0, 1
	elseif sida == "E" then return 1, 0
	elseif sida == "W" then return -1, 0
	end
	error("okänd sida: " .. tostring(sida))
end

--[[ Öppningens sydvästra hörn i världskoordinater, plus hur den ska ritas.

	På N och W går p0 → p1 mot minskande koordinat, så där räknas hörnet
	baklänges — det är den detalj som är lätt att få fel och som gör att en
	dörr hamnar i fel ände av en fasad.

	Returnerar x, z, along ("X" eller "Z") och side (+1/-1 = åt vilket håll
	öppningen sticker ut ur väggen). ]]
function Geometri.oppningsHorn(r: Rekt, sida: string, u: number, b: number)
	local x0, z0 = Geometri.vagg(r, sida)
	if sida == "S" then return x0 + u, z0, "X", -1
	elseif sida == "N" then return x0 - u - b, z0, "X", 1
	elseif sida == "E" then return x0, z0 + u, "Z", 1
	else return x0, z0 - u - b, "Z", -1 end
end

-- Öppningens mittpunkt, som den ligger i fasadlivet.
function Geometri.oppningsMitt(r: Rekt, sida: string, u: number, b: number): (number, number)
	local x, z, along = Geometri.oppningsHorn(r, sida, u, b)
	if along == "X" then return x + b / 2, z else return x, z + b / 2 end
end

-- Taklutning i grader, räknad ur takfot och nock i stället för angiven: hN - hV
-- är resningen över halva spännvidden, och spännvidden avgörs av nocken.
-- "NS" = nocken löper längs y, alltså spänner taket över byggnadens bredd.
function Geometri.taklutning(rekt: Rekt, hV: number, hN: number, nock: string): number
	local spann = if nock == "NS" then rekt.w else rekt.h
	return math.deg(math.atan((hN - hV) / (spann / 2)))
end

-- Sitter två byggnader ihop? Väggarna ska mötas, inte överlappa, och de ska ha
-- ett gemensamt stycke att mötas längs. Marginalen är en decimeter: byggmåtten
-- i src/site.js står i hela och halva meter, så ett verkligt möte träffar
-- exakt och ett glapp är alltid större än så.
function Geometri.sitterIhop(a: Rekt, b: Rekt, marginal: number?): boolean
	local m = marginal or 0.1
	local overX = math.min(a.x + a.w, b.x + b.w) - math.max(a.x, b.x)
	local overY = math.min(a.y + a.h, b.y + b.h) - math.max(a.y, b.y)
	-- Möte i x-led: gaveln mot gaveln, med ett gemensamt stycke i y-led.
	if math.abs(overX) <= m and overY > m then return true end
	-- Möte i y-led: långsidan mot långsidan.
	if math.abs(overY) <= m and overX > m then return true end
	return false
end

--[[ Boxfacken i EN rad, som lokala y-intervall.

	Facken börjar vid boxStartY och är boxB djupa fram till klubbdelen. Ett
	fack som skär ett `brott` i sin rad finns inte — där går hästförbindelsen
	genom raden. Förut hoppades ett fack över i ALLA rader för en tvärkorridor
	tvärs huset; planen har ingen sådan, bara brottet i västra raden.

	Samma regel som STALLINNE.fack i src/site.js, och det exporterade `fack`
	bär webbens lista så att specen kan jämföra de två.

	Ligger här och inte i byggskriptet därför att specen måste kunna mäta samma
	fack som byggs. Skriver man logiken två gånger mäter man inte längre det man
	bygger. ]]
function Geometri.boxfack(stall, rad): { { y0: number, y1: number } }
	local fack = {}
	local y = stall.boxStartY
	while y + stall.boxB <= stall.klubbY + 0.001 do
		local y1 = y + stall.boxB
		local bruten = false
		for _, b in ipairs(stall.brott or {}) do
			if rad ~= nil and b.rad == rad.id and y1 > b.y0 + 0.01 and y < b.y1 - 0.01 then
				bruten = true
			end
		end
		if not bruten then table.insert(fack, { y0 = y, y1 = y1 }) end
		y = y1
	end
	return fack
end

--[[ En klubbdelsvägg i bitar, med sina öppningar bortdragna.

	`typ = "tvar"` löper i x på ett fast y och har öppningar som x-intervall;
	`typ = "langs"` löper i y på ett fast x och har öppningar som y-intervall.
	Bitarna kommer i samma koordinat som väggen löper i. Webben (src/world.js,
	src/varld3d.js) bygger ur samma regel: en dörr som finns i spelet finns i
	Roblox, och en som saknas saknas på båda ställena. ]]
function Geometri.vaggBitar(vagg): { { a0: number, a1: number } }
	local a0 = if vagg.typ == "tvar" then vagg.x0 else vagg.y0
	local a1 = if vagg.typ == "tvar" then vagg.x1 else vagg.y1
	local hal = {}
	for _, o in ipairs(vagg.oppningar or {}) do
		table.insert(hal, {
			a0 = if vagg.typ == "tvar" then o.x0 else o.y0,
			a1 = if vagg.typ == "tvar" then o.x1 else o.y1,
		})
	end
	table.sort(hal, function(p, q) return p.a0 < q.a0 end)
	local bitar = {}
	local a = a0
	for _, h in ipairs(hal) do
		if h.a0 - a > 0.05 then table.insert(bitar, { a0 = a, a1 = h.a0 }) end
		if h.a1 > a then a = h.a1 end
	end
	if a1 - a > 0.05 then table.insert(bitar, { a0 = a, a1 = a1 }) end
	return bitar
end

--[[ Tvärväggens bitar, som lokala x-intervall.

	En tvärvägg går inte obruten över huset — den har ett dörrgap där varje
	gång passerar, annars vore stallgången avstängd och klubbdelen oåtkomlig.
	Webbversionen bygger den i bitar mellan gångarna; det här är samma regel,
	så att Roblox inte murar igen en passage som är öppen i spelet.

	Byggbänken hittade precis det felet första gången den kördes: en obruten
	vägg vid y = 43 låg tvärs över klubbhallens gångyta.

	Gångarna kommer som en tabell med id som nyckel, och nyckelordningen i Luau
	är inte definierad — därför sorteras de på x0 innan bitarna räknas ut. ]]
--[[ Hålen i en tvärvägg: gångarna PLUS väggens egna öppningar ur brandplanen.

	Tog förut bara gångarna. Väggen mot servicedelen blev då tät framför varje
	boxrad, och spelaren som kom in genom södra gaveln möttes av en blank
	återvändsgränd — det som underkändes i spelarvyn. Väggen får sina hål ur
	planen nu, inte ur gångarnas lägen. `vagg` är valfri; utan den blir det
	som förut. ]]
--[[ Väggarna i den här listan ligger alla i boxhallen och följer gångarna.
	Klubbdelens väggar, som inte gör det, ligger i `stall.klubb.vaggar` och
	byggs genom Geometri.vaggBitar. ]]
function Geometri.tvarvaggBitar(stall, vagg): { { x0: number, x1: number } }
	local hal = {}
	for _, g in pairs(stall.gangar) do table.insert(hal, g) end
	if vagg ~= nil and vagg.oppningar ~= nil then
		for _, o in ipairs(vagg.oppningar) do table.insert(hal, o) end
	end
	table.sort(hal, function(a, b) return a.x0 < b.x0 end)

	local bitar = {}
	local x = 0
	for _, h in ipairs(hal) do
		if h.x0 - x > 0.05 then table.insert(bitar, { x0 = x, x1 = h.x0 }) end
		if h.x1 > x then x = h.x1 end
	end
	if stall.bredd - x > 0.05 then table.insert(bitar, { x0 = x, x1 = stall.bredd }) end
	return bitar
end

--[[ Läktaren i hela stycken, med hästgångens öppning bortdragen.

	Satellitbilden lägger hästgången centralt, och där kan läktaren inte vara
	obruten — man ska kunna leda hästen igenom. Samma regel som
	`laktarSektioner` i src/site.js; bygger man läktaren i ett stycke muras
	gången igen, och det syns inte förrän någon försöker gå där. ]]
--[[ En trappas steg ur dess data — DELAD regel med webben (`trappsteg` i
	src/site.js). `t` har fotavtryck x0–x1 × y0–y1, nivåerna z0 → z1 och
	`stiger`: "N" om z växer med y, "S" om z växer när y minskar. Steghöjden
	hålls under stegMax (0,19 m) så att karaktären kliver upp för den. ]]
function Geometri.trappsteg(t): { n: number, stig: number, djup: number, axel: string, steg: { { a0: number, a1: number, z: number } } }
	local ax = t.axel or "y"
	local a0 = if ax == "x" then t.x0 else t.y0
	local a1 = if ax == "x" then t.x1 else t.y1
	local stig = t.z1 - t.z0
	local n = math.max(1, math.ceil(math.abs(stig) / (t.stegMax or 0.19)))
	local djup = (a1 - a0) / n
	local bakat = (t.stiger == "S" or t.stiger == "W")
	local steg = {}
	for i = 0, n - 1 do
		local z = t.z0 + stig * (i + 1) / n
		local b0 = if bakat then a1 - djup * (i + 1) else a0 + djup * i
		table.insert(steg, { a0 = b0, a1 = b0 + djup, z = z })
	end
	return { n = n, stig = stig / n, djup = djup, axel = ax, steg = steg }
end

function Geometri.laktarSektioner(laktare): { { y0: number, y1: number } }
	local g = laktare.gap
	if not g then return { { y0 = laktare.y0, y1 = laktare.y1 } } end
	local ut = {}
	if g.y0 - laktare.y0 > 0.2 then
		table.insert(ut, { y0 = laktare.y0, y1 = g.y0 })
	end
	if laktare.y1 - g.y1 > 0.2 then
		table.insert(ut, { y0 = g.y1, y1 = laktare.y1 })
	end
	return ut
end

--[[ Läktarens bänkrader ur datan — SAMMA regel som laktarRader i src/site.js.
	Gångbrädan ligger på däckhöjd närmast banan; rad i har sitsen på
	dackZ + (i+1)·stegH och börjar gangbrada.djup + i·rader.djup in från
	däckets bankant. `in0`/`in1` är avstånd in från bankanten, `z` sitsens
	överkant. Utan `rader`/`gangbrada` i datan finns inga rader — inte fyra
	påhittade. ]]
function Geometri.laktarRader(L): { { in0: number, in1: number, z: number } }
	local r, g = L.rader, L.gangbrada
	if not r or not g then return {} end
	local ut = {}
	for i = 0, r.antal - 1 do
		table.insert(ut, {
			in0 = g.djup + i * r.djup,
			in1 = g.djup + (i + 1) * r.djup,
			z = L.dackZ + (i + 1) * r.stegH,
		})
	end
	return ut
end

--[[ Ett inredningsobjekts fotavtryck som axelparallell rektangel i husets
	lokala meter — samma regel som inredningRekt i src/inredning.js. Vänd
	norr/söder ligger bredden längs x, vänd öster/väster längs y. ]]
function Geometri.inredningRekt(o): Rekt
	local q = math.abs(math.cos(o.rikt)) < 0.5
	local w = if q then o.matt.b else o.matt.d
	local h = if q then o.matt.d else o.matt.b
	return { x = o.pos[1] - w / 2, y = o.pos[2] - h / 2, w = w, h = h }
end

-- Överlappets area mellan två rektanglar. 0 när de bara nuddar varandra.
function Geometri.overlapp(a: Rekt, b: Rekt): number
	local dx = math.min(a.x + a.w, b.x + b.w) - math.max(a.x, b.x)
	local dy = math.min(a.y + a.h, b.y + b.h) - math.max(a.y, b.y)
	if dx <= 0 or dy <= 0 then return 0 end
	return dx * dy
end

--[[ Väggfälten längs ridhusets långsidor: mellan två takstolar, klippta
     till hallens längd (A-gaveln → entrédelens vägg). Fönstren sitter ett
     per fält och pelarna på fältgränserna. Samma regel som webbens
     ridhusFalt i src/varld3d.js. ]]
function Geometri.ridhusFalt(R): { { number } }
	local TS, slut = R.takstomme, R.langd - R.entre
	local ut = {}
	local z = 0
	local p = TS.start
	while p < slut + 0.01 do
		if p - z > 0.5 then table.insert(ut, { z, math.min(p, slut) }) end
		z = p
		p += TS.delning
	end
	if slut - z > 0.5 then table.insert(ut, { z, slut }) end
	return ut
end

return Geometri
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX37">
				<Properties>
					<string name="Name">Anlaggningen</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Bygger hela UBRF-anläggningen i Studio ur den genererade geometrin.
--
-- Kör i ett run_code-anrop tillsammans med BuildKit och UBRFKomplex, eller lägg
-- båda som ModuleScripts i ServerStorage. Skriptet river sin gamla modell och
-- bygger om från grunden, precis som byggnadsskripten i _exempel.luau.
--
-- SKRIV INGA MÅTT HÄR. Alla tal kommer ur UBRFKomplex.luau, som i sin tur
-- genereras ur src/site.js — samma kod som webbspelet bygger sin värld av. Det
-- är hela poängen: Roblox och webben kan inte glida isär om anläggningens mått,
-- färger, öppningar eller om vilka hus som sitter ihop. Behöver ett mått ändras
-- ändras det i src/site.js, sedan körs `node tools/exportera-geometri.js`.
--
-- Det här skriptet får däremot ha egna åsikter om SÅDANT SOM INTE ÄR GEOMETRI:
-- material, tjocklekar, hur en öppning tecknas. Sådant är rendering, och
-- rendering får vara plattformsspecifik enligt paritetsregeln i CLAUDE.md.

local BK = BuildKit             -- inklistrad ovanför, eller require(...)
local G = UBRFKomplex           -- likaså
local GEO = Geometri            -- likaså; ren geometri, mätt i roblox/tests/

--[[ #162: i det inklistrade paketet ligger modulerna redan som lokala
	variabler ovanför den här raden — studio-paket.py inlinar dem. I en
	RIKTIG place (Rojo-synk eller den genererade .rbxlx) finns de i stället
	som syskonmoduler, och då är de tre ovan nil.

	Fallbacken gör att SAMMA fil bygger världen i båda vägarna. Det är hela
	poängen med blockeraren: förut byggde paketet en värld utan gameplay och
	Rojo-synken en gameplay utan värld, och då kan ingen testa First
	Playable. Nu finns det en enda världsbyggare, och den kan köras från
	båda hållen. ]]
if not BK then
	local syskon = script.Parent
	BK = require(syskon.BuildKit)
	GEO = require(syskon.Geometri)
	--[[ Geometrin ligger redan i ReplicatedStorage för klienten. Att mappa
		samma modul en andra gång hade gett två kopior av samma sanning, och
		det är precis vad projektet inte ska ha. Syskonet vinner om det finns,
		annars tas den delade. ]]
	local eget = syskon:FindFirstChild("UBRFKomplex")
	G = require(eget or game:GetService("ReplicatedStorage"):WaitForChild("UBRFKomplex"))
end

local YTOR = G.interiorytor     -- F02-C: delade interiörmaterial, inte en andra färglista

--[[ De gula dörrmarkörerna hör till den VISUELLA GRANSKNINGEN, inte till
	spelet. Blockeraren #162: Tobias stod på en av dem och väntade sig att
	något skulle hända. I QA-paketet ska de vara kvar — de är QA-hjälp och
	flera grindar räknar dem — men en spelbuild ska inte visa gula plattor
	som inte går att använda.

	`studio-paket.py --lage qa` sätter flaggan; `--lage spel` och den
	genererade placen gör det inte, och då blir den nil. ]]
local QA_MARKORER = UBRF_QA_MARKORER == true

local VAGGT = 0.3               -- väggtjocklek, rendering
local MARKT = 0.2               -- marklagrets tjocklek

local MARKFARG: { [string]: Color3 } = {
	gras   = Color3.fromRGB(104, 152, 68),
	grus   = Color3.fromRGB(176, 168, 150),
	asfalt = Color3.fromRGB(78, 78, 82),
	sand   = Color3.fromRGB(206, 186, 148),
	betong = Color3.fromRGB(150, 150, 146),
	aker   = Color3.fromRGB(150, 138, 96),
}

local MARKMATERIAL: { [string]: Enum.Material } = {
	gras   = Enum.Material.Grass,
	grus   = Enum.Material.Ground,
	asfalt = Enum.Material.Asphalt,
	sand   = Enum.Material.Sand,
	betong = Enum.Material.Concrete,
	aker   = Enum.Material.Ground,
}

-- Öppningarnas färger. Namnen kommer ur src/site.js och beskriver vad man ser:
-- portbla = de blågrå skjutportarna, portplat = durkplåtsdörrarna, dorrgul =
-- den ockragula stalldörren under förstukvisten.
local OPPNINGSFARG: { [string]: Color3 } = {
	portbla    = Color3.fromRGB(94, 108, 122),
	portplat   = Color3.fromRGB(150, 152, 156),
	portsilver = Color3.fromRGB(196, 198, 202),
	dorrgul    = Color3.fromRGB(206, 158, 62),
	dorrvit    = Color3.fromRGB(238, 236, 228),
	dorrmork   = Color3.fromRGB(58, 48, 44),
	dorr       = Color3.fromRGB(228, 226, 218),
}

local function arFonster(typ: string): boolean
	return typ == "fonster" or typ == "rund" or typ == "valv"
end

--[[ Går man igenom öppningen? Avgör både att fasaden får en lucka där och
	att dörrbladet blir en dörr med interaktion i stället för en målad panel.
	Ett fönster går man inte igenom, och inte en öppning med bröstning. ]]
local function garIgenom(o): boolean
	return not arFonster(o.typ) and (o.z0 or 0) <= 0.001
end

local function byggMark(model: Model, base: CFrame)
	for _, m in ipairs(G.mark) do
		local p = BK.box(model, base, "Mark " .. m.typ,
			m.rekt.x, -MARKT, m.rekt.y, m.rekt.w, MARKT, m.rekt.h,
			MARKFARG[m.typ] or Color3.fromRGB(120, 120, 120),
			MARKMATERIAL[m.typ] or Enum.Material.Ground)
		p.CanCollide = false
	end
end

local function byggOppning(model: Model, base: CFrame, b, o)
	-- Var öppningen sitter är geometri och ligger därför i Geometri.luau, som
	-- är mätt mot webbkoden. Hur den tecknas är rendering och ligger här.
	local x, z, along, side = GEO.oppningsHorn(b.rekt, o.sida, o.u, o.b)

	local namn = (o.label or o.typ) .. (if o.intern then " (intern)" else "")
	if arFonster(o.typ) then
		BK.window(model, base, x, z, o.z0, o.b, o.h, along, side,
			Color3.fromRGB(238, 236, 228))
	else
		local f = OPPNINGSFARG[o.typ] or Color3.fromRGB(200, 200, 200)
		local blad = BK.opening(model, base, namn, x, z, o.z0, o.b, o.h, along, side, f,
			Enum.Material.SmoothPlastic)
		--[[ #162: dörrbladet märks upp med det som behövs för att öppna det,
			så att serverns DorrService inte behöver gissa ur ett namn som
			"dorrvit" (flera dörrar delar namn). Attribut, inte tagg: den här
			filen körs också i byggbänkens stubbar, där CollectionService inte
			finns. Måtten kommer ur öppningen — inget nytt hittas på. ]]
		if garIgenom(o) then
			blad:SetAttribute("UBRFDorr", true)
			blad:SetAttribute("Byggnad", b.id)
			blad:SetAttribute("Sida", o.sida)
			blad:SetAttribute("Bredd", o.b)
			blad:SetAttribute("Hojd", o.h)
			blad:SetAttribute("Langs", along)
			blad:SetAttribute("Utat", side)
			blad:SetAttribute("Etikett", namn)
		end
	end

	--[[ Skärmtaket över en entrédörr.

		`skarm` fanns i den delade geometrin och ritades av webben, men den
		här filen läste aldrig fältet — så varje dörr som på webben bar ett
		vitt skärmtak stod i Roblox som en naken lucka i väggen. Det är just
		det som avgör om något LÄSER som en entré på håll, och stallets
		klubbdörr mot grusplanen är en av dem.

		Förenklat mot webbens `v3dSkarmtak`: där är taket en gavelform med
		två sneda sidobalkar; här är det en platta med två konsoler. Samma
		mått och samma läge — stiliserat betyder förenklat, inte påhittat. ]]
	if o.skarm then
		local UT, TJOCK, OVER = 0.80, 0.13, 0.30
		local V = Color3.fromRGB(238, 236, 228)
		local y = o.z0 + o.h + OVER
		--[[ `side` är +1/-1 och pekar ut från fasaden längs den axel väggen
			INTE löper i. Plattan skjuter ut åt det hållet. ]]
		local ut = if side > 0 then 0 else -UT
		if along == "X" then
			BK.box(model, base, "Skärmtak", x + (o.b - o.skarm) / 2, y, z + ut,
				o.skarm, TJOCK, UT, V, Enum.Material.SmoothPlastic)
			for _, s in ipairs({ 0, 1 }) do
				BK.box(model, base, "Skärmkonsol",
					x + (o.b - o.skarm) / 2 + s * (o.skarm - 0.11), y - 0.62, z + ut,
					0.11, 0.62, 0.11, V, Enum.Material.SmoothPlastic)
			end
		else
			BK.box(model, base, "Skärmtak", x + ut, y, z + (o.b - o.skarm) / 2,
				UT, TJOCK, o.skarm, V, Enum.Material.SmoothPlastic)
			for _, s in ipairs({ 0, 1 }) do
				BK.box(model, base, "Skärmkonsol", x + ut, y - 0.62,
					z + (o.b - o.skarm) / 2 + s * (o.skarm - 0.11),
					0.11, 0.62, 0.11, V, Enum.Material.SmoothPlastic)
			end
		end
	end
end

--[[ ══ FASADEN SOM SEGMENT RUNT DÖRRARNA ═══════════════════════════════

	Blockerare i #162, funnen av Tobias i Studio: han stod på den gula
	markören vid den vita dörren och kom inte in. Orsaken satt inte i
	markören och inte i en saknad prompt — fasaden byggdes som FYRA HELA
	LÅDOR, och öppningarna MÅLADES på utsidan som 6 cm tunna paneler. Dörren
	fanns alltså att se men väggen bakom den kolliderade. Ingen kom in i
	något hus, med eller utan interaktion.

	Interiörväggarna var redan segmenterade med dörrarna som luckor
	(entréhallen, klubbdelen). Fasaden var inte det. Det här rättar just den
	skillnaden.

	INGEN BYGGNAD, DÖRR ELLER FÖNSTER FLYTTAS. Luckan läggs där öppningen
	redan står, räknad ur samma verifierade `b.oppningar` och samma
	`GEO.oppningsHorn` som panelen ritas ur. Väggen får en lucka; öppningen
	behåller sitt läge, sin bredd och sin höjd.

	Fönster segmenteras INTE — man går inte genom ett fönster — och inte
	heller en öppning med bröstning (`z0 > 0`). ]]

--[[ Luckornas spann längs väggens EGEN axel, sorterade.

	`oppningsHorn` räknar N och W baklänges, så spannet måste hämtas därifrån
	och inte räknas ut på nytt här — det är precis den detalj som annars
	lägger luckan i fel ände av fasaden. ]]
local function luckor(b, sida: string): { { number } }
	local ut = {}
	for _, o in ipairs(b.oppningar or {}) do
		if o.sida == sida and garIgenom(o) then
			local x, z, along = GEO.oppningsHorn(b.rekt, o.sida, o.u, o.b)
			table.insert(ut, { (if along == "X" then x else z), o.b, o.h })
		end
	end
	table.sort(ut, function(p, q) return p[1] < q[1] end)
	return ut
end

--[[ En fasadvägg byggd som segment, med överstycke över varje lucka.

	`langd` löper längs `along`; `x`/`z` är väggens hörn som i `BK.wall`. ]]
local function vaggMedLuckor(model: Model, base: CFrame, namn: string,
	x: number, z: number, langd: number, hojd: number, t: number,
	along: "X" | "Z", farg: Color3, hal: { { number } })
	local start = if along == "X" then x else z
	local slut = start + langd
	local kant = start

	local function segment(fran: number, till: number)
		if till - fran <= 0.001 then return end
		if along == "X" then
			BK.wall(model, base, namn, fran, z, till - fran, hojd, t, "X", farg)
		else
			BK.wall(model, base, namn, x, fran, till - fran, hojd, t, "Z", farg)
		end
	end

	for _, l in ipairs(hal) do
		local a0 = math.max(l[1], start)
		local a1 = math.min(l[1] + l[2], slut)
		if a1 > a0 then
			segment(kant, a0)
			--[[ Överstycket. Utan det blir luckan en glugg upp till nocken,
				och då är dörren inte längre en dörr. ]]
			local h = l[3]
			if hojd > h + 0.001 then
				if along == "X" then
					BK.box(model, base, namn .. " överstycke", a0, h, z,
						a1 - a0, hojd - h, t, farg)
				else
					BK.box(model, base, namn .. " överstycke", x, h, a0,
						t, hojd - h, a1 - a0, farg)
				end
			end
			kant = math.max(kant, a1)
		end
	end
	segment(kant, slut)
end

local function byggHus(model: Model, base: CFrame, b)
	local r = b.rekt
	local fasad = b.fargV
	local tak = b.fargT or fasad

	BK.box(model, base, b.id .. " grund", r.x, -0.25, r.y, r.w, 0.25, r.h,
		Color3.fromRGB(120, 120, 115), Enum.Material.Concrete)

	vaggMedLuckor(model, base, b.id .. " syd",  r.x, r.y, r.w, b.hV, VAGGT, "X", fasad, luckor(b, "S"))
	vaggMedLuckor(model, base, b.id .. " norr", r.x, r.y + r.h - VAGGT, r.w, b.hV, VAGGT, "X", fasad, luckor(b, "N"))
	vaggMedLuckor(model, base, b.id .. " vast", r.x, r.y, r.h, b.hV, VAGGT, "Z", fasad, luckor(b, "W"))
	vaggMedLuckor(model, base, b.id .. " ost",  r.x + r.w - VAGGT, r.y, r.h, b.hV, VAGGT, "Z", fasad, luckor(b, "E"))

	for _, o in ipairs(b.oppningar or {}) do
		byggOppning(model, base, b, o)
	end

	-- gableRoof vill ha nocken som "X" eller "Z". Spelets nock "NS" löper längs
	-- y, alltså längs z i Roblox.
	model:SetAttribute("GavelFarg", fasad)
	BK.gableRoof(model, base, r.x, r.y, r.w, r.h, b.hV,
		GEO.taklutning(r, b.hV, b.hN, b.nock),
		if b.nock == "NS" then "Z" else "X", 0.4, tak)
end

--[[ ══ IGENKÄNNINGSDRAGEN ═══════════════════════════════════════════

	Review 03:s tillägg: verifierade identitetsdrag fanns bara i webbens
	renderare, så primärplattformen saknade just det som avgör om någon
	känner igen UBRF. Måtten ligger nu i G.identitet, exporterade ur
	src/site.js — inte avskrivna hit.

	Bara det som gör att man känner igen huset. Dekor utan källa hör inte
	hemma här, och listar och skruvar hör inte till en fidelity-gate. ]]

local IDFARG = {
	huv     = Color3.fromRGB(78, 84, 92),
	svart   = Color3.fromRGB(38, 41, 46),
	vit     = Color3.fromRGB(238, 236, 228),
	betong  = Color3.fromRGB(194, 191, 182),
	stal    = Color3.fromRGB(154, 160, 166),
	kabel   = Color3.fromRGB(180, 185, 190),
	vent    = Color3.fromRGB(194, 199, 204),
	panel   = Color3.fromRGB(94, 44, 51),
	list    = Color3.fromRGB(238, 236, 228),
	trappa  = Color3.fromRGB(58, 62, 68),
}

local function byggStallIdentitet(model: Model, base: CFrame)
	local b = nil
	for _, x in ipairs(G.byggnader) do if x.id == "stall" then b = x end end
	if not b then return end
	local r, I = b.rekt, G.identitet.stall
	local cx = r.x + r.w / 2

	-- Huvraden på nocken, en per box. Det tydligaste draget på håll.
	local H = I.huvrad
	for i = 1, H.antal do
		local z = r.y + r.h - (H.forstaFranNorr + H.delning * (i - 1))
		BK.box(model, base, "Takhuv " .. i, cx - H.sida / 2, b.hN + 0.28 - H.hojd / 2,
			z - H.sida / 2, H.sida, H.hojd, H.sida, IDFARG.huv, Enum.Material.Metal)
		BK.box(model, base, "Huvhatt " .. i, cx - H.hattB / 2, b.hN + 0.62,
			z - H.hattB / 2, H.hattB, 0.09, H.hattB, IDFARG.huv, Enum.Material.Metal)
	end

	-- Snörasskyddet på båda takfallen, en tredjedel upp.
	local N = I.snorasskydd
	local halv, res = r.w / 2, b.hN - b.hV
	for _, sida in ipairs({ -1, 1 }) do
		local px = cx + sida * halv * N.andelUt
		local py = b.hV + res * N.andelUpp
		BK.box(model, base, "Snörasskydd " .. (if sida < 0 then "väst" else "öst"),
			px - 0.03, py + 0.14, r.y + 0.6, 0.06, 0.06, r.h - 1.2,
			IDFARG.svart, Enum.Material.Metal)
	end

	-- Förstukvisten på västra långsidan. u mäts från norra gaveln söderut.
	--[[ Förstukvisten sitter på NORRA GAVELN och skjuter ut mot grusplanen.

		Den låg på västra långsidan till 2026-09-02, då produktägaren bytte
		plats på verandan och gavelns enkla skärmtaksdörr. Spegelvänt mot
		förut: den sträcker sig nu längs x och skjuter ut i +z, i stället för
		tvärtom. `uFranOst` mäts från östra gavelhörnet, samma konvention som
		öppningarnas u på N-sidan. ]]
	local K = I.forstukvist
	local kx = r.x + r.w - K.uFranOst          -- verandans mitt längs gaveln
	local kn = r.y + r.h                       -- gavelns yttervägg
	BK.box(model, base, "Förstukvist golv", kx - K.bredd / 2, 0, kn,
		K.bredd, 0.14, K.djup, IDFARG.betong, Enum.Material.Concrete)
	BK.box(model, base, "Förstukvist tak", kx - K.bredd / 2 - 0.2, K.takfot, kn,
		K.bredd + 0.4, 0.12, K.djup + 0.2,
		b.fargT or IDFARG.huv, Enum.Material.Metal)
	for _, sida in ipairs({ -1, 1 }) do
		BK.box(model, base, "Förstukvist stolpe",
			kx + sida * (K.bredd / 2 - 0.2), 0, kn + K.djup - 0.25,
			0.15, K.takfot, 0.15, IDFARG.vit, Enum.Material.WoodPlanks)
	end
	-- Ribbräcket, med öppningen mitt för dörren. Spegelvänt med verandan:
	-- löper längs x vid gavelns yttre kant i stället för längs z.
	local sido = (K.bredd - 0.34 - K.oppning) / 2
	for _, sida in ipairs({ -1, 1 }) do
		BK.box(model, base, "Förstukvist räcke",
			kx + sida * (K.oppning / 2 + sido / 2) - sido / 2, 0.26,
			kn + K.djup - 0.21,
			sido, 1.2, 0.06, IDFARG.vit, Enum.Material.WoodPlanks)
	end

	-- Balkongen och spiraltrappan på klubbgaveln i norr.
	local BA, SP = I.balkong, I.spiraltrappa
	local gm = r.x + r.w / 2
	BK.box(model, base, "Balkong", gm - BA.bredd / 2, BA.z - 0.12,
		r.y + r.h, BA.bredd, 0.12, BA.djup, IDFARG.trappa, Enum.Material.Metal)
	BK.box(model, base, "Balkongräcke", gm - BA.bredd / 2, BA.z,
		r.y + r.h + BA.djup - 0.06, BA.bredd, BA.rackeH, 0.06,
		IDFARG.svart, Enum.Material.Metal)

	local sx = gm + SP.franGavelmitt
	BK.box(model, base, "Spiraltrappa spindel", sx - 0.09, 0, r.y + r.h + 0.53,
		0.18, BA.z + 0.5, 0.18, IDFARG.svart, Enum.Material.Metal)
	for i = 1, SP.steg do
		local vinkel = (i - 1) * 0.40
		BK.box(model, base, "Spiraltrappsteg " .. i,
			sx + math.cos(vinkel) * SP.radie / 2 - SP.radie / 2,
			BA.z * i / SP.steg,
			r.y + r.h + 0.62 + math.sin(vinkel) * SP.radie / 2 - 0.15,
			SP.radie, 0.05, 0.30, IDFARG.trappa, Enum.Material.Metal)
	end
end

local function byggRidhusIdentitet(model: Model, base: CFrame)
	local R, I = G.ridhus, G.identitet.ridhus
	local o = R.origo

	--[[ DEN ROSTBRUNA ÖVRE LÅNGVÄGGEN.

		`KNOWN MISMATCH`, rättad: Roblox byggde den på BÅDA långsidorna i
		nästan hela hallens längd. Det verifierade är motsatsen —
		`ridhus-inne-02` visar den på EN DEL av EN långsida, och resten av
		samma vägg är ljus. Webben har läst `ovreVagg.sida/y0/y1` sedan
		Review 03; Roblox gjorde det inte, och det var en av de tydligaste
		Roblox-only sanningarna som fanns kvar.

		Sidan kommer ur `sidor.panel` via `ovreVagg.sida`, så en framtida
		spegling flyttar väggen på båda ytorna samtidigt.

		Färgen läser den MÄTTA `R.panel` (#765B59 ur en färgmask på -02), inte
		IDFARG.panel — den senare var det gamla mättade rödlila. ]]
	local O = I.ovreVagg
	local y0, y1 = R.sargH + O.overSarg, R.tak - O.underTak
	local px = if O.sida == "W" then 0.16 else R.bredd - 0.16
	local pL = O.y1 - O.y0
	BK.box(model, base, "Övre långvägg", o.x + px - O.tjocklek / 2, y0,
		o.y + O.y0, O.tjocklek, y1 - y0, pL,
		R.panel or IDFARG.panel, Enum.Material.Metal)
	for i = 1, O.listar do
		local yy = y0 + 0.25 + (y1 - y0 - 0.5)
			* (if O.listar > 1 then (i - 1) / (O.listar - 1) else 0.5)
		BK.box(model, base, "Väggläkt", o.x + px - 0.05, yy, o.y + O.y0,
			0.10, 0.07, pL, R.panelList or IDFARG.list,
			Enum.Material.SmoothPlastic)
	end

	--[[ FÖNSTERBANDET byggs redan i byggRidhusInre. SPONSORSKYLTARNA byggdes
		INTE alls i Roblox — de fanns bara i webben. De hänger på panelen, i
		den ordning ridhus-inne-02 visar dem, och deras läge härleds ur
		panelens stycke i den delade datan. Förenklad grafik är i sin
		ordning; fel antal eller fel ordning är det inte. ]]
	local inat = if O.sida == "W" then 1 else -1
	for i, sk in ipairs(R.skyltar or {}) do
		local skylt = BK.box(model, base, "Sponsorskylt " .. i,
			o.x + px + inat * 0.06, y0 + (y1 - y0) * 0.30,
			o.y + sk.y - sk.b / 2, 0.05, 0.62, sk.b,
			sk.bg or Color3.fromRGB(242, 237, 226), Enum.Material.SmoothPlastic)
		skylt.CanCollide = false
		skylt:SetAttribute("Text", sk.text)
	end

	--[[ TAKSTOMMEN OCH UNDERTAKET.

		Roblox byggde stål, kabelstegar och ventilation men varken trästomme
		eller undertak — de talen fanns bara som literaler inne i webbens
		v3dRidhus. Review 10 har rätt i att en andra geometrisanning inte ska
		handkopieras hit: fakta ligger nu i `R.takstomme` och `R.takfarg`, och
		båda ytorna läser dem.

		Färgerna är MÄTTA: ridhusets takstolar är mörkt gråbruna och nästan
		neutrala, INTE varmt limträ som stallets. ]]
	local TS, TF = R.takstomme, R.takfarg
	if TS and TF then
		local halvS = R.bredd / 2
		local takL = math.sqrt(halvS ^ 2 + TS.resning ^ 2)
		local takV = math.atan2(TS.resning, halvS)
		for _, sida in ipairs({ -1, 1 }) do
			local fall = Instance.new("Part")
			fall.Name = "Ridhus takfall"; fall.Anchored = true
			fall.CanCollide = false
			fall.Color = TF.plat; fall.Material = Enum.Material.Metal
			fall.Size = Vector3.new(BK.M * takL, BK.M * TS.platT,
				BK.M * (R.langd + 0.6))
			fall.CFrame = base
				* CFrame.new(BK.M * (o.x + halvS + sida * halvS / 2),
					BK.M * (R.tak + TS.resning / 2),
					BK.M * (o.y + R.langd / 2))
				* CFrame.Angles(0, 0, -sida * takV)
			fall.Parent = model
		end
		local z = TS.start
		while z < R.langd do
			BK.box(model, base, "Ridhus takbalk", o.x, R.tak - 0.2 - TS.balkH / 2,
				o.y + z - TS.balkD / 2, R.bredd, TS.balkH, TS.balkD,
				TF.balk, Enum.Material.Wood).CanCollide = false
			BK.box(model, base, "Ridhus kungstolpe",
				o.x + halvS - TS.kungB / 2, R.tak - 0.05,
				o.y + z - TS.kungB / 2, TS.kungB, TS.kungH, TS.kungB,
				TF.balk, Enum.Material.Wood).CanCollide = false
			z += TS.delning
		end
	end

	-- MOTSÄGELSE 3: takets stål, kabelstegar och ventilation.
	local P = I.takProfiler
	for i, a in ipairs(P.andelar) do
		BK.box(model, base, "Stålprofil " .. i, o.x + R.bredd * a - P.b / 2,
			R.tak - P.underTak - P.h, o.y + 0.5, P.b, P.h, R.langd - 1,
			IDFARG.stal, Enum.Material.Metal)
	end

	local K = I.kabelstegar
	for i, a in ipairs(K.andelar) do
		local x = o.x + R.bredd * a
		for _, d in ipairs({ -K.bredd / 2, K.bredd / 2 - 0.05 }) do
			BK.box(model, base, "Kabelstege " .. i, x + d, R.tak - K.underTak,
				o.y + 1, 0.05, 0.16, R.langd - 2, IDFARG.kabel, Enum.Material.Metal)
		end
		-- Stegpinnarna. Utan dem läser stegen som ännu en balk.
		local z = 2
		while z < R.langd - 2 do
			BK.box(model, base, "Stegpinne", x - K.bredd / 2, R.tak - K.underTak,
				o.y + z, K.bredd, 0.03, 0.05, IDFARG.kabel, Enum.Material.Metal)
			z += K.pinnDelning
		end
	end

	local V = I.ventkanaler
	for i, a in ipairs(V.andelar) do
		local x = o.x + R.bredd * a
		BK.box(model, base, "Ventkanal " .. i, x - V.radie, R.tak - V.underTak - V.radie,
			o.y + 1.5, V.radie * 2, V.radie * 2, R.langd - 3,
			IDFARG.vent, Enum.Material.Metal)
		local z = 5
		while z < R.langd - 4 do
			BK.box(model, base, "Ventdon", x - 0.16, R.tak - V.underTak - 0.63,
				o.y + z - 0.16, 0.32, 0.42, 0.32, IDFARG.vent, Enum.Material.Metal)
			z += V.donDelning
		end
	end
end

-- Staketen runt banorna och hagarna. Sträckorna kommer ur G.staket, måtten
-- ur G.banomrade.staket. Trästaketet har TRE reglar — mätt i
-- references/omnejd/banan-03. Webben ritade tidigare två, och Roblox ritade
-- inga alls: uteridbanan stod helt utan inhägnad på primärplattformen.
--
-- Alla sträckor i src/site.js är axelparallella, så box räcker. Skulle en
-- diagonal sträcka läggas till måste den här funktionen byggas om.
local STAKETFARG: { [string]: { regel: Color3, stolpe: Color3 } } = {
	tra  = { regel = Color3.fromRGB(176, 161, 132), stolpe = Color3.fromRGB(138, 122, 94) },
	rail = { regel = Color3.fromRGB(122, 46, 40),  stolpe = Color3.fromRGB(106, 40, 34) },
	el   = { regel = Color3.fromRGB(140, 133, 120), stolpe = Color3.fromRGB(110, 106, 94) },
}

--[[ STAKETENS SOLIDA BITAR — grindöppningarna bortsubtraherade.

     Motsvarigheten till `staketSegment()` i src/site.js, och den finns
     av samma skäl: en grind som bara är en markör är ingen grind.
     Tobias produkttest 2026-09-06 fällde webben på precis det, och en
     rättelse som bara gällde webben hade lämnat Roblox med slutna
     hagar — paritetsregeln säger att spelvärlden ska motsvara sig
     själv på båda ytorna.

     Grinden anges som en punkt på staketlinjen plus en bredd; punkten
     projiceras på det segment den ligger på och segmentet delas. ]]
local function staketSegment(st): { { number } }
	local ut = {}
	for i = 1, #st.p - 1 do
		local x0, y0 = st.p[i][1], st.p[i][2]
		local x1, y1 = st.p[i + 1][1], st.p[i + 1][2]
		local dx, dy = x1 - x0, y1 - y0
		local L = math.sqrt(dx * dx + dy * dy)
		if L >= 1e-9 then
			local hal = {}
			for _, g in ipairs((st :: any).grindar or {}) do
				local t = ((g.p[1] - x0) * dx + (g.p[2] - y0) * dy) / (L * L)
				if t >= 0 and t <= 1 then
					local px, py = x0 + dx * t, y0 + dy * t
					--[[ Punkten måste ligga PÅ linjen, inte bara projiceras
					     på den — annars öppnar en grind på en annan sida
					     fel sträcka. ]]
					if math.sqrt((px - g.p[1]) ^ 2 + (py - g.p[2]) ^ 2) <= 0.35 then
						local halv = (g.bredd or 2.0) / 2 / L
						table.insert(hal, { math.max(0, t - halv), math.min(1, t + halv) })
					end
				end
			end
			table.sort(hal, function(a, b) return a[1] < b[1] end)
			local t0 = 0
			for _, h in ipairs(hal) do
				if h[1] > t0 then
					table.insert(ut, { x0 + dx * t0, y0 + dy * t0, x0 + dx * h[1], y0 + dy * h[1] })
				end
				t0 = math.max(t0, h[2])
			end
			if t0 < 1 then
				table.insert(ut, { x0 + dx * t0, y0 + dy * t0, x1, y1 })
			end
		end
	end
	return ut
end

local function byggStaket(model: Model, base: CFrame)
	local S = G.banomrade.staket
	for _, st in ipairs(G.staket) do
		local farg = STAKETFARG[st.typ] or STAKETFARG.tra
		-- Trästaketet vid banan är inte en stapel likadana reglar: EN kraftig
		-- toppregel, eltråd på svarta isolatorer under, och där staketet
		-- omsluter sand en grov syll i marknivå som håller sanden. Mätt i
		-- references/omnejd/banan-01. Rail och el är enklare.
		local reglar, stolpH, delning, tj
		if st.typ == "tra" then
			reglar, stolpH, delning, tj = {}, S.stolpH, S.stolpDelning, S.stolpTvarsnitt
		elseif st.typ == "rail" then
			reglar, stolpH, delning, tj = { 0.38, 0.80 }, 0.85, 3.0, 0.12
		else
			reglar, stolpH, delning, tj = { 0.70, 1.05 }, 1.0, 6.0, 0.07
		end

		for _, bit in ipairs(staketSegment(st)) do
			local a, b = { bit[1], bit[2] }, { bit[3], bit[4] }
			local dx, dz = b[1] - a[1], b[2] - a[2]
			local len = math.sqrt(dx * dx + dz * dz)
			if len >= 0.01 then
				local langsX = math.abs(dx) >= math.abs(dz)
				local x0 = math.min(a[1], b[1])
				local z0 = math.min(a[2], b[2])

				-- Liggande virke: (namn, mitthöjd, höjd, djup, färg, material)
				local liggande = {}
				if st.typ == "tra" then
					local T = S.toppregel
					table.insert(liggande, { "Staketets toppregel", T.z, T.h, T.d,
						farg.regel, Enum.Material.WoodPlanks })
					if st.sandkant then
						local Y = S.sandsyll
						table.insert(liggande, { "Sandsyll", Y.z, Y.h, Y.d,
							Color3.fromRGB(156, 138, 110), Enum.Material.Wood })
					end
					for _, y in ipairs(S.tradar) do
						table.insert(liggande, { "Eltrad", y, S.tradTjocklek, S.tradTjocklek,
							Color3.fromRGB(58, 54, 46), Enum.Material.Metal })
					end
				else
					for _, y in ipairs(reglar) do
						table.insert(liggande, { "Staketregel " .. st.typ, y, 0.10, 0.05,
							farg.regel, Enum.Material.WoodPlanks })
					end
				end

				for _, L in ipairs(liggande) do
					local namn, y, hojd, djup = L[1], L[2], L[3], L[4]
					local w = if langsX then len else djup
					local d = if langsX then djup else len
					local px = if langsX then x0 else x0 - djup / 2
					local pz = if langsX then z0 - djup / 2 else z0
					local r = BK.box(model, base, namn,
						px, y - hojd / 2, pz, w, hojd, d, L[5], L[6])
					r.CanCollide = false
				end

				local n = math.max(1, math.floor(len / delning + 0.5))
				for k = 0, n do
					local t = k / n
					local sx = a[1] + dx * t - tj / 2
					local sz = a[2] + dz * t - tj / 2
					BK.box(model, base, "Staketstolpe " .. st.typ,
						sx, 0, sz, tj, stolpH, tj,
						farg.stolpe, Enum.Material.Wood)
					-- De svarta isolatorerna som bär eltråden.
					if st.typ == "tra" then
						for _, y in ipairs(S.tradar) do
							local iso = BK.box(model, base, "Isolator",
								sx + (tj - S.isolatorB) / 2, y - S.isolatorH / 2,
								sz + (tj - S.isolatorB) / 2,
								S.isolatorB, S.isolatorH, S.isolatorB,
								Color3.fromRGB(38, 36, 31), Enum.Material.SmoothPlastic)
							iso.CanCollide = false
						end
					end
				end
			end
		end
	end
end

-- Belysningsmasterna runt uteridbanan. Dubbel armatur på en tvärarm — se den
-- närmaste masten i references/omnejd/banan-03. Lägena står i G.props.
local function byggMaster(model: Model, base: CFrame)
	local MA = G.banomrade.mast
	for _, p in ipairs(G.props) do
		if p.typ == "mast" then
			local x, z = p.pos[1], p.pos[2]
			local d = MA.stamOver * 2
			BK.box(model, base, "Belysningsmast", x - d / 2, 0, z - d / 2,
				d, MA.hojd, d, Color3.fromRGB(140, 143, 146), Enum.Material.Metal)
			local arm = BK.box(model, base, "Mastarm", x - MA.armB / 2, MA.hojd,
				z - MA.armD / 2, MA.armB, MA.armH, MA.armD,
				Color3.fromRGB(140, 143, 146), Enum.Material.Metal)
			arm.CanCollide = false
			for _, dx in ipairs({ -MA.lampDelning / 2, MA.lampDelning / 2 }) do
				local lampa = BK.box(model, base, "Mastarmatur",
					x + dx - MA.lampB / 2, MA.hojd + MA.armH - MA.lampH,
					z - MA.lampD / 2, MA.lampB, MA.lampH, MA.lampD,
					Color3.fromRGB(58, 61, 64), Enum.Material.Metal)
				lampa.CanCollide = false
			end
		end
	end
end

--[[ ══ FIRST PLAYABLE-SPAWNEN ═══════════════════════════════════════════

	Blockerare i #162, punkt C: Tobias spawnade för långt från den avsedda
	starten. Orsaken var att INGEN `SpawnLocation` skapades någonstans i
	repot — Roblox spawnade därför på sitt eget standardläge, och det fanns
	inget spawnkontrakt att vinna över.

	Läget är inte valt av mig. Det är `STALL-ANKOMST`, reviewkameran som
	tillkom i #80 runda 3 och som bär `CHATGPT_VISUAL_PASS`: 6,0 m norr om
	stallets nordfasad, centrerad på den ockragula entrédörren under
	verandan, med blicken mot dörren. Alltså exakt den plats en besökare
	anländer till, och den vy som redan är granskad som ankomsten.

	Härlett ur samma `G.byggnader`/`GEO.oppningsMitt` som fasaden byggs ur —
	inga egna koordinater. Flyttas dörren följer spawnen med.

	Plattan är GENOMSKINLIG. Den är en spawnpunkt, inte dekor, och en
	synlig platta hade ändrat granskade exteriörbilder utan att tillföra
	något. `Neon`-markörerna är QA-hjälp; det här är inte en sådan. ]]

local ANKOMST_UT = 6.0          -- m norr om fasaden, som STALL-ANKOMST

local function byggSpawn(model: Model, base: CFrame)
	local stall
	for _, b in ipairs(G.byggnader) do
		if b.id == "stall" then stall = b end
	end
	if not stall then
		warn("[UBRF] Ingen byggnad 'stall' — First Playable-spawnen hoppas över.")
		return
	end

	local dorr
	for _, o in ipairs(stall.oppningar or {}) do
		if o.sida == "N" and o.typ == "dorrgul" then dorr = o end
	end
	if not dorr then
		warn("[UBRF] Stallets ockragula entrédörr saknas — spawnen hoppas över.")
		return
	end

	local dx, dz = GEO.oppningsMitt(stall.rekt, "N", dorr.u, dorr.b)
	local sx, sz = dx, stall.rekt.y + stall.rekt.h + ANKOMST_UT

	local M = BK.M
	local sp = Instance.new("SpawnLocation")
	sp.Name = "UBRFStart"
	sp.Anchored = true
	sp.CanCollide = false
	sp.Transparency = 1
	sp.Size = Vector3.new(6, 0.2, 6)
	sp.Neutral = true
	sp.Duration = 0
	--[[ Riktningen tas som en BLICK MOT DÖRREN i stället för som en vinkel.
		Webbens `rikt` och Roblox yaw har olika konvention, och en vinkel som
		räknas om för hand är precis den sorts detalj som tystnar fel. Ser man
		dörren när man spawnar är riktningen rätt, oavsett konvention. ]]
	local har = (base * CFrame.new(sx * M, 0.1 * M, sz * M)).Position
	local dit = (base * CFrame.new(dx * M, 0.1 * M, dz * M)).Position
	sp.CFrame = CFrame.lookAt(har, Vector3.new(dit.X, har.Y, dit.Z))
	sp:SetAttribute("UBRFStart", true)
	sp:SetAttribute("MotDorr", "stall N dorrgul")
	sp:SetAttribute("AvstandM", ANKOMST_UT)
	sp.Parent = model
end

local function byggDorrmarkorer(model: Model, base: CFrame)
	for _, d in ipairs(G.dorrar) do
		local p = BK.box(model, base, "Dörr " .. d.id,
			d.pos[1] - 0.5, 0, d.pos[2] - 0.5, 1, 0.1, 1,
			Color3.fromRGB(240, 210, 90), Enum.Material.Neon)
		p.CanCollide = false
		p:SetAttribute("Mot", d.mot)
		p:SetAttribute("Text", d.text)
	end
end

--[[ ══ INSIDORNA ═════════════════════════════════════════════════════════

	Review 02: att datan finns i den generade modulen räcker inte om byggaren
	struntar i den. Fyra boxrader och två gångar ska gå att SE i Roblox, inte
	bara stå i en tabell.

	Det som byggs är Gate F01:s STRUKTUR — planformen, gångarna, tvärkorridoren,
	de namngivna rummen, ridbanan, läktaren. Inte möblering: ingen spånremsa,
	inga namnskyltar, inga hinder. Det är rendering och hör inte till en
	fidelity-gate.

	Interiörernas lokalkoordinater sitter i husets sydvästra hörn. Offseten
	kommer ur exporten (G.stall.origo) och räknas inte om här. ]]

local INRE = {
	golv    = Color3.fromRGB(140, 136, 128),
	gang    = Color3.fromRGB(154, 150, 142),
	vagg    = Color3.fromRGB(207, 200, 188),
	box     = Color3.fromRGB(126, 96, 66),
	front   = Color3.fromRGB(150, 150, 155),
	sand    = Color3.fromRGB(206, 186, 148),
	sarg    = Color3.fromRGB(228, 226, 218),
	laktare = Color3.fromRGB(112, 84, 60),
	glas    = Color3.fromRGB(170, 205, 225),
	rum     = Color3.fromRGB(186, 180, 170),
}

--[[ Väggar och rum ur ett planblock (stallets klubbdel, ridhusets entrédel).

	Blocket är samma tabell som webben kolliderar mot (STALLINNE.klubb,
	RIDHUSINNE.entrehall i src/site.js): väggar som segment med planens
	öppningar, rum som gångbara rektanglar. Bitarna mellan öppningarna kommer
	ur Geometri.vaggBitar — samma regel som src/world.js klubbVaggBitar — så
	att en dörr som finns i spelet finns i Roblox och en som saknas saknas på
	båda ställena.

	Rum som är `stangt` (inget läsbart dörrhål på planen) byggs som hela,
	halvgenomskinliga volymer: man ska se att de finns men inte gå in.
	Namngivna gångbara rum får en tunn, okolliderande etikettplatta med
	namnet som attribut, så att Studio kan visa vad som är vad utan att
	något solitt tillkommer. Rum med tom etikett (`label = ""`) är avsiktligt
	namnlösa — funktion REFERENCE GAP — och får ingen platta alls; webben
	ritar heller ingen text för dem. Tom sträng är sann i Luau, därför
	prövas längden uttryckligen. ]]
--[[ Spatial Canon v2 — provenance på varje vägg/glas/sluten volym i de
	omtvistade ytorna: Primitiv (WALL/GLASS), CanonId, SourceId, Confidence.
	Samma fält som webben läser ur src/site.js; bygge.spec kräver att de
	finns (SCV2-02) och att de matchar datan (SCV2-05). ]]
local function kanonAttribut(p, v)
	if v.primitiv then p:SetAttribute("Primitiv", v.primitiv) end
	if v.canon_id then p:SetAttribute("CanonId", v.canon_id) end
	if v.source_id then p:SetAttribute("SourceId", v.source_id) end
	if v.confidence then p:SetAttribute("Confidence", v.confidence) end
end

local function byggVaggarOchRum(model: Model, base: CFrame, o, h: number, K, prefix: string, farg: Color3)
	for _, v in ipairs(K.vaggar) do
		local t = v.tjock or 0.16
		local mat = if v.brand then Enum.Material.Concrete else Enum.Material.Plaster
		for j, bit in ipairs(GEO.vaggBitar(v)) do
			local namn = prefix .. " " .. v.id .. ":" .. j
			--[[ Spatial Canon v2: GLASS är en låg bröstning med en glasruta
			     över; WALL är hel. Båda bär provenance-attributen. ]]
			local glas = v.primitiv == "GLASS"
			local bh = if glas then (v.brostning or 0.95) else h
			local p
			if v.typ == "tvar" then
				p = BK.box(model, base, namn,
					o.x + bit.a0, 0, o.y + v.y - t / 2, bit.a1 - bit.a0, bh, t, farg, mat)
			else
				p = BK.box(model, base, namn,
					o.x + v.x - t / 2, 0, o.y + bit.a0, t, bh, bit.a1 - bit.a0, farg, mat)
			end
			--[[ Inomhusläsbarhet: klientens Genomsikt tonar den här biten när
			     den står mellan kameran och karaktären. Samma regel som webben. ]]
			p:SetAttribute("Genomsiktlig", true)
			kanonAttribut(p, v)
			if glas then
				local g
				if v.typ == "tvar" then
					g = BK.box(model, base, namn .. " glas",
						o.x + bit.a0, bh, o.y + v.y - 0.02, bit.a1 - bit.a0, h - bh, 0.04,
						Color3.fromRGB(191, 211, 220), Enum.Material.Glass)
				else
					g = BK.box(model, base, namn .. " glas",
						o.x + v.x - 0.02, bh, o.y + bit.a0, 0.04, h - bh, bit.a1 - bit.a0,
						Color3.fromRGB(191, 211, 220), Enum.Material.Glass)
				end
				g.Transparency = 0.55
				-- glaset tonas som en väggbit när det står mellan kamera och karaktär
				g:SetAttribute("Genomsiktlig", true)
				kanonAttribut(g, v)
				--[[ Avställningshyllan ovanpå disken mot gången och vita
					karmposter som delar glaset i rutor (ridhus-klubb-02). ]]
				if v.hylla then
					local V = Color3.fromRGB(238, 238, 232)
					local function gs(q) q.CanCollide = false; q:SetAttribute("Genomsiktlig", true); return q end
					local L2 = bit.a1 - bit.a0
					local n = math.max(1, math.floor(L2 / 0.85 + 0.5))
					if v.typ == "tvar" then
						gs(BK.box(model, base, "Glasdisk " .. v.id .. " hylla", o.x + bit.a0, bh, o.y + v.y - t / 2, L2, 0.05, v.hylla + t,
							Color3.fromRGB(242, 240, 234), Enum.Material.SmoothPlastic))
						for i = 0, n do
							local a = math.clamp(bit.a0 + L2 * i / n, bit.a0 + 0.04, bit.a1 - 0.04)
							gs(BK.box(model, base, "Glasdisk " .. v.id .. " karmpost", o.x + a - 0.04, bh, o.y + v.y - t / 2 - 0.01, 0.08, h - bh, t + 0.02, V, Enum.Material.SmoothPlastic))
						end
						gs(BK.box(model, base, "Glasdisk " .. v.id .. " karmöverstycke", o.x + bit.a0, h - 0.08, o.y + v.y - t / 2 - 0.01, L2, 0.08, t + 0.02, V, Enum.Material.SmoothPlastic))
					else
						gs(BK.box(model, base, "Glasdisk " .. v.id .. " hylla", o.x + v.x - t / 2, bh, o.y + bit.a0, v.hylla + t, 0.05, L2,
							Color3.fromRGB(242, 240, 234), Enum.Material.SmoothPlastic))
						for i = 0, n do
							local a = math.clamp(bit.a0 + L2 * i / n, bit.a0 + 0.04, bit.a1 - 0.04)
							gs(BK.box(model, base, "Glasdisk " .. v.id .. " karmpost", o.x + v.x - t / 2 - 0.01, bh, o.y + a - 0.04, t + 0.02, h - bh, 0.08, V, Enum.Material.SmoothPlastic))
						end
						gs(BK.box(model, base, "Glasdisk " .. v.id .. " karmöverstycke", o.x + v.x - t / 2 - 0.01, h - 0.08, o.y + bit.a0, t + 0.02, 0.08, L2, V, Enum.Material.SmoothPlastic))
					end
				end
			end
		end
		--[[ DÖRRARNA (PO 2026-09-04 07:54, blocker 4): varje öppning får ett
			ÖVERSTYCKE (vägg ovanför dörrhöjden) och en vit KARM med mörk smyg
			och tröskel — ridhus-klubb-03/-19, stall-inne-03. Dörrhöjd 2,1 m om
			öppningen inte anger `h`. Samma regel som webbens v3dVaggarOchRum. ]]
		for _, op in ipairs(v.oppningar or {}) do
			local q0 = if v.typ == "tvar" then op.x0 else op.y0
			local q1 = if v.typ == "tvar" then op.x1 else op.y1
			local dh = op.h or 2.1
			if q1 - q0 >= 0.3 and dh < h - 0.05 then
				local Lo, mo = q1 - q0, (q0 + q1) / 2
				local K1, K2 = Color3.fromRGB(238, 238, 232), Color3.fromRGB(140, 135, 123)
				local tj, dj = 0.10, t + 0.06
				local namnO = "Dörrkarm " .. v.id .. " " .. (op.id or "")
				local function del(suffix, x, y, z, w, hh, d, farg, kollid)
					local q = BK.box(model, base, namnO .. suffix, x, y, z, w, hh, d, farg, Enum.Material.SmoothPlastic)
					q.CanCollide = kollid == true
					q:SetAttribute("Genomsiktlig", true)
					kanonAttribut(q, v)
					return q
				end
				if v.typ == "tvar" then
					local ov = BK.box(model, base, "Överstycke " .. v.id .. " " .. (op.id or ""), o.x + q0, dh, o.y + v.y - t / 2, Lo, h - dh, t, farg, mat)
					ov:SetAttribute("Genomsiktlig", true); kanonAttribut(ov, v)
					del(" foder V", o.x + q0 - tj, 0, o.y + v.y - dj / 2, tj, dh + tj, dj, K1)
					del(" foder H", o.x + q1, 0, o.y + v.y - dj / 2, tj, dh + tj, dj, K1)
					del(" foder topp", o.x + q0 - tj, dh, o.y + v.y - dj / 2, Lo + 2 * tj, tj, dj, K1)
					del(" smyg V", o.x + q0, 0, o.y + v.y - (t - 0.01) / 2, 0.03, dh, t - 0.01, K2)
					del(" smyg H", o.x + q1 - 0.03, 0, o.y + v.y - (t - 0.01) / 2, 0.03, dh, t - 0.01, K2)
					del(" smyg topp", o.x + q0, dh - 0.03, o.y + v.y - (t - 0.01) / 2, Lo, 0.03, t - 0.01, K2)
					del(" tröskel", o.x + q0, 0, o.y + v.y - dj / 2, Lo, 0.02, dj, Color3.fromRGB(90, 86, 80))
				else
					local ov = BK.box(model, base, "Överstycke " .. v.id .. " " .. (op.id or ""), o.x + v.x - t / 2, dh, o.y + q0, t, h - dh, Lo, farg, mat)
					ov:SetAttribute("Genomsiktlig", true); kanonAttribut(ov, v)
					del(" foder V", o.x + v.x - dj / 2, 0, o.y + q0 - tj, dj, dh + tj, tj, K1)
					del(" foder H", o.x + v.x - dj / 2, 0, o.y + q1, dj, dh + tj, tj, K1)
					del(" foder topp", o.x + v.x - dj / 2, dh, o.y + q0 - tj, dj, tj, Lo + 2 * tj, K1)
					del(" smyg V", o.x + v.x - (t - 0.01) / 2, 0, o.y + q0, t - 0.01, dh, 0.03, K2)
					del(" smyg H", o.x + v.x - (t - 0.01) / 2, 0, o.y + q1 - 0.03, t - 0.01, dh, 0.03, K2)
					del(" smyg topp", o.x + v.x - (t - 0.01) / 2, dh - 0.03, o.y + q0, t - 0.01, 0.03, Lo, K2)
					del(" tröskel", o.x + v.x - dj / 2, 0, o.y + q0, dj, 0.02, Lo, Color3.fromRGB(90, 86, 80))
				end
			end
		end
	end
	for _, r in ipairs(K.rum or {}) do
		local q = r.rekt
		if r.stangt then
			local p = BK.box(model, base, "Slutet rum " .. r.id,
				o.x + q.x, 0, o.y + q.y, q.w, h * 0.9, q.h, INRE.rum, Enum.Material.Plaster)
			p.Transparency = 0.45
			p:SetAttribute("Rum", r.id)
			p:SetAttribute("Genomsiktlig", true)
			kanonAttribut(p, r)
		elseif r.label ~= nil and r.label ~= "" then
			local p = BK.box(model, base, "Rumsetikett " .. r.label,
				o.x + q.x, 0.03, o.y + q.y, q.w, 0.02, q.h, INRE.rum, Enum.Material.SmoothPlastic)
			p.CanCollide = false
			p.Transparency = 0.6
			p:SetAttribute("Rum", r.id)
			p:SetAttribute("Text", r.label)
		end
	end
end

--[[ INREDNINGEN (F02-B) ur G.inredning — samma lista som webben ritar och
	kolliderar mot (src/inredning.js). Varje post bär källa och klass, och
	de följer med som attribut så att Studio kan visa varifrån en soffa
	kommer. Byggt som lådor i objektets färg plus det som gör typen
	igenkännbar; renderingen får vara enklare än webbens, men VAR något
	står och hur stort det är är samma tal. Allt i listan är axelparallellt
	(rikt i kvartsvarv), så BK.box räcker. ]]
local function byggInredning(model: Model, base: CFrame, o, lista, prefix: string)
	for _, ob in ipairs(lista or {}) do
		local q = GEO.inredningRekt(ob)
		local z0 = ob.z0 or 0
		local namn = prefix .. " " .. ob.id
		-- Hög, opak inredning skymmer figuren som en vägg: Genomsiktlig (tonas
		-- av Genomsikt på klienten) — samma regel som webbens inredningHog.
		local hog = not (ob.typ == "lysror" or ob.typ == "exitskylt" or ob.typ == "ventkanal" or ob.typ == "spegel")
			and (z0 + ob.matt.h) >= 1.4 and ob.matt.d >= 0.3
		local function del(suffix: string, x, y, z, w, h, d, farg, mat, kollid: boolean?)
			local p = BK.box(model, base, namn .. suffix, x, y, z, w, h, d, farg, mat)
			p.CanCollide = if kollid == nil then (ob.kolliderar == true) else kollid
			if hog then p:SetAttribute("Genomsiktlig", true) end
			p:SetAttribute("Inredning", ob.id)
			p:SetAttribute("Rum", ob.rum)
			p:SetAttribute("Klass", ob.klass)
			p:SetAttribute("Kalla", ob.kalla)
            if ob.ytmaterial then p:SetAttribute("Ytmaterial", ob.ytmaterial) end
            return p
		end
		local f, f2 = ob.farg, ob.farg2 or Color3.fromRGB(107, 107, 107)
        local ytmaterial = if ob.ytmaterial == "Leather" then Enum.Material.SmoothPlastic else Enum.Material.Fabric
		local X, Y, W, H = o.x + q.x, o.y + q.y, q.w, q.h
		local typ = ob.typ
		if typ == "soffa" or typ == "fatolj" then
			del("", X, z0, Y, W, 0.42, H, f, ytmaterial)
			-- ryggen ligger på baksidan: motsatt `rikt`
			local dx = -math.cos(ob.rikt) * (q.w / 2 - 0.11) * (if math.abs(math.cos(ob.rikt)) > 0.5 then 1 else 0)
			local dy = -math.sin(ob.rikt) * (q.h / 2 - 0.11) * (if math.abs(math.sin(ob.rikt)) > 0.5 then 1 else 0)
			local rw = if math.abs(math.cos(ob.rikt)) > 0.5 then 0.22 else W
			local rh = if math.abs(math.cos(ob.rikt)) > 0.5 then H else 0.22
			del(" rygg", X + W / 2 + dx - rw / 2, z0 + 0.42, Y + H / 2 + dy - rh / 2, rw, ob.matt.h - 0.42, rh, f, ytmaterial)
		elseif typ == "bord" then
			local tj = if ob.detaljer then ob.detaljer.skivaTjocklek or 0.05 else 0.05
			del(" skiva", X, z0 + ob.matt.h - tj, Y, W, tj, H, f, Enum.Material.Wood)
			for _, bx in ipairs({ X + 0.045, X + W - 0.09 }) do
				for _, by in ipairs({ Y + 0.045, Y + H - 0.09 }) do
					del(" ben", bx, z0, by, 0.045, ob.matt.h - tj, 0.045, f2, Enum.Material.Wood, false)
				end
			end
		elseif typ == "stol" then
			del(" sits", X, z0 + 0.45, Y, W, 0.05, H, f, Enum.Material.SmoothPlastic)
			for _, bx in ipairs({ X + 0.02, X + W - 0.055 }) do
				for _, by in ipairs({ Y + 0.02, Y + H - 0.055 }) do
					del(" ben", bx, z0, by, 0.035, 0.45, 0.035, f2, Enum.Material.Wood, false)
				end
			end
			del(" rygg ram vänster", X + 0.02, z0 + 0.45, Y + 0.015, 0.045, ob.matt.h - 0.45, 0.045, f2, Enum.Material.Wood, false)
			del(" rygg ram höger", X + W - 0.065, z0 + 0.45, Y + 0.015, 0.045, ob.matt.h - 0.45, 0.045, f2, Enum.Material.Wood, false)
			for i = 1, ((ob.detaljer and ob.detaljer.ryggSpjalor) or 2) do
				del(" rygg spjäla " .. i, X + W * 0.14, z0 + 0.49 + (ob.matt.h - 0.54) * i / 3, Y + 0.015,
					W * 0.72, 0.035, 0.04, f, Enum.Material.SmoothPlastic, false)
			end
		elseif typ == "ponny" then
			del(" kropp", X + W / 2 - 0.21, z0 + 0.8, Y + H / 2 - 0.5, 0.42, 0.45, 1.0, f, Enum.Material.SmoothPlastic)
			del(" hals", X + W / 2 - 0.10, z0 + 1.0, Y + H / 2 + 0.35, 0.20, 0.55, 0.32, f, Enum.Material.SmoothPlastic)
			del(" sadel", X + W / 2 - 0.20, z0 + 1.25, Y + H / 2 - 0.25, 0.40, 0.12, 0.42, f2, Enum.Material.Fabric, false)
			del(" ben", X + W / 2 - 0.04, z0, Y + H / 2 - 0.04, 0.08, 0.8, 0.08, f, Enum.Material.SmoothPlastic, false)
		elseif typ == "klocka" then
			del("", X, z0, Y, W, ob.matt.h, H, f, Enum.Material.SmoothPlastic, false)
		elseif typ == "vaxt" then
			del(" kruka", X + W / 2 - 0.2, z0, Y + H / 2 - 0.2, 0.4, 0.35, 0.4, f2, Enum.Material.SmoothPlastic)
			del(" krona", X, z0 + ob.matt.h * 0.45, Y, W, ob.matt.h * 0.55, H, f, Enum.Material.Grass, false)
		elseif typ == "tavlor" then
			del("", X, z0, Y, W, ob.matt.h, H, f,
				Enum.Material.SmoothPlastic, false)
			local D = ob.detaljer or {}
			local langsX = math.abs(math.sin(ob.rikt)) > 0.5
			local front = if langsX
				then Y + (if math.sin(ob.rikt) > 0 then H else -0.015)
				else X + (if math.cos(ob.rikt) > 0 then W else -0.015)
			local function mark(suffix, u, low, ww, hh, color)
				if langsX then
					del(suffix, X + u, z0 + low, front, ww, hh, 0.015, color, Enum.Material.SmoothPlastic, false)
				else
					del(suffix, front, z0 + low, Y + u, 0.015, hh, ww, color, Enum.Material.SmoothPlastic, false)
				end
			end
			local langd = if langsX then W else H
			mark(" bildyta", langd * 0.08, ob.matt.h * 0.08, langd * 0.84, ob.matt.h * 0.84, f2)
			if D.motiv == "hastanatomi" then
				-- Grafiska anatomilager utan ord eller uppfunna etiketter.
				local a = if D.variant == 2 then Color3.fromRGB(140, 110, 90) else Color3.fromRGB(168, 111, 104)
				mark(" anatomi kropp", langd * 0.31, ob.matt.h * 0.48, langd * 0.34, ob.matt.h * 0.16, a)
				mark(" anatomi hals", langd * 0.62, ob.matt.h * 0.55, langd * 0.12, ob.matt.h * 0.13, a)
				mark(" anatomi huvud", langd * 0.76, ob.matt.h * 0.57, langd * 0.10, ob.matt.h * 0.07, a)
				mark(" anatomi svans", langd * 0.19, ob.matt.h * 0.50, langd * 0.13, ob.matt.h * 0.035, a)
				mark(" anatomi ben 1", langd * 0.38, ob.matt.h * 0.24, langd * 0.035, ob.matt.h * 0.25, a)
				mark(" anatomi ben 2", langd * 0.60, ob.matt.h * 0.24, langd * 0.035, ob.matt.h * 0.25, a)
				for i = 0, 3 do
					mark(" anatomi lager " .. i, langd * (0.28 + i * 0.15), ob.matt.h * 0.485,
						langd * 0.018, ob.matt.h * 0.13, Color3.fromRGB(210, 184, 168))
				end
			end
		elseif typ == "whiteboard" then
			del("", X, z0, Y, W, ob.matt.h, H, Color3.fromRGB(185, 189, 192), Enum.Material.Metal, false)
			local langsX = math.abs(math.sin(ob.rikt)) > 0.5
			local front = if langsX
				then Y + (if math.sin(ob.rikt) > 0 then H else -0.015)
				else X + (if math.cos(ob.rikt) > 0 then W else -0.015)
			if langsX then
				del(" skrivyta", X + 0.03, z0 + 0.03, front, W - 0.06, ob.matt.h - 0.06, 0.015, f, Enum.Material.SmoothPlastic, false)
				if ob.detaljer and ob.detaljer.hylla then
					del(" pennhylla", X + W * 0.04, z0 - 0.04, front, W * 0.92, 0.035, 0.08, Color3.fromRGB(174, 179, 181), Enum.Material.Metal, false)
				end
			else
				del(" skrivyta", front, z0 + 0.03, Y + 0.03, 0.015, ob.matt.h - 0.06, H - 0.06, f, Enum.Material.SmoothPlastic, false)
				if ob.detaljer and ob.detaljer.hylla then
					del(" pennhylla", front, z0 - 0.04, Y + H * 0.04, 0.08, 0.035, H * 0.92, Color3.fromRGB(174, 179, 181), Enum.Material.Metal, false)
				end
			end
			if ob.detaljer and ob.detaljer.arbetsmarken then
				local ink = if ob.detaljer.variant == 2 then Color3.fromRGB(101, 112, 90) else Color3.fromRGB(80, 106, 112)
				local langd = if langsX then W else H
				for i = 0, 5 do
					local ww = langd * (0.13 + ((i * 3 + (ob.detaljer.variant or 1)) % 5) * 0.055)
					local u = langd * 0.16 + (i % 2) * langd * 0.22
					if langsX then
						del(" arbetsmarkering " .. i, X + u, z0 + ob.matt.h * (0.18 + i * 0.105), front,
							ww, 0.018, 0.008, ink, Enum.Material.SmoothPlastic, false)
					else
						del(" arbetsmarkering " .. i, front, z0 + ob.matt.h * (0.18 + i * 0.105), Y + u,
							0.008, 0.018, ww, ink, Enum.Material.SmoothPlastic, false)
					end
				end
			end
		elseif typ == "exitskylt" then
			del("", X, z0, Y, W, ob.matt.h, H, f, Enum.Material.Neon, false)
		elseif typ == "lysror" then
			local D = ob.detaljer or {}
			if D.holje then del(" hölje", X, z0 + ob.matt.h * 0.3, Y, W, ob.matt.h * 0.7, H, Color3.fromRGB(216, 216, 211), Enum.Material.Metal, false) end
			del(" ljusyta", X + W * 0.06, z0, Y + H * 0.19, W * 0.88, ob.matt.h * 0.45, H * 0.62, f, Enum.Material.Neon, false)
			if D.upphangd then
				for _, u in ipairs({ 0.16, 0.82 }) do
					del(" vajer", X + W * u, z0 - 0.16, Y + H / 2 - 0.009, 0.018, 0.22, 0.018, Color3.fromRGB(119, 122, 123), Enum.Material.Metal, false)
				end
			end
		elseif typ == "dorr" then
			-- stängt dörrblad med karm, fönster och handtag PÅ en vägg (ingen passage)
			del(" karm", X - 0.10, 0, Y - 0.01, W + 0.20, ob.matt.h + 0.10, H + 0.02, Color3.fromRGB(238, 238, 232), Enum.Material.SmoothPlastic, false)
			del(" blad", X, 0, Y, W, ob.matt.h, H, f, Enum.Material.Metal, false)
			local g = del(" fönster", X + W * 0.29, ob.matt.h * 0.58, Y - 0.01, W * 0.42, ob.matt.h * 0.24, H + 0.02, f2, Enum.Material.Glass, false)
			g.Transparency = 0.4
		elseif typ == "spegel" then
			del(" ram", X, z0 - 0.06, Y, W, ob.matt.h + 0.12, H, f, Enum.Material.Wood, false)
			local gp = del(" glas", X, z0, Y, W, ob.matt.h, H, Color3.fromRGB(159, 179, 196), Enum.Material.Glass, false)
			gp.Reflectance = 0.6
		elseif typ == "ventkanal" then
			del("", X, z0, Y, W, ob.matt.h, H, f, Enum.Material.Metal, false)
			local D = ob.detaljer or {}
			if D.perforerad then
				local langsX = math.abs(math.sin(ob.rikt)) > 0.5
				local front = if langsX
					then Y + (if math.sin(ob.rikt) > 0 then H else -0.01)
					else X + (if math.cos(ob.rikt) > 0 then W else -0.01)
				local langd = if langsX then W else H
				for rad = 0, (D.halrader or 1) - 1 do
					for i = 0, 13 do
						local u = langd * (i + 0.5 + (rad % 2) * 0.25) / 14
						if langsX then
							del(" perforering", X + u, z0 + 0.055 + rad * 0.075, front, 0.045, 0.045, 0.01, Color3.fromRGB(95, 98, 100), Enum.Material.Metal, false)
						else
							del(" perforering", front, z0 + 0.055 + rad * 0.075, Y + u, 0.01, 0.045, 0.045, Color3.fromRGB(95, 98, 100), Enum.Material.Metal, false)
						end
					end
				end
			end
		elseif typ == "krokrad" then
			del(" skena", X, z0 + ob.matt.h - 0.05, Y, W, 0.05, H, f, Enum.Material.Metal, false)
			del(" vastar", X, z0, Y, W, ob.matt.h - 0.15, H, f2, Enum.Material.Fabric, false)
		elseif typ == "skapbank" then
			-- `vaningar` = luckor i två våningar (ridhus-klubb-16/-20), `ben` = kroppen på svarta ben (-20/-21).
			-- Ventilation byggs bara som familjens separata över-/sockelband, aldrig som ett gemensamt hålmönster.
			local ben = ob.ben or 0
			local kh = ob.matt.h - ben
			local v = ob.vaningar or 1
			del("", X, z0 + ben, Y, W, kh, H, f, Enum.Material.Metal)
			if ben > 0 then
				for _, bx in ipairs({ X + 0.03, X + W - 0.08 }) do
					for _, by in ipairs({ Y + 0.03, Y + H - 0.08 }) do
						del(" ben", bx, z0, by, 0.05, ben, 0.05, Color3.fromRGB(30, 30, 30), Enum.Material.Metal, false)
					end
				end
			end
			local D = ob.detaljer or {}
			local fargor = ob.fargor or { f }
			local n = D.kolumner or math.max(1, math.round(ob.matt.b / 0.4))
			local dh = (kh - 0.16) / v
			local langsX = math.abs(math.sin(ob.rikt)) > 0.5
			local fx = if math.cos(ob.rikt) > 0 then X + W else X - 0.01
			local fy = if math.sin(ob.rikt) > 0 then Y + H else Y - 0.01
			local langd = if langsX then W else H
			local w = langd / n
			-- u = längs fronten, inte världens X. Därmed fungerar samma
			-- beskrivning på båda sidor av gången och för alla fyra riktningar.
			local function front(suffix, u, low, ww, hh, dj, c, material)
				if langsX then
					return del(suffix, X + u, low, fy, ww, hh, dj, c, material, false)
				else
					return del(suffix, fx, low, Y + u, dj, hh, ww, c, material, false)
				end
			end
			for i = 0, n - 1 do
				local c = fargor[(i % #fargor) + 1]
				for j = 0, v - 1 do
					local zy = z0 + ben + 0.1 + j * dh
					local namn = " dorr " .. (i + 1) .. (if v > 1 then "-" .. (j + 1) else "")
					local u = i * w + 0.01
					front(namn, u, zy, w - 0.02, dh - 0.02, 0.01, c, Enum.Material.Metal)
					if D.ram then
						local rc = D.ramfarg or f
						for _, side in ipairs({ 0.002, w - 0.020 }) do
							front(namn .. " ram sida", u + side, zy, 0.018, dh, 0.018, rc, Enum.Material.Metal)
						end
						for _, low in ipairs({ zy, zy + dh - 0.018 }) do
							front(namn .. " ram tvär", u, low, w, 0.018, 0.018, rc, Enum.Material.Metal)
						end
					end
					if D.profil then
						local line = Color3.fromRGB(68, 73, 74)
						front(namn .. " profil neder", u + 0.015, zy + 0.04, w - 0.05, 0.008, 0.015, line, Enum.Material.Metal)
						for _, side in ipairs({ 0.016, w - 0.044 }) do
							front(namn .. " profil sida", u + side, zy + 0.045, 0.008, dh - 0.09, 0.015, line, Enum.Material.Metal)
						end
					end
					if D.beslag then
						front(namn .. " las", u + w * 0.75, zy + dh * 0.55, 0.055, 0.09, 0.025, Color3.fromRGB(142, 147, 149), Enum.Material.Metal)
						front(namn .. " nyckelhal", u + w * 0.765, zy + dh * 0.58, 0.018, 0.025, 0.03, Color3.fromRGB(52, 56, 59), Enum.Material.Metal)
						front(namn .. " nummerskylt", u + w * 0.13, zy + dh * 0.88, 0.035, 0.012, 0.02, Color3.fromRGB(217, 216, 209), Enum.Material.SmoothPlastic)
					end
					if D.ventilation then
						for k = 0, 2 do
							front(namn .. " ventilation " .. k, u + w * 0.285, zy + 0.035 + k * 0.025,
								w * 0.43, 0.008, 0.02, Color3.fromRGB(77, 81, 82), Enum.Material.Metal)
						end
					end
				end
			end
			if D.overkantVent then
				local hal = math.max(8, n * 4)
				for k = 0, hal - 1 do
					front(" overkantvent " .. k, langd * (0.04 + 0.92 * k / (hal - 1)),
						z0 + kh - 0.035, 0.018, 0.012, 0.022, Color3.fromRGB(77, 81, 82), Enum.Material.Metal)
				end
			end
			if D.sockelVent then
				local hal = math.max(8, n * 4)
				for k = 0, hal - 1 do
					front(" sockelvent " .. k, langd * (0.04 + 0.92 * k / (hal - 1)),
						z0 + ben + 0.025, 0.018, 0.012, 0.022, Color3.fromRGB(77, 81, 82), Enum.Material.Metal)
				end
			end
		elseif typ == "bommar" then
			local fargor = ob.fargor or { f }
			local n = ob.antal or 5
			for i = 0, n - 1 do
				local c = fargor[(i % #fargor) + 1]
				if math.abs(math.cos(ob.rikt)) > 0.5 then
					del(" bom " .. (i + 1), X + W / 2 - 0.04, z0, Y + (H / n) * (i + 0.5) - 0.04, 0.08, 1.9, 0.08, c, Enum.Material.SmoothPlastic, false)
				else
					del(" bom " .. (i + 1), X + (W / n) * (i + 0.5) - 0.04, z0, Y + H / 2 - 0.04, 0.08, 1.9, 0.08, c, Enum.Material.SmoothPlastic, false)
				end
			end
		elseif typ == "hinderstod" then
			local n = ob.antal or 3
			for i = 0, n - 1 do
				del(" stod " .. (i + 1), X + (W / n) * (i + 0.5) - 0.05, z0, Y + H / 2 - 0.05, 0.10, ob.matt.h, 0.10, f, Enum.Material.SmoothPlastic, false)
			end
		elseif typ == "bokstavsstall" then
			del(" hylla", X, z0 + 0.6, Y, W, 0.04, H, Color3.fromRGB(169, 143, 104), Enum.Material.Wood, false)
			del(" bokstaver", X, z0 + 0.64, Y, W, 0.28, H, f, Enum.Material.SmoothPlastic, false)
		elseif typ == "tunna" then
			del("", X, z0, Y, W, ob.matt.h, H, f, Enum.Material.Metal)
			del(" band", X - 0.005, z0 + ob.matt.h * 0.55, Y - 0.005, W + 0.01, 0.12, H + 0.01, f2, Enum.Material.SmoothPlastic, false)
		-- Zonen efter pausrummet (PO-referens stall-efter-pausrum-po-v1): samma tecknare som webben.
		elseif typ == "ror" then
			del("", X, z0, Y, W, ob.matt.h, H, f, Enum.Material.Metal, false)
		elseif typ == "brandslackare" then
			del("", X, z0, Y, W, ob.matt.h * 0.78, H, f, Enum.Material.Metal, false)
			del(" topp", X + W * 0.28, z0 + ob.matt.h * 0.78, Y + H * 0.28, W * 0.44, ob.matt.h * 0.22, H * 0.44, Color3.fromRGB(30, 30, 30), Enum.Material.Metal, false)
		elseif typ == "vask" then
			del("", X, z0, Y, W, ob.matt.h * 0.85, H, f, Enum.Material.Metal)
			del(" bänk", X, z0 + ob.matt.h * 0.85, Y, W, 0.05, H, f2, Enum.Material.Metal, false)
			del(" ho", X + W * 0.2, z0 + ob.matt.h * 0.85 + 0.05, Y + H * 0.2, W * 0.6, 0.02, H * 0.55, Color3.fromRGB(110, 114, 117), Enum.Material.Metal, false)
			if math.abs(math.cos(ob.rikt)) > 0.5 then
				del(" kran", X + (if math.cos(ob.rikt) > 0 then 0.06 else W - 0.10), z0 + ob.matt.h * 0.9, Y + H / 2 - 0.02, 0.04, 0.26, 0.04, f2, Enum.Material.Metal, false)
			else
				del(" kran", X + W / 2 - 0.02, z0 + ob.matt.h * 0.9, Y + (if math.sin(ob.rikt) > 0 then 0.06 else H - 0.10), 0.04, 0.26, 0.04, f2, Enum.Material.Metal, false)
			end
		elseif typ == "krokar" then
			del(" skena", X, z0 + ob.matt.h - 0.04, Y, W, 0.04, H, f, Enum.Material.Metal, false)
			del(" handduk", X + W * 0.6, z0, Y, 0.22, ob.matt.h - 0.12, H, f2, Enum.Material.Fabric, false)
		elseif typ == "racke" then
			local n = math.max(2, math.round(ob.matt.b / 1.3) + 1)
			local langs = math.abs(math.cos(ob.rikt)) > 0.5
			for i = 0, n - 1 do
				if langs then
					del(" stolpe " .. (i + 1), X + (W - 0.06) * i / (n - 1), z0, Y + H / 2 - 0.03, 0.06, ob.matt.h, 0.06, f, Enum.Material.Metal)
				else
					del(" stolpe " .. (i + 1), X + W / 2 - 0.03, z0, Y + (H - 0.06) * i / (n - 1), 0.06, ob.matt.h, 0.06, f, Enum.Material.Metal)
				end
			end
			for _, hz in ipairs({ ob.matt.h * 0.55, ob.matt.h * 0.96 }) do
				if langs then
					del(" regel", X, z0 + hz - 0.02, Y + H / 2 - 0.02, W, 0.04, 0.04, f2, Enum.Material.Metal, false)
				else
					del(" regel", X + W / 2 - 0.02, z0 + hz - 0.02, Y, 0.04, 0.04, H, f2, Enum.Material.Metal, false)
				end
			end
		else
			-- skap, kartong, bank, stovelhylla och allt annat: en låda i färgen
			del("", X, z0, Y, W, ob.matt.h, H, f,
				if typ == "stovelhylla" or typ == "skap" or typ == "bank" then Enum.Material.Wood else Enum.Material.SmoothPlastic)
		end
	end
end

--[[ Stallet: fyra boxrader, två gångar, tvärkorridor, namngivna rum.

	Raderna och gångarna kommer ur planens mätta andelar (G.stall.band), inte ur
	någon delning gjord här. Ändras STALLINNE.bredd i src/site.js flyttar sig
	allt med, på båda plattformarna samtidigt. ]]
local function byggStallInre(model: Model, base: CFrame)
	local S = G.stall
	local o = S.origo
	local h = S.tak

	-- F02-C: endast den befintliga klubbdelens golv. Samma källa och
	-- material som webben; inga nya rumsgränser eller kollisionsytor.
	do
		local Y = YTOR.stallKlubb
		local k = S.klubb
		local gp = BK.box(model, base, "Stallklubb matt golv", o.x, 0.02, o.y + k.y0,
			S.bredd, 0.004, S.langd - k.y0, Y.farg, Enum.Material.Concrete)
		gp.CanCollide = false
		gp:SetAttribute("Ytfinish", Y.typ)
		gp:SetAttribute("Kalla", Y.kalla)
		gp:SetAttribute("FargKlass", Y.fargKlass)
	end

	-- Gångytorna, inklusive tvärkorridoren. De ligger som eget golv så att man
	-- ser var man kan gå — det är cirkulationen gaten frågar efter.
	for i, g in ipairs(S.gangytor) do
		if g.tvar then
			-- Tvärkorridoren: ljus betong (bottenplattan) med gångarnas mörka stråk
			-- fortsatta fram till serviceväggen (PO-referens stall-efter-pausrum-po-v1).
			for id, gg in pairs(S.gangar) do
				local p = BK.box(model, base, "Stallgång " .. i .. " stråk " .. id,
					o.x + gg.x0, 0.02, o.y + S.klubbY, gg.x1 - gg.x0, 0.04, S.klubb.y0 - S.klubbY, S.gangSten,
					Enum.Material.Pavement)
				p.CanCollide = false
			end
		else
			local p = BK.box(model, base, "Stallgång " .. i,
				o.x + g.x, 0.02, o.y + g.y, g.w, 0.04, g.h, S.gangSten,
				Enum.Material.Pavement)
			p.CanCollide = false
		end
	end

	--[[ Boxraderna.

		SENIOR INTERIOR FIDELITY, rättad KNOWN MISMATCH: fronterna och
		mellanväggarna byggdes här i BRUNT TRÄ (rgb 126,96,66, WoodPlanks)
		medan fotona visar mörk antracitpanel i galvad stålram — och medan
		webben redan ritade dem grå. Det var två sanningar om samma yta, och
		den bruna fanns bara i den här filen. Färgerna är nu MÄTTA ur
		stall-inne-05 och stall-inne-06 och står i det delade
		G.identitet.stall.boxfront, som båda ytorna läser.

		Andra rättade felläsningen: gallret var en TÄT skiva i DiamondPlate.
		Fotona visar VÅGRÄTA runda reglar mellan lodräta ändstolpar, med
		luft emellan — man ser in i boxen. Höjderna (panel 1,35, kappregel
		1,38, stolpe 2,15, överliggare 2,20) kommer ur samma delade data och
		räknas inte om här.

		Facken kommer ur Geometri, som specen mäter. Räknar man ut dem här
		mäter specen inte längre det som byggs. ]]
	local BF = G.identitet.stall.boxfront
	for _, rad in ipairs(S.rader) do
		local x0 = o.x + rad.x0
		for i, f in ipairs(GEO.boxfack(S, rad)) do
			local namn = rad.id .. " " .. i
			-- Skiljeväggar i fackets båda ändar, i panelens ton och höjd.
			for _, par in ipairs({ { "", f.y0 }, { "b", f.y1 } }) do
				BK.box(model, base, "Boxvägg " .. namn .. par[1],
					x0, 0, o.y + par[2], rad.djup, BF.heldelH, 0.08,
					BF.heldel, Enum.Material.Metal)
			end
			-- Den täta panelen mot gången, och kappregeln ovanpå den.
			local fx = if rad.vetter > 0 then x0 + rad.djup - 0.06 else x0
			BK.box(model, base, "Boxfront " .. namn,
				fx, 0, o.y + f.y0 + 0.08, 0.06, BF.heldelH, S.boxB - 0.16,
				BF.heldel, Enum.Material.Metal)
			BK.box(model, base, "Kappregel " .. namn,
				fx - 0.02, BF.ramZ, o.y + f.y0 + 0.08, 0.10, 0.10, S.boxB - 0.16,
				BF.ram, Enum.Material.Metal)
			-- Ändstolparna, upp till överliggaren.
			for _, zy in ipairs({ f.y0 + 0.08, f.y1 - 0.08 }) do
				local st = BK.box(model, base, "Frontstolpe " .. namn,
					fx - 0.04, 0, o.y + zy - 0.07, 0.14, BF.stolpH, 0.14,
					BF.ram, Enum.Material.Metal)
				st.CanCollide = false
			end
			-- De vågräta reglarna, jämnt fördelade mellan kappregel och
			-- överliggare. Antalet står i datan, inte här.
			for g = 1, BF.reglar do
				local z = BF.ramZ + (BF.toppregelZ - BF.ramZ) * g / (BF.reglar + 1)
				local r = BK.box(model, base, "Frontregel " .. namn .. ":" .. g,
					fx - 0.01, z, o.y + f.y0 + 0.15, BF.regelD, BF.regelD,
					S.boxB - 0.30, BF.ram, Enum.Material.Metal)
				r.CanCollide = false
			end
			BK.box(model, base, "Överliggare " .. namn,
				fx - 0.04, BF.toppregelZ, o.y + f.y0 + 0.08, 0.14, 0.10,
				S.boxB - 0.16, BF.ram, Enum.Material.Metal)
		end
	end

	-- Tvärväggarna ur planen, i bitar med dörrgap där gångarna passerar. Den
	-- mot klubbdelen är en branddörrsvägg. En obruten vägg här stänger av
	-- stallgången — byggbänken fällde precis det.
	for i, v in ipairs(S.tvarvaggar) do
		for j, bit in ipairs(GEO.tvarvaggBitar(S, v)) do
			BK.box(model, base, "Tvärvägg " .. i .. ":" .. j,
				o.x + bit.x0, 0, o.y + v.y, bit.x1 - bit.x0, h, 0.2, INRE.vagg,
				if v.brand then Enum.Material.Concrete else Enum.Material.Plaster)
		end
	end

	--[[ KLUBBDELEN ur utrymningsplanen, rättad av Product Owner 2026-09-03.

		Förut tre svävande lådor med rumsnamn i en öppen hall. Nu planens
		väggar, segment för segment med dörrarna som luckor, ur samma lista
		som webben kolliderar mot. Rummen är golv man går på; bara de som är
		`stangt` (den namnlösa volymen, Ö-toaletten, det lilla rummet utan
		läsbar dörr) byggs som hela volymer. Rumsnamnen står som attribut på
		en tunn golvplatta så att Studio kan visa vad som är vad utan att
		något solitt tillkommer. ]]
	byggVaggarOchRum(model, base, o, h, S.klubb, "Klubbvägg", INRE.vagg)
	--[[ KLUBBDELENS INNERTAK (PO/ChatGPT 2026-09-04 08:50, blocker A):
		stall-inne-01/-02/-03/-04 visar ett platt vitt innertak — plattan på
		klubbväggarnas höjd över hela klubbdelen norr om den genomgående
		väggen. Genomsiktlig så att den tonas om kameran hamnar över den. ]]
	do
		local gy = nil
		for _, v in ipairs(S.klubb.vaggar) do if v.id == "genomgaende" then gy = v.y end end
		gy = gy or S.klubbY
		local tak = BK.box(model, base, "Klubbdelens innertak", o.x, 2.8, o.y + gy, S.bredd, 0.10, S.langd - gy,
			Color3.fromRGB(244, 242, 236), Enum.Material.SmoothPlastic)
		tak.CanCollide = false
		tak:SetAttribute("Genomsiktlig", true)
	end

	--[[ Taket över boxhallen: limträstomme och galvad plåt.

		Det som avgör om någon känner igen stallgången inifrån är inte
		golvet utan TAKET — de varma limträbalkarna mot den grå korrugerade
		plåten, i varje bildruta av gången. Roblox byggde ingenting av det:
		gableRoof lägger ett yttertak i fasadkortets kulör, och undersidan
		blev den kulören. Det var inte en utsmyckning som saknades, det var
		husets tydligaste inre drag.

		Färgerna är MÄTTA ur stall-inne-05 och stall-inne-06 och står i det
		delade G.identitet.stall.stallgang. Resningen står i
		G.stall.takresning — den låg som ett lokalt tal i webbens renderare
		och fanns därför inte här alls. ]]
	local SG = G.identitet.stall.stallgang
	local resn = S.takresning
	local halvB, langd = S.bredd / 2, S.langd
	local takL = math.sqrt(halvB * halvB + resn * resn)
	local takV = math.atan2(resn, halvB)
	local mx = o.x + halvB
	for _, sida in ipairs({ -1, 1 }) do
		local p = Instance.new("Part")
		p.Name = "Stalltak plåt"; p.Anchored = true; p.CanCollide = false
		p.Color = SG.takplat; p.Material = Enum.Material.Metal
		p.Size = Vector3.new(BK.M * takL, BK.M * 0.12, BK.M * langd)
		p.CFrame = base
			* CFrame.new(BK.M * (mx + sida * halvB / 2), BK.M * (h + resn / 2),
				BK.M * (o.y + langd / 2))
			* CFrame.Angles(0, 0, -sida * takV)
		p.Parent = model
	end
	-- Tvärbalkar var fjärde meter, plus nockbalken. Samma delning som webben.
	for z = 2, langd - 1, 4 do
		BK.box(model, base, "Limträbalk", o.x, h - 0.13, o.y + z - 0.11,
			S.bredd, 0.26, 0.22, SG.limtra, Enum.Material.Wood).CanCollide = false
		for _, sida in ipairs({ -1, 1 }) do
			local p = Instance.new("Part")
			p.Name = "Limträstag"; p.Anchored = true; p.CanCollide = false
			p.Color = SG.limtra; p.Material = Enum.Material.Wood
			p.Size = Vector3.new(BK.M * takL * 0.9, BK.M * 0.16, BK.M * 0.14)
			p.CFrame = base
				* CFrame.new(BK.M * (mx + sida * halvB * 0.45),
					BK.M * (h + resn * 0.45), BK.M * (o.y + z))
				* CFrame.Angles(0, 0, -sida * takV)
			p.Parent = model
		end
	end
	BK.box(model, base, "Nockbalk", mx - 0.10, h + resn - 0.20, o.y,
		0.20, 0.24, langd, SG.limtra, Enum.Material.Wood).CanCollide = false

	--[[ Pendelarmaturerna över de två gångarna.

		`KNOWN MISMATCH` som rättas här: webben har haft dem sedan Review 05,
		Roblox inte alls — och det är armaturerna som gör att undertaket läses
		som ljus galvplåt hela vägen upp i nocken i i05. Samma delning (4,5 m)
		och samma lägen som webben, ur S.gangar. Antal och typ är
		`[REFERENCE GAP]`; att de hänger i rad över gångarna är `VERIFIED`. ]]
	for z = 3, langd - 1, 4.5 do
		for _, g in ipairs({ S.gangar.A, S.gangar.B }) do
			local ax = o.x + (g.x0 + g.x1) / 2
			local upp = BK.box(model, base, "Armaturpendel",
				ax - 0.012, h - 0.16, o.y + z - 0.012, 0.024, 0.16, 0.024,
				Color3.fromRGB(142, 147, 155), Enum.Material.Metal)
			upp.CanCollide = false
			local lampa = BK.box(model, base, "Stallarmatur",
				ax - 0.20, h - 0.23, o.y + z - 0.20, 0.40, 0.09, 0.40,
				Color3.fromRGB(251, 246, 228), Enum.Material.Neon)
			lampa.CanCollide = false
		end
	end

	-- Klockan i gångens bortre ände. `VERIFIED` i två oberoende bildrutor
	-- (IMG_0160 och stall-inne-05) och byggd i webben sedan Review 05 —
	-- men inte här. Läget står i G.stall.klocka.
	if S.klocka then
		local K = S.klocka
		local ur = BK.box(model, base, "Stallklocka",
			o.x + K.x, K.z - K.r, o.y + K.y - K.r, 0.09, K.r * 2, K.r * 2,
			Color3.fromRGB(238, 236, 228), Enum.Material.SmoothPlastic)
		ur.CanCollide = false
	end

	-- Namngivna rum och servicedelar. Låga volymer med sitt namn som attribut —
	-- namnen är fidelity-fakta ur utrymningsplanen, inredningen är det inte.
	for _, lista in ipairs({ S.rum, S.service }) do
		for _, r in ipairs(lista) do
			if r.oppen then continue end
			local p = BK.box(model, base, r.label,
				o.x + r.rekt.x, 0, o.y + r.rekt.y, r.rekt.w, h * 0.9, r.rekt.h,
				INRE.rum, Enum.Material.Plaster)
			p.Transparency = 0.45
			p:SetAttribute("Rum", r.id)
			p:SetAttribute("Genomsiktlig", true)
		end
	end

	--[[ SERVICEBUKTARNA — samma rättelse som webben fick.

		`KNOWN MISMATCH`, underkänd i webbens spelarvy och lika fel här:
		spolspiltan och spånförrådet byggdes som slutna volymer. stall-inne-07
		och -09 visar öppna bukter — fristående galvade spolbommar, spånsäckar
		på pall, mörk antracitpanel mot ytterväggen och rörstråk längs den
		vita väggen. `oppen` i den delade datan avgör vilket som byggs, så
		ytorna inte kan glida isär igen.

		Panelen läser boxfronternas MÄTTA färg: i09 ger #4A4B44 mot
		fronternas #454A4F — samma produkt, olika ljus. ]]
	local mitt = S.bredd / 2
	for _, r in ipairs(S.service) do
		if not r.oppen then continue end
		local k = r.rekt
		local innerX = if k.x < mitt then k.x + 0.10 else k.x + k.w - 0.20
		local ut = if k.x < mitt then 1 else -1
		BK.box(model, base, "Buktpanel " .. r.id,
			o.x + innerX, 0, o.y + k.y + 0.15, 0.10, r.panelH, k.h - 0.3,
			BF.heldel, Enum.Material.Metal).CanCollide = false
		if r.bommar then
			for i = 1, r.bommar do
				local bz = k.y + k.h * (i - 0.2) / (r.bommar + 0.6)
				BK.box(model, base, "Spolbom " .. r.id .. " " .. i,
					o.x + innerX + ut * (k.w * 0.55), 0, o.y + bz,
					0.13, 2.0, 0.13, BF.ram, Enum.Material.Metal)
			end
			BK.box(model, base, "Bomrail " .. r.id,
				o.x + innerX + ut * 0.30, r.railZ, o.y + k.y + 0.3,
				0.10, 0.10, k.h - 0.6, BF.ram,
				Enum.Material.Metal).CanCollide = false
		end
		if r.sackar then
			local sa = r.sackar
			for rad = 0, sa.rader - 1 do
				for i = 0, 2 do
					local sp = BK.box(model, base, "Spånsäckar " .. r.id,
						o.x + innerX + ut * (0.15 + rad * (sa.djup + 0.15)), 0,
						o.y + k.y + 0.3 + ((k.h - 0.6) / 3) * i,
						sa.djup, sa.hojd, (k.h - 0.6) / 3 - 0.12,
						Color3.fromRGB(220, 214, 200), Enum.Material.Fabric)
					sp.CanCollide = false
				end
			end
		end
		-- Rörstråket längs ytterväggen, i07 och i09.
		for _, z in ipairs({ 2.15, 2.55 }) do
			BK.box(model, base, "Servicerör " .. r.id,
				o.x + innerX + ut * 0.18, z, o.y + k.y + 0.2,
				0.09, 0.09, k.h - 0.4, BF.ram,
				Enum.Material.Metal).CanCollide = false
		end
	end

	--[[ Gaveldörren i söder: ljust parti med grön utrymningsskylt över.
		`VERIFIED` i i07 och i09 — i båda ser man gräset utanför. ]]
	if S.gaveloppning then
		--[[ PO-referens stall-efter-pausrum-po-v1 § Bortre ände: grå dubbeldörr
			med grön nödutgångsskylt. i07/i09 visade dörren ÖPPEN med dagsljus
			(ett tillstånd); bladen byggs stängda, grå, med ljus ruta var. ]]
		local G2 = S.gaveloppning
		local bb = G2.bredd / 2 - 0.02
		for i, sd in ipairs({ -1, 1 }) do
			local cx = o.x + G2.x + G2.bredd / 2 + sd * (bb / 2 + 0.01)
			BK.box(model, base, "Gaveldörr blad " .. i, cx - bb / 2, 0, o.y + 0.04, bb, G2.hojd, 0.08,
				Color3.fromRGB(140, 143, 146), Enum.Material.Metal).CanCollide = false
			BK.box(model, base, "Gaveldagsljus", cx - bb * 0.25, G2.hojd * 0.50, o.y + 0.12, bb * 0.5, G2.hojd * 0.24, 0.02,
				Color3.fromRGB(234, 242, 246), Enum.Material.SmoothPlastic).CanCollide = false
		end
		BK.box(model, base, "Exitskylt syd",
			o.x + G2.x + G2.bredd / 2 - G2.exitB / 2, G2.hojd + G2.exitOver,
			o.y + 0.06, G2.exitB, G2.exitH, 0.06,
			Color3.fromRGB(30, 122, 60), Enum.Material.Neon).CanCollide = false
		-- Valvfönstren i södra gaveln inifrån, med metallgaller (samma referens). u från västra hörnet.
		local hus
		for _, b in ipairs(G.byggnader) do if b.id == "stall" then hus = b end end
		for _, op in ipairs((hus and hus.oppningar) or {}) do
			if op.sida == "S" and op.typ == "valv" and op.z0 < 3 then
				local x0 = o.x + op.u
				BK.box(model, base, "Gavelfönster inifrån, karm", x0 - 0.10, op.z0 - 0.10, o.y + 0.03,
					op.b + 0.20, op.h + 0.20, 0.06, Color3.fromRGB(238, 236, 228), Enum.Material.SmoothPlastic).CanCollide = false
				local g = BK.box(model, base, "Gavelfönster inifrån, glas", x0, op.z0, o.y + 0.10,
					op.b, op.h, 0.03, Color3.fromRGB(200, 214, 222), Enum.Material.Glass)
				g.CanCollide = false
				g.Transparency = 0.3
				for i = 0, 4 do
					BK.box(model, base, "Gavelfönster inifrån, galler", x0 + op.b * (i + 0.5) / 5 - 0.01, op.z0 + op.h * 0.02, o.y + 0.19,
						0.02, op.h * 0.92, 0.02, Color3.fromRGB(110, 114, 117), Enum.Material.Metal).CanCollide = false
				end
			end
		end
	end

	-- Inredningen ur G.inredning.stall (F02-B): uppehållsrummet, teorisalen,
	-- sadelkammaren och exitskylten vid gång A:s norra ände.
	byggInredning(model, base, o, G.inredning and G.inredning.stall, "Inredning")
	--[[ Norra gaveln inifrån (klubbgaveln): samma öppningar som den låsta
		fasaden — entrédörren mitt på gaveln med ett runt fönster på var sida
		(stall-entre-15). Dörrbladet som en del i väggen (färgen inifrån är
		[antagande], samma som utsidan), vit karm, solfjäderfönstret som ljus
		ruta; de runda fönstren som karm + glas (fyrkantig stilisering, samma
		som fasadens `rund` i BK.window). u räknas från östra hörnet. Planens
		vindfång och `ut_n` rörs inte — dokumenterad motsägelse
		(STALLINNE.klubb-noten). Samma tecknare som webben (v3dStall). ]]
	do
		local hus
		for _, b in ipairs(G.byggnader) do if b.id == "stall" then hus = b end end
		local V = Color3.fromRGB(238, 236, 228)
		for _, op in ipairs((hus and hus.oppningar) or {}) do
			if op.sida == "N" and op.z0 < 3 and (op.typ == "dorrgul" or op.typ == "rund") then
				local x0 = o.x + S.bredd - op.u - op.b
				local zIn = o.y + S.langd
				if op.typ == "dorrgul" then
					BK.box(model, base, "Klubbentrén inifrån", x0, 0, zIn - 0.09, op.b, op.h, 0.06,
						Color3.fromRGB(168, 118, 80), Enum.Material.Wood).CanCollide = false
					BK.box(model, base, "Klubbentréns karm", x0 - 0.12, op.h, zIn - 0.10,
						op.b + 0.24, 0.12, 0.07, V, Enum.Material.SmoothPlastic).CanCollide = false
					for _, sx in ipairs({ x0 - 0.12, x0 + op.b }) do
						BK.box(model, base, "Klubbentréns karm", sx, 0, zIn - 0.10,
							0.12, op.h + 0.12, 0.07, V, Enum.Material.SmoothPlastic).CanCollide = false
					end
					BK.box(model, base, "Klubbentréns solfjäderfönster", x0 + op.b * 0.13, op.h * 0.64, zIn - 0.13,
						op.b * 0.74, op.h * 0.30, 0.03, Color3.fromRGB(200, 214, 222), Enum.Material.Glass).CanCollide = false
				else
					BK.box(model, base, "Runt fönster inifrån, karm", x0 - 0.08, op.z0 - 0.08, zIn - 0.10,
						op.b + 0.16, op.h + 0.16, 0.06, V, Enum.Material.SmoothPlastic).CanCollide = false
					local g = BK.box(model, base, "Runt fönster inifrån, glas", x0, op.z0, zIn - 0.13,
						op.b, op.h, 0.03, Color3.fromRGB(184, 204, 216), Enum.Material.Glass)
					g.CanCollide = false
					g.Transparency = 0.3
				end
			end
		end
		--[[ Västväggens valvfönster inifrån (review 2026-09-04 08:50, blocker A):
			stall-inne-01 läser soffa–fönster–fotovägg–växt–ponny; fönstret är
			västväggens rundbågiga valv. Fasadens två W-valv (u från norra
			gaveln) ligger båda i uppehållsrummet. Fasadens valv står z 1,55–3,10
			men innertaket på 2,8 (fotot: bågen slutar under taklisten) — rutan
			klipps under taket; höjden inifrån är [antagande], exteriören låst.
			Samma tecknare som webben (v3dStall). ]]
		local gy0 = S.klubbY
		for _, v in ipairs(S.klubb.vaggar) do if v.id == "genomgaende" then gy0 = v.y end end
		for _, op in ipairs((hus and hus.oppningar) or {}) do
			if op.sida == "W" and op.typ == "valv" and op.z0 < 3 then
				local cy = S.langd - op.u - op.b / 2
				if cy >= gy0 then
					local h = math.min(op.h, 2.80 - 0.15 - op.z0)
					local z0 = o.y + cy - op.b / 2
					BK.box(model, base, "Valvfönster inifrån, karm", o.x + 0.03, op.z0 - 0.10, z0 - 0.10,
						0.06, h + 0.20, op.b + 0.20, V, Enum.Material.SmoothPlastic).CanCollide = false
					local g = BK.box(model, base, "Valvfönster inifrån, glas", o.x + 0.10, op.z0, z0,
						0.03, h, op.b, Color3.fromRGB(200, 214, 222), Enum.Material.Glass)
					g.CanCollide = false
					g.Transparency = 0.3
					BK.box(model, base, "Valvfönster inifrån, fönsterbräda", o.x + 0.03, op.z0 - 0.04, z0 - 0.15,
						0.22, 0.04, op.b + 0.30, V, Enum.Material.SmoothPlastic).CanCollide = false
				end
			end
		end
	end
end

--[[ Ridhuset: banan, sargen med porten, läktaren, glasrummen, domarbåset.

	20 × 60 kommer ur G.ridhus.bana och är bekräftad av Tobias. Läktaren,
	glasrummen och båset är Gate F01:s rättade interiörfakta — de är byggda
	därför att de avgör igenkänningen, inte för att de är utsmyckning. ]]
local function byggRidhusInre(model: Model, base: CFrame)
	local R = G.ridhus
	local o = R.origo
	local b = R.bana

	--[[ Ridbanan — den FYSISKA ridytan sarg till sarg (södra sargen mot
		A-gaveln, ridhus-inne-23; norra vid entrédelens gräns), inte
		dressyrens 20 × 60. Layouten ligger i R.dressyr och skrivs som
		attribut så att Studio kan visa båda. Sanden läser den delade, MÄTTA
		`R.sandFarg` (#6F5D4D ur -03), inte INRE.sand. ]]
	local sand = BK.box(model, base, "Ridbanan",
		o.x + b.x, 0, o.y + b.y, b.w, 0.06, b.h,
		R.sandFarg or INRE.sand, Enum.Material.Sand)
	sand.CanCollide = false
	sand:SetAttribute("Matt", string.format("%.0fx%.1f", b.w, b.h))
	if R.dressyr then
		local dr = R.dressyr
		sand:SetAttribute("Dressyr", string.format("%.0fx%.0f", dr.w, dr.h))
		local layout = BK.box(model, base, "Dressyrlayout 20x60",
			o.x + dr.x, 0.03, o.y + dr.y, dr.w, 0.02, dr.h,
			R.sandFarg or INRE.sand, Enum.Material.Sand)
		layout.CanCollide = false
		layout.Transparency = 1
		layout:SetAttribute("Forankring", dr.forankring or "A")
	end

	-- Sargen runt banan, med porten som en lucka i norra kortsidan.
	local sh = R.sargH
	BK.box(model, base, "Sarg väst", o.x + b.x - 0.1, 0, o.y + b.y, 0.1, sh, b.h, INRE.sarg)
	-- Östra långsidan i två stycken: grinden mot hästgången är gapet. Utan den
	-- går det inte att leda hästen mellan banan och gången, och gången blir
	-- dekoration. Webbens vägsökning fällde precis det.
	local gr = R.sargGrind
	if gr then
		BK.box(model, base, "Sarg öst syd", o.x + b.x + b.w, 0, o.y + b.y,
			0.1, sh, gr.y0 - b.y, INRE.sarg)
		BK.box(model, base, "Sarg öst norr", o.x + b.x + b.w, 0, o.y + gr.y1,
			0.1, sh, b.y + b.h - gr.y1, INRE.sarg)
	else
		BK.box(model, base, "Sarg öst", o.x + b.x + b.w, 0, o.y + b.y, 0.1, sh, b.h, INRE.sarg)
	end
	BK.box(model, base, "Sarg syd",  o.x + b.x, 0, o.y + b.y - 0.1, b.w, sh, 0.1, INRE.sarg)
	--[[ Norra kortsidan i två stycken. Gapet mellan dem är SPELABSTRAKTIONEN
		sargport (G.spelabstraktioner, src/site.js): ingen bild visar en
		grind i sargen och bredden är vald, så den är inte fidelity-geometri
		utan spelets väg från entrédelen ut på banan. Den byggs som ett gap
		plus en genomskinlig, okolliderande markör med klass som attribut,
		så att Studio visar VAD den är. (Senior Re-review 2026-09-03.) ]]
	local sp = G.spelabstraktioner.ridhus.sargport
	BK.box(model, base, "Sarg norr väst", o.x + b.x, 0, o.y + b.y + b.h,
		sp.x0 - b.x, sh, 0.1, INRE.sarg)
	BK.box(model, base, "Sarg norr öst", o.x + sp.x1, 0, o.y + b.y + b.h,
		b.x + b.w - sp.x1, sh, 0.1, INRE.sarg)
	local markor = BK.box(model, base, "Spelabstraktion sargport", o.x + sp.x0, 0, o.y + b.y + b.h - 0.05,
		sp.x1 - sp.x0, sh, 0.2, Color3.fromRGB(214, 174, 60), Enum.Material.Neon)
	markor.CanCollide = false
	markor.Transparency = 0.7
	markor:SetAttribute("Klass", sp.klass)
	markor:SetAttribute("Fidelity", sp.fidelity)
	markor:SetAttribute("Motiv", sp.motiv)

	--[[ Läktaren längs östra långsidan.

		`KNOWN MISMATCH A`, rättad på båda ytorna: den byggdes som fyra
		TRAPPSTEG i ljust trä. `ridhus-inne-01` och `-02` är båda tagna FRÅN
		läktaren och visar ett PLANT plankdäck med en solid mörkbetsad
		brädfront och en ljus kappregel — inga steg. Trappstegen finns vid
		KORTÄNDAN, under glasrummen, och byggs där nedan. De två
		strukturerna hade blandats ihop.

		Höjderna kommer ur den delade datan och är härledda ur `-03`; se
		noten i src/site.js. ]]
	--[[ F02-B: kommentaren ovan är ÖVERSPELAD. Matrisen (references/
		buildings/ridhus/INTERIOR-MATRIS.md § 2) återkallar den solida
		mörka fronten och kappregeln — de var lästa ur en beskuren
		förgrund — och slår fast att läktaren är sarg + plan GÅNGBRÄDA i
		mörkt trä + STEGADE BÄNKRADER i ljus furu längs hela långsidan
		(ridhus-inne-04, -07, -14, -43). Raderna kommer ur
		Geometri.laktarRader, samma regel som webbens laktarRader. ]]
	local L = R.laktare
	local lE = R.sidor and R.sidor.laktare == "E"
	local bankant = if lE then L.x0 else L.x0 + L.dackDjup   -- däckets kant mot banan
	local inat = if lE then 1 else -1                          -- riktning in från banan
	local g, rr = L.gangbrada, L.rader
	local bankFarg = if rr then rr.farg else INRE.laktare
	local kantFarg = if rr then rr.kantFarg else INRE.laktare
	-- Läktarens NORRA 4 m (LAKTARE_TONAD_ANDE, delad med webben) byggs som
	-- egna delar med Genomsiktlig: står figuren i entréhallen bakom dem
	-- döljer raderna henne annars (siktgrinden #78). Resten tonas aldrig,
	-- så däcket man går på förblir synligt.
	local LAKTARE_TONAD_ANDE = 4.0
	for s, sek in ipairs(GEO.laktarSektioner(L)) do
	  local bitar = if math.abs(sek.y1 - L.y1) < 0.01 and (sek.y1 - sek.y0) > 6
	    then { { y0 = sek.y0, y1 = sek.y1 - LAKTARE_TONAD_ANDE, gs = false }, { y0 = sek.y1 - LAKTARE_TONAD_ANDE, y1 = sek.y1, gs = true } }
	    else { { y0 = sek.y0, y1 = sek.y1, gs = false } }
	  for _, bit in ipairs(bitar) do
		local dj = bit.y1 - bit.y0
		local function gs(p) if bit.gs then p:SetAttribute("Genomsiktlig", true) end return p end
		local gX = if inat > 0 then bankant else bankant - g.djup
		gs(BK.box(model, base, "Läktargångbräda " .. s,
			o.x + gX, L.dackZ - 0.10, o.y + bit.y0, g.djup, 0.10, dj,
			g.farg, Enum.Material.WoodPlanks))
		for i, rad in ipairs(GEO.laktarRader(L)) do
			local x0 = if inat > 0 then bankant + rad.in0 else bankant - rad.in1
			local dju = rad.in1 - rad.in0
			gs(BK.box(model, base, "Läktarrad " .. s .. ":" .. i,
				o.x + x0, rad.z - rr.sittTjock, o.y + bit.y0, dju, rr.sittTjock, dj,
				bankFarg, Enum.Material.WoodPlanks))
			-- sättsteget ner mot banan och den röda kantlisten (-04)
			local sX = if inat > 0 then bankant + rad.in0 else bankant - rad.in0 - 0.04
			gs(BK.box(model, base, "Läktarsättsteg " .. s .. ":" .. i,
				o.x + sX, L.dackZ, o.y + bit.y0, 0.04, rad.z - L.dackZ - rr.sittTjock, dj,
				bankFarg, Enum.Material.WoodPlanks))
			gs(BK.box(model, base, "Läktarkantlist " .. s .. ":" .. i,
				o.x + sX, rad.z, o.y + bit.y0, 0.06, 0.04, dj,
				kantFarg, Enum.Material.SmoothPlastic)).CanCollide = false
		end
		-- Stomme under däcket, så att det inte svävar.
		local stX = if inat > 0 then bankant + L.dackDjup - 0.3 else bankant - L.dackDjup + 0.18
		gs(BK.box(model, base, "Läktarstomme " .. s,
			o.x + stX, 0, o.y + bit.y0, 0.12, L.dackZ, dj,
			INRE.laktare, Enum.Material.Wood)).CanCollide = false
	  end
	  do
		local dj = sek.y1 - sek.y0
		-- Elon-dynorna på översta raden (-07); förut bara i webben.
		local rader = GEO.laktarRader(L)
		local topp = rader[#rader]
		if topp and R.dynor then
			for i = 0, R.dynor - 1 do
				local z = sek.y0 + 2.0 + i * ((dj - 4) / math.max(1, R.dynor - 1))
				local dX = if inat > 0 then bankant + (topp.in0 + topp.in1) / 2 else bankant - (topp.in0 + topp.in1) / 2
				BK.box(model, base, "Läktardyna " .. (i + 1),
					o.x + dX - 0.17, topp.z, o.y + z - 0.22, 0.34, 0.06, 0.44,
					Color3.fromRGB(38, 40, 44), Enum.Material.Fabric).CanCollide = false
			end
		end
	  end
	end

	--[[ TRAPPORNA (R.trappor, Product Owner 2026-09-03): läktargångens
		trappa upp till övre gången och stegen från entréhallen upp på
		däcket. Stegen ur den delade regeln Geometri.trappsteg — samma
		steg som webbens nivåregel läser — som klossar karaktären kliver
		upp för (steghöjd < 0,19 m = 0,57 studs). Sträng och räcke på den
		fria sidan, utan kollision. Provenance som väggarna. ]]
	for _, t in ipairs(R.trappor or {}) do
		local T = GEO.trappsteg(t)
		local langsX = T.axel == "x"
		local b = if langsX then t.y1 - t.y0 else t.x1 - t.x0
		for i, st in ipairs(T.steg) do
			local tj = math.max(0.06, math.abs(T.stig))
			local p
			if langsX then
				p = BK.box(model, base, "Trappa " .. t.id .. " steg " .. i,
					o.x + st.a0, st.z - tj, o.y + t.y0, st.a1 - st.a0, tj, b,
					Color3.fromRGB(90, 66, 50), Enum.Material.WoodPlanks)
			else
				p = BK.box(model, base, "Trappa " .. t.id .. " steg " .. i,
					o.x + t.x0, st.z - tj, o.y + st.a0, b, tj, st.a1 - st.a0,
					Color3.fromRGB(90, 66, 50), Enum.Material.WoodPlanks)
			end
			p:SetAttribute("Genomsiktlig", true)
			kanonAttribut(p, t)
		end
		local a0 = if langsX then t.x0 else t.y0
		local a1 = if langsX then t.x1 else t.y1
		local lang = a1 - a0
		local bakat = (t.stiger == "S" or t.stiger == "W")
		local lut = math.atan2(t.z1 - t.z0, lang) * (if bakat then -1 else 1)
		local L = math.sqrt(lang * lang + (t.z1 - t.z0) * (t.z1 - t.z0))
		-- handledare (och för gavelloppen det vita snedställda sidostycket) på bansidan
		local sidor = if langsX then { t.y0 + 0.05 } elseif t.x0 < 1.0 then { t.x1 - 0.05 } else { t.x0 + 0.05, t.x1 - 0.05 }
		for _, sx in ipairs(sidor) do
			for i = 1, T.n, 3 do
				local st = T.steg[i]
				local c = (st.a0 + st.a1) / 2
				local px = if langsX then c else sx
				local pz = if langsX then sx else c
				local stolpe = BK.box(model, base, "Trappa " .. t.id .. " räckesstolpe " .. i,
					o.x + px - 0.03, st.z, o.y + pz - 0.03, 0.06, 0.95, 0.06,
					Color3.fromRGB(138, 106, 68), Enum.Material.Wood)
				stolpe.CanCollide = false
				stolpe:SetAttribute("Genomsiktlig", true)   -- tonas när de skymmer (som webben)
			end
			local am, zm = (a0 + a1) / 2, (t.z0 + t.z1) / 2
			local function sned(namn, h, dz, farg, mat, ds)
				local d = BK.box(model, base, namn, 0, 0, 0, 0.06, h, 0.06, farg, mat)
				d.CanCollide = false
				d:SetAttribute("Genomsiktlig", true)   -- sidostycke/handledare tonas när de skymmer
				if langsX then
					d.Size = Vector3.new(BK.M * L, BK.M * h, BK.M * 0.05)
					d.CFrame = base * CFrame.new(BK.M * (o.x + am), BK.M * (zm + dz), BK.M * (o.y + sx + (ds or 0))) * CFrame.Angles(0, 0, lut)
				else
					d.Size = Vector3.new(BK.M * 0.05, BK.M * h, BK.M * L)
					d.CFrame = base * CFrame.new(BK.M * (o.x + sx + (ds or 0)), BK.M * (zm + dz), BK.M * (o.y + am)) * CFrame.Angles(-lut, 0, 0)
				end
			end
			if langsX then
				-- Från banan är det vita sidostycket det man ser av loppet (ridhus-inne-01):
				-- ett trapets med vågrät underkant i blockets krön och överkanten längs
				-- räcket 0,9 m över stegen. Byggt som en lutande skiva över stegen plus
				-- en vit fyllnad per steg ner till blockets krön; räcket ovanpå kanten.
				local V = Color3.fromRGB(233, 229, 220)
				sned("Trappa " .. t.id .. " sidostycke", 0.90, 0.45, V, Enum.Material.Plaster, -0.10)
				local bas = math.min(t.z0, t.z1)
				for i, st in ipairs(T.steg) do
					if st.z - bas > 0.02 then
						local f = BK.box(model, base, "Trappa " .. t.id .. " sidostycke fyllnad " .. i,
							o.x + st.a0, bas, o.y + sx - 0.125, st.a1 - st.a0, st.z - bas, 0.05, V, Enum.Material.Plaster)
						f.CanCollide = false
						f:SetAttribute("Genomsiktlig", true)
					end
				end
				sned("Trappa " .. t.id .. " handledare", 0.06, 0.93, Color3.fromRGB(138, 106, 68), Enum.Material.Wood, -0.10)
			else
				-- Loppet längs y (läktartrappan vid H): den vita snedställda sidan mot
				-- raderna/banan (ridhus-inne-15/-14/-20) som för C-trapporna, vänd åt +x.
				local V = Color3.fromRGB(233, 229, 220)
				sned("Trappa " .. t.id .. " sidostycke", 0.90, 0.45, V, Enum.Material.Plaster, 0.10)
				local bas = math.min(t.z0, t.z1)
				for i, st in ipairs(T.steg) do
					if st.z - bas > 0.02 then
						local f = BK.box(model, base, "Trappa " .. t.id .. " sidostycke fyllnad " .. i,
							o.x + sx + 0.075, bas, o.y + st.a0, 0.05, st.z - bas, st.a1 - st.a0, V, Enum.Material.Plaster)
						f.CanCollide = false
						f:SetAttribute("Genomsiktlig", true)
					end
				end
				sned("Trappa " .. t.id .. " handledare", 0.06, 0.93, Color3.fromRGB(138, 106, 68), Enum.Material.Wood, 0.10)
			end
		end
	end
	--[[ SPELETS LÄKTARSTEG (G.spelabstraktioner.ridhus.laktarSteg): hallgolvet →
		läktardäcket vid däckets norra ände (PO 2026-09-04 07:54, blocker 3).
		ridhus-inne-39 visar nivåskillnaden men inte stegen — därför
		spelabstraktion, märkt som bänkradsstegen. ]]
	do
		local ls = G.spelabstraktioner and G.spelabstraktioner.ridhus and G.spelabstraktioner.ridhus.laktarSteg
		if ls and ls.x1 > ls.x0 and ls.y1 > ls.y0 then
			local T = GEO.trappsteg(ls)
			local b = ls.x1 - ls.x0
			for i, st in ipairs(T.steg) do
				local tj = math.max(0.06, math.abs(T.stig))
				local p = BK.box(model, base, "Spelabstraktion laktarsteg steg " .. i,
					o.x + ls.x0, st.z - tj, o.y + st.a0, b, tj, st.a1 - st.a0,
					Color3.fromRGB(185, 168, 134), Enum.Material.WoodPlanks)
				p:SetAttribute("Klass", ls.klass)
				p:SetAttribute("Fidelity", ls.fidelity)
				p:SetAttribute("Motiv", ls.motiv)
			end
			local markor = BK.box(model, base, "Spelabstraktion laktarsteg", o.x + ls.x0, ls.z1 + 0.3, o.y + ls.y0,
				b, 0.12, ls.y1 - ls.y0, Color3.fromRGB(214, 174, 60), Enum.Material.Neon)
			markor.CanCollide = false
			markor.Transparency = 0.7
			markor:SetAttribute("Klass", ls.klass)
			markor:SetAttribute("Fidelity", ls.fidelity)
			markor:SetAttribute("Motiv", ls.motiv)
		end
	end
	--[[ SPELETS BÄNKRADSSTEG (G.spelabstraktioner.ridhus.bankradSteg): inte
		fidelity — inget foto visar hur publiken kommer upp på raderna. Byggs
		som kliv-bara klossar MÄRKTA med Klass/Fidelity/Motiv som attribut
		(ingen CanonId/SourceId/Confidence), i neutral färg, med en gul
		genomskinlig markör som sargporten. Räknas inte in i något F02-PASS. ]]
	do
		local bs = G.spelabstraktioner and G.spelabstraktioner.ridhus and G.spelabstraktioner.ridhus.bankradSteg
		if bs and bs.x1 > bs.x0 then
			local T = GEO.trappsteg(bs)
			local b = bs.y1 - bs.y0
			for i, st in ipairs(T.steg) do
				local tj = math.max(0.06, math.abs(T.stig))
				local p = BK.box(model, base, "Spelabstraktion bankradsteg steg " .. i,
					o.x + st.a0, st.z - tj, o.y + bs.y0, st.a1 - st.a0, tj, b,
					Color3.fromRGB(185, 168, 134), Enum.Material.WoodPlanks)
				p:SetAttribute("Klass", bs.klass)
				p:SetAttribute("Fidelity", bs.fidelity)
				p:SetAttribute("Motiv", bs.motiv)
			end
			local markor = BK.box(model, base, "Spelabstraktion bankradsteg", o.x + bs.x0, bs.z1 + 0.3, o.y + bs.y0,
				bs.x1 - bs.x0, 0.12, b, Color3.fromRGB(214, 174, 60), Enum.Material.Neon)
			markor.CanCollide = false
			markor.Transparency = 0.7
			markor:SetAttribute("Klass", bs.klass)
			markor:SetAttribute("Fidelity", bs.fidelity)
			markor:SetAttribute("Motiv", bs.motiv)
		end
	end
	--[[ ÖVRE GÅNGEN (R.ovreGang): golvet på caféplanet längs banans kant som
		läktargångens trappa landar i (`ridhus-klubb-10`), och ett räcke mot
		banan där C-blockets glasband inte står — utom i trappans mynning.
		Caféets rum innanför är REFERENCE GAP och byggs inte. ]]
	if R.ovreGang then
		local G2 = R.ovreGang
		local golv = BK.box(model, base, "Övre gångens golv",
			o.x + G2.x0, G2.z - 0.26, o.y + G2.y0, G2.x1 - G2.x0, 0.26, G2.y1 - G2.y0,
			Color3.fromRGB(207, 200, 188), Enum.Material.WoodPlanks)
		golv:SetAttribute("Genomsiktlig", true)
		local trappa = nil
		for _, t in ipairs(R.trappor or {}) do if t.id == "laktargang_upp" then trappa = t end end
		local K2 = R.kortanda
		local fri = { { G2.x0, K2 and K2.x0 or G2.x1 }, { K2 and K2.x1 or G2.x1, G2.x1 } }
		for _, seg in ipairs(fri) do
			local a, b2 = seg[1], seg[2]
			local bitar = { { a, b2 } }
			if trappa and trappa.x0 < b2 and trappa.x1 > a then
				bitar = { { a, trappa.x0 }, { trappa.x1, b2 } }
			end
			for j, bit in ipairs(bitar) do
				if bit[2] - bit[1] > 0.05 then
					BK.box(model, base, "Övre gångens räcke " .. j,
						o.x + bit[1], G2.z, o.y + G2.y0 - 0.06, bit[2] - bit[1], 1.0, 0.06,
						Color3.fromRGB(233, 229, 220), Enum.Material.Plaster)
				end
			end
		end
	end

	--[[ LANDGÅNGEN PÅ ÖVRE PLAN (R.ovreGangV): från läktartrappans topp vid
		läktarens norra ände norrut till övre gången (ridhus-klubb-10,
		ridhus-inne-39). Golv på caféplanet i läktarens västra meter, räcke
		mot hallen på östra sidan. ]]
	if R.ovreGangV then
		local V2 = R.ovreGangV
		local golv = BK.box(model, base, "Övre gångens västarm golv",
			o.x + V2.x0, V2.z - 0.26, o.y + V2.y0, V2.x1 - V2.x0, 0.26, V2.y1 - V2.y0,
			Color3.fromRGB(207, 200, 188), Enum.Material.WoodPlanks)
		golv:SetAttribute("Genomsiktlig", true)
		local racke = BK.box(model, base, "Övre gångens västarm räcke",
			o.x + V2.x1 - 0.06, V2.z, o.y + V2.y0, 0.06, 1.0, V2.y1 - V2.y0,
			Color3.fromRGB(233, 229, 220), Enum.Material.Plaster)
		racke:SetAttribute("Genomsiktlig", true)
	end

	-- Kortändans läktare: trappstegsblock, två trappor och glasbandet ovanför.
	-- De glasade rummen låg förut längs LÅNGSIDAN, i läktarens liv. Fotot
	-- ridhus-inne-01 visar dem över ett trappstegsblock vid kortändan, och
	-- bokstaven C framför blocket avgör saken: C ligger mitt på en kortsida.
	local K = R.kortanda
	if K then
		local br = K.x1 - K.x0
		--[[ Blocket står på en SOCKEL. Utan den steg raderna bort från banan
			och bara den översta kom över sargen — 0,25 m på fjorton meters
			håll. `-01` visar flera rader över sargkrönet. ]]
		local SO = K.sockelH or 0
		if SO > 0 then
			BK.box(model, base, "Kortändans sockel", o.x + K.x0, 0, o.y + K.y0,
				br, SO, K.y1 - K.y0, INRE.laktare, Enum.Material.WoodPlanks)
		end
		--[[ Bänkarna läser den MÄTTA `K.bank` (#86715B ur -01), inte
			INRE.laktare. Webben hade #D8C7A4, ljus furu, vilket fotot
			motsäger — och Roblox hade sin egen ton. Två sanningar om samma
			bänk; nu delar de en. ]]
		--[[ `vand` säger var BANAN ligger. "S": blocket står i norra änden,
			stegen stiger norrut från bankanten y0 mot gavelväggen y1, där
			den vita väggen, klockan och glasbandet står. `ut` pekar från
			banan mot väggen; `bank`/`vagg` är de två kanterna. Förut var
			talen skrivna för ett block i söder med väggen vid y0. ]]
		local mS = K.vand == "S"
		local bank = if mS then K.y0 else K.y1
		local vagg = if mS then K.y1 else K.y0
		local ut = if mS then 1 else -1
		for i = 1, K.steg do
			--[[ steg i täcker stegD från bankanten inåt; klossen står på
				sockeln och når radens sitthöjd SO + i × stegH (+ plankan).
				Förut stod basen på SO + (i−1) × stegH med samma höjd, så
				raderna steg 0,64 m i stället för 0,32 — det syntes först
				när kedjan upp till C-trapporna provades (2026-09-03). ]]
			local z0 = if mS then bank + (i - 1) * K.stegD else bank - i * K.stegD
			BK.box(model, base, "Kortändans steg " .. i,
				o.x + K.x0, SO,
				o.y + z0, br, K.stegH * i + 0.1, K.stegD,
				K.bank or INRE.laktare, Enum.Material.WoodPlanks)
		end
		-- De två trapporna byggs som gångbara STAIR-primitiver ur R.trappor ovan.
		--[[ Glasbandet är INTE en obruten remsa. `ridhus-inne-01` visar att
			de två trapporna bryter det: deras vita snedställda barriärer
			skjuter upp genom bandet, och mellan dem står den vita väggen
			med klockan. Segmenten räknas ur samma `trappor`-tal som
			trapporna byggs av, så de inte kan glida isär. ]]
		local H = (K.sockelH or 0) + K.steg * K.stegH
		local gz = H + K.glasOver
		--[[ DEN VITA VÄGGEN mellan bänkarna och glasbandet, vid väggsidan.
			Roblox byggde bara steg, trappor och glas; gapet däremellan
			visade skalets material, inte den vita väggen ridhus-inne-01
			visar. Att flytta glaset uppåt räcker inte om gapet exponerar
			fel yta. ]]
		BK.box(model, base, "Kortändans vita vägg", o.x + K.x0, H,
			o.y + vagg - (if mS then 0.14 else 0.16), br, K.glasOver, 0.14,
			R.hallvagg or INRE.vagg,
			Enum.Material.Plaster).CanCollide = false

		-- Klockan MELLAN trapporna, och kompassrosen till vänster om dem,
		-- på den vita väggens bansida.
		local framfor = vagg - ut * 0.22
		if K.klocka then
			local KL = K.klocka
			BK.box(model, base, "Kortändans klocka",
				o.x + KL.x - KL.r, H + KL.overBlock - KL.r, o.y + framfor - 0.04,
				KL.r * 2, KL.r * 2, 0.08,
				Color3.fromRGB(244, 241, 232),
				Enum.Material.SmoothPlastic).CanCollide = false
		end
		if K.stjarna then
			local ST = K.stjarna
			for i = 0, 3 do
				local lang = if i % 2 == 0 then ST.r * 2 else ST.r * 1.45
				local stav = Instance.new("Part")
				stav.Name = "Kompassros"; stav.Anchored = true
				stav.CanCollide = false
				stav.Color = ST.farg
				stav.Material = Enum.Material.SmoothPlastic
				stav.Size = Vector3.new(BK.M * lang, BK.M * ST.tjocklek, BK.M * 0.05)
				stav.CFrame = base
					* CFrame.new(BK.M * (o.x + ST.x),
						BK.M * (H + ST.overBlock), BK.M * (o.y + framfor - 0.02))
					* CFrame.Angles(0, 0, i * math.pi / 4)
				stav.Parent = model
			end
		end
		local brytn = {}
		for _, t in ipairs(K.trappor or {}) do table.insert(brytn, t) end
		table.sort(brytn, function(a, b2) return a.x0 < b2.x0 end)
		local seg, sx = {}, K.x0
		for _, t in ipairs(brytn) do
			if t.x0 - sx > 0.3 then table.insert(seg, { sx, t.x0 }) end
			if t.x1 > sx then sx = t.x1 end
		end
		if K.x1 - sx > 0.3 then table.insert(seg, { sx, K.x1 }) end
		for i, sg in ipairs(seg) do
			local w = sg[2] - sg[1]
			local glas = BK.box(model, base, "Kortändans glasband " .. i,
				o.x + sg[1], gz, o.y + vagg - (if mS then 0.0 else 0.12), w, K.glasH, 0.12,
				INRE.glas, Enum.Material.Glass)
			glas.Transparency = 0.55
			glas.CanCollide = false
			local n = math.max(1, math.round(w / (K.glasPost or 1.9)))
			for j = 0, n do
				BK.box(model, base, "Glaspost",
					o.x + sg[1] + w * j / n - 0.055, gz, o.y + vagg - (if mS then 0.02 else 0.14),
					0.11, K.glasH, 0.14,
					K.glasKarm or INRE.laktare,
					Enum.Material.Wood).CanCollide = false
			end
		end
	end

	--[[ Fönstren ovanför panelen — OMGRANSKADE 2026-09-03: SEPARATA
		öppningar, en per väggfält mellan pilastrarna (ridhus-inne-31, -17,
		-24), inte ett löpande band. Fälten kommer ur Geometri.ridhusFalt,
		samma regel som webben. ]]
	local FB = G.identitet.ridhus.fonsterband
	local OV = G.identitet.ridhus.ovreVagg
	if FB and OV then
		local fx = if OV.sida == "W" then 0.16 else R.bredd - 0.16
		local fy = R.tak - FB.underTak - FB.h
		for i, falt in ipairs(GEO.ridhusFalt(R)) do
			local b = math.min(FB.faltBredd or 3.0, (falt[2] - falt[1]) - 1.0)
			if b >= 0.8 then
				local zm = (falt[1] + falt[2]) / 2
				local glas = BK.box(model, base, "Ridhus fönster " .. i,
					o.x + fx, fy, o.y + zm - b / 2, FB.tjocklek, FB.h, b,
					FB.glas, Enum.Material.Glass)
				glas.Transparency = 0.35
				glas.CanCollide = false
				for _, z in ipairs({ zm - b / 2, zm + b / 2 - 0.09 }) do
					BK.box(model, base, "Fönsterpost", o.x + fx - 0.02, fy,
						o.y + z, FB.tjocklek + 0.03, FB.h, 0.09,
						FB.karm, Enum.Material.Wood).CanCollide = false
				end
			end
		end
	end

	--[[ PELARNA på båda långsidorna där takstolarna landar: pilastrarna som
		delar panelen i fält (ridhus-inne-31) och läktarsidans mörka pelare i
		den ljusa skivpanelen (ridhus-inne-14, INTERIOR-MATRIS § 5). Utan dem
		är läktarväggen en slät yta i samma ton som alla andra väggar. ]]
	local LV = G.identitet.ridhus.laktarVagg
	if LV and OV then
		for _, falt in ipairs(GEO.ridhusFalt(R)) do
			local z = falt[2]
			if z < R.langd - R.entre - 0.01 then
				for _, sida in ipairs({ "W", "E" }) do
					local x = if sida == "W" then 0.16 else R.bredd - 0.16 - LV.pelareB
					local z0 = if sida == OV.sida then R.sargH + OV.overSarg else 0
					BK.box(model, base, "Väggpelare " .. sida, o.x + x, z0,
						o.y + z - LV.pelareB / 2, LV.pelareB, R.tak - z0, LV.pelareB,
						LV.pelareFarg, Enum.Material.Wood).CanCollide = false
				end
			end
		end
	end

	-- Domarbåset vid E, med exit-skylten över öppningen.
	--[[ Domarbåset vid E. Roblox byggde det som EN slät låda — ingen
		upphöjd nivå, ingen trappa, inga räcken, inget tak. Webben har haft
		allt det sedan Review 03, så det var en Roblox-only brist på just
		det som gör båset igenkännbart. `ridhus-inne-03`, beskuren: en liten
		mörk trästuga med SADELTAK och utskjutande takfot, på en upphöjd
		nivå, med en trappa som har räcke på BÅDA sidor. ]]
	local D = R.domarbas
	local golv = L.dackZ
	BK.box(model, base, "Domarbåsets nivå", o.x + D.x - (D.b + 1.6) / 2, 0,
		o.y + D.y - (D.b + 1.2) / 2, D.b + 1.6, golv, D.b + 1.2,
		INRE.laktare, Enum.Material.WoodPlanks)
	-- Tonas när det står mellan kameran och spelaren (webben: eget nät med
	-- toningsfotavtryck), som klubbdelens väggar.
	BK.box(model, base, "Domarbås", o.x + D.x - D.b / 2, golv,
		o.y + D.y - D.b / 2, D.b, D.h, D.b,
		Color3.fromRGB(74, 53, 36), Enum.Material.WoodPlanks):SetAttribute("Genomsiktlig", true)
	-- Öppningen mot banan, så att båset inte blir en sluten låda. Banan
	-- ligger på den sida läktaren inte står.
	local dIn = if lE then -1 else 1
	BK.box(model, base, "Domarbåsets öppning",
		o.x + D.x + (if lE then -D.b / 2 - 0.06 else D.b / 2),
		golv + D.h * 0.22, o.y + D.y - D.b * 0.31, 0.06, D.h * 0.62,
		D.b * 0.62, Color3.fromRGB(28, 26, 24),
		Enum.Material.SmoothPlastic).CanCollide = false
	-- Sadeltaket, silhuetten man känner igen båset på.
	local BT = R.basTak
	if BT then
		local bb = D.b + BT.utsprang * 2
		for _, sida in ipairs({ -1, 1 }) do
			local tak = Instance.new("Part")
			tak.Name = "Domarbåsets tak"; tak.Anchored = true
			tak.CanCollide = false
			tak.Color = Color3.fromRGB(58, 42, 28)
			tak.Material = Enum.Material.WoodPlanks
			local sl = math.sqrt((bb / 2) ^ 2 + BT.resning ^ 2)
			tak.Size = Vector3.new(BK.M * sl, BK.M * 0.09, BK.M * bb)
			tak.CFrame = base
				* CFrame.new(BK.M * (o.x + D.x + sida * bb / 4),
					BK.M * (golv + D.h + BT.resning / 2),
					BK.M * (o.y + D.y))
				* CFrame.Angles(0, 0, -sida * math.atan2(BT.resning, bb / 2))
			tak.Parent = model
		end
	end
	-- Trappan upp, med räcke på BÅDA sidor.
	if D.trappa then
		local st, sd = 5, 0.30
		local sh = golv / st
		local z0 = D.y + D.b / 2 + 0.35
		for i = 0, st - 1 do
			BK.box(model, base, "Domarbåsets trappsteg",
				o.x + D.x - 0.5, sh * i, o.y + z0 + sd * i, 1.0, sh + 0.02, sd,
				INRE.laktare, Enum.Material.WoodPlanks)
		end
		for _, sx in ipairs({ -0.52, 0.52 }) do
			for i = 0, st - 1, 2 do
				BK.box(model, base, "Domarbåsets räcke",
					o.x + D.x + sx - 0.035, sh * i, o.y + z0 + sd * i,
					0.07, golv * 0.55 + 0.32, 0.07,
					Color3.fromRGB(138, 106, 68),
					Enum.Material.Wood).CanCollide = false
			end
		end
	end
	if D.exit then
		local skylt = BK.box(model, base, "Exit-skylt",
			o.x + D.x + dIn * (D.b / 2 + 0.05) - 0.03,
			golv + D.h + 0.20, o.y + D.y - 0.25, 0.06, 0.22, 0.5,
			Color3.fromRGB(46, 160, 84), Enum.Material.Neon)
		skylt.CanCollide = false
	end

	--[[ Klockan vid "centrala trappan" är borta: den var en dubblett av
		C-blockets klocka, som sitter mellan de två trapporna. Granskningen
		2026-08-31 såg en enda klocka i alla bilder. ]]

	--[[ ENTRÉDELEN ur planen — samma schema och samma byggare som stallets
		klubbdel: väggar i bitar med planens luckor, slutna rum som volymer,
		namngivna gångbara rum som etikettplattor. ]]
	if R.entrehall then
		local Y = YTOR.ridhusEntre
		local E = R.entre or R.cafe.djup
		local gp = BK.box(model, base, "Ridhusentre matt golv", o.x + 0.2, 0.02, o.y + R.langd - E + 0.2,
			R.bredd - 0.4, 0.004, E - 0.4, Y.farg, Enum.Material.SmoothPlastic)
		gp.CanCollide = false
		gp:SetAttribute("Ytfinish", Y.typ)
		gp:SetAttribute("Kalla", Y.kalla)
		gp:SetAttribute("FargKlass", Y.fargKlass)
		byggVaggarOchRum(model, base, o, R.tak, R.entrehall, "Entrévägg", INRE.vagg)
		--[[ FASADENS DÖRRAR INIFRÅN (PO 2026-09-04 07:54, blocker 2): huvudentrén i
			västväggen (dorrvit u 9), gavlarnas dörrar — dörrblad, vitt foder,
			glasrutor i dubbeldörren och grön utrymningsskylt på insidan av
			väggen (IMG_0169-f05, ridhus-klubb-03/-19). Samma tecknare som
			webbens v3dDorrarInifran; u räknas moturs som i G.byggnader. ]]
		do
			local hus
			for _, b in ipairs(G.byggnader) do if b.id == "ridhus" then hus = b end end
			local FARG = { dorr = Color3.fromRGB(26, 26, 28), dorrgul = Color3.fromRGB(168, 118, 80), dorrvit = Color3.fromRGB(232, 226, 212),
				dorrgra = Color3.fromRGB(162, 164, 166), dorrmork = Color3.fromRGB(70, 63, 56) }
			local V = Color3.fromRGB(238, 236, 228)
			local ut = 0.14
			for _, op in ipairs((hus and hus.oppningar) or {}) do
				if FARG[op.typ] and (op.z0 or 0) <= 0.5 then
					-- lokal ram: (cx, cy) dörrens mitt på insidan, `langsX` = dörren ligger längs x
					local langsX = op.sida == "N" or op.sida == "S"
					local cx, cy, inn
					if op.sida == "W" then cx, cy, inn = ut, R.langd - op.u - op.b / 2, 1
					elseif op.sida == "N" then cx, cy, inn = R.bredd - op.u - op.b / 2, R.langd - ut, -1
					elseif op.sida == "S" then cx, cy, inn = op.u + op.b / 2, ut, 1
					else cx, cy, inn = R.bredd - ut, op.u + op.b / 2, -1 end
					local namn = "Fasaddörr inifrån " .. op.sida .. " u" .. tostring(op.u)
					local function del(suffix, du, z0, dz, w, hh, d, farg, mat)
						-- du längs dörren, dz inåt från väggens insida
						local x = if langsX then cx + du - w / 2 else cx + inn * dz - d / 2
						local y = if langsX then cy + inn * dz - d / 2 else cy + du - w / 2
						local q = BK.box(model, base, namn .. suffix, x, z0, y, if langsX then w else d, hh, if langsX then d else w, farg, mat)
						q.CanCollide = false
						return q
					end
					del(" blad", 0, 0, 0.03, op.b, op.h, 0.06, FARG[op.typ], Enum.Material.SmoothPlastic)
					local tj = 0.12
					del(" foder topp", 0, op.h, 0.04, op.b + 2 * tj, tj, 0.07, V, Enum.Material.SmoothPlastic)
					del(" foder V", -(op.b + tj) / 2, 0, 0.04, tj, op.h + tj, 0.07, V, Enum.Material.SmoothPlastic)
					del(" foder H", (op.b + tj) / 2, 0, 0.04, tj, op.h + tj, 0.07, V, Enum.Material.SmoothPlastic)
					if op.typ == "dorrvit" then
						for _, sd in ipairs({ -1, 1 }) do
							local g = del(" glas", sd * op.b * 0.24, op.h * 0.61, 0.06, op.b * 0.30, op.h * 0.22, 0.02, Color3.fromRGB(58, 74, 92), Enum.Material.Glass)
							g.Transparency = 0.3
						end
						del(" mittpost", 0, op.h * 0.04, 0.06, 0.05, op.h * 0.92, 0.05, V, Enum.Material.SmoothPlastic)
						del(" handtag", op.b * 0.07, 0.9, 0.08, 0.05, 0.30, 0.04, Color3.fromRGB(196, 199, 201), Enum.Material.Metal)
					else
						del(" handtag", op.b * 0.34, 0.97, 0.08, 0.05, 0.16, 0.05, Color3.fromRGB(196, 199, 201), Enum.Material.Metal)
					end
					local sk = del(" utrymningsskylt", 0, op.h + tj + 0.14, 0.05, 0.32, 0.16, 0.03, Color3.fromRGB(30, 154, 74), Enum.Material.Neon)
					sk.Transparency = 0.1
					del(" utrymningsskylt piktogram", 0, op.h + tj + 0.17, 0.07, 0.20, 0.10, 0.01, Color3.fromRGB(232, 245, 236), Enum.Material.SmoothPlastic)
				end
			end
		end
	end

	--[[ F02-B: det som stod framme på banan fanns bara i webben — hindren,
		konerna och uppsittningspallen (RIDHUSINNE.hinder/koner/pall, ur
		interiörfotona; lägena är ASSUMPTION). Nu samma tal här. ]]
	for i, h in ipairs(R.hinder or {}) do
		local bx, bz = o.x + R.bana.x + h.x, o.y + R.bana.y + h.y
		local bomFarg = if h.farg == "bla" then Color3.fromRGB(58, 110, 165) else Color3.fromRGB(192, 57, 43)
		for _, s in ipairs({ -1, 1 }) do
			BK.box(model, base, "Hinderstöd " .. i .. (if s < 0 then " V" else " H"),
				bx + s * h.b / 2 - 0.05, 0, bz - 0.05, 0.10, 1.5, 0.10,
				Color3.fromRGB(240, 237, 230), Enum.Material.SmoothPlastic)
		end
		BK.box(model, base, "Hinderbom " .. i,
			bx - h.b / 2, math.max(0.02, h.h), bz - 0.045, h.b, 0.09, 0.09,
			bomFarg, Enum.Material.SmoothPlastic).CanCollide = false
	end
	for i, k in ipairs(R.koner or {}) do
		BK.box(model, base, "Kon " .. i,
			o.x + R.bana.x + k[1] - 0.15, 0, o.y + R.bana.y + k[2] - 0.15, 0.30, 0.45, 0.30,
			Color3.fromRGB(232, 228, 218), Enum.Material.SmoothPlastic).CanCollide = false
	end
	if R.pall then
		BK.box(model, base, "Uppsittningspall",
			o.x + R.bana.x + R.pall.x - 0.45, 0, o.y + R.bana.y + R.pall.y - 0.5, 0.9, 0.57, 1.0,
			Color3.fromRGB(196, 168, 126), Enum.Material.Wood)
	end
	--[[ Lysrörsraderna längs hallen (RIDHUSINNE.lysror): VERIFIED att de
		finns och löper längs; delningen är ASSUMPTION. Delat tal nu. ]]
	if R.lysror then
		local ly = R.lysror
		local n = 0
		for _, andel in ipairs(ly.andelar) do
			local x = R.bredd * andel
			local y = 4
			while y < R.langd - 2 do
				n += 1
				BK.box(model, base, "Lysrör " .. n,
					o.x + x - ly.bredd / 2, R.tak - ly.underTak, o.y + y - ly.langd / 2, ly.bredd, 0.08, ly.langd,
					ly.farg, Enum.Material.Neon).CanCollide = false
				y += ly.delning
			end
		end
	end

	-- Inredningen ur G.inredning.ridhus (F02-B): speglarna, hinderupplaget på
	-- läktardäcket, skåpkorridorens skåp och stolar, entréns bänk.
	byggInredning(model, base, o, G.inredning and G.inredning.ridhus, "Inredning")
end

local model, base = BK.newBuilding("UBRF", Vector3.new(0, 0, 0), 0, {
	Referens = "references/SITEPLAN.md",
	Geometri = "roblox/buildings/UBRFKomplex.luau (genererad ur src/site.js)",
})

byggMark(model, base)
for _, b in ipairs(G.byggnader) do byggHus(model, base, b) end
byggStallInre(model, base)
byggRidhusInre(model, base)
byggStallIdentitet(model, base)
byggRidhusIdentitet(model, base)
byggStaket(model, base)
byggMaster(model, base)
if QA_MARKORER then byggDorrmarkorer(model, base) end
byggSpawn(model, base)

print(("OK UBRF byggd: %d byggnader, %d dörrar, %d boxrader, %d gångytor, %d objekt")
	:format(#G.byggnader, #G.dorrar, #G.stall.rader, #G.stall.gangytor,
		#model:GetDescendants()))

-- Ankomstvyn: stå på grusplanen vid de norra gavlarna och titta söderut mot
-- hästgången, samma vy som webbversionen verifieras mot. Husen ska läsa som
-- ETT komplex härifrån, inte som två fristående lador.
-- BK.cameraLike(base, 148, 130, 148, 106)
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX38">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX39">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBX40">
				<Properties>
					<string name="Name">Horse</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Klientens start och den enda uppdateringsloopen.

	En loop, inte en per delsystem. Det är skillnaden mellan tio hästar och
	hundra: varje extra Heartbeat-koppling kostar även när den inte gör
	något, och ordningen mellan delsystemen blir odefinierad om de har varsin.

	Ordningen här är inte godtycklig:
	  1. inmatning   — avsikten läses en gång per bildruta
	  2. rörelse     — tillstånd och fart räknas fram
	  3. animation   — läser tillståndet, skriver benen
	  4. ryttare     — IK ovanpå benen
	  5. ljud, damm  — läser fasen
	  6. kamera      — sist, så den ser slutgiltig position
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Core = require(game:GetService("ReplicatedStorage").HorseCore)
local Config, RigAdapter, Net = Core.Config, Core.RigAdapter, Core.Networking
local Telemetri = require(game:GetService("ReplicatedStorage").HorseCore.Telemetri)

local Input = require(script.Input)
local TouchControls = require(script.TouchControls)
local MovementController = require(script.MovementController)
local AnimationController = require(script.AnimationController)
local CameraController = require(script.CameraController)
local SoundController = require(script.SoundController)
local EffectsController = require(script.EffectsController)
local RiderController = require(script.RiderController)
local InteractionController = require(script.InteractionController)
local PreparationController = require(script.PreparationController)
local UgnetaController = require(script.UgnetaController)
local LektionController = require(script.LektionController)
local KontrollHjalp = require(script.KontrollHjalp)
local Debug = require(script.Debug)
local Genomsikt = require(script.Genomsikt)

local player = Players.LocalPlayer
local ride: { [string]: any }? = nil

--[[ POSEN TILL INSPELNINGEN (G02-D).

     Inspelningen behöver VAR hästen var och ÅT VILKET HÅLL hon stod. Båda
     läses ur riggens root, och båda kan saknas i den bildruta där riggen
     håller på att rivas.

     Kontrollerna är explicita typtest, inte ett pcall. Ett pcall runt den
     här avläsningen hade svalt varje annat fel i samma andetag — och det
     är precis så en riktig krasch blir osynlig i stället för åtgärdad.

     Fälten valideras var för sig i HorseCore/Inspelning: en pose där
     positionen är omätbar men riktningen är ett riktigt tal BEHÅLLER
     riktningen. Att kasta hela posen för ett trasigt fält hade tappat en
     yaw som faktiskt var mätt. ]]
local function poseAv(rig: { [string]: any }?): { [string]: any }?
	if type(rig) ~= "table" then return nil end
	local root = rig.root
	if not root then return nil end
	local pos = root.Position
	local cf = root.CFrame
	if pos == nil or cf == nil then return nil end
	local _, yaw = cf:ToOrientation()
	return { x = pos.X, z = pos.Z, yaw = yaw }
end

local function dismount()
	if not ride then return end
	Telemetri.sittAv(ride.ritt)
	Input.unbind()
	TouchControls.unmount()
	ride.movement:release()
	ride.animation:release()
	ride.camera:release()
	ride.sound:release()
	ride.effects:release()
	ride.rider:release()
	--[[ SÄKERHET FÖRE UNDERVISNING (G02-C). Ritten är slut — av vilket
	     skäl som helst, och flera av dem ÄR säkerhetshändelser: karaktären
	     försvinner, riggen är borta ur workspace, servern flyttar
	     uppsittningen. Lärarytan släcks här, i samma andetag som resten av
	     ekipaget rivs, så att "Bra rytm" aldrig blir kvar på skärmen. ]]
	LektionController.avbryt()
	--[[ Hjälpen hör till ritten. Den ska inte ligga kvar över en spelare
	     som just klivit av. ]]
	KontrollHjalp.dolj()
	Debug.clear()
	InteractionController.setEnabled(true)
	ride = nil
end

--[[ SPELAREN BEGÄR AVSITTNING — lokalt först, servern sedan.

	Förut gjorde både E-vägen och touchkontrollen `InvokeServer()` FÖRE
	`dismount()`. `InvokeServer` yieldar, så ett långsamt eller uteblivet
	serversvar lämnade lektionen igång, den väntande fortsättningen kvar
	och lärarytan uppe — efter att spelaren bett om att få sitta av. Det
	är oförenligt med att säkerhet går före undervisning (senior review av
	b303530, punkt 1).

	Ordningen är därför omvänd:

	  1. `dismount()` städar LOKALT och omedelbart — lärarytan släcks, den
	     väntande fortsättningen kastas, touchkontrollerna rivs och
	     inmatningen kopplas ur. Inget av det behöver serverns tillstånd.
	  2. Serveranropet läggs i en egen tråd, så att svarstiden aldrig kan
	     hålla kvar något lokalt.

	SERVERN ÄGER FORTFARANDE SANNINGEN. Den validerar avsittningen, och
	nekar den skickar den `MountChanged` — då sätter klienten upp igen på
	serverns ord, vilket är en legitim rättelse och inte en egen
	uppsittning. `dismount` är idempotent (`if not ride then return end`),
	och vakten här gör att upprepade tryck varken städar två gånger eller
	skickar en andra begäran. ]]
local function begarAvsittning()
	if not ride then return end
	dismount()
	task.spawn(function()
		local ok, err = pcall(function()
			Net.get("DismountRequest"):InvokeServer()
		end)
		if not ok then
			--[[ Uteblivet eller felande svar får inte återuppliva något
			     lokalt. Servern rättar oss via MountChanged om den vill. ]]
			warn("[Horse] DismountRequest misslyckades: " .. tostring(err))
		end
	end)
end

local function mount(model: Model)
	if ride then dismount() end

	local rig, err = RigAdapter.build(model)
	if not rig then
		warn("[Horse] " .. tostring(err))
		return
	end
	local stats = Config.resolveStats(rig.stats)

	ride = {
		model = model,
		rig = rig,
		stats = stats,
		movement = MovementController.new(rig, stats),
		animation = AnimationController.new(rig, stats),
		camera = CameraController.new(rig),
		sound = SoundController.new(rig, stats),
		effects = EffectsController.new(rig),
		rider = RiderController.new(rig),
		--[[ G02-A: ridningens tillstånd och telemetri, samma kontrakt som
		     webbens src/riding/telemetri.js. Sätts FÖRE första bildrutan
		     av samma skäl som på webben — annars finns ett fönster där
		     loopen kan läsa en avsutten ryttare mitt i en ritt. ]]
		ritt = Telemetri.sittUpp(Telemetri.nyRitt(), model.Name, "ridhus"),
		telemetri = nil :: { [string]: any }?,
		syncTimer = 0,
	}

	local character = player.Character
	if character then
		ride.rider:attach(character)
	end

	Input.bind()
	--[[ Pekkontrollerna byggs först här, och bara på en pekenhet: en
	     spelare vid tangentbordet ska inte få en spak över bilden. De river
	     sig själva i `dismount`, så de kan aldrig ligga kvar och styra en
	     häst man klivit av. ]]
	TouchControls.mount(Input, { dismount = begarAvsittning })
	InteractionController.setEnabled(false)
	Debug.attach(rig, stats)

	--[[ G02-C: lektionen börjar när man sitter upp i ridhuset. Ugneta
	     ställer sig vid sargen och undervisningen kör i den ordinarie
	     loopen nedan — det är hela skillnaden mot en HUD som bara går att
	     anropa. Gestalten placeras mot den BYGGDA banan; hittas den inte
	     körs lektionen ändå, utan figur. ]]
	--[[ Hela anläggningen är EN modell, "UBRF" i mappen "Anläggning"
	     (BuildKit.newBuilding i roblox/buildings/Anlaggningen.luau).
	     Ridbanan och sargen hänger direkt under den. ]]
	local anlaggning = workspace:FindFirstChild("Anläggning")
	LektionController.start(anlaggning and anlaggning:FindFirstChild("UBRF"))
	--[[ Första uppsittningen: visa reglagen en gång, av sig själv. Då är
	     frågan "vad gör jag nu?" som mest aktuell. ]]
	KontrollHjalp.vidUppsittning()

	local missing = (ride.animation :: any).missing
	if missing and #missing > 0 then
		warn(("[Horse] Saknade animationer (%d): %s")
			:format(#missing, table.concat(missing, ", ")))
	end
end

--[[ Inomhusläsbarhet, till fots och till häst: väggar mellan kameran och
     karaktären tonas på den här klienten. ]]
Genomsikt.start()

InteractionController.start(mount)

--[[ Förberedelsen. Prompten "Sitt upp" får bara finnas på den häst servern
     säger att spelaren är klar med — och `redo` läses ur den senast
     mottagna `PreparationSync`, aldrig ur något klienten räknat ut själv. ]]
InteractionController.setReadyCheck(function(model: Model): boolean
	local id = PreparationController.hastId()
	if not id then return false end
	if model:GetAttribute("HorseId") ~= id then return false end
	return PreparationController.redo()
end)
--[[ Prompt-uppdateringen hänger på ATT EN NY VY ACCEPTERATS, inte på
     RemoteEvent-händelsen. Skillnaden är hela rättelsen efter senior review
     runda 2: handskakningens svar kommer inte som en `PreparationSync`, så
     en andra listener på det eventet missade det helt och en sent
     initierad klient fick aldrig sin "Sitt upp"-prompt. ]]
PreparationController.vidNyVy(function()
	InteractionController.uppdatera()
end)
PreparationController.start()
--[[ G02-C: Ugnetas lärar-UX byggs vid uppstart så att den finns när
     första ritten börjar. Själva LEKTIONEN startas av `mount` och stegas
     av loopen längst ned — HUD:en är ytan, LektionController är kedjan. ]]
UgnetaController.start()
--[[ #161: `?`-knappen byggs vid uppstart och lever hela sessionen. Att
     bygga den vid uppsittning hade gett samma hål vi just stängde — hjälpen
     ska finnas i stallet också. ]]
KontrollHjalp.start()

--[[ Servern talar om när uppsittningen ändras — även när den ändras av
     något annat än oss, som respawn eller att hästen tas bort. ]]
Net.get("MountChanged").OnClientEvent:Connect(function(model: Model, rider: Player?)
	if rider == player then
		if not ride or ride.model ~= model then
			mount(model)
		end
	elseif ride and ride.model == model then
		dismount()
	end
end)

--[[ Servern äger energin; klienten predikterar mellan synkarna och
     RÄTTAS här (senior re-review #87, blocker 3). Utan rättelsen hade
     klienten och servern varit två trötthetssanningar igen — nu är
     klientens värde en prediktion av serverns, inte en egen modell. ]]
Net.get("StaminaSync").OnClientEvent:Connect(function(stamina, max, ceiling, energi)
	if ride then
		ride.movement:setCeiling(ceiling)
		if energi ~= nil then ride.movement:setEnergi(energi) end
		Debug.setStamina(stamina, max, ceiling)
	end
end)

--[[ Sitt av med E, och alltid om karaktären dör. Lektionens fortsättning
     ligger före avsittningen: den är ett svar på ett kort som står uppe,
     och får aldrig kunna tolkas som något annat. ]]
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end

	--[[ HJÄLPEN LIGGER FÖRE `not ride`-GRINDEN, och det är rättelsen i
	     #161 (P2-4b ur #153).

	     Hela den här lyssnaren började med `if processed or not ride then
	     return end`, vilket var rätt för avsittning och lektionskort — de
	     betyder ingenting när man står i stallet. Men det gällde alltså
	     ÄVEN `H`: kontrollhjälpen gick bara att öppna medan man satt upp,
	     och att stänga den och sitta av var samma sak som att bli av med
	     den. Det var precis den oåterkalleliga stängningen QA rapporterade.

	     `DPadUp` är gamepadens väg in, kontrollerat ledig: Input.luau tar
	     Thumbstick1, ButtonA/B/R1/L1/R2/L2 och den här filen tar
	     ButtonY/ButtonX. Styrkorset rörs av ingen av dem, och till
	     skillnad från ButtonStart/ButtonSelect är det inte reserverat av
	     Roblox egna menyer. Ingen befintlig rid-, hopp- eller
	     replaybindning har flyttats. ]]
	if input.KeyCode == Enum.KeyCode.H
		or input.KeyCode == KontrollHjalp.GAMEPADKNAPP then
		KontrollHjalp.vaxla()
		return
	end

	if not ride then return end
	--[[ G02-C: spelaren går vidare i lektionen. R och gamepadens Y är
	     valda för att de INTE är bundna i ridningen — Input.luau tar
	     W A S D, Space, Shift, Ctrl, Q, F, Z, C och ButtonA/B/R1/L1, och
	     E betyder redan sitt av. Musen och fingret går in genom knappens
	     eget Activated, inte här.

	     `fortsatt` returnerar false när inget kort väntar, så tangenten
	     stjäl ingenting när lektionen inte frågar. ]]
	if input.KeyCode == Enum.KeyCode.R or input.KeyCode == Enum.KeyCode.ButtonY then
		--[[ Står ridanalysen uppe betyder R "tillbaka", inte "vidare":
		     panelen ligger ovanpå kortet, och den översta ytan äger
		     tangenten. Utan det hade ett R stängt kortet BAKOM panelen och
		     lämnat analysen kvar över nästa försök. ]]
		if LektionController.replayAktiv() then
			LektionController.stangReplay()
			return
		end
		if LektionController.fortsatt() then return end
	end
	--[[ G02-D: "Se ritten". T och gamepadens X är valda av samma skäl som
	     R och Y — Input.luau tar dem inte, och E betyder redan sitt av. ]]
	if input.KeyCode == Enum.KeyCode.T or input.KeyCode == Enum.KeyCode.ButtonX then
		if LektionController.replayAktiv() then
			LektionController.stangReplay()
			return
		end
		if LektionController.replay() then return end
	end
	--[[ "Gå vidare": nöj dig med försöket. Momentet bedöms ändå. ]]
	if input.KeyCode == Enum.KeyCode.G then
		if LektionController.gaVidare() then return end
	end
	--[[ H och styrkorset hanteras ovanför `not ride`-grinden — se noten
	     där. Tangenten är fri: Input.luau tar W A S D, Space, Shift, Ctrl,
	     Q, F, Z, C och spakarna, och E/R/T/G är tagna här. ]]
	--[[ AVSITTNING PÅ BÅDA YTORNA (#162 blockerare 2). `E` var enda vägen
	     ned, och den finns inte på en handkontroll: en gamepadspelare kom
	     upp genom ProximityPrompten och satt sedan fast. Knappen kommer ur
	     `KontrollHjalp.AVSITTNING_GAMEPAD` så att bindningen, hjälptexten
	     och kontrollmatrisen inte kan glida isär. ]]
	if input.KeyCode == Enum.KeyCode.E
		or input.KeyCode == KontrollHjalp.AVSITTNING_GAMEPAD then
		begarAvsittning()
	end
end)

player.CharacterRemoving:Connect(dismount)

RunService.RenderStepped:Connect(function(dt)
	if not ride then return end
	if not ride.rig.root:IsDescendantOf(workspace) then
		dismount()
		return
	end

	--[[ PAUS: världen ritas fortfarande — spelaren ska se var hon står —
	     men hästen stegas inte. Utan det red hon vidare bakom kortet och
	     bakom ridanalysen, och det försök spelaren just tittade på hann bli
	     ogiltigt medan hon tittade.

	     `Input.consume()` körs ÄNDÅ och kastas. Den nollställer
	     engångsflankerna (gångart upp/ner, parad); låg de kvar hade varje
	     tryck under pausen fyrat på en gång när pausen släppte. En impuls
	     ska verka en gång, i den bildruta den gjordes — inte sparas. ]]
	if LektionController.vantar() or LektionController.replayAktiv() then
		Input.consume()
		local loco = ride.movement.loco
		ride.animation:step(loco, dt)
		ride.rider:step(loco, dt)
		ride.camera:step(loco, dt)
		return
	end

	local intent = Input.consume()
	ride.movement:step(intent, dt)

	local loco = ride.movement.loco

	--[[ G02-A: gångarten följs av övergångskontraktet och telemetrin läggs
	     på ride.telemetri, så att G02-B/C har EN avläsningspunkt på båda
	     ytorna. REN AVLÄSNING — modulen räknar ingen fysik, rör ingen
	     Instance och ligger efter movement:step, så den kan varken ändra
	     rörelsen eller ridkänslan. ]]
	Telemetri.foljGangart(ride.ritt, loco.gait)
	ride.telemetri = Telemetri.las(ride.ritt, loco, ride.movement.curvature,
		ride.movement.hjalper)

	--[[ G02-C: lektionen läser telemetrin som just skrivits. Den ligger
	     EFTER avläsningen och FÖRE renderingen av samma skäl som allt
	     annat i den här ordningen: den ska se bildrutans mätning, inte
	     förra bildrutans, och den rör varken rörelse eller kamera. ]]
	LektionController.steg(dt, ride.telemetri, poseAv(ride.rig))

	ride.animation:step(loco, dt)
	ride.rider:step(loco, dt)
	ride.sound:step(loco, dt)
	ride.effects:step(loco, dt)
	ride.camera:step(loco, dt)
	Debug.step(loco)

	--[[ Servern behöver inte 60 uppdateringar i sekunden för att validera
	     en gångart. Tio räcker, och skillnaden märks direkt i bandbredd när
	     flera spelare rider samtidigt. ]]
	ride.syncTimer += dt
	if ride.syncTimer >= 0.1 then
		ride.syncTimer = 0
		Net.get("StateSync"):FireServer(loco.gait, loco.speed)
	end
end)

print("[Horse] Klienten igång")
]]></ProtectedString>
				</Properties>
				<Item class="ModuleScript" referent="RBX41">
					<Properties>
						<string name="Name">AnimationController</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Animationslagret.

	Skilt från rörelsen med flit: den här modulen läser tillstånd och fart,
	och rör aldrig fysik. Byter man animationspaket är det bara den här
	modulen och AnimationConfig som berörs.

	Tre saker gör att det ser dyrt ut i stället för billigt:

	  1. Övertoning mellan spår. Ett spår stannar aldrig tvärt.
	  2. De cykliska gångarterna spolas av `loco.phase`, alltså av
	     tillryggalagd sträcka, inte av en klocka. Hovarna landar därmed där
	     marken är även när bildfrekvensen svajar. Utan det ser hästen ut att
	     åka skridskor.
	  3. Händelseklippen (hopp, landning, stopp, vändning) spelas av sin egen
	     klocka med farten som fart, klampad till [0,72 ; 1,32]. Räcker inte
	     bandet ska gångarten byta i stället — det är därför gångartsbanden
	     överlappar.
]]

local Core = require(game:GetService("ReplicatedStorage").HorseCore)
local Types = require(game:GetService("ReplicatedStorage").HorseCore.Types)
local Config, Gaits, RigAdapter = Core.Config, Core.Gaits, Core.RigAdapter

local AnimationController = {}
AnimationController.__index = AnimationController

function AnimationController.new(rig: Types.Rig, stats: { [string]: any })
	local self = setmetatable({}, AnimationController)
	self.rig = rig
	self.stats = stats
	self.temperament = Config.TEMPERAMENTS[stats.Temperament] or Config.TEMPERAMENTS.Calm
	self.tracks = {} :: { [string]: AnimationTrack }
	self.current = nil :: string?
	self.idleTimer = 0
	self.variantTrack = nil :: AnimationTrack?
	self:_load()
	return self
end

--[[ Id:na är attribut på AnimationConfig, inte konstanter i kod. Saknas ett
     id hoppas spåret över tyst — hästen rör sig ändå, den blir bara stel i
     just det tillståndet. Ett saknat id ska aldrig stoppa spelet. ]]
function AnimationController:_load()
	local config = self.rig.animConfig
	for _, key in Config.ANIMATION_KEYS do
		local id = Config.attr(config, key, "")
		if typeof(id) == "string" and id ~= "" then
			local anim = Instance.new("Animation")
			anim.Name = key
			anim.AnimationId = if id:match("^rbxassetid://") then id else "rbxassetid://" .. id
			local ok, track = pcall(function()
				return self.rig.animator:LoadAnimation(anim)
			end)
			if ok and track then
				self.tracks[key] = track
			else
				warn(("[Horse] Kunde inte ladda animationen %s (%s)"):format(key, anim.AnimationId))
			end
		end
	end
	self.missing = {}
	for _, key in Config.ANIMATION_KEYS do
		if not self.tracks[key] then
			table.insert(self.missing, key)
		end
	end
end

function AnimationController:_play(key: string, fade: number, looped: boolean)
	local track = self.tracks[key]
	if not track then return end
	track.Looped = looped
	track.Priority = Enum.AnimationPriority.Movement
	if not track.IsPlaying then
		track:Play(fade)
	end
end

function AnimationController:_stopAllExcept(key: string?, fade: number)
	for name, track in self.tracks do
		if name ~= key and track.IsPlaying and track ~= self.variantTrack then
			track:Stop(fade)
		end
	end
end

--[[ Idle-varianterna är det som gör att en stillastående häst ser levande
     ut i stället för fryst. De läggs ovanpå grund-idle med högre prioritet
     och tar slut av sig själva. Lynnet styr hur ofta de kommer. ]]
function AnimationController:_stepIdleVariation(loco: Types.Locomotion, dt: number)
	if loco.state ~= "Idle" then
		self.idleTimer = 0
		return
	end
	self.idleTimer += dt
	local interval = self.temperament.idleInterval * (0.7 + math.random() * 0.6)
	if self.idleTimer < interval then return end
	self.idleTimer = 0

	local candidates = {}
	for _, key in Config.IDLE_VARIANTS do
		if self.tracks[key] then table.insert(candidates, key) end
	end
	if #candidates == 0 then return end

	local track = self.tracks[candidates[math.random(#candidates)]]
	track.Looped = false
	track.Priority = Enum.AnimationPriority.Action
	track:Play(0.25)
	self.variantTrack = track
end

function AnimationController:step(loco: Types.Locomotion, dt: number)
	local entry = Config.STATE_ANIMATION[loco.state]
	if not entry then return end

	--[[ Sväng på stället har två klipp; välj efter riktning. ]]
	local key = entry.key
	if loco.state == "TurningInPlace" then
		key = if loco.turnRate < 0 then "TurnLeft" else "TurnRight"
		if not self.tracks[key] then key = "Idle" end
	end

	if key ~= self.current then
		self:_stopAllExcept(key, entry.fade)
		self:_play(key, entry.fade, entry.looped)
		self.current = key
	end

	--[[ ── VEM SPOLAR KLIPPET ───────────────────────────────────────────
	     Förut stod det bara `AdjustSpeed(playbackRate)` här, alltså:
	     klippet spelas av Roblox egen klocka, och vi justerar farten.

	     Det gav TVÅ klockor i samma häst. `loco.phase` räknas distanslåst i
	     `MovementController` — tillryggalagd sträcka delat med gångartens
	     cykellängd — och `SoundController` lägger hovljuden på just den
	     fasen. Benen följde en annan tid än ljudet.

	     De gled isär precis när det syns mest. `playbackRate` är klampad
	     till [0,72 ; 1,32]: utanför bandet går benen med fel takt medan
	     fasen fortsatte rätt. Och `AdjustSpeed` är en ÖNSKAN — blir
	     bildrutan lång, hästen krockar eller terrängen bromsar, så fortsatte
	     klippet ändå medan hästen stod still. Hovljudet tystnade, benen
	     trampade vidare i luften.

	     Nu spolas de cykliska gångarterna av fasen i stället. `TimePosition`
	     är inte en önskan utan ett läge, och samma sträcka ger samma
	     benställning oavsett vad bildfrekvensen gjorde på vägen. Ljud, damm
	     och ben läser därmed EN klocka, och den klockan är marken.

	     `AdjustSpeed(0)` är nödvändig och inte prydnad: utan den skulle
	     Roblox egen framdrivning ligga kvar ovanpå vår spolning och lägga
	     till en halv bildruta i taget — samma glid som vi just tog bort.

	     `Length` är 0 innan klippet hämtats från servern. Då faller vi
	     tillbaka på klockan: hellre en häst som går något fel de första
	     bildrutorna än en häst som står fastfrusen i ruta ett. ]]
	local track = self.tracks[key]
	if track and track.IsPlaying then
		if entry.phase and track.Length > 0 then
			track:AdjustSpeed(0)
			track.TimePosition = (loco.phase % 1) * track.Length
		else
			track:AdjustSpeed(Gaits.playbackRate(loco.gait, math.abs(loco.speed)))
		end
	end

	self:_stepIdleVariation(loco, dt)
	self:_stepProcedural(loco, dt)
end

--[[ Procedurell påbyggnad. Subtil med flit: den ska kännas, inte synas.
     Skrivs efter att animationen uppdaterat benen. Saknas benen händer
     ingenting alls — då tappar man polish, inte spel. ]]
function AnimationController:_stepProcedural(loco: Types.Locomotion, dt: number)
	local gain = self.temperament.reactGain
	local speedFraction = math.clamp(math.abs(loco.speed) / 9, 0, 1)

	-- Halsen leder svängen något. En häst tittar dit den ska.
	local neckYaw = math.clamp(-loco.turnRate * 0.22, -0.20, 0.20) * gain
	RigAdapter.setBoneOffset(self.rig, "Neck01", CFrame.Angles(0, neckYaw * 0.5, 0))
	RigAdapter.setBoneOffset(self.rig, "Head", CFrame.Angles(0, neckYaw * 0.5, 0))

	-- Svansen svänger med farten.
	local t = os.clock()
	local swish = math.sin(t * (1.4 + speedFraction * 3.0)) * (0.05 + speedFraction * 0.10) * gain
	RigAdapter.setBoneOffset(self.rig, "TailBase", CFrame.Angles(0, swish, 0))

	-- Öronen rör sig oberoende, sällan och olika.
	RigAdapter.setBoneOffset(self.rig, "LeftEar",
		CFrame.Angles(math.sin(t * 0.9) * 0.05 * gain, 0, 0))
	RigAdapter.setBoneOffset(self.rig, "RightEar",
		CFrame.Angles(math.sin(t * 1.13 + 2.0) * 0.05 * gain, 0, 0))
end

function AnimationController:release()
	for _, track in self.tracks do
		if track.IsPlaying then track:Stop(0.2) end
	end
	self.current = nil
end

return AnimationController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX42">
					<Properties>
						<string name="Name">CameraController</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Ridkameran.

	STANDARD ÄR SADELN (G02-E del 1, issue #150, Tobias produktbeslut
	2026-09-08). Fram till dess låg kameran på en bom 14–23 studs BAKOM
	hästen: en tredjepersonskamera, alltså vyn av att se sig själv rida.
	Beslutet är att standardvyn ska vara RYTTARENS — vyn från sadeln, med
	hästens hals och öron och vägen framåt.

	Kameran har därför två färdiga mål varje bildruta:

	  A. SADELN — ögonpunkten hämtas ur den uppsuttna karaktärens EGET
	     huvud (`Head`), alltså ur riggen och sitsen som redan finns.
	     Ingen uppfunnen ögonhöjd och inga anläggningskoordinater.
	  B. BOMMEN — den gamla utifrånvyn, oförändrad tal för tal, numera
	     utlånad som feedbackvinkeln `utifran`.

	`Kameralage` ger vikten mellan dem: 0 är sadeln, 1 är vinkeln, och
	kameran interpolerar. En halv vikt är en kamera på väg — inte ett
	tredje specialfall som kan gå sönder för sig.

	Bommen ändrar sig med gångarten: närmare och lugnare i skritt, längre
	bak och vidare i fyrsprång. Synfältet öppnar sig svagt i fart — den
	billigaste och tydligaste fartkänslan som finns.

	INGEN SKAKNING. Skakning läser som skada, inte som fart, och gör folk
	åksjuka i förstapersonsnära vinklar — vilket sadelvyn per definition
	är. Sadeln LÄGGER därför inte till någon rörelse. Den DÄMPAR den
	riggen redan har: höjdled mjukas hårt och klampas mot huvudets
	faktiska läge, sidled sitter nästan stelt. Man ska sitta i sadeln,
	inte sväva bredvid den.

	Kameran har en EGEN kurs som följer hästens med en kort fördröjning.
	Läser den hästens kurs rakt av sitter den stelt fastskruvad i nacken,
	och varje styrutslag rycker hela bilden — det är den vanligaste
	orsaken till att en tredjepersonskamera känns instabil. Med en egen
	kurs svänger hästen först och bilden hinner ifatt. I sadeln är
	fördröjningen kortare: där ÄR man ryttaren, och en ryttare vrider
	huvudet in i svängen tidigare än en släpande bom gör.
]]

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Core = require(game:GetService("ReplicatedStorage").HorseCore)
local Types = require(game:GetService("ReplicatedStorage").HorseCore.Types)
local Config, Gaits, Kameralage = Core.Config, Core.Gaits, Core.Kameralage

local CameraController = {}
CameraController.__index = CameraController

local function smooth(current: number, target: number, tau: number, dt: number): number
	if tau <= 0 then return target end
	return current + (target - current) * (1 - math.exp(-dt / tau))
end

--[[ Samma utjämning för en vinkel. Skillnaden räknas via den korta vägen
     runt cirkeln, annars snurrar kameran ett helt varv varje gång hästens
     kurs passerar noll. ]]
local TWO_PI = 2 * math.pi
local function smoothAngle(current: number, target: number, tau: number, dt: number): number
	local delta = (target - current + math.pi) % TWO_PI - math.pi
	if tau <= 0 then return target end
	return current + delta * (1 - math.exp(-dt / tau))
end

function CameraController.new(rig: Types.Rig)
	local self = setmetatable({}, CameraController)
	self.rig = rig
	self.camera = Workspace.CurrentCamera
	self.dist = Config.CAMERA.BaseFov and 15 or 15
	self.height = 5.2
	self.fov = Config.CAMERA.BaseFov
	self.yaw = math.atan2(rig.root.CFrame.LookVector.X, rig.root.CFrame.LookVector.Z)
	self.previousType = self.camera.CameraType
	self.previousFov = self.camera.FieldOfView
	self.camera.CameraType = Enum.CameraType.Scriptable
	--[[ G02-E del 1: läget ägs här, en instans per ritt. Det rivs i
	     `release`, som `dismount` redan anropar — så ingen begäran kan
	     överleva en avsittning och tändas på nästa häst. ]]
	self.lage = Kameralage.skapa()
	self.eye = nil :: Vector3?          -- dämpad ögonpunkt i sadeln
	self.dolda = {} :: { [BasePart]: number }  -- eget huvud som tonats bort
	return self
end

--[[ ── Ögonpunkten i sadeln ─────────────────────────────────────────
     Karaktären sitter i `RiderSeat`, så dess `Head` ÄR ryttarens huvud.
     Ögonen ligger i huvudets framkant, och den kanten läses ur delens
     egen storlek i stället för att gissas: ändras huvudmodellen följer
     kameran med.

     Saknas karaktären finns ingen sadel att sitta i. Då säger funktionen
     nil och kameran faller tillbaka på bommen — hellre den gamla kända
     vyn än en påhittad punkt i luften. Samma degradering som resten av
     modulerna: saknas underlaget händer ingenting. ]]
local function ogonpunkt(): (Vector3?, BasePart?)
	local player = game:GetService("Players").LocalPlayer
	local character = player and player.Character
	if not character then return nil, nil end
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then return nil, nil end
	return head.Position + head.CFrame.LookVector * (head.Size.Z * 0.5), head
end

--[[ Ditt eget huvud sitter runt objektivet i sadeln, och ett huvud som
     ritas ovanpå kameran är bara en vägg. Det tonas bort med
     `LocalTransparencyModifier` — bara på den här klienten, precis som
     Genomsikt gör med väggar. Resten av kroppen lämnas: armar, händer,
     tyglar och ben är vad man SKA se från sadeln. ]]
function CameraController:_egetHuvud(alfa: number, head: BasePart?)
	local player = game:GetService("Players").LocalPlayer
	local character = player and player.Character
	if not character then return end
	local delar: { BasePart } = {}
	if head then table.insert(delar, head) end
	--[[ `GetChildren` finns på varje riktig Instance, men karaktären kan
	     i en degraderad/ofullständig respawn vara ett placeholder-objekt
	     som ännu inte har den (samma "rätt sorts degradering" som
	     `ogonpunkt()` ovan redan tillämpar på `FindFirstChild`). Ett
	     saknat huvud/accessoarer är då rätt svar — inte en krasch. ]]
	if typeof(character.GetChildren) == "function" then
		for _, barn in character:GetChildren() do
			if barn:IsA("Accessory") then
				local handle = barn:FindFirstChild("Handle")
				if handle and handle:IsA("BasePart") then table.insert(delar, handle) end
			end
		end
	end
	for _, del in delar do
		if self.dolda[del] == nil then self.dolda[del] = del.LocalTransparencyModifier end
		del.LocalTransparencyModifier = 1 - alfa
	end
end

function CameraController:_aterstallHuvud()
	for del, varde in self.dolda do
		if del and del.Parent then del.LocalTransparencyModifier = varde end
	end
	table.clear(self.dolda)
end

--[[ ── Kameralägets API ─────────────────────────────────────────────
     Finns för att DEL 2 ska kunna be om en vinkel utan att röra kameran
     själv. Ingen händelse är kopplad ännu — det är uttryckligen inte
     auktoriserat i den här leveransen. ]]
function CameraController:begarFeedback(id: string, orsak: string?): boolean
	return Kameralage.begar(self.lage, id, orsak)
end
function CameraController:slappFeedback(orsak: string?): boolean
	return Kameralage.slapp(self.lage, orsak)
end
function CameraController:nollstallLage(orsak: string?): boolean
	return Kameralage.nollstall(self.lage, orsak)
end

function CameraController:step(loco: Types.Locomotion, dt: number)
	local gait = Gaits.get(loco.gait)
	local C = Config.CAMERA
	local S = C.Saddle

	--[[ Läget stegas med samma dt som kameran, aldrig med väggklockan.
	     Det är vad som gör den automatiska återgången deterministisk. ]]
	local KL = Kameralage.stega(self.lage, dt)

	self.dist = smooth(self.dist, gait.camera.dist * KL.bak, C.Tau, dt)
	self.height = smooth(self.height, gait.camera.height * KL.hojd, C.Tau, dt)
	self.fov = smooth(self.fov,
		math.min((C.BaseFov + gait.camera.fov) * KL.fov, C.MaxFov), C.Tau, dt)

	local root = self.rig.root
	--[[ Kamerans egen kurs, inte hästens. Fördröjningen är kort nog att
	     man aldrig tappar bort vart man är på väg, och lång nog att
	     styrutslag inte rycker i bilden. Den glider med vikten, så att det
	     bara finns EN kurs att hålla reda på. ]]
	local w = math.clamp(KL.vikt, 0, 1)
	local yawTau = S.YawTau + (C.YawTau - S.YawTau) * w
	self.yaw = smoothAngle(self.yaw, loco.heading, yawTau, dt)
	local heading = self.yaw
	local framat = Vector3.new(math.sin(heading), 0, math.cos(heading))
	local back = -framat
	local right = Vector3.new(math.cos(heading), 0, -math.sin(heading))

	--[[ ── MÅL B: BOMMEN ────────────────────────────────────────────
	     Oförändrad. Feedbackvinkeln vrider bommen runt hästen och skalar
	     dess tal; vid vikt 1 och vinkeln `utifran` är uttrycket exakt det
	     gamla, tal för tal.

	     Kameran hänger efter i svängen i stället för att sitta stelt
	     bakom. Det är den detaljen som gör att svängar läses som svängar. ]]
	local trail = right * math.clamp(-loco.turnRate, -1, 1) * C.Shoulder
	local bomBak = if KL.yaw ~= 0
		then Vector3.new(-math.sin(heading + KL.yaw), 0, -math.cos(heading + KL.yaw))
		else back
	local bomFokus = root.Position + Vector3.new(0, 2, 0) + framat * (C.LookAhead * KL.blick)
	local bomLage = root.Position + bomBak * self.dist + Vector3.new(0, self.height, 0) + trail

	--[[ Håll bommen ur väggar: en strålkastning från hästen ut mot
	     kamerapunkten, och dra in den om något ligger emellan. ]]
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { self.rig.model, game.Players.LocalPlayer.Character }
	local origin = root.Position + Vector3.new(0, 2, 0)
	local hit = Workspace:Raycast(origin, bomLage - origin, params)
	if hit then
		bomLage = hit.Position + (origin - bomLage).Unit * 1.2
	end

	--[[ ── MÅL A: SADELN ────────────────────────────────────────────── ]]
	local raOga, head = ogonpunkt()
	local vb = if raOga then w else 1   -- ingen sadel ⇒ full bomvikt

	local lage, fokus, fov
	if raOga then
		local ra = raOga :: Vector3
		--[[ Dämpningen: höjdled mjukt, sidled nästan stelt, och ögat får
		     aldrig glida längre från huvudets faktiska höjd än taket. Utan
		     taket blir dämpningen en gummisnodd i stället för en sits. ]]
		if not self.eye then self.eye = ra end
		local e = self.eye :: Vector3
		local fxz = 1 - math.exp(-dt / S.TauXZ)
		local fy = 1 - math.exp(-dt / S.TauY)
		local ny = math.clamp(e.Y + (ra.Y - e.Y) * fy, ra.Y - S.CapY, ra.Y + S.CapY)
		self.eye = Vector3.new(e.X + (ra.X - e.X) * fxz, ny, e.Z + (ra.Z - e.Z) * fxz)
		local sadelLage = self.eye :: Vector3
		--[[ Blicken siktar framåt och något nedåt, så att både hästens hals
		     och vägen framför henne ligger i bild. Fallet är litet — en
		     ryttare tittar dit hon ska, inte ner i manen. ]]
		local sadelFokus = sadelLage + framat * S.LookAhead - Vector3.new(0, S.Fall, 0)
		lage = sadelLage:Lerp(bomLage, vb)
		fokus = sadelFokus:Lerp(bomFokus, vb)
		fov = S.Fov + (self.fov - S.Fov) * vb
	else
		self.eye = nil
		lage, fokus, fov = bomLage, bomFokus, self.fov
	end

	--[[ Eget huvud: borta i sadeln, tillbaka på bommen, tonat däremellan
	     så att bytet inte poppar mitt i en övergång. Vikten är kamerans
	     EGEN — den kan alltså inte glida ur synk med var kameran står. ]]
	local p = math.clamp((vb - 0.30) / 0.40, 0, 1)
	self:_egetHuvud(p * p * (3 - 2 * p), head)

	self.camera.CFrame = CFrame.lookAt(lage, fokus)
	self.camera.FieldOfView = fov
	--[[ Läget sparas för specarna och för Debug: EN sanning om vad kameran
	     gör, avläst där den faktiskt gör det. ]]
	self.vikt = vb
	self.lageNamn = if vb < 0.5 then "ryttare" else "feedback"
	self.vinkel = KL.id
end

function CameraController:release()
	--[[ Ritten är slut. Läget släpps HÅRT: ingen uttoning över en
	     avsittning, och ingen begäran kvar som kan tändas på nästa häst. ]]
	Kameralage.nollstall(self.lage, "avsittning")
	self.eye = nil
	self:_aterstallHuvud()
	self.camera.CameraType = self.previousType
	self.camera.FieldOfView = self.previousFov
	local character = game.Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		self.camera.CameraSubject = humanoid
	end
end

return CameraController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX43">
					<Properties>
						<string name="Name">Debug</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Felsökningsrutan.

	Avstängd som standard. Slås på med attributet HorseDebug på
	ReplicatedStorage, eller med F8 under utveckling — aldrig kvar påslagen
	i en publicerad plats.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Debug = {}

local gui: ScreenGui? = nil
local label: TextLabel? = nil
local rigDescription = ""
local statsLine = ""
local staminaLine = ""
local enabled = ReplicatedStorage:GetAttribute("HorseDebug") == true

local function ensureGui()
	if gui then return end
	local screen = Instance.new("ScreenGui")
	screen.Name = "HorseDebug"
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = true
	screen.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromOffset(420, 190)
	text.Position = UDim2.fromOffset(12, 12)
	text.BackgroundColor3 = Color3.fromRGB(12, 10, 18)
	text.BackgroundTransparency = 0.25
	text.TextColor3 = Color3.fromRGB(235, 230, 245)
	text.Font = Enum.Font.Code
	text.TextSize = 14
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.TextYAlignment = Enum.TextYAlignment.Top
	text.Text = ""
	text.Parent = screen

	gui, label = screen, text
end

function Debug.attach(rig, stats)
	local RigAdapter = require(ReplicatedStorage.HorseCore.RigAdapter)
	rigDescription = RigAdapter.describe(rig)
	statsLine = ("%s · %s · nivå %d"):format(
		tostring(stats.HorseName), tostring(stats.Breed), stats.Level)
end

function Debug.setStamina(value: number, max: number, ceiling: string)
	staminaLine = ("uthållighet %d/%d  tak %s"):format(value, max, ceiling)
end

function Debug.step(loco)
	if not enabled then
		if gui then gui.Enabled = false end
		return
	end
	ensureGui()
	if gui then gui.Enabled = true end
	if not label then return end

	label.Text = table.concat({
		statsLine,
		("tillstånd  %s"):format(loco.state),
		("gångart    %s → %s"):format(loco.gait, loco.targetGait),
		("fart       %.2f m/s"):format(loco.speed),
		("sväng      %.2f rad/s   lutning %.3f"):format(loco.turnRate, loco.lean),
		("mark       %s   luft %s"):format(tostring(loco.grounded), tostring(loco.airborne)),
		staminaLine,
		rigDescription,
	}, "\n")
end

function Debug.clear()
	if gui then gui.Enabled = false end
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.F8 then
		enabled = not enabled
	end
end)

return Debug
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX44">
					<Properties>
						<string name="Name">EffectsController</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Dammet under hovarna.

	Sparsamt med flit. Partiklar i ett ridspel ska bekräfta att marken
	finns, inte fira att man rör sig. Damm kommer bara i trav och uppåt,
	bara på mark som dammar, och bara när hovarna slår i.
]]

local Core = require(game:GetService("ReplicatedStorage").HorseCore)
local Types = require(game:GetService("ReplicatedStorage").HorseCore.Types)
local Gaits = Core.Gaits

local EffectsController = {}
EffectsController.__index = EffectsController

local DUSTY = {
	[Enum.Material.Sand] = true, [Enum.Material.Ground] = true,
	[Enum.Material.Sandstone] = true, [Enum.Material.Slate] = true,
	[Enum.Material.Concrete] = true, [Enum.Material.Cobblestone] = true,
}

function EffectsController.new(rig: Types.Rig)
	local self = setmetatable({}, EffectsController)
	self.rig = rig
	self.emitter = nil :: ParticleEmitter?
	self.lastPhase = 0

	--[[ Emittern skapas en gång och släpps i korta skurar i stället för att
	     ligga och gå. En emitter som alltid är på kostar även när hästen står. ]]
	local existing = rig.model:FindFirstChild("HoofDust", true)
	if existing and existing:IsA("ParticleEmitter") then
		self.emitter = existing
		existing.Enabled = false
	end
	return self
end

function EffectsController:step(loco: Types.Locomotion, dt: number)
	local emitter = self.emitter
	if not emitter then return end
	if not loco.grounded or loco.airborne then return end

	local gait = Gaits.get(loco.gait)
	if gait.steps == 0 or Gaits.index(loco.gait) < Gaits.index("trot") then
		return
	end

	local beats = gait.steps
	local now = math.floor(loco.phase * beats)
	if now == math.floor(self.lastPhase * beats) then
		self.lastPhase = loco.phase
		return
	end
	self.lastPhase = loco.phase

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { self.rig.model }
	local hit = workspace:Raycast(self.rig.root.Position, Vector3.new(0, -8, 0), params)
	if not (hit and DUSTY[hit.Material]) then return end

	-- Mängden följer farten: en puff i trav, en tydlig sky i fyrsprång.
	emitter:Emit(math.floor(2 + math.abs(loco.speed)))
end

function EffectsController:release() end

return EffectsController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX45">
					<Properties>
						<string name="Name">Genomsikt</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Inomhusläsbarhet: väggar mellan kameran och spelaren tonas.

	Product Owner 2026-09-03: "spelaren hamnar bakom väggar inomhus, man ser
	inte vart man går". Rummen får INTE flyttas för att lösa det (CLAUDE.md:
	flytta aldrig väggar för kamera-/UI-problem), så det är bilden som ger
	vika. Varje inre väggbit och sluten volym som anläggningsbygget märker
	med attributet `Genomsiktlig` och vars fotavtryck skär sträckan
	kamera → karaktär får LocalTransparencyModifier — bara på den här
	klienten, aldrig i den replikerade världen.

	Samma regel som webben (src/varld3d.js v3dTonas): sträckan provas i
	planet i korta steg med en marginal, och slutar en bit före karaktären
	så att väggen hon själv står intill inte tonas.

	Beslutet (`skymmer`, `valj`) är rena funktioner utan Roblox-API, så att
	de går att pröva i tests/genomsikt.spec.luau. `start` kopplar in dem.
]]

local Genomsikt = {}

Genomsikt.TONING = 0.78     -- LocalTransparencyModifier på skymmande delar
Genomsikt.MARGINAL = 1.0    -- studs runt delens fotavtryck
Genomsikt.STEG = 0.7        -- studs mellan provpunkterna
Genomsikt.SLUTMARGINAL = 1.2 -- studs före karaktären där provningen slutar

--[[ Står delen (position, storlek) mellan `fran` och `till` i planet? ]]
function Genomsikt.skymmer(pos: Vector3, size: Vector3, fran: Vector3, till: Vector3, marginal: number?): boolean
	local m = marginal or Genomsikt.MARGINAL
	local x0, x1 = pos.X - size.X / 2 - m, pos.X + size.X / 2 + m
	local z0, z1 = pos.Z - size.Z / 2 - m, pos.Z + size.Z / 2 + m
	local dx, dz = till.X - fran.X, till.Z - fran.Z
	local L = math.sqrt(dx * dx + dz * dz)
	if L < 1e-6 then return false end
	local n = math.max(1, math.ceil(L / Genomsikt.STEG))
	local slut = math.max(0, L - Genomsikt.SLUTMARGINAL) / L
	for i = 0, n do
		local t = (i / n) * slut
		local x, z = fran.X + dx * t, fran.Z + dz * t
		if x >= x0 and x <= x1 and z >= z0 and z <= z1 then return true end
	end
	return false
end

--[[ De delar i listan som skymmer sträckan. Delarna behöver bara ha
     `Position` och `Size`, så specen kan mata in tabeller. ]]
function Genomsikt.valj(delar: { any }, fran: Vector3, till: Vector3, marginal: number?): { any }
	local ut = {}
	for _, d in ipairs(delar) do
		if Genomsikt.skymmer(d.Position, d.Size, fran, till, marginal) then
			table.insert(ut, d)
		end
	end
	return ut
end

--[[ Kopplar in toningen på klienten. Kandidaterna samlas en gång och fylls
     på när anläggningen växer; en full genomsökning per bildruta hade
     kostat mer än själva provningen. ]]
function Genomsikt.start()
	local RunService = game:GetService("RunService")
	local Workspace = game:GetService("Workspace")
	local Players = game:GetService("Players")

	local kandidater: { BasePart } = {}
	local function kandidat(d: Instance)
		if d:IsA("BasePart") and d:GetAttribute("Genomsiktlig") == true then
			table.insert(kandidater, d :: BasePart)
		end
	end
	for _, d in ipairs(Workspace:GetDescendants()) do kandidat(d) end
	Workspace.DescendantAdded:Connect(kandidat)

	local tonade: { BasePart } = {}
	RunService.RenderStepped:Connect(function()
		local cam = Workspace.CurrentCamera
		local char = Players.LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not cam or not root then return end
		local nya = Genomsikt.valj(kandidater, cam.CFrame.Position, (root :: BasePart).Position)
		for _, d in ipairs(tonade) do d.LocalTransparencyModifier = 0 end
		for _, d in ipairs(nya) do d.LocalTransparencyModifier = Genomsikt.TONING end
		tonade = nya
	end)
end

return Genomsikt
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX46">
					<Properties>
						<string name="Name">Input</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Inmatningen — tangenter, gamepad och peksk��rm till en Intent.

	Ingen spellogik här. Modulen översätter knappar till avsikt och inget
	annat, så att styrningen går att binda om utan att rörelsen rörs.

	W  framåt          S  ned i gångart, sedan stopp, sedan backa
	A/D styr           Shift  upp en gångart     Ctrl  ned en gångart
	Space hoppa        E  sitt upp/av
]]

local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local Types = require(game:GetService("ReplicatedStorage").HorseCore.Types)

local Input = {}

--[[ Tangenterna och pekskärmen har varsitt axelpar, av samma skäl som
     gamepaden har sitt: skriver de i samma fält slår de ut varandra. En
     spelare som håller D och samtidigt drar spaken åt vänster ska få
     summan, inte den som råkade skriva sist. ]]
local state = {
	forward = 0,
	steer = 0,
	touchForward = 0,
	touchSteer = 0,
	gaitUp = false,
	gaitDown = false,
	jump = false,
	--[[ G02-B: TYGELN och PARADEN. `rein` är kontakten (Q eller höger
	     avtryckare — den senare analog, så halvt utslag ger halv
	     kontakt); `paradEdge` är halvhaltens flank. Pekskärmen skriver i
	     touchRein/touchParad vid sidan av, av samma skäl som forward och
	     steer har varsitt par: skriver de i samma fält slår de ut
	     varandra. ]]
	rein = 0,
	touchRein = 0,
	--[[ G02-B, senior review #87: SITSEN som egen axel. −1 lätt (avlastad,
	     framåt), 0 normal, 1 djup. Z och C på tangentbord; vänster
	     avtryckare (analog) för den djupa sitsen på gamepad. Shift och
	     Ctrl är gångartsknappar sedan Gate 01 och rörs inte.

	     Sitsen är en balansmodifierare: sitter man ned i bågen bär man
	     hästen, sitter man lätt får hon bära den själv. Utan axeln kunde
	     Roblox inte ha den delen av modellen alls. ]]
	--[[ KNAPPSTATUS, INTE ETT DELAT AXELVÄRDE (Jules QA-fynd, #89).
	     Z och C skrev förut båda direkt i `seat`, och den som släpptes
	     sist bestämde. Håll Z (lätt) → tryck C (djup) → släpp C: axeln
	     gick till 0 fastän Z fortfarande var nedtryckt. Nu bokförs vilken
	     tangent som FAKTISKT är nere, och axeln HÄRLEDS ur det — samma
	     sak varje gång oavsett ordning.

	     Hålls båda vinner den djupa sitsen: det är den som gör något med
	     hästen (bär bågen), medan den lätta sitsen är att låta bli.

	     [KÄND, EJ ÅTGÄRDAD] W/S och A/D har kvar samma sist-skriven-
	     vinner-mönster i KEY_ACTIONS. Det är Gate 01:s inputlager och
	     ligger utanför G02-B:s scope; jag rapporterar det i stället för
	     att bredda den här PR:en på eget initiativ. ]]
	seatLight = false,
	seatDeep = false,
	touchSeat = 0,
	paradHeld = false,
	_paradEdge = false,
	touchParad = false,
	_upEdge = false,
	_downEdge = false,
}

local bound = false

local KEY_ACTIONS = {
	[Enum.KeyCode.W] = function(v) state.forward = if v then 1 else (if state.forward > 0 then 0 else state.forward) end,
	[Enum.KeyCode.S] = function(v) state.forward = if v then -1 else (if state.forward < 0 then 0 else state.forward) end,
	[Enum.KeyCode.A] = function(v) state.steer = if v then -1 else (if state.steer < 0 then 0 else state.steer) end,
	[Enum.KeyCode.D] = function(v) state.steer = if v then 1 else (if state.steer > 0 then 0 else state.steer) end,
}

local function onInput(_, inputState: Enum.UserInputState, obj: InputObject)
	local pressed = inputState == Enum.UserInputState.Begin
	local action = KEY_ACTIONS[obj.KeyCode]
	if action then
		action(pressed)
		return Enum.ContextActionResult.Sink
	end
	if obj.KeyCode == Enum.KeyCode.LeftShift or obj.KeyCode == Enum.KeyCode.ButtonR1 then
		if pressed and not state.gaitUp then state._upEdge = true end
		state.gaitUp = pressed
	elseif obj.KeyCode == Enum.KeyCode.LeftControl or obj.KeyCode == Enum.KeyCode.ButtonL1 then
		if pressed and not state.gaitDown then state._downEdge = true end
		state.gaitDown = pressed
	elseif obj.KeyCode == Enum.KeyCode.Space or obj.KeyCode == Enum.KeyCode.ButtonA then
		state.jump = pressed
	elseif obj.KeyCode == Enum.KeyCode.Q then
		--[[ Tangenten är av eller på; avtryckaren nedan är analog och
		     läggs till i consume(). Den som har gamepad doserar alltså
		     kontakten, den som har tangentbord får hel eller ingen —
		     samma förhållande som webbens Space mot pekskärmens spak. ]]
		state.rein = if pressed then 1 else 0
	elseif obj.KeyCode == Enum.KeyCode.F or obj.KeyCode == Enum.KeyCode.ButtonB then
		if pressed and not state.paradHeld then state._paradEdge = true end
		state.paradHeld = pressed
	elseif obj.KeyCode == Enum.KeyCode.Z then
		state.seatLight = pressed
	elseif obj.KeyCode == Enum.KeyCode.C then
		state.seatDeep = pressed
	end
	return Enum.ContextActionResult.Sink
end

function Input.bind()
	if bound then return end
	bound = true
	ContextActionService:BindAction("HorseControl", onInput, false,
		Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
		Enum.KeyCode.Space, Enum.KeyCode.LeftShift, Enum.KeyCode.LeftControl,
		Enum.KeyCode.Q, Enum.KeyCode.F, Enum.KeyCode.Z, Enum.KeyCode.C,
		Enum.KeyCode.ButtonA, Enum.KeyCode.ButtonR1, Enum.KeyCode.ButtonL1,
		Enum.KeyCode.ButtonB)
end

function Input.unbind()
	if not bound then return end
	bound = false
	ContextActionService:UnbindAction("HorseControl")
	state.forward, state.steer = 0, 0
	state.touchForward, state.touchSteer = 0, 0
	state.rein, state.touchRein = 0, 0
	state.seatLight, state.seatDeep, state.touchSeat = false, false, 0
	state.paradHeld, state._paradEdge, state.touchParad = false, false, false
	state.gaitUp, state.gaitDown, state.jump = false, false, false
	--[[ FLANKERNA MÅSTE MED. `gaitUp`/`gaitDown` är hållna tillstånd;
	     `_upEdge`/`_downEdge` är den OBEHANDLADE begäran, och den låg kvar
	     här. En spelare som tryckte Shift och sedan satt av innan
	     bildrutan hann konsumera flanken fick gångartsbytet på FÖRSTA
	     bildrutan efter nästa uppsittning — hästen bytte gångart av sig
	     själv innan ryttaren rört en tangent.

	     `_paradEdge` nollades redan; de här två glömdes. Mätt i
	     tests/touch.spec.luau: tre mätningar föll före den här raden. ]]
	state._upEdge, state._downEdge = false, false
end

--[[ Gamepadens vänsterspak går in vid sidan av tangenterna, så att båda
     fungerar samtidigt utan att slå ut varandra. ]]
local function stick(): (number, number)
	for _, obj in UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1) do
		if obj.KeyCode == Enum.KeyCode.Thumbstick1 then
			local v = obj.Position
			local dead = 0.18
			local x = if math.abs(v.X) > dead then v.X else 0
			local y = if math.abs(v.Y) > dead then v.Y else 0
			return y, x
		end
	end
	return 0, 0
end

--[[ Höger avtryckare som ANALOG tygel. Den är en axel och inte en knapp
     på gamepaden, och det är hela poängen: kontakten ska gå att dosera,
     för det är den som avgör om yttertygeln bär svängen. Dödzonen är
     densamma som spakens. ]]
local function trigger(): number
	for _, obj in UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1) do
		if obj.KeyCode == Enum.KeyCode.ButtonR2 then
			local v = obj.Position.Z
			return if v > 0.10 then math.clamp(v, 0, 1) else 0
		end
	end
	return 0
end

--[[ Sitsaxeln HÄRLEDD ur knappstatus. Ren funktion av vad som är nere,
     så ordningen på tryck och släpp inte kan ge två olika svar på samma
     fysiska läge. Djup sits vinner när båda hålls. ]]
function Input.seatAxis(): number
	if state.seatDeep then return 1 end
	if state.seatLight then return -1 end
	return 0
end

--[[ Vänster avtryckare som ANALOG sits. Samma skäl som tygeln på höger:
     hur djupt man sitter är en dosering, inte ett av/på. ]]
local function seatTrigger(): number
	for _, obj in UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1) do
		if obj.KeyCode == Enum.KeyCode.ButtonL2 then
			local v = obj.Position.Z
			return if v > 0.10 then math.clamp(v, 0, 1) else 0
		end
	end
	return 0
end

--[[ Läser av och nollställer flankerna. Anropas exakt en gång per bildruta
     av klientens loop — kallas den två gånger tappas ett gångartsbyte. ]]
function Input.consume(): Types.Intent
	local padForward, padSteer = stick()
	local intent: Types.Intent = {
		forward = math.clamp(state.forward + padForward + state.touchForward, -1, 1),
		steer = math.clamp(state.steer + padSteer + state.touchSteer, -1, 1),
		gaitUp = state._upEdge,
		gaitDown = state._downEdge,
		jump = state.jump,
		rein = math.clamp(state.rein + trigger() + state.touchRein, 0, 1),
		seat = math.clamp(Input.seatAxis() + seatTrigger() + state.touchSeat, -1, 1),
		parad = if (state._paradEdge or state.touchParad) then 1 else 0,
	}
	state._upEdge, state._downEdge = false, false
	state._paradEdge, state.touchParad = false, false
	return intent
end

--[[ För pekskärm: `TouchControls` kallar de här i stället för tangenter.
     Värdena är normaliserade avsikter i −1..1, precis som tangenternas och
     spakens, och läggs till dem i `consume` i stället för att ersätta dem. ]]
function Input.setTouch(forward: number, steer: number)
	state.touchForward = math.clamp(forward, -1, 1)
	state.touchSteer = math.clamp(steer, -1, 1)
end
function Input.setTouchRein(rein: number)
	state.touchRein = math.clamp(rein, 0, 1)
end
function Input.setTouchSeat(seat: number)
	state.touchSeat = math.clamp(seat, -1, 1)
end
function Input.touchParad()
	state.touchParad = true
end
function Input.touchGait(up: boolean)
	if up then state._upEdge = true else state._downEdge = true end
end
function Input.touchJump()
	state.jump = true
	task.delay(0.15, function() state.jump = false end)
end

return Input
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX47">
					<Properties>
						<string name="Name">InteractionController</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Uppsittningen.

	En ProximityPrompt per häst, skapad på klienten så att servern slipper
	replikera dem. Prompten frågar servern om lov — klienten bestämmer
	aldrig själv att den sitter upp.
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Core = require(game:GetService("ReplicatedStorage").HorseCore)
local Net, RigAdapter = Core.Networking, Core.RigAdapter

local InteractionController = {}

local prompts: { [Model]: ProximityPrompt } = {}
local onMount: ((Model) -> ())? = nil

--[[ Får uppsittningsprompten visas för den här modellen?

	Krav 8: `G01Enabled == nil` vid klientjoin får INTE ge en uppsittnings-
	prompt. Attributet replikeras, och en klient som hinner fram före servern
	läser nil — inte false.

	FÖRSTA VERSIONEN VAR FAIL-OPEN, och kommentaren påstod motsatsen.
	`g01Pa()` prövade riktigt `== true`, men svaret användes som
	`if not g01Pa() then return true` — så nil gick rakt in i legacy-grenen
	och VISADE prompten. Exakt det race kravet finns till för. Fälldes av
	senior review på #61.

	Rättningen är att sluta behandla flaggan som boolean. Den har TRE lägen:

	  nil   → göm. Vi vet ännu inte om loopen är på, och att gissa "av" är
	          att gissa åt fel håll.
	  true  → serverns ready-check avgör (`redoFor`).
	  false → legacy: hästsystemet utan G01-loopen, som före den här skivan.

	Att nil och false ger OLIKA svar är hela rättningen. ]]
local redoFor: ((Model) -> boolean)? = nil

--[[ Returnerar nil / true / false — inte en boolean. ]]
function InteractionController.g01Lage(): boolean?
	local v = ReplicatedStorage:GetAttribute("G01Enabled")
	if v == nil then return nil end
	return v == true
end

--[[ Själva beslutet, utan instanser, så att det går att fälla i en spec.
	Låg först som en lokal funktion och var då oprovbar — vilket är hur
	fail-open-buggen kunde ligga kvar bakom en kommentar som påstod rätt
	beteende. ]]
function InteractionController.promptSynlig(lage: boolean?, redo: boolean): boolean
	if lage == nil then
		return false          -- fail closed: vi vet inte än
	end
	if lage == false then
		return true           -- legacy, utan G01-loopen
	end
	return redo
end

local function farVisas(model: Model): boolean
	local redo = redoFor ~= nil and redoFor(model)
	return InteractionController.promptSynlig(InteractionController.g01Lage(), redo)
end

function InteractionController.setReadyCheck(fn: ((Model) -> boolean)?)
	redoFor = fn
end

local function addPrompt(model: Model)
	if prompts[model] then return end
	if not farVisas(model) then return end
	local rig = RigAdapter.build(model)
	if not rig then return end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "MountPrompt"
	prompt.ActionText = "Sitt upp"
	prompt.ObjectText = model:GetAttribute("HorseName") or model.Name
	prompt.HoldDuration = 0.35
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = rig.attachments.Saddle or rig.root

	prompt.Triggered:Connect(function()
		local ok, reason = Net.get("MountRequest"):InvokeServer(model)
		if ok and onMount then
			onMount(model)
		elseif not ok then
			warn("[Horse] Kunde inte sitta upp: " .. tostring(reason))
		end
	end)

	prompts[model] = prompt
end

local function removePrompt(model: Model)
	local prompt = prompts[model]
	if prompt then
		prompt:Destroy()
		prompts[model] = nil
	end
end

--[[ Räkna om vilka prompter som får finnas.

	Behövs för att `addPrompt` bara körs när en modell dyker upp. Utan det
	här skulle en spelare som blir klar med förberedelsen aldrig få sin
	prompt — modellen fanns ju redan när loopen startade — och en som sitter
	upp skulle behålla den. Anropas när servern skickat ny sanning. ]]
function InteractionController.uppdatera()
	for _, model in CollectionService:GetTagged("Horse") do
		if model:IsA("Model") then
			if farVisas(model) then
				addPrompt(model)
			else
				removePrompt(model)
			end
		end
	end
end

function InteractionController.start(mountCallback: (Model) -> ())
	onMount = mountCallback
	for _, model in CollectionService:GetTagged("Horse") do
		if model:IsA("Model") then addPrompt(model) end
	end
	CollectionService:GetInstanceAddedSignal("Horse"):Connect(function(inst)
		if inst:IsA("Model") then addPrompt(inst) end
	end)
	CollectionService:GetInstanceRemovedSignal("Horse"):Connect(function(inst)
		if inst:IsA("Model") then removePrompt(inst :: Model) end
	end)
end

function InteractionController.setEnabled(enabled: boolean)
	for _, prompt in prompts do
		prompt.Enabled = enabled
	end
end

return InteractionController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX48">
					<Properties>
						<string name="Name">KontrollHjalp</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	KONTROLLERNA, KORT — vad gör jag för att sitta upp, byta gångart och hoppa?

	Tobias frågade, och frågan var befogad: reglagen fanns bara i koden.
	Den här modulen svarar med de reglage som FAKTISKT är bundna, läst ur
	src/client/Input.luau, src/client/TouchControls.luau och
	init.client.luau. Ingenting här är påhittat, och ingenting här ÄNDRAR
	en bindning — ridfysik, hjälpsemantik och hoppmodell rörs inte.

	REGLAGEN FÖLJER INMATNINGEN, inte plattformen. Samma regel som
	UgnetaController.medLedtext: en ren pekenhet ska aldrig få en bokstav
	hon inte kan trycka på, och en iPad med tangentbord ska få bokstaven.
	Ordningen är tangentbord → gamepad → touch, för att det är den
	inmatning spelaren faktiskt har framför sig.

	VAD SOM INTE STÅR HÄR: webbens reglage. De skiljer sig verkligt —
	webben har ingen gångartsknapp (gångarten följer av skänkel och tygel)
	och inget hoppreglage (avsprånget kommer ur anridningen). Att skriva
	Roblox-tangenter i webbens hjälp, eller tvärtom, vore att påstå en
	paritet som inte finns. Varje yta visar sina egna.

	── ÅTERÖPPNINGEN (#161) ─────────────────────────────────────────

	Panelen gick att STÄNGA på varje yta men bara att ÖPPNA med `H`. På en
	iPad utan tangentbord var hjälpen därmed en engångsruta: när den väl
	var bortstängd fanns ingen väg tillbaka. QA-rapporten i #153 kallade
	det P2-4b, och #161 löser det med tre vägar in, en per inmatning:

	  · tangentbord  `H`, oförändrad,
	  · pekskärm     en liten permanent `?`-knapp uppe till höger,
	  · gamepad      `DPadUp`.

	`DPadUp` är vald för att den är LEDIG, och det är kontrollerat, inte
	antaget: `Input.luau` binder Thumbstick1, ButtonA, ButtonB, ButtonR1,
	ButtonL1, ButtonR2 och ButtonL2, och `init.client.luau` binder ButtonY
	(lektionen vidare) och ButtonX (se ritten). Styrkorset rörs inte av
	någon av dem, och till skillnad från ButtonStart och ButtonSelect är
	det inte heller reserverat av Roblox egna menyer. Ingen rid-, hopp-
	eller replaybindning har flyttats för att göra plats — det var ett
	uttryckligt krav i #161.

	`?`-KNAPPEN ÄR EGEN GUI, inte en del av `TouchControls`. Skälet är att
	`TouchControls` rivs vid avsittning: en hjälpknapp som bara finns i
	sadeln hade varit borta i stallet, alltså precis när frågan "vad gör
	jag nu?" är som vanligast. Den ligger uppe till höger, där varken
	spaken (nere vänster), ridknapparna (nere höger), förberedelse-HUD:en
	(nere mitten), Ugnetas kort (uppe mitten) eller ridanalysen (uppe
	vänster) ligger — och därmed blockerar den varken ridkontroller eller
	replay.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local KontrollHjalp = {}

local player = Players.LocalPlayer

local gui: ScreenGui? = nil
local panel: Frame? = nil
local rader: { TextLabel } = {}
local visadEnGang = false
--[[ Den permanenta öppningsknappen. Egen ScreenGui, se filhuvudet. ]]
local oppnaGui: ScreenGui? = nil
local oppnaKnapp: TextButton? = nil

local FARG_MORK = Color3.fromRGB(12, 14, 18)
local FARG_TEXT = Color3.fromRGB(246, 242, 232)
local FARG_GULD = Color3.fromRGB(232, 181, 74)

--[[ Reglaget som öppnar hjälpen igen, per inmatning. Publik för att provet
     ska läsa samma beslut som panelen — och för att `docs/KONTROLLMATRIS.md`
     ska gå att kontrollera mot källan i stället för mot minnet. ]]
KontrollHjalp.GAMEPADKNAPP = Enum.KeyCode.DPadUp

--[[ Avsittningens gamepadknapp (#162 blockerare 2). Samma skäl till att den
     är publik: `init.client.luau` binder den, panelen skriver ut den och
     provet läser den — ett beslut, en plats.

     `DPadDown` är valt för att det är den enda naturliga knappen som är
     LEDIG, kontrollerat mot hela `roblox/src`:
       Input.luau       Thumbstick1, ButtonA/B, R1/L1, R2/L2
       init.client      ButtonY (lektionen), ButtonX (se ritten), DPadUp (hjälp)
     Kvar av styrkorset: ned, vänster, höger. `ButtonStart`/`ButtonSelect`
     rörs inte — Roblox har egna menyer på dem.

     Styrkors ned parar sig dessutom med styrkors upp: hjälpen upp, av
     hästen ned. Ingen befintlig rid-, hopp-, replay- eller hjälpbindning
     ändras. ]]
KontrollHjalp.AVSITTNING_GAMEPAD = Enum.KeyCode.DPadDown

--[[ LEDTEXTEN HÄRLEDS UR BINDNINGEN, inte skriven för hand vid sidan om.

     Blockerare 2 var två fel i samma rad: bindningen saknades OCH raden
     påstod "E", en tangent, som gamepadens reglage. Det andra felet är
     möjligt så länge texten och bindningen är två oberoende strängar —
     precis den dubbla sanning `CLAUDE.md` varnar för, i miniatyr.

     Nu slår panelen upp knappen här. Byts konstanten följer texten med,
     och en knapp utan namn syns direkt i panelen i stället för att bli en
     tyst lögn. ]]
local PADNAMN: { [Enum.KeyCode]: string } = {
	[Enum.KeyCode.DPadUp] = "Styrkors upp",
	[Enum.KeyCode.DPadDown] = "Styrkors ned",
	[Enum.KeyCode.DPadLeft] = "Styrkors vänster",
	[Enum.KeyCode.DPadRight] = "Styrkors höger",
}

local function padNamn(kod: Enum.KeyCode): string
	return PADNAMN[kod] or ("(namnlös knapp: " .. tostring(kod) .. ")")
end

--[[ RADERNA. `tgb`/`pad`/`pek` är de reglage som är bundna i produktionen:

     tangentbord  Input.luau: W/S framåt-bakåt, A/D styr, LeftShift gångart
                  upp, LeftControl gångart ner, Q tygel, F parad, Z/C sits,
                  Space hopp. init.client.luau: E sitt upp/av.
     gamepad      Input.luau: Thumbstick1 styr och framåt, ButtonR1 gångart
                  upp, ButtonL1 gångart ner, ButtonR2 tygel, ButtonB parad,
                  ButtonL2 sits, ButtonA hopp.
     touch        TouchControls.luau bygger Spak samt knapparna SITT AV,
                  ▲ FRAMÅT, ▼ LUGNARE, TYGEL, HALVHALT, DJUP SITS, HOPP.
                  Texterna nedan är knapparnas EGNA etiketter.

     Ändras en bindning ska den här tabellen ändras med den. Provet läser
     Input.luau:s egna KeyCodes och faller när en rad påstår en tangent som
     inte längre är bunden. ]]
local RADER = {
	--[[ `pad` stod "E" här (#162 blockerare 2). `E` är en TANGENT. En spelare
	     med bara handkontroll läste alltså en instruktion hon inte kunde
	     följa — och kunde faktiskt inte sitta av alls, för `begarAvsittning`
	     var bara bunden till `E`. Uppsittningen gick via ProximityPrompt,
	     så hon kom UPP på hästen och blev kvar där. ]]
	{ vad = "Sitt upp / sitt av", tgb = "E",
	  pad = padNamn(KontrollHjalp.AVSITTNING_GAMEPAD),                  pek = "SITT AV" },
	{ vad = "Framåt / bakåt",     tgb = "W / S",    pad = "Vänster spak", pek = "Spaken" },
	{ vad = "Styr",               tgb = "A / D",    pad = "Vänster spak", pek = "Spaken" },
	{ vad = "Högre gångart",      tgb = "Shift",    pad = "R1",       pek = "▲ FRAMÅT" },
	{ vad = "Lägre gångart",      tgb = "Ctrl",     pad = "L1",       pek = "▼ LUGNARE" },
	{ vad = "Tygel (kontakt)",    tgb = "Q",        pad = "R2",       pek = "TYGEL" },
	{ vad = "Halvhalt",           tgb = "F",        pad = "B",        pek = "HALVHALT" },
	{ vad = "Djupare sits",       tgb = "Z / C",    pad = "L2",       pek = "DJUP SITS" },
	{ vad = "Hoppa",              tgb = "Space",    pad = "A",        pek = "HOPP" },
	--[[ #161: hjälpen kan öppnas igen på varje yta, och står därför i sin
	     egen hjälp. En rad som säger "H" till en spelare utan tangentbord
	     hade varit precis det problemet raden beskriver. ]]
	{ vad = "Den här hjälpen",    tgb = "H",
	  pad = padNamn(KontrollHjalp.GAMEPADKNAPP),                        pek = "?" },
}

--[[ Vilken sorts inmatning ska hjälpen tala om? Publik för att provet ska
     kunna läsa samma beslut som panelen. ]]
--[[ Raden för ett reglage, som panelen faktiskt skriver ut den. Publik
     för att provet ska kunna mäta LEDTEXTEN och inte bara bindningen —
     blockerare 2 var trasig i just texten. ]]
function KontrollHjalp._rad(vad: string): { [string]: string }?
	for _, r in RADER do
		if r.vad == vad then return r end
	end
	return nil
end

function KontrollHjalp.inmatning(): string
	if UserInputService.KeyboardEnabled then return "tangentbord" end
	if UserInputService.GamepadEnabled then return "gamepad" end
	if UserInputService.TouchEnabled then return "touch" end
	--[[ Ingen känd inmatning: beskriv handlingarna utan reglage hellre än
	     att gissa en tangent hon kanske inte har. ]]
	return "okand"
end

--[[ Raderna som text, för panelen och för provet. Ren avläsning. ]]
function KontrollHjalp.rader(): { { vad: string, reglage: string } }
	local sort = KontrollHjalp.inmatning()
	local ut = {}
	for _, r in RADER do
		local reglage =
			if sort == "tangentbord" then r.tgb
			elseif sort == "gamepad" then r.pad
			elseif sort == "touch" then r.pek
			else ""
		table.insert(ut, { vad = r.vad, reglage = reglage })
	end
	return ut
end

local function bygg()
	if gui then return end
	local g = Instance.new("ScreenGui")
	g.Name = "UBRFKontroller"
	g.ResetOnSpawn = false
	g.IgnoreGuiInset = true
	g.DisplayOrder = 15
	g.Enabled = false
	g.Parent = player:WaitForChild("PlayerGui")
	gui = g

	local p = Instance.new("Frame")
	p.Name = "Panel"
	--[[ Smal och vid kanten: hjälpen ska kunna stå uppe medan man rider,
	     inte lägga sig över vägen framåt. ]]
	p.AnchorPoint = Vector2.new(0, 0.5)
	p.Position = UDim2.new(0, 12, 0.5, 0)
	p.Size = UDim2.new(0, 250, 0, 44 * (#RADER + 2))
	p.BackgroundColor3 = FARG_MORK
	p.BackgroundTransparency = 0.12
	p.Parent = g
	panel = p
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 10); c.Parent = p

	local rubrik = Instance.new("TextLabel")
	rubrik.Name = "Rubrik"
	rubrik.Size = UDim2.new(1, -20, 0, 26)
	rubrik.Position = UDim2.fromOffset(10, 8)
	rubrik.BackgroundTransparency = 1
	rubrik.Text = "Kontroller"
	rubrik.TextColor3 = FARG_GULD
	rubrik.TextXAlignment = Enum.TextXAlignment.Left
	rubrik.Font = Enum.Font.GothamBold
	rubrik.TextSize = 15
	rubrik.Parent = p

	for i = 1, #RADER do
		local l = Instance.new("TextLabel")
		l.Name = "Rad" .. i
		l.Size = UDim2.new(1, -20, 0, 20)
		l.Position = UDim2.fromOffset(10, 34 + (i - 1) * 21)
		l.BackgroundTransparency = 1
		l.TextColor3 = FARG_TEXT
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.Font = Enum.Font.Gotham
		l.TextSize = 12
		l.Text = ""
		l.Parent = p
		table.insert(rader, l)
	end

	--[[ En stängknapp, inte bara en tangent: på en ren pekenhet finns
	     ingen H att trycka på, och en panel som inte går att stänga är
	     värre än ingen panel. 44 px, samma regel som ridanalysen. ]]
	local kn = Instance.new("TextButton")
	kn.Name = "StangHjalp"
	kn.AutoButtonColor = true
	kn.Size = UDim2.new(1, -20, 0, 44)
	kn.Position = UDim2.new(0, 10, 1, -52)
	kn.BackgroundColor3 = FARG_GULD
	kn.TextColor3 = Color3.fromRGB(23, 20, 10)
	kn.Font = Enum.Font.GothamBold
	kn.TextSize = 12
	kn.Text = "Stäng"
	kn.ZIndex = 6
	kn.Parent = p
	local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.new(1, 0); kc.Parent = kn
	kn.Activated:Connect(function() KontrollHjalp.dolj() end)
end

local function fyll()
	local lista = KontrollHjalp.rader()
	for i, l in ipairs(rader) do
		local r = lista[i]
		if r then
			l.Text = if r.reglage ~= "" then `{r.vad}  ·  {r.reglage}` else r.vad
			l.Visible = true
		else
			l.Text = ""
			l.Visible = false
		end
	end
	local kn = panel and panel:FindFirstChild("StangHjalp")
	if kn then
		--[[ Ledtexten bara där tangenten finns. ]]
		(kn :: TextButton).Text =
			if UserInputService.KeyboardEnabled then "Stäng  (H)" else "Stäng"
	end
end

--[[ ── ÖPPNINGSKNAPPEN ──────────────────────────────────────────────

     En egen ScreenGui som lever hela sessionen. `ResetOnSpawn = false` gör
     att den överlever respawn; `IgnoreGuiInset = false` gör att den lägger
     sig UNDER Roblox egen topbar i stället för bakom den.

     48 px, alltså över golvet på 44 som `docs/KONTROLLMATRIS.md` regel 5
     sätter och som resten av pek-UI:t redan följer. Träffytan är knappens
     egen storlek — ingen genomskinlig marginal som ser mindre ut än den
     är, och ingen etikett som sticker utanför sin knapp.

     Den ritas för TOUCH och GAMEPAD men inte för en ren tangentbords-
     klient: där finns `H`, och en musanvändare får ändå knappen om hon
     saknar tangentbord. Samma regel som resten av modulen — reglagen
     följer inmatningen, inte plattformen. ]]
local KNAPPSTORLEK = 48

local function byggOppna()
	if oppnaGui then return end
	if UserInputService.KeyboardEnabled and not UserInputService.TouchEnabled then
		--[[ Ren tangentbordsklient: `H` finns och knappen skulle bara ta
		     plats. Beslutet läses om vid varje `KontrollHjalp.start`, så en
		     iPad som kopplar bort sitt tangentbord får knappen. ]]
		return
	end
	local g = Instance.new("ScreenGui")
	g.Name = "UBRFHjalpknapp"
	g.ResetOnSpawn = false
	g.IgnoreGuiInset = false
	--[[ Under ridanalysen (20) men över kontrollpanelen (15): panelen ska
	     kunna ligga över knappen utan att knappen försvinner bakom den. ]]
	g.DisplayOrder = 16
	g.Parent = player:WaitForChild("PlayerGui")
	oppnaGui = g

	local b = Instance.new("TextButton")
	b.Name = "Hjalp"
	b.AnchorPoint = Vector2.new(1, 0)
	b.Position = UDim2.new(1, -12, 0, 12)
	b.Size = UDim2.fromOffset(KNAPPSTORLEK, KNAPPSTORLEK)
	b.BackgroundColor3 = FARG_MORK
	b.BackgroundTransparency = 0.12
	b.TextColor3 = FARG_GULD
	b.Font = Enum.Font.GothamBold
	b.TextSize = 22
	b.Text = "?"
	b.AutoButtonColor = true
	b.BorderSizePixel = 0
	b.Parent = g
	local horn = Instance.new("UICorner")
	horn.CornerRadius = UDim.new(1, 0)
	horn.Parent = b
	b.Activated:Connect(function() KontrollHjalp.vaxla() end)
	oppnaKnapp = b
end

--[[ Knappen göms medan panelen står uppe: panelen har sin egen `Stäng`, och
     två reglage för samma sak på skärmen samtidigt är en fråga, inte en
     hjälp. Den kommer tillbaka i samma ögonblick panelen stängs. ]]
local function speglaOppna()
	local b = oppnaKnapp
	if b then b.Visible = not KontrollHjalp.synlig() end
end

function KontrollHjalp.visa()
	bygg()
	fyll()
	local g = gui
	if g then g.Enabled = true end
	speglaOppna()
end

function KontrollHjalp.dolj()
	local g = gui
	if g then g.Enabled = false end
	speglaOppna()
end

--[[ Startas av `init.client.luau`. Bygger bara öppningsknappen — panelen
     byggs först när den behövs, som förut. ]]
function KontrollHjalp.start()
	byggOppna()
	speglaOppna()
end

--[[ Provkrok: knappen som faktiskt ritats, eller nil när inmatningen inte
     ska ha någon. Provet läser den i stället för att bygga en egen. ]]
function KontrollHjalp._oppnaKnapp(): TextButton?
	return oppnaKnapp
end

function KontrollHjalp.synlig(): boolean
	local g = gui
	return g ~= nil and g.Enabled == true
end

function KontrollHjalp.vaxla(): boolean
	if KontrollHjalp.synlig() then KontrollHjalp.dolj() else KontrollHjalp.visa() end
	return KontrollHjalp.synlig()
end

--[[ FÖRSTA UPPSITTNINGEN. Hjälpen visas en gång av sig själv — då är
     frågan "vad gör jag nu?" som mest aktuell — och sedan bara när
     spelaren ber om den. Att visa den vid varje uppsittning hade blivit
     en ruta att stänga bort, inte en hjälp. ]]
function KontrollHjalp.vidUppsittning()
	if visadEnGang then return end
	visadEnGang = true
	KontrollHjalp.visa()
end

return KontrollHjalp
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX49">
					<Properties>
						<string name="Name">LektionController</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	LEKTIONEN PÅ KLIENTEN — den kedja som saknades.

	UgnetaController är en HUD och UgnetaGestalt är en figur. Ingen av dem
	kör en lektion. Den här modulen gör det, och den anropas från den
	ENDA uppdateringsloopen i init.client.luau — inte från en egen
	Heartbeat, av samma skäl som står i loopens huvud.

	Vad spelaren får, i den ordningen UX-variant 1 + 3 säger:

	  1. övningen presenteras (rubrik + två punkter, ur kanonen),
	  2. spelaren startar försöket själv,
	  3. hon rider — och får bara några ord live, aldrig ett kort,
	  4. efter försök 1: en sak som var bra, en att förbättra,
	     "Prova igen",
	  5. försök 2 på SAMMA övning, mätt från noll,
	  6. efter försök 2: en konkret jämförelse mot försök 1,
	  7. nästa övning.

	LEKTIONEN VÄNTAR PÅ SPELAREN (senior review av c53a2c7). Förut gick
	den vidare på en sexsekunderstimer, och "Prova igen" var en TextLabel
	utan input: kortet såg ut som ett val men var en nedräkning. Två fel
	föll ut av det. Spelaren kunde inte välja att försöka igen, och
	mätningen av nästa försök började medan ryttaren fortfarande läste
	kortet — timern brydde sig inte om ifall någon var redo.

	Nu finns `lage`, och det är hela rättelsen:

	  "ny"           en övning ska presenteras
	  "presentation" kortet uppe, spelaren väljer när försöket börjar
	  "rider"        DET ENDA läget där något mäts
	  "efter"        återkopplingen uppe, spelaren väljer att gå vidare
	  "ingen"        passet är slut

	Mätningen nollställs vid spelarens handling (`Lektion.vidare` i
	`fortsattning`), inte när timern råkar löpa ut.

	Mätningen kommer ur `ride.telemetri`, alltså ur HorseCore/Telemetri —
	samma avläsning webben gör. Ingen egen fysik, inga egna formler:
	bedömningen ligger i HorseCore/Lektion och HorseCore/Ugneta.

	SÄKERHET VINNER. `avbryt` släcker chip, kort och gestalt på en gång —
	och kastar den väntande fortsättningen, så att ett tangenttryck efter
	avsittningen inte kan starta ett försök på en häst som inte finns.
	Den anropas när ritten tar slut av vilket skäl som helst — inklusive
	de skäl som ÄR säkerhetshändelser: karaktären försvinner, riggen är
	borta ur workspace, servern flyttar uppsittningen. En "Bra rytm" får
	aldrig bli kvar på skärmen efter att ekipaget inte finns längre.
]]

local Lektion = require(game:GetService("ReplicatedStorage").HorseCore.Lektion)
local UgnetaController = require(script.Parent.UgnetaController)
local UgnetaGestalt = require(script.Parent.UgnetaGestalt)
local ReplayController = require(script.Parent.ReplayController)
local Inspelning = require(game:GetService("ReplicatedStorage").HorseCore.Inspelning)

local LektionController = {}

local LIVE_CD = require(game:GetService("ReplicatedStorage").HorseCore.RidKanon).UGNETA.LIVE_CD

local pass: Lektion.Pass? = nil
local liveCd = 0
local liveSagt = ""
local lage = "ingen"

--[[ ── G02-D: RITTEN SPELAS IN EN GÅNG ──────────────────────────────
     En inspelare per FÖRSÖK. Den startas när mätningen startar och stängs
     när försöket stängs — samma två ögonblick, inte två egna. Skulle de
     glida isär hade replayen visat en annan ritt än den som bedömdes, och
     då hade vi haft två sanningar om samma försök.

     `inspelningar` håller posterna per övning i den ordning de rids.
     Spöket i analysen är den NÄST sista i den listan: spelarens eget förra
     försök, aldrig en uppfunnen ideallinje.

     Bara de övningar som HAR en definition i kanonen spelas in
     (Inspelning.spelasIn). En post utan version går inte att jämföra mot
     något, och att stämpla den med en påhittad version vore precis den
     falska referens som är förbjuden. ]]
local inspelare: Inspelning.Recorder? = nil
local inspelningar: { [string]: { Inspelning.Post } } = {}
local senasteOvning: string? = nil

--[[ SPELARENS HANDLING. Registreras hos HUD:en i `start` och körs när
     knappen, tangenten eller gamepadknappen fyrar — HUD:en har redan
     stängt kortet när vi kommer hit, så det här är bara lifecyclen.

     `Lektion.vidare` ligger HÄR och inte direkt efter `avslutaForsok`:
     det är spelarens val som nollställer mätningen, vilket är precis vad
     provet kan mäta. ]]
--[[ Stänger den pågående inspelningen och lägger posten i historiken.
     Idempotent: ett andra anrop har ingen inspelare att stänga. En post
     utan sampel läggs INTE undan — en tom ritt är ingen ritt, och en tom
     post i listan hade blivit ett spöke utan väg. ]]
local function stangInspelning()
	local r = inspelare
	inspelare = nil
	if not r then return end
	local post = Inspelning.avsluta(r)
	if not post or #post.sampel == 0 then return end
	local lista = inspelningar[post.ovning]
	if not lista then lista = {}; inspelningar[post.ovning] = lista end
	table.insert(lista, post)
end

--[[ Startar en inspelning för det försök som just börjat mätas. Anropas
     varje bildruta men gör bara något första gången: finns redan en
     inspelare är försöket igång. ]]
local function startaInspelning(p: Lektion.Pass, tm: { [string]: any }?)
	if inspelare then return end
	local id = Lektion.ovningId(p)
	if not Inspelning.spelasIn(id) then
		--[[ ÖVNINGEN SPELAS INTE IN — och då ska det INTE gå att "se ritten".
		     `senasteOvning` måste nollas här, inte bara sättas när en
		     inspelning startar. Annars pekade den kvar på FÖRRA övningen, och
		     kortet efter en oinspelad övning erbjöd "Se ritten" som öppnade
		     någon annans ritt. Falsifieringen (`trav_skritt` avstängd) visade
		     det: knappen stod kvar, grön, med voltens post bakom sig. ]]
		senasteOvning = nil
		return
	end
	local hast = if type(tm) == "table" and type(tm.hast) == "string" then tm.hast else nil
	inspelare = Inspelning.ny(id :: string, hast)
	senasteOvning = id
end

--[[ Finns det en ritt att visa för den övning som just bedömdes? ]]
local function harRitt(): boolean
	local id = senasteOvning
	if not id then return false end
	local lista = inspelningar[id]
	return lista ~= nil and #lista > 0
end

--[[ SE RITTEN. Öppnar analysen på det senaste försöket med förra försöket
     som spöke. Ridningen fryses av init.client medan panelen är uppe —
     inte här: den här modulen äger lektionen, inte rörelsen. ]]
local function oppnaReplay()
	local id = senasteOvning
	if not id then return end
	local lista = inspelningar[id]
	if not lista or #lista == 0 then return end
	ReplayController.oppna(lista[#lista], if #lista > 1 then lista[#lista - 1] else nil)
end

local function fortsattning()
	local p = pass
	if not p then return end
	--[[ En ny mätning börjar. Inspelaren nollas HÄR, i samma handling som
	     nollställer mätningen, så att nästa försök spelas in från noll och
	     inte fortsätter i det förras post. ]]
	inspelare = nil
	if lage == "presentation" then
		lage = "rider"
	elseif lage == "efter" then
		local forra = p.ix
		Lektion.vidare(p)
		if p.klar then
			lage = "ingen"
		elseif p.ix == forra then
			--[[ SAMMA övning, nytt försök. Spelaren tryckte "Prova igen",
			     och det ÄR valet att börja om — att sedan visa samma
			     presentationskort igen vore ett andra klick för ett beslut
			     som redan är fattat. ]]
			lage = "rider"
		else
			--[[ Ny övning: den ska presenteras innan den rids. ]]
			lage = "ny"
		end
	end
	liveCd, liveSagt = 0, ""
end

--[[ Startar lektionen. `ridhus` är den byggda modellen; utan den finns
     ingen plats att ställa Ugneta på, och då körs lektionen ändå — HUD:en
     är inte beroende av gestalten. En saknad byggnad ska inte tysta
     undervisningen, bara gestalten. ]]
function LektionController.start(ridhus: Instance?)
	pass = Lektion.nyttPass()
	liveCd, liveSagt = 0, ""
	lage = "ny"
	inspelare = nil
	inspelningar = {}
	senasteOvning = nil
	UgnetaController.vidFortsatt(fortsattning)
	UgnetaController.vidReplay(oppnaReplay)
	--[[ GÅ VIDARE. Momentet är redan bedömt av `avslutaForsok`; det här
	     hoppar över omridningen, inte bedömningen. Lifecyclens regel ligger
	     i Lektion.hoppaOver — HUD:en flyttar inte passet själv. ]]
	UgnetaController.vidVidare(function()
		local p = pass
		if not p then return end
		inspelare = nil
		Lektion.hoppaOver(p)
		lage = if p.klar then "ingen" else "ny"
		liveCd, liveSagt = 0, ""
	end)
	UgnetaGestalt.visa(ridhus)
end

function LektionController.pagar(): boolean
	return pass ~= nil and not (pass :: Lektion.Pass).klar
end

function LektionController.pass(): Lektion.Pass?
	return pass
end

function LektionController.lage(): string
	return lage
end

--[[ Väntar lektionen på spelaren just nu? init.client frågar innan den
     tolkar tangenten, så att samma knapp kan betyda något annat när
     inget kort står uppe. ]]
function LektionController.vantar(): boolean
	return pass ~= nil and UgnetaController.vantar()
end

--[[ Spelaren gick vidare, via tangent eller gamepad. Musen och fingret
     går in genom knappens eget Activated. Returnerar false när det inte
     fanns någon väntan — då har tangenten inte betytt något här. ]]
function LektionController.fortsatt(): boolean
	if not pass then return false end
	return UgnetaController.fortsatt()
end

--[[ De två andra vägarna ut ur ett avslutat försök. Samma mönster som
     `fortsatt`: returnerar false när det inte fanns något val att göra, så
     att tangenten faller igenom till sin vanliga betydelse. ]]
function LektionController.replay(): boolean
	if not pass then return false end
	return UgnetaController.replay()
end

function LektionController.gaVidare(): boolean
	if not pass then return false end
	return UgnetaController.gaVidare()
end

--[[ Står analysen uppe? init.client fryser ridningen på den frågan — och
     frågar modulen, inte ett eget flaggvärde, så att det bara finns ett
     svar. ]]
function LektionController.replayAktiv(): boolean
	return ReplayController.aktiv()
end

--[[ Stänger analysen utan att röra kortet bakom den. Väntan är kvar: att
     ha SETT sin ritt är inte att ha valt vad som ska hända med den. ]]
function LektionController.stangReplay(): boolean
	if not ReplayController.aktiv() then return false end
	ReplayController.stang()
	return true
end

--[[ Presentationen av övningen. Kortet, men INTE mitt under ridningen:
     det visas innan försöket börjar och spelaren stänger det själv
     genom att starta. ]]
local function presentera(p: Lektion.Pass)
	local o = Lektion.ovning(p)
	if not o then return end
	UgnetaController.visa(o.rubrik, o.punkter, true, "Börja")
	lage = "presentation"
end

--[[ ETT STEG. Anropas varje bildruta med ritt-telemetrin. ]]
function LektionController.steg(dt: number, tm: { [string]: any }?,
	pose: { [string]: any }?)
	local p = pass
	if not p or p.klar then return end
	UgnetaController.steg(dt)

	if lage == "ny" then
		presentera(p)
		return
	end

	--[[ VÄNTAN PÅ SPELAREN. Kortet står kvar, ingenting mäts, tiden växer
	     inte. Det är här den gamla timern satt, och det är därför
	     mätningen kunde börja innan ryttaren var redo. ]]
	if UgnetaController.vantar() then return end
	if lage ~= "rider" then return end

	if not tm or tm.uppsutten ~= true then return end

	--[[ Inspelningen ligger FÖRE mätningen och läser samma bildruta som
	     den. Att spela in efter `Lektion.matning` hade gett en post som
	     ligger en bildruta efter det som bedömdes. ]]
	startaInspelning(p, tm)
	Inspelning.sampla(inspelare, dt, tm, pose)

	p.tid += dt
	--[[ `dt` följer med: täckningen räknas i uppmätta sekunder, inte i
	     bildrutor, så en snabb klient inte får "mer underlag" än en
	     långsam på samma ritt. ]]
	Lektion.matning(p, tm, dt)

	--[[ LIVE: några ord, och aldrig samma ord två gånger i rad. ]]
	liveCd -= dt
	if liveCd <= 0 then
		local txt, bra = Lektion.liveCue(p, Lektion.kvalitet(tm))
		if txt ~= "" and txt ~= liveSagt then
			liveCd = if bra then LIVE_CD.bra else LIVE_CD.fel
			liveSagt = txt
			UgnetaController.live(txt, bra)
		end
	end

	if p.tid < Lektion.FORSOK_SEK then return end

	--[[ FÖRSÖKET ÄR SLUT. Betyget hör till underlaget, inte till
	     lifecyclen: `avslutaForsok` lämnar medelvärdena och Ugneta
	     rangordnar dem. ]]
	--[[ Stäng försöket FÖRST. Betyget, kortet och replayen ska alla se
	     samma avslutade ritt — inte en som stängs en bildruta senare. ]]
	stangInspelning()
	local h = Lektion.avslutaForsok(p)
	if h then
		UgnetaController.efterForsok(h.ovningId, h.nu, h.fore, h.forsokNr, harRitt())
		lage = "efter"
	else
		--[[ INGET UNDERLAG → INGET OMDÖME, men spelaren får veta varför.
		     `avslutaForsok` ger nil när ingen dimension nådde kraven
		     (ryttaren satt aldrig upp, telemetrin uteblev, fälten var
		     ogiltiga). Att gissa fram ett omdöme hade blivit falskt
		     beröm eller falskt fel om en ritt som aldrig mättes — men att
		     bara tyst gå vidare vore obegripligt: hon såg ett försök ta
		     slut utan ett ord. Kortet säger därför exakt det som är
		     sant, varken mer eller mindre, och väntar på spelaren som
		     alla andra kort. ]]
		UgnetaController.visa("Försöket kunde inte bedömas",
			{ "Det fanns inte tillräckligt mätt underlag den här gången." },
			true, if p.forsokNr < 2 then "Prova igen" else "Nästa övning")
		lage = "efter"
	end
	liveCd, liveSagt = 0, ""
end

--[[ Slut på ritten, av vilket skäl som helst. Säkerhet före undervisning:
     chipet släcks, kortet stängs, den väntande fortsättningen kastas och
     gestalten tas bort. ]]
function LektionController.avbryt()
	pass = nil
	liveCd, liveSagt = 0, ""
	lage = "ingen"
	--[[ SÄKERHET FÖRE UNDERVISNING. Analysen stängs och inspelningen
	     kastas — en halv ritt som avbröts av en avsittning är inget att
	     spela upp, och panelen får aldrig bli kvar över ett ekipage som
	     inte finns. Posterna släpps med passet: de hörde till det. ]]
	ReplayController.stang()
	inspelare = nil
	inspelningar = {}
	senasteOvning = nil
	UgnetaController.vidFortsatt(nil)
	UgnetaController.vidReplay(nil)
	UgnetaController.vidVidare(nil)
	UgnetaController.sakerhetTarOver()
	UgnetaGestalt.dolj()
end

return LektionController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX50">
					<Properties>
						<string name="Name">MovementController</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rörelsen — den modul som avgör om hästen känns som ett djur eller ett fordon.

	Körs hos den som äger nätverket, alltså ryttarens egen klient. Servern
	validerar resultatet men simulerar det inte, för annars ligger latensen
	i varje styrutslag och hästen känns som en båt.

	Fyra saker gör skillnaden mot ett fordon:

	  1. Tempot dras mot gångartens hemtempo, inte mot en knapp. Släpper man
	     W stannar hästen inte — den rullar ned i skritt.
	  2. Styraxeln ber om en KURVATUR, inte om en vridhastighet. Radien
	     blir 1/kurvatur oavsett fart, så en snabbare gångart ger en
	     vidare båge av sig själv i stället för genom en motkraft.
	  3. Svängen tar tag gradvis, så inget snäpper till 90 grader.
	  4. Accelerationen är olika uppåt och nedåt, och tyngre hästar är trögare.
	  5. Styrutslaget rampas innan det används. En tangent är av eller på,
	     och utan rampen finns bara tre lägen: helt vänster, rakt, helt
	     höger. Med den doserar man svängen genom hur länge man håller, och
	     en gamepadspak som redan står halvvägs rampas mot just halvvägs.

	Marken sköts av Humanoid. Det är medvetet: Roblox löser sluttningar,
	kanter och trappor bättre än en egen strålkastning gör, och det som
	känns fordonsaktigt kommer från styrmodellen — inte från Humanoid.
]]

local RunService = game:GetService("RunService")

local Core = require(game:GetService("ReplicatedStorage").HorseCore)
local Types = require(game:GetService("ReplicatedStorage").HorseCore.Types)
local Config, Gaits, RigAdapter = Core.Config, Core.Gaits, Core.RigAdapter
local StateMachine = Core.StateMachine
local RidKanon, Hjalper, Svar = Core.RidKanon, Core.Hjalper, Core.Svar

local MovementController = {}
MovementController.__index = MovementController

local function approach(current: number, target: number, up: number, down: number, dt: number): number
	if target > current then
		return current + math.min(target - current, up * dt)
	end
	return current - math.min(current - target, down * dt)
end

--[[ ── HJÄLPERNA UR AVSIKTEN ────────────────────────────────────────
     Enhetens axlar → ridningens ord, med talen ur RidKanon.KONTAKT.

     REN FUNKTION, och den ligger utanför `step()` av ett skäl (Jules
     QA-fynd, #89): konstruktorn behöver EXAKT samma översättning för att
     kunna sätta ett giltigt utgångsläge. Räknades den bara inne i
     `step()` var `self.hjalper` nil fram till första bildrutan, och en
     telemetriläsning dessförinnan saknade hela hjälpblocket. Att skriva
     neutralvärdena en andra gång i konstruktorn hade varit två sanningar
     om samma sak; nu är det en. ]]
function MovementController.semantik(intent: Types.Intent): { [string]: any }
	local KN = RidKanon.KONTAKT
	local framat = math.clamp(intent.forward or 0, -1, 1)
	local skankel = if framat >= 0
		then KN.SKANKEL_NEUTRAL + framat * (0.78 - KN.SKANKEL_NEUTRAL)
		else KN.SKANKEL_NEUTRAL + framat * (KN.SKANKEL_NEUTRAL - 0.05)
	local tygel = KN.TYGEL_NEUTRAL
		+ math.clamp(intent.rein or 0, 0, 1) * (KN.TYGEL_MAX - KN.TYGEL_NEUTRAL)
	--[[ Sitsen: −1 lätt … 0 normal … 1 djup, skalad till modellens spann
	     kring SITS_NEUTRAL på samma sätt som webbens inputlager gör det. ]]
	local seat = math.clamp(intent.seat or 0, -1, 1)
	local sits = if seat >= 0
		then KN.SITS_NEUTRAL + seat * (KN.SITS_MAX - KN.SITS_NEUTRAL)
		else KN.SITS_NEUTRAL + seat * (KN.SITS_NEUTRAL - (-0.6))
	--[[ Styraxeln skalas till samma spann som webbens inputlager, så att
	     böjkravet betyder samma sak på båda ytorna. ]]
	local hj = Hjalper.semantik({
		skankel = skankel, tygel = tygel, sits = sits,
		styrning = math.clamp(intent.steer or 0, -1, 1) * RidKanon.HJALP.STYR_FULLT,
		parad = intent.parad or 0,
	})
	--[[ Hjalper.semantik lämnar redan skankel/tygel/sits vidare, så
	     anroparen läser dem därifrån i stället för att räkna om dem. ]]
	return hj
end

--[[ Ryttaren som INTE gör något. Neutralläget är inte nollor — en häst
     rids aldrig med släppt skänkel — utan KONTAKT:s egna mittvärden, och
     de kommer härifrån så att de inte kan skilja sig från runtime. ]]
local NEUTRAL_INTENT: Types.Intent = {
	forward = 0, steer = 0, rein = 0, seat = 0, parad = 0,
	gaitUp = false, gaitDown = false, jump = false,
}

--[[ Exponentiell utjämning som är oberoende av bildfrekvens. Ett rakt
     lerp med fast faktor ger olika känsla vid 30 och 144 Hz. ]]
local function smooth(current: number, target: number, tau: number, dt: number): number
	if tau <= 0 then return target end
	return current + (target - current) * (1 - math.exp(-dt / tau))
end

function MovementController.new(rig: Types.Rig, stats: { [string]: any })
	local self = setmetatable({}, MovementController)
	self.rig = rig
	self.stats = stats
	self.temperament = Config.TEMPERAMENTS[stats.Temperament] or Config.TEMPERAMENTS.Calm
	self.machine = StateMachine.new()
	self.jumpReady = 0
	self.ceiling = Gaits.SPELBAR_TOPP

	local heading = math.atan2(rig.root.CFrame.LookVector.X, rig.root.CFrame.LookVector.Z)
	self.loco = {
		speed = 0, heading = heading, turnRate = 0, lean = 0,
		gait = "halt", targetGait = "halt", state = "Idle",
		phase = 0, airborne = false, grounded = true,
		slope = Vector3.yAxis, stamina = stats.MaxStamina,
		--[[ G02-B punkt 2. `beddGangart` är vad ryttaren bad om,
		     `targetGait` vad hästen svarat på — under svarstiden skiljer
		     de sig, och det är hela skillnaden mot före G02-B, då cue:n
		     startade förloppet i samma bildruta den föll. ]]
		beddGangart = "halt", svarstid = 0, overgangstid = 0, etableringstid = 0,
		--[[ UTGÅNGSLÄGET ÄR KANON (senior re-review #87, blocker 2).
		     Stod som literaler här — mjukhet 1, spänning 0, energi 1 —
		     medan webben satte upp på 0,5 / 0,15 / 0,835. Samma formler
		     på olika ritt är inte samma produkt, och det var blockeraren.
		     Talen läses nu ur RidKanon.START, exporterad ur webbens
		     SVAR_START. ]]
		mjukhet = RidKanon.START.MJUKHET,
		spanning = RidKanon.START.SPANNING,
		fokus = RidKanon.START.FOKUS,
		balans = RidKanon.START.BALANS,
		energi = Svar.startEnergi(), paradKvalitet = 0,
	} :: Types.Locomotion

	--[[ Ryttarens rang hos hästen. VÄXER under ritten sedan blocker 2,
	     med webbens formel: en stadig hand bygger den, spänning river
	     den. Den låg låst på 0,5 här, och eftersom spänningen läser
	     rangen var det en tyst skillnad i hela spänningsmodellen. ]]
	--[[ HJÄLPERNA ÄR GILTIGA REDAN HÄR (Jules QA-fynd, #89). `self.hjalper`
	     sattes förut först inne i `step()`, så allt som läste controllern
	     före första bildrutan — telemetrin i synnerhet — fick nil och
	     tappade hela hjälpblocket. Utgångsläget är ryttaren som ännu inte
	     gjort något, räknat med SAMMA funktion som runtime använder. ]]
	self.hjalper = MovementController.semantik(NEUTRAL_INTENT)
	self.rang = RidKanon.START.RANG
	self.slopePitch = 0
	self.steerInput = 0        -- rampat styrutslag, se _steer nedan
	self.curvature = 0         -- aktuell kurvatur, 1/m
	self.lastPos = nil         -- förra bildrutans läge, driver fasen
	return self
end

--[[ Styrutslaget mellan tangent och sväng. Tar snabbare än det släpper:
     att börja svänga ska kännas omedelbart, att sluta svänga ska kännas
     som att hästen rätar upp sig — inte som att någon släpper ett reglage. ]]
function MovementController:_steer(raw: number, dt: number): number
	local M = Config.MOVEMENT
	local tau = if math.abs(raw) > math.abs(self.steerInput)
		then M.SteerTauPress else M.SteerTauRelease
	self.steerInput = smooth(self.steerInput, raw, tau, dt)
	if math.abs(self.steerInput) < 0.004 then self.steerInput = 0 end
	return self.steerInput
end

--[[ Vilken gångart spelaren begär. W från stillastående startar skritt,
     Shift/Ctrl stegar, S rullar ned och backar till slut. Spelaren väljer
     alltså gångart, aldrig ett exakt tempo — det är skillnaden mot en
     gaspedal, och det är därför hästen känns som en häst. ]]
function MovementController:_targetGait(intent: Types.Intent, paradFlank: boolean?): string
	--[[ Stegar från den gångart ryttaren SENAST BAD OM, inte från den
	     hästen hunnit svara på (G02-B punkt 2). Två snabba tryck ska ge
	     två steg även om hästen ännu inte börjat på det första — annars
	     äter svarstiden upp hjälper, och den ska skjuta svaret i tid, inte
	     ta bort det. ]]
	local index = Gaits.index(self.loco.beddGangart or self.loco.targetGait)

	if intent.gaitUp then index += 1 end
	if intent.gaitDown then index -= 1 end
	--[[ PARADEN ÄR EN NEDÅTGÅENDE HJÄLP (G02-B punkt 1), inte bara en
	     kvalitetsmätare. På webben är halvhalten den ridmässigt rätta
	     vägen ned och tar ett steg i gångartstrappan; här gör den
	     detsamma, vid sidan av gångartsknappen. Kanalen är en impuls, så
	     flanken räknas en gång — att hålla F ger inte en oändlig parad. ]]
	--[[ FLANKEN, inte nivån (senior re-review #87, blocker 2). Raden
	     läste `intent.parad > 0` varje bildruta, så att HÅLLA F stegade
	     ned hela trappan på tre bildrutor — precis det kommentaren ovan
	     påstod inte kunde hända. Den var osynlig så länge blocket runt
	     bara kördes när gångarten redan bytt. ]]
	if paradFlank == nil then paradFlank = (intent.parad or 0) > 0 end
	if paradFlank then index -= 1 end

	if intent.forward > 0.5 and index <= 1 then
		index = 2                                   -- W ur halt startar skritt
	elseif intent.forward < -0.5 then
		index -= 1                                   -- S rullar ned en gångart
	end

	--[[ Två tak, och det yttre går inte att förhandla bort: uthålligheten
	     kan sänka spelarens tak, men ingenting kan höja det över
	     Gaits.SPELBAR_TOPP. Utan min() här hade en felaktig eller
	     manipulerad GaitCeiling från servern öppnat fyrsprånget. ]]
	local ceilingIndex = math.min(Gaits.index(self.ceiling), Gaits.index(Gaits.SPELBAR_TOPP))
	index = math.clamp(index, 1, ceilingIndex)
	return Gaits.byIndex(index)
end

function MovementController:step(intent: Types.Intent, dt: number)
	--[[ ── TIDEN MÅSTE GÅ FRAMÅT (Jules QA-fynd, #89) ─────────────────
	     En negativ eller icke-finit `dt` är en klockanomali, och bildrutan
	     hoppas över hel. Utan vakten sprack `math.clamp(steg, -takSteg,
	     takSteg)` i kurvaturens takstegsberäkning: `takSteg` blir negativt
	     vid negativ dt, och då är min > max. Uppmätt: `step(intent, -0.5)`
	     kastade "invalid argument #3 to 'clamp'" mitt i bildrutan, med
	     halva tillståndet redan skrivet.

	     `dt == 0` släpps IGENOM med flit och är mätt säker: allt rör sig
	     noll, kurvaturens tak blir noll, och tillståndet är oförändrat och
	     finit efteråt. Att hoppa över nolldeltat hade tappat bildrutans
	     hjälper och en gångartsbegäran som råkar falla där. ]]
	if not (dt >= 0) then return end
	local loco = self.loco
	local rig = self.rig
	local stats = self.stats
	local M = Config.MOVEMENT

	--[[ CUE OCH ÖVERGÅNGSTID (G02-A, PO 2026-09-05). Modellen fanns redan
	     — spelaren väljer gångart, inte tempo — men den mättes inte. Här
	     bokförs NÄR begäran ändrades och hur lång tid hästen tog på sig,
	     så telemetrin kan visa samma sak som webben. Ingen regel ändras. ]]
	loco.tid = (loco.tid or 0) + dt

	--[[ ── HJÄLPERNA I RIDNINGENS ORD (G02-B punkt 1) ────────────────
	     Axlarna översätts en gång per bildruta med den DELADE semantiken
	     i HorseCore.Hjalper, som läser talen ur RidKanon.HJALP —
	     genererad ur webbens modul. Inga tal skrivs av här.

	     Skänkeln byggs av framåtavsikten kring modellens neutralläge, på
	     samma sätt som webbens inputlager gör det: en häst rids inte med
	     släppt skänkel, så nollan i mitten är ett mittvärde och inte 0. ]]
	local hj = MovementController.semantik(intent)
	local skankel, tygel = hj.skankel, hj.tygel
	self.hjalper = hj

	--[[ ── MJUKHET OCH SPÄNNING (senior review #87, blocker 1) ────────
	     Mjukheten är handens stadga över tid: hjälpernas avvikelse från
	     sitt eget glidande medel. Spänningen läser den, och fokus läser
	     båda. Formlerna är webbens och talen ligger i RidKanon.SVAR. ]]
	self._medel = self._medel or { skankel = hj.skankel, tygel = hj.tygel,
		sits = hj.sits, styrning = hj.styrning }
	loco.mjukhet = Svar.mjukhet(loco.mjukhet or 1, self._medel, hj, dt)
	do
		local hast = {
			kanslighet = Svar.kanslighet(self.temperament, stats),
			forlatande = stats.Forlatande or 0.60,
			skygghet = stats.Skygghet or 0.20,
		}
		--[[ SADELLAGE OCH DAGSFORM ÄR KANON sedan blocker 2 — samma
		     utgångsläge som webben, ur RidKanon.START, i stället för
		     två egna neutrala element. STALLRO och UNDERLAG saknar
		     fortfarande källa och står i Svar.KONTEXT_SAKNAS; de körs
		     på sina neutrala element och fylls inte med gissningar. ]]
		local spMal = Svar.spanningMal(hj, hast, loco.mjukhet, self.rang,
			self.gangartWebb or "halt",
			{ stallro = 1, underlag = 1,
				sadellage = RidKanon.START.SADELLAGE,
				dagsform = RidKanon.START.DAGSFORM,
				utomhus = self.utomhus == true })
		--[[ Rangen växer av handen och rivs av spänningen. Läses av
		     spänningen NÄSTA bildruta, precis som på webben där raden
		     ligger sist i stepRide. ]]
		self.rang = Svar.rangSteg(self.rang, loco.mjukhet, loco.spanning or 0, dt)
		loco.spanning = Svar.spanningSteg(loco.spanning or 0, spMal, hast, dt)
	end

	--[[ ── HALVHALTEN LÄSES ALLTID (senior re-review #87, blocker 2) ──
	     Den här läsningen låg INNE i "begäran ändrades"-blocket nedan.
	     En halvhalt som inte råkade byta gångart registrerades därför
	     aldrig: ingen paradkvalitet, ingen fokuslyft, ingen `halvhalt`
	     i telemetrin. På webben är en halvhalt en hjälp i sig och läses
	     när den ges — och det är hela poängen med G02-B punkt 1.

	     Cross-platform-scenariot hittade det: mac_kenzie parerades vid
	     10,0 s och bad om halt först vid 10,23 s, och tappade då hela
	     fokuslyftet — 0,738 mot webbens 0,785. En halvhalt är inte
	     mindre välriden för att hästen redan gick i den gångart
	     ryttaren ville ha.

	     EN PARAD PER TRYCK. `paradFlank` är kanalens stigande flank, så
	     att hålla knappen inne inte blir en oändlig rad halvhalter. Det
	     var vad koden PÅSTOD att den gjorde; den läste nivån. ]]
	local paradNu = (intent.parad or 0) > RidKanon.HJALP.PARAD_TROSKEL
	local paradFlank = paradNu and not self._paradHalls
	self._paradHalls = paradNu
	if paradFlank then
		loco.paradKvalitet = Hjalper.paradKvalitet({ skankel = skankel, tygel = tygel })
		loco.paradTid = loco.tid
		loco.cue = "halvhalt"
	end

	local forraMal = loco.beddGangart or loco.targetGait
	loco.beddGangart = self:_targetGait(intent, paradFlank)
	if loco.beddGangart ~= forraMal then
		local upp = Gaits.index(loco.beddGangart) > Gaits.index(forraMal)
		loco.cue = if upp then "framåt" else "nedåt"
		loco.cueTid = loco.tid
		loco._overgangKlar = false
		--[[ FÖRLOPPET STARTAS HÄR, från det tempo hästen FAKTISKT har.
		     Att utgå från nuvarande tempo och inte från gångartens norm
		     är det som gör förloppet avbrytbart: kommer en motsatt
		     begäran mitt i, börjar nästa förlopp där hon är.

		     Längden är kanon (Config.MOVEMENT.Transition) skalad med
		     hästens egen svarsförmåga. Skalan är 1,0 för en neutral
		     häst, precis som webbens, så basvärdena betyder samma sak
		     på båda ytorna. Nedåt avgör bestämdheten: att bara hålla
		     emot ger det mjuka förloppet, S ger det korta. ]]
		local T = M.Transition
		local kraft = if intent.forward < -0.5 then 1 else 0
		local bas = if upp
			then (T[loco.beddGangart] or T.canter)
			else T.downSoft - (T.downSoft - T.downFirm) * kraft
		local svar = (0.65 + 0.70 * stats.Acceleration) * self.temperament.accelBias
		--[[ HÄSTENS SVARSTID (G02-B punkt 2). Förloppet beräknas här, ur
		     hjälpen som gavs, men STARTAR först när väntan är slut. Att
		     flytta beräkningen till svaret hade betytt att en parad mätte
		     den tygel ryttaren råkar ha en halv sekund senare i stället
		     för den hon parerade med.

		     Tydligheten är samordningen — skänkeln framför tröskeln och
		     handen i kontaktbandet — samma formel som paradens kvalitet,
		     och samma val som webben gjorde efter att marginalmåttet
		     visat sig omöjligt att göra rött genom inputlagret.

		     FOKUS RÄKNAS HÄR sedan #87:s första review och skickas som
		     hästens faktiska fokus. `or 1` nedan är bara en vakt för
		     bildrutan innan fokus fått sitt första värde. ]]
		local klarhet = Hjalper.paradKvalitet({ skankel = skankel, tygel = tygel })
		local vantan = Svar.svarstid(self.stats, Svar.kanslighet(self.temperament, stats),
			loco.fokus or 1, loco.energi or 1, klarhet)
		loco.svarstid = vantan
		self._vantar = { fran_gait = forraMal, till = loco.beddGangart,
			kvar = vantan, langd = bas / math.max(svar, 0.2) }
	end

	--[[ SVARET. Hjälpen tappas aldrig bort: när väntan är slut startar
	     förloppet, och det är först då `targetGait` byter. Övergångens
	     kanon mäter alltså fortsatt FÖRLOPPET och inte fördröjningen,
	     precis som på webben. ]]
	local vantar = self._vantar
	if vantar then
		vantar.kvar -= dt
		if vantar.kvar <= 0 then
			loco.targetGait = vantar.till
			loco.svarTid = loco.tid
			--[[ Förloppets klocka startar med rörelsen, inte med begäran. ]]
			self._ovStart = loco.tid
			self._ov = { fran = loco.speed, t = 0,
				langd = vantar.langd, fran_gait = vantar.fran_gait }
			self._vantar = nil
		end
	end
	--[[ TRE TIDER, TRE LÅSTA BETYDELSER (senior review #87, blocker 3).
	     Fältet mätte förut en tredje sak än kommentarerna påstod, på båda
	     ytorna. Nu: `svarstid` begäran → svar, `overgangstid` förloppets
	     faktiska längd, `etableringstid` begäran → gångarten ÄR den
	     beddna. Alla tre mäts; ingen räknas fram ur de andra. ]]
	--[[ Jämför mot BEDDGANGART och inte mot targetGait. Under svarstiden
	     har targetGait ännu inte bytt, så `gait == targetGait` är sant
	     redan innan hästen börjat svara — villkoret slog då till i samma
	     bildruta som cue:n föll och rapporterade etableringstid 0,000.
	     Uppmätt när provet nedan skrevs; det är precis vad provet finns
	     för. Etablerad är hon när hon går i den gångart ryttaren BAD om. ]]
	if not loco._overgangKlar and loco.cueTid
		and loco.gait == loco.beddGangart and loco.targetGait == loco.beddGangart then
		loco.etableringstid = loco.tid - loco.cueTid
		loco._overgangKlar = true
	end
	local gait = Gaits.get(loco.targetGait)

	--[[ ── Tempo ──────────────────────────────────────────────────────
	     Målet är gångartens hemtempo, med ett litet spann som ryttaren kan
	     skjuta inom. Hästen får aldrig ligga still mellan två gångarter. ]]
	local reverse = loco.targetGait == "halt" and intent.forward < -0.5
	local target = if reverse then -M.ReverseSpeed else gait.norm
	if not reverse and gait.norm > 0 then
		target += intent.forward * (gait.max - gait.norm) * 0.35
		target = math.clamp(target, gait.min, gait.max) * (0.85 + 0.30 * stats.Speed)
	end

	local accelScale = (0.65 + 0.70 * stats.Acceleration) * self.temperament.accelBias
	local ov = self._ov
	if ov and ov.t < ov.langd then
		--[[ UNDER FÖRLOPPET styr kurvan, inte approach(). Mjukstegskurvan
		     u²(3−2u) startar och slutar med noll lutning, vilket ger en
		     övergång utan ryck i någon ände och utan platå på mitten.
		     Samma kurva och samma längd som webben. ]]
		ov.t += dt
		local u = math.clamp(ov.t / ov.langd, 0, 1)
		local mjuk = u * u * (3 - 2 * u)
		loco.speed = ov.fran + (target - ov.fran) * mjuk
		if u >= 1 then
			--[[ KLOCKAD, inte avläst ur ov.langd: läses längden ur planen
			     kan provet inte upptäcka att kurvan slutar någon
			     annanstans än den skulle. ]]
			loco.overgangstid = loco.tid - (self._ovStart or loco.tid)
			self._ov = nil
		end
	else
		self._ov = nil
		local up = gait.accel * accelScale
		local down = gait.retard * accelScale
		if intent.forward < -0.5 then
			down += M.BrakeExtra
		end
		loco.speed = approach(loco.speed, target, up, down, dt)
	end

	--[[ ── Sväng ──────────────────────────────────────────────────────
	     Kurvaturen är det spelaren styr: hur snävt hästen böjer sig, i
	     1/meter. Gångartens turn-faktor sätter taket — en häst i fyrsprång
	     böjer sig inte som en häst i skritt — och vridhastigheten faller
	     ut som kurvatur × tempo. Radien blir därmed 1/kurvatur oavsett
	     fart, alltså vidare bågar i högre gångart utan att någon motkraft
	     behöver räknas fram.

	     Kurvaturen tar tag snabbare än den släpper: att lägga sig i en
	     båge går fortare än att räta upp sig ur den, både i verkligheten
	     och i känslan. ]]
	local speedAbs = math.abs(loco.speed)
	local steer = self:_steer(intent.steer, dt)
	--[[ SVÄNGKÄNSLAN FÖLJER DEN FAKTISKA GÅNGARTEN, inte den begärda.

	     Taket och trögheten togs förut ur Gaits.get(loco.targetGait),
	     alltså ur den gångart ryttaren just BAD om. Då bytte svängkänslan
	     i samma bildruta som cue:n föll, medan webben behåller den gamla
	     gångartens sväng ända till 55 %-punkten — hela poängen med att
	     etiketten byter en bit in i förloppet är att hästen inte ÄR i
	     travet förrän hon är det.

	     loco.gait sätts längre ned i step(), så värdet här är förra
	     bildrutans. Webben har exakt samma förhållande: GANGSVANG läses i
	     stegaRitt() innan stepRide() uppdaterar gångarten. ]]
	local svangGait = Gaits.get(loco.gait)
	local kappaCeiling = M.CurvatureMax * svangGait.turn * (0.70 + 0.60 * stats.Agility)
	local kappaWanted = steer * kappaCeiling
	--[[ ── HÄSTEN FALLER IN (G02-B punkt 2) ───────────────────────────
	     Den enda plats där hästens tillstånd ändrar VAR hon hamnar och
	     inte bara vad hon får för betyg. En häst som tappat balansen i en
	     sväng faller in på inre skuldran: bågen blir snävare än ryttaren
	     bad om.

	     Taket ligger på BEGÄRAN och inte på den integrerade kurvaturen,
	     så CurvatureRateTime och kurvaturens tröghet gäller oförändrat —
	     infallet kan inte göra styrningen ryckig, det flyttar var bågen
	     hamnar. Noll på rakt spår och noll i balans. Identiskt med
	     webbens, och avstängbart med SVAR.INFALL_MAX = 0. ]]
	local bojkrav = math.min(1, math.abs(hj.styrning) / RidKanon.HJALP.STYR_FULLT)
	kappaWanted *= 1 + Svar.infall(loco.balans or 1, bojkrav)
	if loco.speed < -0.05 then
		kappaWanted = -kappaWanted                    -- backar man styr man spegelvänt
	end
	--[[ Gångartens egen tröghet i svängen (G02-A.1 P3). Talet ligger i
	     Gaits.svangTau och speglar RID_KANON.SVANGTAU på webben.
	     Skritten rättar sig kvickast, galoppen lägger sig i bågen
	     långsammare och känns därför vidare. ]]
	local kappaTau = (if math.abs(kappaWanted) > math.abs(self.curvature)
		then M.CurvatureTauPress else M.CurvatureTauRelease) * (svangGait.svangTau or 1)
	--[[ Bågen måste ur kroppen innan den läggs åt andra hållet
	     (G02-A.1 P4). Samma regel och samma tal som webben: kurvaturen
	     får inte ändras fortare än gångartens kurvaturtak delat med
	     CurvatureRateTime. En vanlig insvängning ligger under taket. ]]
	local nyKappa = smooth(self.curvature, kappaWanted, kappaTau, dt)
	local takSteg = (kappaCeiling / M.CurvatureRateTime) * dt
	local steg = math.clamp(nyKappa - self.curvature, -takSteg, takSteg)
	self.curvature += steg
	if math.abs(self.curvature) < 0.0015 then self.curvature = 0 end
	loco.turnRate = self.curvature * loco.speed
	--[[ Vändning på stället läggs till där farten är låg. Utan den kan en
	     stående häst inte vrida sig alls, eftersom omega är kurvatur
	     gånger tempo — och tillståndsmaskinen har ett eget läge för just
	     att vända på stället. Termen tonas ut linjärt och är helt borta
	     när hästen går, så den kan aldrig ge en pivot under ritt. ]]
	if speedAbs < M.TurnInPlaceBelow then
		local andel = 1 - speedAbs / M.TurnInPlaceBelow
		loco.turnRate += steer * M.TurnInPlaceRate
			* (0.70 + 0.60 * stats.Agility) * andel
	end
	loco.heading = (loco.heading + loco.turnRate * dt) % (2 * math.pi)

	--[[ ── HÄSTENS SVAR: BALANS OCH ENERGI (G02-B punkt 2) ────────────
	     Balansen läser yttertygelstödet ur hjälpsemantiken, svängens
	     fartkrav ur samma centripetaluttryck som webben (v²/r) och
	     övergången ur att ett förlopp pågår. SPÄNNINGSTERMEN FINNS sedan
	     #87:s första review och skickas som hästens faktiska spänning.

	     Energin räknas per gångart och sekund ur samma tabell som webben,
	     översatt via RidKanon.MOTSVARIGHET så att tabellen slipper finnas
	     i två nyckelrymder.

	     ENERGIN ÄR SERVERNS (senior re-review #87). Det här är klientens
	     prediktion mellan synkarna, med samma kanon; `setEnergi()` rättar
	     den när StaminaSync kommer. `loco.stamina` är presentationen i
	     0–MaxStamina, inte ett eget tillstånd. ]]
	do
		local S = RidKanon.SVAR
		local radie = if math.abs(self.curvature) > 0.002
			then 1 / math.abs(self.curvature) else math.huge
		local fartkrav = 0
		if speedAbs > 0.5 and radie < 40 then
			fartkrav = math.clamp(((speedAbs * speedAbs) / math.max(radie, 1) - 3.0) / 9.0, 0, 1)
		end
		--[[ FOKUS: handens stadga, lugnet, utomhus och den lästa
		     halvhalten. Paradlyftet ligger i `loco.paradKvalitet` den
		     bildruta paraden lästes. ]]
		local paradLyft = if loco.paradTid == loco.tid then (loco.paradKvalitet or 0) else 0
		local fMal = Svar.fokusMal(loco.mjukhet or 1, loco.spanning or 0,
			self.utomhus == true, paradLyft, self.stats)
		loco.fokus = (loco.fokus or 0.70)
			+ (fMal - (loco.fokus or 0.70)) * math.clamp(dt / S.FOKUS_TAU, 0, 1)
		if paradLyft > 0 then
			loco.fokus = math.clamp(math.max(loco.fokus,
				loco.fokus + S.FOKUS_PARAD * Svar.profil(self.stats).fokus
					* paradLyft * 0.55), 0, 1)
		end
		local bMal = Svar.balansMal(self.stats, stats.Agility or 0.5, bojkrav,
			hj.ytterstod, fartkrav, self._ov ~= nil, loco.spanning or 0, hj.sits)
		local bTau = if bMal < (loco.balans or 1) then S.BALANS_TAU_NER else S.BALANS_TAU_UPP
		loco.balans = smooth(loco.balans or 1, bMal, bTau, dt)

		local webbGangart = self.gangartWebb or "halt"
		for w, r in RidKanon.MOTSVARIGHET do
			if r == loco.gait then webbGangart = w end
		end
		self.gangartWebb = webbGangart
		--[[ PREDIKTION mellan serverns synkar, med samma kanon som
		     servern räknar med. Rättas av setEnergi(). ]]
		loco.energi = math.clamp((loco.energi or 1)
			+ Svar.energiTakt(webbGangart, loco.spanning or 0, self.stats) * dt, 0, 1)
		--[[ `stamina` är energins PRESENTATION i 0–MaxStamina, inte ett
		     eget tillstånd. Servern skriver samma tal på modellen. ]]
		loco.stamina = loco.energi * (stats.MaxStamina or 100)
	end

	--[[ ── Lutning ─────────────────────────────────────────────────────
	     Proportionell mot svängkraften, alltså turnRate × fart. Klampad så
	     att den aldrig ser ut som en motorcykel. ]]
	local leanTarget = math.clamp(loco.turnRate * speedAbs * M.LeanGain, -M.LeanMax, M.LeanMax)
	loco.lean = smooth(loco.lean, leanTarget, M.LeanTau, dt)

	--[[ ── Mark ────────────────────────────────────────────────────────
	     En strålkastning per bildruta och häst, inte fyra. Normalen jämnas
	     ut hårt: utan det skakar kroppen på varje liten terrängkant. ]]
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { rig.model }
	local hit = workspace:Raycast(rig.root.Position, Vector3.new(0, -M.ProbeDepth, 0), params)

	loco.grounded = hit ~= nil
	local normal = if hit then hit.Normal else Vector3.yAxis
	loco.slope = loco.slope:Lerp(normal, 1 - math.exp(-dt / M.SlopeTau))

	local forwardVector = Vector3.new(math.sin(loco.heading), 0, math.cos(loco.heading))
	local grade = -loco.slope:Dot(forwardVector)
	self.slopePitch = smooth(self.slopePitch, grade * M.SlopeAlign, M.SlopeTau, dt)

	--[[ ── Hopp ───────────────────────────────────────────────────────
	     Kräver fart och mark, och har nedkylning. Ingen luftdubbelhopp. ]]
	local hum = rig.humanoid
	local jumpFired = false
	self.jumpReady = math.max(0, self.jumpReady - dt)
	if intent.jump and hum and loco.grounded and self.jumpReady <= 0
		and speedAbs >= M.JumpMinSpeed then
		hum.Jump = true
		self.jumpReady = M.JumpCooldown
		jumpFired = true
	end

	loco.airborne = if hum then
		hum:GetState() == Enum.HumanoidStateType.Freefall
			or hum:GetState() == Enum.HumanoidStateType.Jumping
		else false

	--[[ ── Tillstånd och fas ──────────────────────────────────────────── ]]
	--[[ Den FAKTISKA gångarten räknas här och skickas IN i maskinen, i
	     stället för att skrivas över efteråt. Skillnaden är inte kosmetisk:
	     maskinens tillstånd (och därmed animationen, som väljs ur
	     loco.state) byggde annars på sin egen fartbaserade gångart medan
	     loco.gait redan följde förloppet. Två sanningar i samma bildruta.

	     Etiketten byter en bit in i förloppet — hästen är på väg in i
	     travet en stund innan travet syns. Samma regel som webben. ]]
	local faktiskGangart = nil
	if self._ov then
		local u = math.clamp(self._ov.t / self._ov.langd, 0, 1)
		faktiskGangart = if u >= M.Transition.switchAt
			then loco.targetGait
			else self._ov.fran_gait
	end
	loco.state = self.machine:step({
		speed = loco.speed,
		turnRate = loco.turnRate,
		airborne = loco.airborne,
		braking = intent.forward < -0.5,
		jumpFired = jumpFired,
		gait = faktiskGangart,
	}, dt)
	loco.gait = self.machine.gait

	--[[ ── Fasen följer MARKEN ────────────────────────────────────────
	     Förut drevs fasen av beatRate × dt, alltså av den fart vi BEGÄRT.
	     Nu mäts hur långt hästen faktiskt kom sedan förra bildrutan, och
	     fasen är den sträckan delad med gångartens cykellängd. Krockar
	     hästen med något eller bromsas av terrängen slutar hovarna att
	     trampa i luften, och stillastående häst går inte på stället.

	     Rootens läge är i studs; cykellängden i meter. ]]
	local pos = rig.root.Position
	local moved = if self.lastPos then (pos - self.lastPos).Magnitude else 0
	self.lastPos = pos
	local cycle = Gaits.cycleLength(loco.gait)
	if cycle > 0 then
		loco.phase = (loco.phase + (moved / Config.STUDS_PER_METRE) / cycle) % 1
	end

	--[[ ── Ut i världen ───────────────────────────────────────────────
	     VRIDNINGEN HAR EN ÄGARE, OCH DET ÄR DEN HÄR RADEN.

	     `HorseService` sätter `AutoRotate = false` med motiveringen att
	     spelet äger vridningen. Den här modulen räknade fram `loco.heading`
	     och lämnade sedan över till en AutoRotate som inte fanns — så bara
	     vändning på stället vred faktiskt riggen. Under ritt kunde
	     rörelsevektorn böja av medan hästen fortsatte peka rakt fram: en
	     häst som åker i sidled genom svängen.

	     Nu skrivs kursen på roten varje bildruta, i alla lägen. Positionen
	     lämnas orörd — `Humanoid:Move` sköter förflyttningen, fysiken sköter
	     höjden — och roten hålls upprätt: kroppens lutning och sluttningens
	     pitch ligger i `rootJoint.C0`, inte här. Skriver man dem på samma
	     ställe går den ena inte att trimma utan att den andra ändras.

	     `loco.heading` är redan utjämnad genom kurvaturens tidskonstanter,
	     så det finns ingen snärt att dämpa här. Att i stället slå på
	     AutoRotate igen vore att lämna vridtakten till Roblox, och det är
	     precis den fordonskänsla gaten ska bort ifrån. ]]
	local root = rig.root
	root.CFrame = CFrame.new(root.CFrame.Position) * CFrame.Angles(0, loco.heading, 0)

	if hum then
		--[[ Vändning på stället: farten noll, men kursen ändras ändå av
		     raden ovan. Golvet på 0,35 studs/s som fanns förut gav en
		     synlig sidledsglidning i alla stillastående lägen. ]]
		local studs = Config.toStuds(math.abs(loco.speed))
		local turningInPlace = math.abs(loco.turnRate) > 0.05 and studs < 0.35
		hum.WalkSpeed = if turningInPlace then 0 else studs
		local dir = if loco.speed < -0.05 then -forwardVector else forwardVector
		hum:Move(dir, false)
	end

	RigAdapter.setBodyTilt(rig, loco.lean, self.slopePitch)
end

function MovementController:setCeiling(gait: string)
	self.ceiling = gait
end

--[[ Serverns energi. Klienten predikterar mellan synkarna med samma
     kanon; det här är rättelsen som gör att de två inte kan glida isär.
     Att det är en SETTER och inte ett eget tillstånd är hela poängen med
     blocker 3: en sanning, med prediktion. ]]
function MovementController:setEnergi(energi: number)
	self.loco.energi = math.clamp(energi, 0, 1)
end

function MovementController:release()
	self.steerInput = 0
	self.curvature = 0
	self._ov = nil
	self.lastPos = nil
	local hum = self.rig.humanoid
	if hum then
		hum.WalkSpeed = 0
		hum:Move(Vector3.zero, false)
	end
	RigAdapter.setBodyTilt(self.rig, 0, 0)
end

return MovementController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX51">
					<Properties>
						<string name="Name">PreparationController</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[ SKÖTSELNS HUD — förberedelsen, fyndet och eftervården.

	Visar serverns sanning och inget annat. Den här filen räknar aldrig ut
	om ett steg är klart — den ritar `PreparationSync` och `PassSync`.
	Skälet är krav 10: en sen init eller en refresh får inte skriva över
	nyare serverfeedback, och det enda sättet att garantera det är att
	klienten inte har någon egen uppfattning som kan vara nyare.

	Layouten är byggd för 320 px bredd först. Det är inte en artig gest mot
	mobilen — Tobias familj spelar på iPad, och en HUD som kräver 900 px är
	inte spelbar för dem.

	── TVÅ LISTOR, INTE TVÅ HUD:AR (#161) ───────────────────────────

	Panelen visar numera fyra olika saker, men aldrig mer än en i taget:

	  faser + moment   den vanliga skötseln,
	  fyndets svar     visitationen hittade något,
	  välfärdsstoppet  arbetet är avbrutet, ridläraren tar över,
	  eftervården      passets andra halva, efter avsittning.

	Alla fyra ritas med SAMMA radkod. Ett moment och en fas har samma form
	i vyn (`id`, `namn`, `klar`), och eftervårdens moment har det också —
	det är därför `Pass.vy` medvetet härmar `Preparation.vy`. En egen
	eftervårds-HUD hade varit en femte plats där samma bock ritas på ett
	femte sätt.

	── TRÄFFYTAN ────────────────────────────────────────────────────

	Fasraderna är 26 px höga och INTE tryckbara längre: en fas kvitteras
	inte med ett tryck sedan #161, den blir klar av sina moment. De är
	alltså en LÄGESVISNING, och behöver därför inte 44 px.

	Momentknapparna är det man faktiskt trycker på, och de är 44 px —
	`docs/KONTROLLMATRIS.md` regel 5, samma golv som ridanalysen och
	pekreglagen redan följer.
]]

local Players = game:GetService("Players")

local Core = require(game:GetService("ReplicatedStorage").HorseCore)
local Preparation = require(game:GetService("ReplicatedStorage").HorseCore.Preparation)
local Net = Core.Networking

local PreparationController = {}

local player = Players.LocalPlayer

local gui: ScreenGui? = nil
local radBehallare: Frame? = nil
local momentBehallare: Frame? = nil
local rubrik: TextLabel? = nil
local hjalp: TextLabel? = nil
local rader: { [string]: { ram: Frame, bock: TextLabel, namn: TextLabel } } = {}
local momentRader: { [string]: TextButton } = {}
--[[ En aktiv `Activated`-anslutning per momentknapp. Se `momentRad`. ]]
local momentKoppling: { [string]: RBXScriptConnection } = {}
local senasteVy: any = nil
local senastePass: any = nil
--[[ Revisionen på det som faktiskt ritats. `nil` = ingenting ritat än.
	Förberedelsen och passet har VAR SIN, trots att servern räknar dem ur
	samma serie: de kommer som två olika event och en passvy får inte
	kastas för att en förberedelsevy råkade ha ett högre nummer. ]]
local senasteRev: number? = nil
local senastePassRev: number? = nil
local rita

--[[ Det klienten senast bad om, och därmed väntar svar på. Används bara för
	att gråa ut knappen medan svaret är på väg — inte för att gissa utfallet. ]]
local vantarPa: string? = nil

local FARG_KLAR = Color3.fromRGB(127, 180, 137)
local FARG_TUR = Color3.fromRGB(214, 174, 60)
local FARG_VILAR = Color3.fromRGB(120, 124, 128)
local FARG_FEL = Color3.fromRGB(208, 101, 90)
local FARG_TEXT = Color3.fromRGB(238, 240, 242)

--[[ Golvet för en träffyta. Står som en namngiven konstant för att provet
	ska kunna läsa samma tal som knappen ritas med. ]]
PreparationController.TRAFFYTA = 44

local function bygg()
	if gui then return end
	local g = Instance.new("ScreenGui")
	g.Name = "UBRFForberedelse"
	g.ResetOnSpawn = false
	g.IgnoreGuiInset = true
	g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	g.Parent = player:WaitForChild("PlayerGui")

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	--[[ Skalan är i procent av skärmen med ett tak i pixlar: på en telefon
		får panelen ta 92 % av bredden, på en 4K-skärm ska den inte bli en
		halvmeter bred.

		Höjden växte från 190 till 300 px när momenten kom till: fasraden
		och momentraden ligger under varandra, och en panel som klipper av
		momentlistan hade gjort de sista momenten omöjliga att trycka på. ]]
	panel.Size = UDim2.new(0.92, 0, 0, 300)
	panel.SizeConstraint = Enum.SizeConstraint.RelativeXX
	panel.Position = UDim2.new(0.5, 0, 1, -12)
	panel.AnchorPoint = Vector2.new(0.5, 1)
	panel.BackgroundColor3 = Color3.fromRGB(24, 26, 28)
	panel.BackgroundTransparency = 0.15
	panel.BorderSizePixel = 0
	panel.Parent = g

	local max = Instance.new("UISizeConstraint")
	max.MaxSize = Vector2.new(420, 380)
	max.MinSize = Vector2.new(240, 220)
	max.Parent = panel

	local horn = Instance.new("UICorner")
	horn.CornerRadius = UDim.new(0, 10)
	horn.Parent = panel

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 10)
	pad.PaddingLeft = UDim.new(0, 12)
	pad.PaddingRight = UDim.new(0, 12)
	pad.Parent = panel

	local r = Instance.new("TextLabel")
	r.Name = "Rubrik"
	r.Size = UDim2.new(1, 0, 0, 20)
	r.BackgroundTransparency = 1
	r.Font = Enum.Font.GothamBold
	r.TextSize = 15
	r.TextXAlignment = Enum.TextXAlignment.Left
	r.TextColor3 = FARG_TEXT
	r.Text = "Gör i ordning din häst"
	r.Parent = panel
	rubrik = r

	local lista = Instance.new("Frame")
	lista.Name = "Steg"
	lista.Position = UDim2.new(0, 0, 0, 24)
	lista.Size = UDim2.new(1, 0, 0, 100)
	lista.BackgroundTransparency = 1
	lista.Parent = panel

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.Padding = UDim.new(0, 2)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = lista
	radBehallare = lista

	--[[ Momenten scrollar. Ryktningen har sex och iordningställandet åtta;
		på en telefon i liggande läge ryms de inte alla, och en lista som
		klipps av utan att gå att rulla är en lista där de sista stegen inte
		finns. ScrollBarThickness 4 för att stapeln inte ska äta träffytan. ]]
	local mlista = Instance.new("ScrollingFrame")
	mlista.Name = "Moment"
	mlista.Position = UDim2.new(0, 0, 0, 128)
	mlista.Size = UDim2.new(1, 0, 1, -152)
	mlista.BackgroundTransparency = 1
	mlista.BorderSizePixel = 0
	mlista.ScrollBarThickness = 4
	mlista.AutomaticCanvasSize = Enum.AutomaticSize.Y
	mlista.CanvasSize = UDim2.new(0, 0, 0, 0)
	mlista.Parent = panel

	local mlayout = Instance.new("UIListLayout")
	mlayout.FillDirection = Enum.FillDirection.Vertical
	mlayout.Padding = UDim.new(0, 4)
	mlayout.SortOrder = Enum.SortOrder.LayoutOrder
	mlayout.Parent = mlista
	momentBehallare = mlista :: any

	local h = Instance.new("TextLabel")
	h.Name = "Hjalp"
	h.Position = UDim2.new(0, 0, 1, -24)
	h.Size = UDim2.new(1, 0, 0, 24)
	h.BackgroundTransparency = 1
	h.Font = Enum.Font.Gotham
	h.TextSize = 12
	h.TextWrapped = true
	h.TextXAlignment = Enum.TextXAlignment.Left
	h.TextColor3 = Color3.fromRGB(186, 190, 194)
	h.Text = ""
	h.Parent = panel
	hjalp = h

	gui = g
end

--[[ En fasrad. LÄGESVISNING, inte en knapp — se filhuvudet. ]]
local function rad(steg: any, ordning: number)
	local befintlig = rader[steg.id]
	if not befintlig then
		local ram = Instance.new("Frame")
		ram.Name = steg.id
		ram.Size = UDim2.new(1, 0, 0, 20)
		ram.BackgroundTransparency = 1
		ram.BorderSizePixel = 0
		ram.Parent = radBehallare

		local bock = Instance.new("TextLabel")
		bock.Name = "Bock"
		bock.Size = UDim2.new(0, 22, 1, 0)
		bock.BackgroundTransparency = 1
		bock.Font = Enum.Font.GothamBold
		bock.TextSize = 13
		bock.Parent = ram

		local namn = Instance.new("TextLabel")
		namn.Name = "Namn"
		namn.Position = UDim2.new(0, 24, 0, 0)
		namn.Size = UDim2.new(1, -28, 1, 0)
		namn.BackgroundTransparency = 1
		namn.Font = Enum.Font.Gotham
		namn.TextSize = 12
		namn.TextXAlignment = Enum.TextXAlignment.Left
		namn.Parent = ram

		befintlig = { ram = ram, bock = bock, namn = namn }
		rader[steg.id] = befintlig
	end

	befintlig.ram.LayoutOrder = ordning
	befintlig.ram.Visible = true
	befintlig.namn.Text = steg.namn
	if steg.klar then
		befintlig.bock.Text = "✓"
		befintlig.bock.TextColor3 = FARG_KLAR
		befintlig.namn.TextColor3 = FARG_KLAR
	elseif senasteVy and senasteVy.nasta == steg.id then
		befintlig.bock.Text = "•"
		befintlig.bock.TextColor3 = FARG_TUR
		befintlig.namn.TextColor3 = FARG_TEXT
	else
		befintlig.bock.Text = "·"
		befintlig.bock.TextColor3 = FARG_VILAR
		befintlig.namn.TextColor3 = FARG_VILAR
	end
end

--[[ En momentknapp. `skicka` är vad ett tryck gör — den skiljer sig mellan
	skötselmoment, fyndsvar och eftervård, men RADEN är densamma. ]]
local function momentRad(m: any, ordning: number, paTur: boolean, skicka: () -> ())
	local knapp = momentRader[m.id]
	if not knapp then
		knapp = Instance.new("TextButton")
		knapp.Name = m.id
		knapp.Size = UDim2.new(1, -6, 0, PreparationController.TRAFFYTA)
		knapp.BackgroundColor3 = Color3.fromRGB(38, 41, 44)
		knapp.BorderSizePixel = 0
		knapp.AutoButtonColor = true
		knapp.Font = Enum.Font.Gotham
		knapp.TextSize = 13
		knapp.TextXAlignment = Enum.TextXAlignment.Left
		knapp.TextWrapped = true
		knapp.Text = ""
		knapp.Parent = momentBehallare

		local horn = Instance.new("UICorner")
		horn.CornerRadius = UDim.new(0, 6)
		horn.Parent = knapp

		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 10)
		pad.PaddingRight = UDim.new(0, 10)
		pad.Parent = knapp

		momentRader[m.id] = knapp
	end
	--[[ Lyssnaren kopplas om varje gång: samma knapp-id kan betyda ett
		skötselmoment i en vy och ett eftervårdsmoment i nästa, och en
		gammal lyssnare som ligger kvar skickar fel avsikt till servern.

		Anslutningarna hålls i en egen tabell och inte som ett barn till
		knappen. Ett barn hade krävt `Destroying` för att städas, och det
		är en signal HUD:en inte behöver bry sig om — den vet redan exakt
		när den kopplar om. ]]
	local gammal = momentKoppling[m.id]
	if gammal then gammal:Disconnect() end
	momentKoppling[m.id] = knapp.Activated:Connect(skicka)

	knapp.LayoutOrder = ordning
	knapp.Visible = true
	knapp.Text = (if m.klar then "✓  " else "")  .. m.namn

	if m.klar then
		knapp.TextColor3 = FARG_KLAR
		knapp.BackgroundColor3 = Color3.fromRGB(30, 38, 32)
		knapp.AutoButtonColor = false
	elseif m.fel then
		--[[ Ett felaktigt alternativ ritas som ett alternativ, inte som en
			varning. Att gråa ut det hade tagit bort valet, och därmed hela
			lärandet — se `Preparation`s not om `fel`. ]]
		knapp.TextColor3 = FARG_TEXT
		knapp.BackgroundColor3 = Color3.fromRGB(38, 41, 44)
		knapp.AutoButtonColor = true
	elseif paTur then
		knapp.TextColor3 = Color3.fromRGB(23, 20, 10)
		knapp.BackgroundColor3 = FARG_TUR
		knapp.AutoButtonColor = true
	else
		knapp.TextColor3 = FARG_VILAR
		knapp.BackgroundColor3 = Color3.fromRGB(32, 34, 37)
		knapp.AutoButtonColor = true
	end
end

local function doljOanvanda(anvanda: { [string]: boolean })
	for id, knapp in pairs(momentRader) do
		knapp.Visible = anvanda[id] == true
	end
end

--[[ Observatörer som körs EFTER att en ny vy tagits emot och skrivits ned.
	Uppsittningsprompten hänger här. ]]
local lyssnare: { (any) -> () } = {}

function PreparationController.vidNyVy(fn: (any) -> ())
	table.insert(lyssnare, fn)
end

--[[ Enda vägen in till HUD:en. Allt som kommer utifrån — spontan sync eller
	svar på handskakningen — går genom den här, och den släpper bara igenom
	en NYARE vy (krav 10).

	Den anropar också observatörerna, och det är en RÄTTELSE: förut låg
	prompt-uppdateringen i en EGEN `PreparationSync`-listener i init.client.
	Handskakningens svar går inte genom den listenern, så en klient som
	initierades sent när servern redan stod på `ready_to_mount` fick rätt
	HUD men ALDRIG någon "Sitt upp"-prompt — det kom ingen ny sync att
	väcka den. Fälldes av senior review, runda 2.

	Att lägga det här i stället för i en andra listener tar dessutom bort
	beroendet av i vilken ordning två listeners på samma RemoteEvent råkar
	köra: observatören kan inte köra före den vy den beskriver. ]]
local function ritaOmNyare(vy: any)
	if not Preparation.farRita(senasteRev, vy) then return end
	senasteRev = vy.rev
	rita(vy)
	for _, fn in ipairs(lyssnare) do
		fn(vy)
	end
end

--[[ Exporterad för provet: samma väg in som nätet använder. Provet ska driva
	den riktiga funktionen, inte en kopia av regeln. ]]
function PreparationController.tillampa(vy: any)
	ritaOmNyare(vy)
end

function PreparationController.tillampaPass(vy: any)
	--[[ Samma revisionsregel som förberedelsen, men på sin egen räknare. ]]
	if not Preparation.farRita(senastePassRev, vy) then return end
	senastePassRev = vy.rev
	senastePass = vy
	if senasteVy then rita(senasteVy) end
end

--[[ Står eftervården på tur? Passvyn äger frågan; förberedelsen vet inget
	om den. ]]
local function iEftervard(): boolean
	return senastePass ~= nil and senastePass.lage == "aftercare"
end

--[[ Är passet RÄKNAT och sparat? (#162 omreview, fynd 3.)

	`Pass.markeraRaknat` sätter `lage = "recorded"`. Den här vyn kände bara
	igen `aftercare`, så `recorded` föll igenom till skötselvyn — och där är
	förberedelsen fortfarande komplett, så rubriken blev **"Klar — du kan
	sitta upp"**. Samtidigt nekar `GameplayService.farSittaUpp` samma
	spelare med **"Du har redan ridit idag"**, eftersom `lage ~= before_ride`.

	Servergrinden är rätt: den är fail-closed. Det var PRESENTATIONEN som
	ljög, och en First Playable får aldrig be spelaren om något servern
	uttryckligen nekar. ]]
local function passRaknat(): boolean
	return senastePass ~= nil and senastePass.lage == "recorded"
end

function rita(vy: any)
	bygg()
	senasteVy = vy

	local anvanda: { [string]: boolean } = {}

	--[[ ── 1. VÄLFÄRDSSTOPPET ─────────────────────────────────────
		Ligger först för att det stänger allt annat. Ingen fas, inget
		moment, ingen uppsittning — bara texten om varför. ]]
	if vy.stoppad then
		for _, r in pairs(rader) do r.ram.Visible = false end
		doljOanvanda(anvanda)
		if rubrik then rubrik.Text = "Ridläraren tar över" end
		if hjalp then hjalp.Text = tostring(vy.stoppad) end
		if gui then gui.Enabled = true end
		return
	end

	--[[ ── 2. FYNDET ──────────────────────────────────────────────
		Ett obesvarat fynd tar över panelen. Faserna ritas kvar som lägesbild
		— spelaren ska se var i dagen hon är — men det enda som går att
		trycka på är svaren. ]]
	for i, steg in ipairs(vy.steg or {}) do
		rad(steg, i)
	end

	if vy.svar and #vy.svar > 0 then
		for i, s in ipairs(vy.svar) do
			anvanda[s.id] = true
			momentRad({ id = s.id, namn = s.namn, klar = false, fel = s.fel }, i, not s.fel,
				function() PreparationController.svara(s.id) end)
		end
		doljOanvanda(anvanda)
		if rubrik then rubrik.Text = "Du hittade något" end
		if hjalp then hjalp.Text = tostring(vy.fynd or "") end
		if gui then gui.Enabled = true end
		return
	end

	--[[ ── 3. EFTERVÅRDEN ─────────────────────────────────────────
		Passet är i `aftercare`. Faserna är avklarade och ointressanta nu;
		det som återstår är hästen. ]]
	if iEftervard() then
		for _, r in pairs(rader) do r.ram.Visible = false end
		local nasta = senastePass.nastaMoment
		local text = ""
		for i, m in ipairs(senastePass.moment or {}) do
			anvanda[m.id] = true
			momentRad(m, i, m.id == nasta, function()
				PreparationController.eftervard(m.id)
			end)
			if m.id == nasta then text = m.text or "" end
		end
		doljOanvanda(anvanda)
		if rubrik then rubrik.Text = "Ta hand om henne" end
		if hjalp then hjalp.Text = text end
		if gui then gui.Enabled = true end
		return
	end

	--[[ ── 3b. PASSET ÄR RÄKNAT ───────────────────────────────────
		Dagens pass är avslutat och sparat. Det finns ingenting kvar att
		göra på den här hästen idag, och framför allt: sitt INTE upp — det
		nekar servern. Raderna släcks; ett moment att trycka på här vore
		samma lögn som rubriken var. ]]
	if passRaknat() then
		for _, r in pairs(rader) do r.ram.Visible = false end
		doljOanvanda(anvanda)
		if rubrik then rubrik.Text = "Passet är klart och sparat" end
		if hjalp then
			hjalp.Text = "Bra jobbat. Du har ridit ditt pass idag."
		end
		if gui then gui.Enabled = true end
		return
	end

	--[[ ── 4. SKÖTSELN ────────────────────────────────────────────── ]]
	local nasta = vy.nastaMoment
	local momenttext = ""
	for i, m in ipairs(vy.moment or {}) do
		anvanda[m.id] = true
		momentRad(m, i, m.id == nasta, function()
			PreparationController.begar(vy.nasta, m.id)
		end)
		if m.id == nasta then momenttext = m.text or "" end
	end
	doljOanvanda(anvanda)

	if vy.status == "waiting_model" then
		if rubrik then rubrik.Text = "Väntar på din häst" end
		if hjalp then hjalp.Text = "Hon är tilldelad men står inte i världen än." end
	elseif vy.status == "riding" then
		if rubrik then rubrik.Text = "Du rider" end
		if hjalp then hjalp.Text = "" end
	elseif vy.redo then
		if rubrik then rubrik.Text = "Klar — du kan sitta upp" end
		if hjalp then hjalp.Text = "Kontrollera gjorden en sista gång." end
	else
		local fasnamn = nil
		for _, steg in ipairs(vy.steg or {}) do
			if steg.id == vy.nasta then fasnamn = steg.namn end
		end
		if rubrik then rubrik.Text = fasnamn or "Gör i ordning din häst" end
		if hjalp then hjalp.Text = momenttext end
	end

	--[[ HUD:en göms medan man rider — men INTE när eftervården väntar, och
		det är hela skillnaden mot före #161: en spelare som satt av mötte
		förut en tom skärm, och passet tog aldrig slut. ]]
	if gui then gui.Enabled = vy.status ~= "riding" end
end

--[[ ── AVSIKTERNA UT ────────────────────────────────────────────────

	Alla tre går samma väg: ett fjärranrop med en AVSIKT, ett svar som bara
	får ändra hjälptexten. Ett avslag ritar INTE om listan. Servern skickar
	alltid en färsk sync efter varje försök, och den är sanningen; skulle
	det här svaret rita något eget skulle det kunna komma efter och skriva
	över den. ]]
local function skicka(nyckel: string, remote: string, ...)
	if vantarPa then return end
	vantarPa = nyckel
	local args = table.pack(...)
	task.spawn(function()
		local ok, skal = Net.get(remote):InvokeServer(table.unpack(args, 1, args.n))
		vantarPa = nil
		if not ok and hjalp then
			hjalp.Text = tostring(skal or "Det gick inte just nu")
		end
	end)
end

function PreparationController.begar(fasId: string?, momentId: string?)
	if not fasId or not momentId then return end
	skicka(momentId, "PreparationMoment", fasId, momentId)
end

function PreparationController.svara(svarId: string)
	skicka(svarId, "PreparationSvar", svarId)
end

function PreparationController.eftervard(momentId: string)
	skicka(momentId, "PassMoment", momentId)
end

function PreparationController.redo(): boolean
	return senasteVy ~= nil and senasteVy.redo == true
end

function PreparationController.hastId(): string?
	return senasteVy and senasteVy.hastId or nil
end

--[[ Provkrokar: vad HUD:en faktiskt ritade. Provet läser dem i stället för
	att bygga en egen uppfattning om vad som borde ha ritats. ]]
function PreparationController._synligaMoment(): { string }
	local ut = {}
	for id, knapp in pairs(momentRader) do
		if knapp.Visible then table.insert(ut, id) end
	end
	table.sort(ut)
	return ut
end

function PreparationController._rubrik(): string
	return rubrik and rubrik.Text or ""
end

function PreparationController.start()
	--[[ ORDNINGEN ÄR KONTRAKTET: listenerna ansluts FÖRST, handskakningen
		anropas sedan. Servern skickar sin första vy från `bind()` vid
		PlayerAdded, och en RemoteEvent som avfyras innan någon lyssnar är
		borta för alltid — den köas inte. Utan handskakningen startade
		klienten därför utan hästId, steg och ready-state, utan någon
		deterministisk ny sync att vänta på.

		`PassSync` ansluts i samma andetag och av exakt samma skäl: servern
		skickar passvyn direkt i handskakningen, och en klient som inte
		lyssnade än hade missat att eftervården väntade. ]]
	Net.get("PreparationSync").OnClientEvent:Connect(ritaOmNyare)
	Net.get("PassSync").OnClientEvent:Connect(PreparationController.tillampaPass)

	task.spawn(function()
		local ok, vy = pcall(function()
			return Net.get("PreparationHello"):InvokeServer()
		end)
		if ok and vy then
			ritaOmNyare(vy)
		end
	end)
end

return PreparationController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX52">
					<Properties>
						<string name="Name">ReplayController</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	RIDANALYSEN PÅ ROBLOX — spelaren får se sin egen ritt.

	G02-D (#137): efter ett avslutat försök ska ritten gå att SE, inte
	bara läsas om i två meningar. Panelen ritar den inspelade vägen i
	planvy, låter spelaren spela, pausa, hoppa och sakta ned — och lägger
	FÖRRA försöket bakom som ett spöke, så att "bättre linje den här
	gången" är något hon kan se och inte bara ett påstående.

	LÄSER, ÄNDRAR ALDRIG. Panelen rör inte posten, inte hästen, inte
	progressionen och inget serverauktoritativt tillstånd. Den svarar bara
	på frågan "hur såg ritten ut vid tiden t?" genom Inspelning.vid, som
	är ren avläsning. Det finns ingen andra bedömningsmodell här: panelen
	betygsätter ingenting.

	INGEN PÅHITTAD IDEALLINJE. Spöket är spelarens EGET förra försök. En
	streckad "så borde du ha ridit"-kurva hade varit en uppfunnen referens
	och är uttryckligen inte beställd — finns inget förra försök ritas
	inget spöke, och panelen säger det i stället för att fylla hålet.

	SÄKERHET VINNER, precis som i UgnetaController. `stang` kan anropas
	från avsittningen, från karaktärens försvinnande eller från
	LektionController.avbryt, och den släpper då både RenderStepped-
	kopplingen och alla referenser till posterna. En panel får aldrig bli
	kvar över en ritt som inte finns längre.

	INMATNINGEN ÄGS AV init.client.luau. Musen och fingret går in genom
	knapparnas egna Activated; tangent och gamepad kommer in genom de
	publika funktionerna nedan. HUD:en lyssnar inte själv på
	UserInputService — samma regel som resten av klienten.

	MINDRE RÖRELSE OM SPELAREN BETT OM DET. Är GuiService.
	ReducedMotionEnabled satt startar panelen PAUSAD i stället för att
	genast sätta igång en markör som rör sig av sig själv. Spelaren
	scrubbar då i sin egen takt. Inget innehåll går förlorat — bara den
	automatiska rörelsen.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Inspelning = require(game:GetService("ReplicatedStorage").HorseCore.Inspelning)

local ReplayController = {}

local player = Players.LocalPlayer

local gui: ScreenGui? = nil
local bana: Frame? = nil
local markor: Frame? = nil
local tidLabel: TextLabel? = nil
local statusLabel: TextLabel? = nil
local spelaKnapp: TextButton? = nil
local stangKnapp: TextButton? = nil
local rad: Frame? = nil
local knappar: { TextButton } = {}

local aktiv = false
local post: Inspelning.Post? = nil
local ghost: Inspelning.Post? = nil
local tid = 0
local fart = 1
local spelar = false
local conn: RBXScriptConnection? = nil
local stangFn: (() -> ())? = nil

--[[ Banans utsträckning i postens egna koordinater. Räknas om vid varje
     öppning: två försök på samma övning kan täcka olika stor yta, och en
     fast ram hade klippt det ena. ]]
local minx, maxx, minz, maxz = 0, 1, 0, 1

local FARG_MORK = Color3.fromRGB(12, 14, 18)
local FARG_GULD = Color3.fromRGB(232, 181, 74)
local FARG_TEXT = Color3.fromRGB(246, 242, 232)
local FARG_NU = Color3.fromRGB(127, 180, 137)
local FARG_FORE = Color3.fromRGB(214, 174, 60)

--[[ Högst så många punkter ritas per ritt. En 120-sekunders post har 2400
     sampel; att rita dem alla vore 2400 Frames för en linje ögat ändå
     läser som en kurva. Steget räknas ur postens längd, så en kort och en
     lång ritt kostar lika mycket att rita. ]]
local PUNKTER_NU = 120
local PUNKTER_FORE = 100

--[[ ── KONTROLLRADEN MÅSTE FÅ PLATS ─────────────────────────────────
     Första utkastet la fem knappar à 104 px, fyra mellanrum och en
     tidsruta à 120 px på EN vågrät rad utan brytning: 670 px. Panelen är
     90 % av viewporten minus 24 px, alltså 327 px på en 390 px telefon och
     667 px på en iPad i porträtt. Knapparna gick helt enkelt inte att nå
     — och provet såg det inte, för det mätte knapparnas HÖJD (44 px) men
     aldrig om de rymdes.

     Raden bryts nu i flera rader när bredden kräver det, och knapparna
     delar på bredden i stället för att sticka ut. Två gränser hålls:
     ingen träffyta under 44 px hög, och ingen knapp smalare än
     KNAPP_MIN — hellre en rad till än en knapp som fingret missar.

     Tidsrutan flyttades ut ur raden. Den är en avläsning, inte en
     handling, och den ska inte konkurrera om plats med det spelaren
     trycker på. ]]
local KNAPP_MIN = 64
local KNAPP_MAX = 104
local KNAPP_HOJD = 44
local GAP = 6
local PANEL_ANDEL = 0.9      -- panelens bredd som andel av viewporten
local PANEL_MARGINAL = 24    -- kontrollradens indrag i panelen

--[[ Ren funktion, med flit: den går att prova mot en bredd utan att bygga
     en enda Instance, och den är samma räkning som `tillampaLayout` sedan
     använder. Två räkningar hade kunnat glida isär. ]]
local function radLayout(bredd: number, antal: number): { perRad: number,
	knappBredd: number, rader: number, hojd: number }
	if antal <= 0 then
		return { perRad = 0, knappBredd = 0, rader = 0, hojd = 0 }
	end
	local b = math.max(0, bredd)
	--[[ Hur många ryms med den SMALASTE godtagbara knappen? Minst en, och
	     aldrig fler än det finns knappar. ]]
	local perRad = math.floor((b + GAP) / (KNAPP_MIN + GAP))
	perRad = math.clamp(perRad, 1, antal)
	local rader = math.ceil(antal / perRad)
	--[[ Fyll ut raden jämnt, men bli inte bredare än designbredden. ]]
	local knappBredd = math.floor((b - (perRad - 1) * GAP) / perRad)
	knappBredd = math.max(1, math.min(KNAPP_MAX, knappBredd))
	return {
		perRad = perRad, knappBredd = knappBredd, rader = rader,
		hojd = rader * KNAPP_HOJD + (rader - 1) * GAP,
	}
end

--[[ Viewportens bredd. Saknas kameran — vilket den gör i vissa
     uppstartslägen — antas en skrivbordsbredd hellre än noll: en nolla
     hade gett en rad per knapp och en panel som fyller hela skärmen. ]]
local function viewportBredd(): number
	local cam = Workspace.CurrentCamera
	local vp = cam and (cam :: any).ViewportSize
	if vp and type(vp.X) == "number" and vp.X > 0 then return vp.X end
	return 1280
end

local function reducerRorelse(): boolean
	--[[ Egenskapen finns inte på alla klienter. Ett explicit typtest, inte
	     ett pcall: ett pcall hade dolt varje annat fel i samma andetag. ]]
	local v = (GuiService :: any).ReducedMotionEnabled
	return v == true
end

local function tomBana()
	local b = bana
	if not b then return end
	for _, c in b:GetChildren() do
		if c.Name == "Nu" or c.Name == "Fore" then c:Destroy() end
	end
end

--[[ Utsträckningen över BÅDA posterna, så att spöket och ritten ligger i
     samma skala. Ligger de i var sin ram går de inte att jämföra, och
     jämförelsen är hela poängen med spöket. ]]
local function ram()
	minx, maxx, minz, maxz = math.huge, -math.huge, math.huge, -math.huge
	local function ta(p: Inspelning.Post?)
		if not p then return end
		for _, s in p.sampel do
			if s.x ~= nil and s.z ~= nil then
				minx = math.min(minx, s.x); maxx = math.max(maxx, s.x)
				minz = math.min(minz, s.z); maxz = math.max(maxz, s.z)
			end
		end
	end
	ta(post); ta(ghost)
	--[[ Ingen mätt position alls — då finns ingen bana att rita. En
	     hopfallen ram (division med noll) är värre än en tom ruta. ]]
	if minx == math.huge then minx, maxx, minz, maxz = 0, 1, 0, 1 end
	if maxx - minx < 1 then maxx = minx + 1 end
	if maxz - minz < 1 then maxz = minz + 1 end
end

local function skala(x: number, z: number): (number, number)
	return (x - minx) / (maxx - minx), (z - minz) / (maxz - minz)
end

local function punkt(s: Inspelning.Sampel, namn: string, farg: Color3, genomskin: number)
	local b = bana
	if not b or s.x == nil or s.z == nil then return end
	local u, v = skala(s.x, s.z)
	local d = Instance.new("Frame")
	d.Name = namn
	d.Size = UDim2.fromOffset(4, 4)
	d.AnchorPoint = Vector2.new(0.5, 0.5)
	d.Position = UDim2.fromScale(u, 1 - v)
	d.BackgroundColor3 = farg
	d.BackgroundTransparency = genomskin
	d.BorderSizePixel = 0
	d.ZIndex = 3
	d.Parent = b
end

local function ritaSpar(p: Inspelning.Post?, namn: string, farg: Color3,
	genomskin: number, tak: number)
	if not p or #p.sampel == 0 then return end
	local steg = math.max(1, math.floor(#p.sampel / tak))
	for i = 1, #p.sampel, steg do
		punkt(p.sampel[i], namn, farg, genomskin)
	end
end

--[[ Tangentledtext bara där tangenten FINNS — samma regel som
     UgnetaController.medLedtext, och av samma skäl: en ren pekenhet ska
     inte få en bokstav hon inte kan trycka på. ]]
local function medLedtext(txt: string, tangent: string, pad: string): string
	if UserInputService.KeyboardEnabled then return `{txt}  ({tangent})` end
	if UserInputService.GamepadEnabled then return `{txt}  ({pad})` end
	return txt
end

local function bygg()
	if gui then return end
	local g = Instance.new("ScreenGui")
	g.Name = "UBRFReplay"
	g.ResetOnSpawn = false
	g.IgnoreGuiInset = true
	g.DisplayOrder = 20
	g.Enabled = false
	g.Parent = player:WaitForChild("PlayerGui")
	gui = g

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.Size = UDim2.new(0.9, 0, 0.78, 0)
	panel.Position = UDim2.new(0.05, 0, 0.11, 0)
	panel.BackgroundColor3 = FARG_MORK
	panel.BackgroundTransparency = 0.04
	panel.Parent = g
	local pc = Instance.new("UICorner"); pc.CornerRadius = UDim.new(0, 10); pc.Parent = panel

	local rubrik = Instance.new("TextLabel")
	rubrik.Name = "Rubrik"
	rubrik.Size = UDim2.new(1, -24, 0, 30)
	rubrik.Position = UDim2.fromOffset(12, 8)
	rubrik.BackgroundTransparency = 1
	rubrik.Text = "Din ritt"
	rubrik.TextColor3 = FARG_TEXT
	rubrik.TextXAlignment = Enum.TextXAlignment.Left
	rubrik.Font = Enum.Font.GothamBold
	rubrik.TextSize = 18
	rubrik.Parent = panel

	local status = Instance.new("TextLabel")
	status.Name = "Status"
	status.Size = UDim2.new(1, -24, 0, 18)
	status.Position = UDim2.fromOffset(12, 34)
	status.BackgroundTransparency = 1
	status.Text = ""
	status.TextColor3 = FARG_FORE
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.Font = Enum.Font.Gotham
	status.TextSize = 12
	status.Parent = panel
	statusLabel = status

	local b = Instance.new("Frame")
	b.Name = "Bana"
	b.Size = UDim2.new(1, -24, 1, -118)
	b.Position = UDim2.fromOffset(12, 56)
	b.BackgroundColor3 = Color3.fromRGB(24, 27, 33)
	b.ClipsDescendants = true
	b.Parent = panel
	bana = b

	local m = Instance.new("Frame")
	m.Name = "Markor"
	m.Size = UDim2.fromOffset(10, 10)
	m.AnchorPoint = Vector2.new(0.5, 0.5)
	m.BackgroundColor3 = Color3.fromRGB(255, 249, 236)
	m.BorderSizePixel = 0
	m.ZIndex = 5
	m.Parent = b
	markor = m

	--[[ TIDSRUTAN LIGGER I HUVUDET, inte i kontrollraden. Den är en
	     avläsning och ska inte ta plats från det spelaren trycker på. ]]
	local tl = Instance.new("TextLabel")
	tl.Name = "Tid"
	tl.Size = UDim2.new(0, 120, 0, 24)
	tl.Position = UDim2.new(1, -132, 0, 10)
	tl.BackgroundTransparency = 1
	tl.TextColor3 = FARG_TEXT
	tl.TextXAlignment = Enum.TextXAlignment.Right
	tl.Font = Enum.Font.Gotham
	tl.TextSize = 12
	tl.Text = ""
	tl.Parent = panel
	tidLabel = tl

	local r = Instance.new("Frame")
	r.Name = "Kontroller"
	r.BackgroundTransparency = 1
	r.Parent = panel
	rad = r

	--[[ Ingen UIListLayout. Knapparna placeras av `tillampaLayout`, som
	     räknar med samma funktion provet räknar med — en vågrät layout
	     som inte kan brytas var precis felet. ]]
	local function knapp(namn: string, txt: string, fn: () -> ()): TextButton
		local x = Instance.new("TextButton")
		x.Name = namn
		x.AutoButtonColor = true
		x.Size = UDim2.fromOffset(KNAPP_MAX, KNAPP_HOJD)
		x.BackgroundColor3 = FARG_GULD
		x.TextColor3 = Color3.fromRGB(23, 20, 10)
		x.Font = Enum.Font.GothamBold
		x.TextSize = 12
		x.Text = txt
		x.ZIndex = 6
		x.Parent = r
		local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1, 0); c.Parent = x
		x.Activated:Connect(fn)
		table.insert(knappar, x)
		return x
	end

	spelaKnapp = knapp("Spela", "Spela", function() ReplayController.spelaPausa() end)
	knapp("Bak", "−5 s", function() ReplayController.hoppa(-5) end)
	knapp("Fram", "+5 s", function() ReplayController.hoppa(5) end)
	knapp("Fart", "0,5×", function() ReplayController.vaxlaFart() end)
	stangKnapp = knapp("Stang", "Tillbaka", function() ReplayController.stang() end)

	ReplayController.tillampaLayout()

	--[[ Skärmen kan ändra storlek medan panelen står uppe: rotation på en
	     telefon, ett fönster som dras. Layouten räknas om då. Signalen
	     finns inte på alla klienter — ett explicit typtest, inget pcall. ]]
	local cam = Workspace.CurrentCamera
	if cam and type((cam :: any).GetPropertyChangedSignal) == "function" then
		(cam :: any):GetPropertyChangedSignal("ViewportSize"):Connect(function()
			ReplayController.tillampaLayout()
		end)
	end
end

--[[ Placerar kontrollraden efter den bredd som faktiskt finns. Publik
     för att provet ska kunna kalla den efter att ha ändrat viewporten —
     samma väg som en skärmrotation tar. ]]
function ReplayController.tillampaLayout()
	local r = rad
	if not r or #knappar == 0 then return end
	local bredd = viewportBredd() * PANEL_ANDEL - PANEL_MARGINAL
	local L = radLayout(bredd, #knappar)
	for i, k in ipairs(knappar) do
		local ix = i - 1
		local kol = ix % L.perRad
		local rd = math.floor(ix / L.perRad)
		k.Size = UDim2.fromOffset(L.knappBredd, KNAPP_HOJD)
		k.Position = UDim2.fromOffset(kol * (L.knappBredd + GAP),
			rd * (KNAPP_HOJD + GAP))
	end
	r.Size = UDim2.new(1, -PANEL_MARGINAL, 0, L.hojd)
	r.Position = UDim2.new(0, 12, 1, -(L.hojd + 12))
	--[[ Banan krymper så att den aldrig hamnar under knapparna. ]]
	local b = bana
	if b then
		b.Size = UDim2.new(1, -PANEL_MARGINAL, 1, -(L.hojd + 80))
	end
end

--[[ Layouten som tal, för prov och felsökning. Ren avläsning. ]]
function ReplayController.layout(): { [string]: any }
	local bredd = viewportBredd() * PANEL_ANDEL - PANEL_MARGINAL
	local L = radLayout(bredd, math.max(#knappar, 1))
	return { bredd = bredd, perRad = L.perRad, knappBredd = L.knappBredd,
		rader = L.rader, hojd = L.hojd, minBredd = KNAPP_MIN, minHojd = KNAPP_HOJD }
end

local function rita()
	local p = post
	if not p then return end
	local m = markor
	if m then
		local s = Inspelning.vid(p, tid)
		if s and s.x ~= nil and s.z ~= nil then
			local u, v = skala(s.x, s.z)
			m.Position = UDim2.fromScale(u, 1 - v)
			m.Visible = true
		else
			--[[ Ingen mätt position vid den här tidpunkten. Markören
			     försvinner hellre än ställer sig i ett hörn och påstår
			     att hästen var där. ]]
			m.Visible = false
		end
	end
	local tl = tidLabel
	if tl then tl.Text = string.format("%.1f / %.1f s", tid, p.sekunder) end
	--[[ LEDTEXTEN RÄKNAS OM HÄR, inte en gång i `bygg()`. En iPad kan få ett
	     tangentbord efter att panelen byggts, och en spelare kan koppla in en
	     handkontroll mitt i ett pass. Byggdes texten en gång låg fel bokstav
	     kvar resten av sessionen — och provet som växlade inmatningsförmåga
	     såg det. ]]
	local sk = spelaKnapp
	if sk then
		sk.Text = medLedtext(if spelar then "Pausa" else "Spela", "T", "X")
	end
	local stk = stangKnapp
	if stk then stk.Text = medLedtext("Tillbaka", "R", "Y") end
end

--[[ ── Publikt: öppna, stäng, styr ──────────────────────────────── ]]

--[[ Öppnar panelen på en post. `fore` är förra försöket på samma övning,
     eller nil. Returnerar false när posten inte går att spela upp — då
     har ingenting öppnats och den som frågade får veta det i stället för
     att stå med en tom panel.

     Posten VERSIONSKONTROLLERAS. En post skriven av ett äldre schema
     tolkas inte tyst mot dagens definition; ett spöke från en äldre
     övningsversion visas men MÄRKS, eftersom en jämförelse mot den inte
     betyder samma sak. ]]
function ReplayController.oppna(nyPost: Inspelning.Post?, fore: Inspelning.Post?,
	nyStangFn: (() -> ())?): boolean
	if type(nyPost) ~= "table" then return false end
	local las = Inspelning.lasbar(nyPost)
	if not las.ok then return false end
	if #nyPost.sampel == 0 then return false end

	bygg()
	post = nyPost
	--[[ Ett spöke som inte går att läsa är inget spöke. Hellre ingen
	     jämförelse än en jämförelse mot något vi inte vet betydelsen av. ]]
	local foreLas = if type(fore) == "table" then Inspelning.lasbar(fore) else nil
	ghost = if foreLas and foreLas.ok and fore and #fore.sampel > 0 then fore else nil
	stangFn = nyStangFn
	tid = 0
	fart = 1
	--[[ Startar pausad när spelaren bett om mindre rörelse. ]]
	spelar = not reducerRorelse()
	aktiv = true

	local g = gui
	if g then g.Enabled = true end
	ReplayController.tillampaLayout()
	tomBana()
	ram()
	ritaSpar(ghost, "Fore", FARG_FORE, 0.45, PUNKTER_FORE)
	ritaSpar(post, "Nu", FARG_NU, 0.15, PUNKTER_NU)

	local st = statusLabel
	if st then
		if not ghost then
			st.Text = "Första försöket — inget tidigare att jämföra med."
		elseif foreLas and foreLas.lage == "gammal" then
			st.Text = `Förra försöket ligger bakom i gult ({foreLas.skal}).`
		elseif las.lage == "gammal" then
			st.Text = `Förra försöket ligger bakom i gult ({las.skal}).`
		else
			st.Text = "Förra försöket ligger bakom i gult."
		end
	end

	if conn then conn:Disconnect() end
	conn = RunService.RenderStepped:Connect(function(dt: number)
		--[[ En bildruta som redan var i luften när panelen stängdes får
		     inte rita i en stängd panel. ]]
		if not aktiv then return end
		local p = post
		if not p then return end
		if spelar and type(dt) == "number" and dt > 0 then
			tid = math.min(p.sekunder, tid + dt * fart)
			if tid >= p.sekunder then spelar = false end
		end
		rita()
	end)
	rita()
	return true
end

--[[ Stänger panelen. Idempotent, och släpper ALLT: kopplingen, posterna
     och återanropet. Anropas från avsittningen och från
     LektionController.avbryt lika gärna som från Tillbaka-knappen. ]]
function ReplayController.stang()
	if conn then conn:Disconnect(); conn = nil end
	aktiv = false
	spelar = false
	post = nil
	ghost = nil
	tid = 0
	local g = gui
	if g then g.Enabled = false end
	tomBana()
	--[[ Återanropet nollas FÖRE det körs. Annars kunde ett `stang` inuti
	     återanropet köra samma callback en gång till. ]]
	local fn = stangFn
	stangFn = nil
	if fn then fn() end
end

function ReplayController.aktiv(): boolean
	return aktiv
end

function ReplayController.spelaPausa(): boolean
	if not aktiv or not post then return false end
	spelar = not spelar
	--[[ Står uppspelningen på slutet betyder Spela "spela om", inte
	     "stå kvar på sista bildrutan". ]]
	if spelar and tid >= (post :: Inspelning.Post).sekunder then tid = 0 end
	rita()
	return true
end

function ReplayController.hoppa(delta: number): boolean
	local p = post
	if not aktiv or not p then return false end
	if type(delta) ~= "number" or delta ~= delta then return false end
	tid = math.max(0, math.min(p.sekunder, tid + delta))
	rita()
	return true
end

function ReplayController.vaxlaFart(): number
	if not aktiv then return fart end
	fart = if fart == 1 then 0.5 else 1
	return fart
end

--[[ Läget, för prov och för den som kör lektionen. Ren avläsning — en
     kopia, så att ingen kan skriva i panelens tillstånd genom den. ]]
function ReplayController.lage(): { [string]: any }
	return {
		aktiv = aktiv, spelar = spelar, tid = tid, fart = fart,
		harFore = ghost ~= nil,
		sekunder = if post then (post :: Inspelning.Post).sekunder else 0,
	}
end

return ReplayController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX53">
					<Properties>
						<string name="Name">RiderController</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Ryttaren i sadeln.

	Kroppen sitter fast i sitsen — det sköter Roblox. Den här modulen gör
	det som skiljer en ryttare från en last: händerna hittar tyglarna och
	fötterna hittar stigbyglarna, med IKControl i stället för fastsvetsade
	lemmar. Svetsar man fast varje lem i en pose blir ryttaren en docka som
	inte reagerar på något.

	Saknas attachment-punkterna händer ingenting — då sitter ryttaren i
	sadeln i sin vanliga pose. Det är rätt sorts degradering.
]]

local Players = game:GetService("Players")

local Core = require(game:GetService("ReplicatedStorage").HorseCore)
local Types = require(game:GetService("ReplicatedStorage").HorseCore.Types)
local RigAdapter = Core.RigAdapter

local RiderController = {}
RiderController.__index = RiderController

--[[ Vilken IK-kedja som ska nå vilken punkt på hästen. ]]
local CHAINS = {
	{ name = "LeftHand",  endEffector = "LeftHand",  target = "LeftReinAttachment",     chainRoot = "LeftUpperArm" },
	{ name = "RightHand", endEffector = "RightHand", target = "RightReinAttachment",    chainRoot = "RightUpperArm" },
	{ name = "LeftFoot",  endEffector = "LeftFoot",  target = "LeftStirrupAttachment",  chainRoot = "LeftUpperLeg" },
	{ name = "RightFoot", endEffector = "RightFoot", target = "RightStirrupAttachment", chainRoot = "RightUpperLeg" },
}

function RiderController.new(rig: Types.Rig)
	local self = setmetatable({}, RiderController)
	self.rig = rig
	self.controls = {} :: { IKControl }
	self.track = nil :: AnimationTrack?
	return self
end

function RiderController:attach(character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	local animator = humanoid:FindFirstChildOfClass("Animator")

	--[[ Ridposen spelas med Action-prioritet så att den vinner över
	     Roblox egen sittanimation, som annars lägger ryttaren i stolspose. ]]
	local id = self.rig.animConfig and self.rig.animConfig:GetAttribute("RiderSeated")
	if animator and typeof(id) == "string" and id ~= "" then
		local anim = Instance.new("Animation")
		anim.AnimationId = if id:match("^rbxassetid://") then id else "rbxassetid://" .. id
		local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
		if ok and track then
			track.Priority = Enum.AnimationPriority.Action
			track.Looped = true
			track:Play(0.25)
			self.track = track
		end
	end

	--[[ IK i stället för svetsar. Roblox löser kedjan varje bildruta, så
	     händerna följer med när hästens huvud rör sig och fötterna hänger
	     kvar i stigbyglarna även när kroppen gungar. ]]
	for _, chain in CHAINS do
		local target = self.rig.attachments[chain.target]
		local effector = character:FindFirstChild(chain.endEffector)
		local root = character:FindFirstChild(chain.chainRoot)
		if target and effector and root then
			local control = Instance.new("IKControl")
			control.Name = "Horse_" .. chain.name
			control.Type = Enum.IKControlType.Position
			control.EndEffector = effector
			control.ChainRoot = root
			control.Target = target
			control.Weight = 0.85
			control.Parent = humanoid
			table.insert(self.controls, control)
		end
	end
end

--[[ ── Sekundärrörelsen ────────────────────────────────────────────
     De ofrivilliga rörelser en kropp gör när den sitter på en annan
     kropp som rör sig. Läggs OVANPÅ sitsen, aldrig i stället för den.

       · TRÖGHETEN — accelererar hästen hamnar ryttaren efter och lutar
         bakåt en aning; bromsar hästen kommer hon före. Signalen är
         tempoderivatan, hårt utjämnad: rå derivata hackar, och en
         ryttare som ryckte per bildruta skulle läsa som ragdoll.
       · BALANSEN — i en sväng söker hon sig inåt, men bara en tredjedel
         av hästens lutning. Kroppen ska följa hästen, inte tävla med den.

     Talen är desamma som webbversionens, så att en spelare som byter
     plattform känner igen sig: ±0,055 rad (3,2°) tröghet och ±0,030
     (1,7°) balans. Utan taken blir en hård inbromsning en kullerbytta.

     Rotationen läggs på HumanoidRootPart via en egen Motor6D-offset om
     riggen har en; saknas den händer ingenting, vilket är rätt sorts
     degradering — samma regel som resten av modulen. ]]
local INERTIA_GAIN = 0.014
local INERTIA_MAX = 0.055
local BALANCE_SHARE = 0.34
local BALANCE_MAX = 0.030
local ACCEL_TAU = 0.18

function RiderController:step(loco: Types.Locomotion, dt: number)
	local give = 1 - math.clamp(math.abs(loco.speed) / 14, 0, 0.35)
	for _, control in self.controls do
		control.Weight = 0.85 * give
	end

	--[[ Tempoderivatan, utjämnad. Klampningen på ±6 m/s² finns för att
	     ett gångartsbyte eller en kollision annars ger en spik. ]]
	local prev = self.lastSpeed or loco.speed
	self.lastSpeed = loco.speed
	local raw = math.clamp((loco.speed - prev) / math.max(dt, 1e-4), -6, 6)
	self.accel = (self.accel or 0) + (raw - (self.accel or 0))
		* (1 - math.exp(-dt / ACCEL_TAU))

	self.pitch = math.clamp(-(self.accel) * INERTIA_GAIN, -INERTIA_MAX, INERTIA_MAX)
	self.roll = math.clamp(loco.lean * BALANCE_SHARE, -BALANCE_MAX, BALANCE_MAX)
	RigAdapter.setRiderLean(self.rig, self.roll, self.pitch)
end

function RiderController:release()
	self.accel, self.pitch, self.roll, self.lastSpeed = 0, 0, 0, nil
	RigAdapter.setRiderLean(self.rig, 0, 0)
	for _, control in self.controls do
		control:Destroy()
	end
	table.clear(self.controls)
	if self.track then
		self.track:Stop(0.25)
		self.track = nil
	end
end

return RiderController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX54">
					<Properties>
						<string name="Name">SoundController</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Hovljud och hästljud.

	Hovarna slår i takt med gångarten, inte med en timer: fasen kommer från
	rörelsemodulen, som räknar den ur farten. Det gör att ljudet stämmer med
	benen även när animationen sträcks eller hästen bromsar.

	Underlaget läses av med samma strålkastning som marken redan gör, och
	byter ljudmapp. Saknas ett ljud spelas inget — tystnad är bättre än fel
	ljud, och ett saknat ljud får aldrig stoppa något.
]]

local Core = require(game:GetService("ReplicatedStorage").HorseCore)
local Types = require(game:GetService("ReplicatedStorage").HorseCore.Types)
local Config, Gaits = Core.Config, Core.Gaits

local SoundController = {}
SoundController.__index = SoundController

--[[ Ljud-id:n sätts som attribut på en Configuration som heter Sounds i
     hästmodellen, med namn som Hoof_Grass, Hoof_Stone, Snort, Neigh. ]]
local SURFACES = {
	[Enum.Material.Grass] = "Grass", [Enum.Material.LeafyGrass] = "Grass",
	[Enum.Material.Ground] = "Dirt", [Enum.Material.Mud] = "Dirt",
	[Enum.Material.Sand] = "Sand", [Enum.Material.Sandstone] = "Sand",
	[Enum.Material.Wood] = "Wood", [Enum.Material.WoodPlanks] = "Wood",
	[Enum.Material.Concrete] = "Stone", [Enum.Material.Slate] = "Stone",
	[Enum.Material.Cobblestone] = "Stone", [Enum.Material.Rock] = "Stone",
}

function SoundController.new(rig: Types.Rig, stats: { [string]: any })
	local self = setmetatable({}, SoundController)
	self.rig = rig
	self.stats = stats
	self.temperament = Config.TEMPERAMENTS[stats.Temperament] or Config.TEMPERAMENTS.Calm
	self.config = rig.model:FindFirstChild("Sounds")
	self.lastPhase = 0
	self.surface = "Grass"
	self.nextVocal = os.clock() + 12
	self.pool = {} :: { [string]: Sound }
	return self
end

function SoundController:_sound(key: string): Sound?
	if self.pool[key] then return self.pool[key] end
	local id = Config.attr(self.config, key, "")
	if typeof(id) ~= "string" or id == "" then return nil end
	local s = Instance.new("Sound")
	s.Name = key
	s.SoundId = if id:match("^rbxassetid://") then id else "rbxassetid://" .. id
	s.RollOffMaxDistance = 120
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.Parent = self.rig.root
	self.pool[key] = s
	return s
end

function SoundController:_hoof()
	local sound = self:_sound("Hoof_" .. self.surface) or self:_sound("Hoof_Dirt")
	if not sound then return end
	--[[ Slumpad tonhöjd. Fyra identiska hovslag i rad låter som en maskin;
	     några procents variation räcker för att det ska låta levande. ]]
	sound.PlaybackSpeed = 0.92 + math.random() * 0.16
	sound:Play()
end

function SoundController:step(loco: Types.Locomotion, dt: number)
	--[[ Ett hovslag varje gång fasen passerar en delning. Antalet delningar
	     är gångartens takt: skritt fyra, trav två, galopp tre, fyrsprång fyra. ]]
	local gait = Gaits.get(loco.gait)
	if gait.steps > 0 and loco.grounded and not loco.airborne then
		local beats = gait.steps
		local now = math.floor(loco.phase * beats)
		local before = math.floor(self.lastPhase * beats)
		if now ~= before then
			self:_hoof()
		end
	end
	self.lastPhase = loco.phase

	-- Underlaget uppdateras sällan; materialet ändras inte per bildruta.
	if math.random() < dt * 4 then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { self.rig.model }
		local hit = workspace:Raycast(self.rig.root.Position, Vector3.new(0, -8, 0), params)
		if hit then
			self.surface = SURFACES[hit.Material] or "Dirt"
		end
	end

	--[[ Läten kommer sällan och aldrig i rad. En häst som gnäggar var femte
	     sekund blir outhärdlig efter en minut. ]]
	if os.clock() > self.nextVocal then
		local key = if math.abs(loco.speed) > 5 then "Snort" else "Breath"
		local sound = self:_sound(key)
		if sound then sound:Play() end
		self.nextVocal = os.clock() + (14 + math.random() * 16) / self.temperament.soundRate
	end
end

function SoundController:release()
	for _, sound in self.pool do
		sound:Stop()
	end
end

return SoundController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX55">
					<Properties>
						<string name="Name">TouchControls</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Ridningens pekkontroller.

	`Input` har haft `setTouch`, `touchGait` och `touchJump` sedan början,
	men ingen har anropat dem: API:t fanns, spelaren fanns inte. Den här
	modulen är den saknade anroparen och ingenting mer. Ingen ny
	rörelsearkitektur, ingen egen avsiktsmodell — spaken skriver samma
	normaliserade avsikter som W/A/S/D och gamepaden, och går genom samma
	`Input.consume()` in i `MovementController`.

	SPAKEN ÄR ANALOG, INTE FYRA KNAPPAR I EN CIRKEL. Det är hela poängen:
	en liten dragning ska ge en linjekorrigering, en halv ska ge en 20 m
	volt, en hel ska ge en snäv volt. Kurvan nedan är portad från
	webbversionen, där de tre nivåerna är uppmätta med riktiga pekhändelser.

	Ritas bara på pekenheter, bara när man sitter upp, och rivs vid avsittning.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local TouchControls = {}

--[[ ── Kurvan ──────────────────────────────────────────────────────────
     Samma tal som `src/mobil.js`: expo 0,35 och dödzon 0,07 på styraxeln,
     0,12 på framåtaxeln. Den högre dödzonen framåt finns för att tummen
     nästan alltid har en liten lodrät komponent när man styr — utan den
     ökar hästen gångart av misstag mitt i en volt.

     Expo betyder att kurvan är delvis rak, delvis kubisk. En rent
     kvadratisk kurva provades i webben och föll: 25 % spakutslag gav 2 %
     styrning, alltså 203 m radie — i praktiken rakt fram, och därmed inte
     tre användbara nivåer. ]]
local EXPO = 0.35
local DEAD_STEER = 0.07
local DEAD_FORWARD = 0.12

local function dodzon(v: number, d: number): number
	local a = math.abs(v)
	if a <= d then return 0 end
	return math.sign(v) * (a - d) / (1 - d)
end

local function kurva(v: number): number
	local a = math.abs(v)
	return math.sign(v) * a * (EXPO + (1 - EXPO) * a * a)
end

--[[ Spakens läge → avsikt. Ren funktion, utan Roblox-beroenden, så att den
     går att mäta i bänken utan att någon GUI behöver finnas.

     `dx`/`dy` är pixlar från spakens mitt, `radie` dess yttermått. Y vänds:
     på skärmen växer Y nedåt, men framåt är uppåt. ]]
function TouchControls.axis(dx: number, dy: number, radie: number): (number, number)
	if radie <= 0 then return 0, 0 end
	local nx, ny = dx / radie, -dy / radie
	--[[ Utanför cirkeln normaliseras längden till 1 i stället för att
	     klampas per axel: annars blir diagonalen snabbare än rakt fram,
	     vilket är samma fel som ett odiagonalklampat WASD gör. ]]
	local len = math.sqrt(nx * nx + ny * ny)
	if len > 1 then nx, ny = nx / len, ny / len end
	return kurva(dodzon(ny, DEAD_FORWARD)), kurva(dodzon(nx, DEAD_STEER))
end

TouchControls.RADIE = 66          -- spakens yttermått i pixlar
TouchControls.KNAPP = 56          -- knopens diameter

--[[ ── GUI ─────────────────────────────────────────────────────────────
     Byggs först vid uppsittning, på en pekenhet. Allt nedanför är
     Roblox-instanser och kan därför bara köras i Studio eller i en klient;
     mätbänken testar `axis` och `Input`-kontraktet, inte gesterna. ]]
local gui: ScreenGui? = nil
local aktivFinger: InputObject? = nil
local Input = nil :: any            -- sätts av mount, för att undvika cykel

local function nyRam(namn: string, parent: Instance): Frame
	local f = Instance.new("Frame")
	f.Name = namn
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Parent = parent
	return f
end

local function nyKnapp(namn: string, text: string, parent: Instance): TextButton
	local b = Instance.new("TextButton")
	b.Name = namn
	b.Text = text
	b.AutoButtonColor = false
	--[[ 44 px är golvet för ett touchmål, och 56 är vad en tumme vill ha
	     när man samtidigt håller i telefonen med samma hand. ]]
	b.Size = UDim2.fromOffset(64, 56)
	b.BackgroundColor3 = Color3.fromRGB(24, 27, 33)
	b.BackgroundTransparency = 0.18
	b.TextColor3 = Color3.fromRGB(236, 232, 222)
	b.TextSize = 15
	b.Font = Enum.Font.GothamMedium
	b.BorderSizePixel = 0
	b.Parent = parent
	local horn = Instance.new("UICorner")
	horn.CornerRadius = UDim.new(0, 14)
	horn.Parent = b
	return b
end

--[[ Spaken följer fingret som startade den, inte vilket finger som helst:
     annars kapar en tumme på gångartsknappen styrningen mitt i en volt. ]]
local function kopplaSpak(bas: Frame, knop: Frame)
	local function centrum(): Vector2
		local p, s = bas.AbsolutePosition, bas.AbsoluteSize
		return p + s / 2
	end

	local function flytta(pos: Vector2)
		local c = centrum()
		local dx, dy = pos.X - c.X, pos.Y - c.Y
		local len = math.sqrt(dx * dx + dy * dy)
		local r = TouchControls.RADIE
		if len > r then dx, dy = dx / len * r, dy / len * r end
		knop.Position = UDim2.new(0.5, dx, 0.5, dy)
		Input.setTouch(TouchControls.axis(dx, dy, r))
	end

	--[[ Att släppa MÅSTE nolla båda axlarna på en gång. Ett finger som
	     lyfts mitt i en sväng och lämnar kvar 0,6 styrning är en häst som
	     fortsätter svänga av sig själv. ]]
	local function slapp()
		aktivFinger = nil
		knop.Position = UDim2.fromScale(0.5, 0.5)
		Input.setTouch(0, 0)
	end

	bas.InputBegan:Connect(function(obj: InputObject)
		if obj.UserInputType ~= Enum.UserInputType.Touch then return end
		if aktivFinger then return end
		aktivFinger = obj
		flytta(Vector2.new(obj.Position.X, obj.Position.Y))
	end)

	--[[ Rörelsen lyssnas på globalt, inte på ramen: drar man tummen utanför
	     cirkeln ska styrningen ligga kvar på max i stället för att slockna. ]]
	UserInputService.InputChanged:Connect(function(obj: InputObject)
		if obj ~= aktivFinger then return end
		flytta(Vector2.new(obj.Position.X, obj.Position.Y))
	end)
	UserInputService.InputEnded:Connect(function(obj: InputObject)
		if obj == aktivFinger then slapp() end
	end)
end

--[[ Roblox egna pekreglage flyttar KARAKTÄREN. Sitter hon i sadeln blir
     det två saker som drar i samma kropp, och i värsta fall reser hon sig
     ur sitsen mitt i galoppen. De stängs av medan man rider och sätts på
     igen vid avsittning — inte permanent, eftersom spelaren ska kunna gå
     till fots i stallet som vanligt. ]]
local styrningAv = false
local function egnaReglage(pa: boolean)
	local scripts = Players.LocalPlayer:FindFirstChild("PlayerScripts")
	local modul = scripts and scripts:FindFirstChild("PlayerModule")
	if not modul then return end
	local ok, controls = pcall(function()
		return (require(modul) :: any):GetControls()
	end)
	if not ok or not controls then return end
	if pa then controls:Enable() else controls:Disable() end
	styrningAv = not pa
end

--[[ `hooks.dismount` kallas när spelaren trycker på avsittningsknappen —
     pekskärmen har ingen E-tangent att trycka på. ]]
function TouchControls.mount(input: any, hooks: { dismount: () -> () })
	if gui then return end
	if not UserInputService.TouchEnabled then return end
	Input = input

	local spelare = Players.LocalPlayer
	local mapp = spelare:FindFirstChildOfClass("PlayerGui")
	if not mapp then return end

	gui = Instance.new("ScreenGui")
	local g = gui :: ScreenGui
	g.Name = "HorseTouch"
	g.ResetOnSpawn = false
	g.IgnoreGuiInset = false
	g.DisplayOrder = 8
	g.Parent = mapp

	--[[ Spaken nere till vänster, knapparna nere till höger: samma sida som
	     webbversionen lägger dem, och samma sida som tummarna faktiskt är. ]]
	local bas = nyRam("Spak", g)
	bas.Size = UDim2.fromOffset(TouchControls.RADIE * 2, TouchControls.RADIE * 2)
	bas.Position = UDim2.new(0, 24, 1, -(TouchControls.RADIE * 2) - 28)
	bas.BackgroundTransparency = 0.55
	bas.BackgroundColor3 = Color3.fromRGB(24, 27, 33)
	local basHorn = Instance.new("UICorner")
	basHorn.CornerRadius = UDim.new(1, 0)
	basHorn.Parent = bas

	local knop = nyRam("Knop", bas)
	knop.Size = UDim2.fromOffset(TouchControls.KNAPP, TouchControls.KNAPP)
	knop.Position = UDim2.fromScale(0.5, 0.5)
	knop.AnchorPoint = Vector2.new(0.5, 0.5)
	knop.BackgroundTransparency = 0.1
	knop.BackgroundColor3 = Color3.fromRGB(214, 174, 60)
	local knopHorn = Instance.new("UICorner")
	knopHorn.CornerRadius = UDim.new(1, 0)
	knopHorn.Parent = knop

	local knappar = nyRam("Knappar", g)
	knappar.Size = UDim2.fromOffset(150, 344)
	knappar.Position = UDim2.new(1, -168, 1, -372)
	local rad = Instance.new("UIListLayout")
	rad.FillDirection = Enum.FillDirection.Vertical
	rad.HorizontalAlignment = Enum.HorizontalAlignment.Right
	rad.VerticalAlignment = Enum.VerticalAlignment.Bottom
	rad.Padding = UDim.new(0, 10)
	rad.Parent = knappar

	local av = nyKnapp("Av", "SITT AV", knappar)
	local hoppa = nyKnapp("Hoppa", "HOPP", knappar)
	local ned = nyKnapp("Ned", "▼ LUGNARE", knappar)
	local upp = nyKnapp("Upp", "▲ FRAMÅT", knappar)
	--[[ G02-B: TYGELN och PARADEN på pekskärmen. Utan dem kan en spelare
	     med pekskärm varken hålla kontakten eller ge en halvhalt, och då
	     är yttertygelstödet — och därmed hästens balans i svängen —
	     stängt för hela den plattformen. Webben har samma två på sin
	     pekskärm (HALVHALT-knappen och tygeln). ]]
	local tygel = nyKnapp("Tygel", "TYGEL", knappar)
	local parad = nyKnapp("Parad", "HALVHALT", knappar)
	--[[ Sitsen: hålls, som tygeln. Djup sits bär bågen — se
	     SVAR.BALANS_VIKT. Utan knappen kan en spelare med pekskärm inte
	     stödja volten med sätet, och då är den delen av modellen stängd
	     för hela plattformen. ]]
	local sits = nyKnapp("Sits", "DJUP SITS", knappar)
	upp.LayoutOrder, ned.LayoutOrder = 1, 2
	tygel.LayoutOrder, sits.LayoutOrder, parad.LayoutOrder = 3, 4, 5
	hoppa.LayoutOrder, av.LayoutOrder = 6, 7

	--[[ Gångartsknapparna är flanktriggade i `Input`: ett tryck ger ett
	     byte, hur länge man än håller kvar. Att hålla ned ska inte rusa
	     genom skritt–trav–galopp. ]]
	upp.MouseButton1Click:Connect(function() Input.touchGait(true) end)
	ned.MouseButton1Click:Connect(function() Input.touchGait(false) end)
	hoppa.MouseButton1Click:Connect(function() Input.touchJump() end)
	av.MouseButton1Click:Connect(hooks.dismount)

	--[[ Tygeln HÅLLS — kontakten är ett tillstånd, inte en händelse — och
	     paraden är en impuls, precis som flanken på F. Att göra tvärtom
	     hade gett en tygel man knäpper på och en halvhalt man kan hålla
	     inne, och ingetdera är ridning. ]]
	tygel.MouseButton1Down:Connect(function() Input.setTouchRein(1) end)
	tygel.MouseButton1Up:Connect(function() Input.setTouchRein(0) end)
	tygel.MouseLeave:Connect(function() Input.setTouchRein(0) end)
	parad.MouseButton1Click:Connect(function() Input.touchParad() end)
	sits.MouseButton1Down:Connect(function() Input.setTouchSeat(1) end)
	sits.MouseButton1Up:Connect(function() Input.setTouchSeat(0) end)
	sits.MouseLeave:Connect(function() Input.setTouchSeat(0) end)

	kopplaSpak(bas, knop)
	egnaReglage(false)
end

function TouchControls.unmount()
	if gui then
		gui:Destroy()
		gui = nil
	end
	aktivFinger = nil
	if Input then Input.setTouch(0, 0) end
	if styrningAv then egnaReglage(true) end
end

function TouchControls.isActive(): boolean
	return gui ~= nil
end

return TouchControls
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX56">
					<Properties>
						<string name="Name">UgnetaController</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[ UGNETAS LÄRAR-UX PÅ ROBLOX (G02-C, UX-variant 1 + 3).

	Samma upplevelse som webben, inte en egen tolkning:

	  LIVE under ridning — några ord i ett litet chip ("Mjukare hand",
	  "Bra rytm", "Precis så"). Ingen panel, ingen textström. Ridningen
	  ska vinna över UI:t.

	  MELLAN FÖRSÖKEN — kortet. Efter försök 1: högst en sak som var bra,
	  en att förbättra och ett tydligt "Prova igen". Efter försök 2: en
	  konkret jämförelse mot försök 1.

	  SÄKERHET vinner alltid. Ett säkerhetsmeddelande släcker live-chipet
	  och tar över ytan, precis som på webben.

	INGEN PARALLELL SANNING. Vilka dimensioner en övning bedöms på, hur
	många observationer som får visas och hur de rangordnas kommer ur
	HorseCore/Ugneta, som i sin tur läser RidKanon.UGNETA — genererad ur
	webbens src/larare.js. Den här filen räknar inte om bedömningen; den
	visar den.

	Mätvärdena kommer ur HorseCore/Telemetri, samma källa som webbens
	G.telemetri. Kvalitetsmåtten byggs av `Ugneta.kvalitet`, inte av
	egna formler här.

	Layouten är byggd för 320 px bredd först — samma skäl som
	PreparationController: familjen spelar på iPad och telefon.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Ugneta = require(game:GetService("ReplicatedStorage").HorseCore.Ugneta)
local RidKanon = require(game:GetService("ReplicatedStorage").HorseCore.RidKanon)

local UgnetaController = {}

local player = Players.LocalPlayer

local gui: ScreenGui? = nil
local chip: TextLabel? = nil
local kort: Frame? = nil
local kortRubrik: TextLabel? = nil
local kortPunkter: { TextLabel } = {}
local kortKnapp: TextButton? = nil
--[[ G02-D: kortet efter ett försök bär numera TRE vägar vidare, inte en.
     Huvudknappen är kvar precis som den var (Prova igen / Nästa övning);
     de två nya är sidoval och styr därför sina egna knappar:

       "Se ritten"   öppnar ridanalysen. Den avslutar INTE väntan — kortet
                     står kvar bakom panelen, och när panelen stängs är
                     valet fortfarande hennes.
       "Gå vidare"   nöjer sig med försöket. Momentet betygsätts ändå;
                     det är omridningen hon hoppar över, inte bedömningen.

     Kortet efter det SISTA försöket får ingen "Gå vidare" — huvudknappen
     ÄR att gå vidare då, och två knappar för samma sak är ingen valfrihet.
     Ett kort utan inspelning får ingen "Se ritten": ett val som inte kan
     leda någonstans är sämre än inget val. ]]
local replayKnapp: TextButton? = nil
local vidareKnapp: TextButton? = nil
local replayFn: (() -> ())? = nil
local vidareFn: (() -> ())? = nil

--[[ ÅTERFÖRSÖKET ÄR EN HANDLING, INTE EN SKYLT (senior review av
	c53a2c7). Knappen var en TextLabel utan input-handler, och lifecyclen
	gick vidare på en sexsekunderstimer: kortet SÅG ut som ett val men var
	en nedräkning. En skylt som ser ut som en knapp är inte en knapp.

	Nu väntar lektionen på spelaren. `vantarPa` ÄR den väntan, och så
	länge den är sann mäts ingenting — se LektionController.steg. Det är
	också därför tre ingångar (knapp, tangent, gamepad) går genom EN
	`fortsatt`: en väntan som kan avslutas på tre ställen skulle kunna
	avslutas två gånger. ]]
local vantarPa = false
local fortsattFn: (() -> ())? = nil

local FARG_GULD = Color3.fromRGB(232, 181, 74)
local FARG_BRA = Color3.fromRGB(140, 196, 120)
local FARG_MORK = Color3.fromRGB(12, 14, 18)
local FARG_TEXT = Color3.fromRGB(246, 242, 232)

--[[ Live-orden: korta cues, en för fel och en för rätt. Registret är
	avsiktligt litet — fler ord blir en textström, och det är precis det
	variant 1+3 säger nej till.

	Det stod förut som en handskriven kopia här. Samma ord som webbens,
	men en KOPIA, och en kopia kan glida. Nu läses både orden och hur
	länge chipet står kvar ur kanonen. ]]
local LIVE = RidKanon.UGNETA.LIVE
local LIVE_CD = RidKanon.UGNETA.LIVE_CD

local DIM_ORD = {
	linje = "linjen", rytm = "rytmen", balans = "balansen",
	timing = "timingen", mjukhet = "mjukheten", respons = "hästens svar",
	tempo = "tempot",
}

local liveTid = 0
local liveSagt = ""

local function bygg()
	if gui then return end
	local g = Instance.new("ScreenGui")
	g.Name = "UBRFUgneta"
	g.ResetOnSpawn = false
	g.IgnoreGuiInset = true
	g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	g.Parent = player:WaitForChild("PlayerGui")
	--[[ Sätts HÄR, inte i slutet: vakten `if gui then return end` ovan
	     läser den, och utan tilldelningen byggde varje anrop en ny HUD
	     ovanpå den förra. Specen fångade två "Live" i samma ScreenGui. ]]
	gui = g

	--[[ LIVE-CHIPET. Uppe i kanten, aldrig över ridvägen, och utan
		porträtt eller rubrik — det är skillnaden mot kortet. ]]
	local c = Instance.new("TextLabel")
	c.Name = "Live"
	c.AnchorPoint = Vector2.new(0.5, 0)
	c.Position = UDim2.new(0.5, 0, 0, 10)
	c.Size = UDim2.new(0, 0, 0, 30)
	c.AutomaticSize = Enum.AutomaticSize.X
	c.BackgroundColor3 = FARG_MORK
	c.BackgroundTransparency = 0.18
	c.TextColor3 = FARG_TEXT
	c.Font = Enum.Font.GothamBold
	c.TextSize = 15
	c.Text = ""
	c.Visible = false
	c.ZIndex = 6
	local cpad = Instance.new("UIPadding")
	cpad.PaddingLeft = UDim.new(0, 14)
	cpad.PaddingRight = UDim.new(0, 14)
	cpad.Parent = c
	local ccorner = Instance.new("UICorner")
	ccorner.CornerRadius = UDim.new(1, 0)
	ccorner.Parent = c
	local cstroke = Instance.new("UIStroke")
	cstroke.Color = FARG_GULD
	cstroke.Transparency = 0.5
	cstroke.Parent = c
	c.Parent = g
	chip = c

	--[[ KORTET. Visas bara mellan försöken. ]]
	local k = Instance.new("Frame")
	k.Name = "Kort"
	k.AnchorPoint = Vector2.new(0.5, 1)
	k.Position = UDim2.new(0.5, 0, 1, -14)
	k.Size = UDim2.new(0.92, 0, 0, 170)
	k.SizeConstraint = Enum.SizeConstraint.RelativeXX
	k.BackgroundColor3 = FARG_MORK
	k.BackgroundTransparency = 0.08
	k.Visible = false
	k.ZIndex = 5
	local kmax = Instance.new("UISizeConstraint")
	kmax.MaxSize = Vector2.new(640, 260)
	kmax.Parent = k
	local kcorner = Instance.new("UICorner")
	kcorner.CornerRadius = UDim.new(0, 10)
	kcorner.Parent = k
	local kstroke = Instance.new("UIStroke")
	kstroke.Color = FARG_GULD
	kstroke.Transparency = 0.52
	kstroke.Parent = k
	local kpad = Instance.new("UIPadding")
	kpad.PaddingTop = UDim.new(0, 10)
	kpad.PaddingBottom = UDim.new(0, 10)
	kpad.PaddingLeft = UDim.new(0, 13)
	kpad.PaddingRight = UDim.new(0, 13)
	kpad.Parent = k
	local klista = Instance.new("UIListLayout")
	klista.Padding = UDim.new(0, 3)
	klista.SortOrder = Enum.SortOrder.LayoutOrder
	klista.Parent = k
	k.Parent = g
	kort = k

	local namn = Instance.new("TextLabel")
	namn.Name = "Avsandare"
	namn.LayoutOrder = 1
	namn.Size = UDim2.new(1, 0, 0, 13)
	namn.BackgroundTransparency = 1
	namn.TextXAlignment = Enum.TextXAlignment.Left
	namn.Font = Enum.Font.RobotoMono
	namn.TextSize = 11
	namn.TextColor3 = Color3.fromRGB(231, 200, 107)
	namn.Text = "UGNETA · RIDINSTRUKTÖR"
	namn.ZIndex = 6
	namn.Parent = k

	local r = Instance.new("TextLabel")
	r.Name = "Rubrik"
	r.LayoutOrder = 2
	r.Size = UDim2.new(1, 0, 0, 20)
	r.BackgroundTransparency = 1
	r.TextXAlignment = Enum.TextXAlignment.Left
	r.Font = Enum.Font.GothamBold
	r.TextSize = 16
	r.TextColor3 = FARG_TEXT
	r.Text = ""
	r.ZIndex = 6
	r.Parent = k
	kortRubrik = r

	for i = 1, Ugneta.MAX_OBSERVATIONER do
		local p = Instance.new("TextLabel")
		p.Name = "Punkt" .. i
		p.LayoutOrder = 2 + i
		p.Size = UDim2.new(1, 0, 0, 18)
		p.BackgroundTransparency = 1
		p.TextXAlignment = Enum.TextXAlignment.Left
		p.Font = Enum.Font.Gotham
		p.TextSize = 14
		p.TextColor3 = FARG_TEXT
		p.Text = ""
		p.Visible = false
		p.ZIndex = 6
		p.Parent = k
		table.insert(kortPunkter, p)
	end

	local kn = Instance.new("TextButton")
	kn.Name = "Knapp"
	kn.AutoButtonColor = true
	kn.LayoutOrder = 9
	kn.Size = UDim2.new(0, 108, 0, 22)
	kn.BackgroundColor3 = FARG_GULD
	kn.TextColor3 = Color3.fromRGB(23, 20, 10)
	kn.Font = Enum.Font.GothamBold
	kn.TextSize = 12
	kn.Text = "Prova igen"
	kn.Visible = false
	kn.ZIndex = 6
	local kncorner = Instance.new("UICorner")
	kncorner.CornerRadius = UDim.new(1, 0)
	kncorner.Parent = kn
	kn.Parent = k
	kortKnapp = kn

	--[[ Sidoknapparna. Samma yta, samma träffstorlek, tydligt underordnad
	     färg — huvudvalet ska fortfarande vara det som syns först. ]]
	local function sidoKnapp(namn: string, txt: string, ordning: number,
		fn: () -> ()): TextButton
		local x = Instance.new("TextButton")
		x.Name = namn
		x.AutoButtonColor = true
		x.LayoutOrder = ordning
		x.Size = UDim2.new(0, 108, 0, 22)
		x.BackgroundColor3 = Color3.fromRGB(60, 72, 68)
		x.TextColor3 = FARG_TEXT
		x.Font = Enum.Font.GothamBold
		x.TextSize = 12
		x.Text = txt
		x.Visible = false
		x.ZIndex = 6
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(1, 0)
		c.Parent = x
		x.Parent = k
		x.Activated:Connect(fn)
		return x
	end
	replayKnapp = sidoKnapp("SeRitten", "Se ritten", 10, function()
		UgnetaController.replay()
	end)
	vidareKnapp = sidoKnapp("GaVidare", "Gå vidare", 11, function()
		UgnetaController.gaVidare()
	end)

	--[[ Mus och finger går in här. Tangent och gamepad kommer in via
	     init.client.luau, som äger inmatningen — HUD:en lyssnar inte
	     själv på UserInputService, av samma skäl som allt annat ligger i
	     den enda loopen. ]]
	kn.Activated:Connect(function()
		UgnetaController.fortsatt()
	end)
end

--[[ TANGENTLEDTEXT PÅ KNAPPEN (Tobias beslut 2026-09-07).

	Spelaren såg "Prova igen" men ingenting om att R gör samma sak —
	knappen var träffbar men tangenten var osynlig.

	Ledtexten visas bara där tangenten FINNS. En ren pekenhet ska inte
	få en bokstav hon inte kan trycka på, och det är inmatningen som
	avgör, inte plattformen: en iPad med tangentbord får ledtexten, en
	telefon får den inte. Tangenterna är desamma som init.client lyssnar
	på — R och gamepadens Y.

	Webben har ingen motsvarande ledtext, och ska inte ha det: den styrs
	med mus och finger. Paritetsregeln säger uttryckligen att inputadapter
	och UI får vara plattformsspecifika. ]]
local function medLedtext(txt: string): string
	if UserInputService.KeyboardEnabled then return txt .. "  (R)" end
	if UserInputService.GamepadEnabled then return txt .. "  (Y)" end
	return txt
end

--[[ ── Live-registret ─────────────────────────────────────────── ]]
function UgnetaController.liveText(fokusId: string, bra: boolean): string
	local r = LIVE[fokusId]
	if not r then return if bra then "Precis så" else "" end
	return if bra then r.bra else r.fel
end

function UgnetaController.live(txt: string, bra: boolean)
	if txt == "" then return end
	bygg()
	local c = chip
	if not c then return end
	c.Text = txt
	c.Visible = true
	local stroke = c:FindFirstChildOfClass("UIStroke")
	if stroke then stroke.Color = if bra then FARG_BRA else FARG_GULD end
	liveTid = LIVE_CD.visa
	liveSagt = txt
end

function UgnetaController.steg(dt: number)
	if liveTid > 0 then
		liveTid -= dt
		if liveTid <= 0 then
			local c = chip
			if c then c.Visible = false end
			liveSagt = ""
		end
	end
end

--[[ SÄKERHET VINNER. Släcker live-chipet och stänger kortet, så att
	"Bra rytm" aldrig står kvar bredvid en varning. ]]
function UgnetaController.sakerhetTarOver()
	local c = chip
	if c then c.Visible = false end
	local k = kort
	if k then k.Visible = false end
	--[[ SÄKERHET FÖRE UNDERVISNING. Även sidovalen kastas: ett "Se ritten"
	     som överlevde avsittningen hade kunnat öppna en analys av en ritt
	     på en häst som inte finns. ]]
	replayFn = nil
	vidareFn = nil
	local rk = replayKnapp
	if rk then rk.Visible = false end
	local vk = vidareKnapp
	if vk then vk.Visible = false end
	liveTid = 0
	liveSagt = ""
	--[[ SÄKERHET FÖRE UNDERVISNING. En väntande fortsättning får inte
	     överleva ett säkerhetsavbrott: annars kunde ett R-tryck efter
	     avsittningen starta ett försök på en häst som inte finns. ]]
	vantarPa = false
end

--[[ ── Kortet mellan försöken ─────────────────────────────────── ]]
local function visaKort(rubrik: string, punkter: { string }, knapp: boolean,
	knappText: string?, replay: boolean?, vidare: boolean?)
	bygg()
	local k, r = kort, kortRubrik
	if not k or not r then return end
	r.Text = rubrik
	for i, p in kortPunkter do
		local txt = punkter[i]
		p.Text = txt or ""
		p.Visible = txt ~= nil
	end
	local kn = kortKnapp
	if kn then
		kn.Visible = knapp
		if knapp and knappText then kn.Text = medLedtext(knappText) end
	end
	--[[ Sidovalen visas bara när de FINNS. Den som ropar avgör: en övning
	     utan inspelning har ingen ritt att se, och det sista försöket har
	     ingen omridning att hoppa över. ]]
	local rk = replayKnapp
	if rk then rk.Visible = replay == true end
	local vk = vidareKnapp
	if vk then vk.Visible = vidare == true end
	--[[ Kortet väntar exakt när det har en knapp. Ett kort utan knapp är
	     en upplysning, inte ett val. ]]
	vantarPa = knapp
	k.Visible = true
	--[[ Kortet hör till pausen mellan försöken. Går ridningen vidare
		ska det bort — det får aldrig ligga kvar över en aktiv ritt. ]]
	local c = chip
	if c then c.Visible = false end
end

--[[ Kortet, öppet för den som kör lektionen. Presentationen av en övning
	och återkopplingen efter ett försök är samma yta — skillnaden är vad
	som står i den, inte vilken ruta den ritas i. ]]
function UgnetaController.visa(rubrik: string, punkter: { string }, knapp: boolean,
	knappText: string?, replay: boolean?, vidare: boolean?)
	visaKort(rubrik, punkter, knapp, knappText, replay, vidare)
end

function UgnetaController.dolj()
	local k = kort
	if k then k.Visible = false end
	vantarPa = false
end

--[[ Efter ett försök. `fore` är nil på första försöket. Observationerna
	kommer ur HorseCore/Ugneta — samma rangordning som webben. ]]
function UgnetaController.efterForsok(ovningId: string, nu: { [string]: number },
	fore: { [string]: number }?, forsokNr: number, kanSeRitten: boolean?)
	local obs = Ugneta.observationer(ovningId, nu, fore)
	local punkter = {}
	for _, o in obs do
		local ord = DIM_ORD[o.dim] or o.dim
		if o.sort == "battre" then
			table.insert(punkter, `Bättre {ord} den här gången.`)
		elseif o.sort == "kvar" then
			table.insert(punkter, `Fortsätt med {ord}.`)
		elseif o.sort == "bra" then
			table.insert(punkter, `Bra {ord}.`)
		else
			table.insert(punkter, `Jobba på {ord}.`)
		end
	end
	if #punkter == 0 then table.insert(punkter, "Jämnare försök. Behåll samma känsla.") end
	local forsta = fore == nil
	--[[ Kortet har alltid en fortsättning nu. Förut fick bara försök 1 en
	     knapp och försök 2 låg kvar tills timern tog det — spelaren hade
	     inget sätt att säga "klar". ]]
	--[[ "Se ritten" bara när det FINNS en inspelning av försöket, och
	     "Gå vidare" bara efter första försöket — efter det sista är
	     huvudknappen redan vägen vidare. ]]
	visaKort(if forsta then "Prova igen" else `Försök {forsokNr}`, punkter, true,
		if forsta then "Prova igen" else "Nästa övning",
		kanSeRitten == true, forsta)
	return punkter
end

--[[ ── Fortsättningen: spelarens handling ──────────────────────────
	Kortet mellan försöken stänger inte sig självt. Den som kör lektionen
	registrerar vad som ska hända när spelaren väljer att gå vidare. ]]
function UgnetaController.vidFortsatt(fn: (() -> ())?)
	fortsattFn = fn
end

function UgnetaController.vidReplay(fn: (() -> ())?)
	replayFn = fn
end

function UgnetaController.vidVidare(fn: (() -> ())?)
	vidareFn = fn
end

--[[ SE RITTEN. Öppnar analysen och LÄMNAR KVAR väntan — kortet ligger
     bakom panelen och valet är fortfarande spelarens när hon stänger den.
     Returnerar false när det inte finns någon väntan eller ingen ritt att
     visa, så att tangenten faller igenom till sin vanliga betydelse. ]]
function UgnetaController.replay(): boolean
	if not vantarPa then return false end
	local fn = replayFn
	if not fn then return false end
	fn()
	return true
end

--[[ GÅ VIDARE. Avslutar väntan precis som `fortsatt`, men kör den andra
     vägen ut. De två delar vakt med flit: en väntan som kan avslutas på
     två ställen får inte kunna avslutas två gånger — det var så ett
     tidigare utkast räknade samma moment i `bedomda` en gång för mycket. ]]
function UgnetaController.gaVidare(): boolean
	if not vantarPa then return false end
	local fn = vidareFn
	if not fn then return false end
	vantarPa = false
	local k = kort
	if k then k.Visible = false end
	fn()
	return true
end

--[[ Står kortet och väntar på spelaren? ]]
function UgnetaController.vantar(): boolean
	return vantarPa
end

--[[ Spelaren gick vidare. Returnerar false när det inte fanns någon
	väntan att avsluta — så att en tangenttryckning utan kort aldrig kan
	starta ett försök i smyg, och så att init.client kan låta samma
	tangent falla igenom till sin vanliga betydelse. ]]
function UgnetaController.fortsatt(): boolean
	if not vantarPa then return false end
	vantarPa = false
	local k = kort
	if k then k.Visible = false end
	local fn = fortsattFn
	if fn then fn() end
	return true
end

function UgnetaController.start()
	bygg()
end

return UgnetaController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX57">
					<Properties>
						<string name="Name">UgnetaGestalt</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	UGNETA SOM GESTALT — hon står vid sargen, inte bara i ett HUD-kort.

	Blocker 2 i senior review av 09e07da: webben hade fått en igenkännbar
	Ugneta (grått hår, glasögon) men Roblox hade bara lärar-UX:en. Roblox
	är primär spelplattform, och den aktiva produktgaten säger att hon
	ska vara FYSISKT närvarande under lektionen.

	Enkelt och i husets stil: samma primitiver som resten av anläggningen
	bygger med (Part, SmoothPlastic, meter × 3 studs). Ingen ny art
	direction, ingen karaktärsrigg, inget hopp i detaljnivå.

	PLATSEN LÄSES UR DET BYGGDA, INTE UR EN ANDRA MODELL. Punkten kommer
	ur RidKanon.UGNETA.PLATS — samma tal som webbens `ugnetaPlats()` — och
	löses upp mot de delar som faktiskt står i workspace ("Ridbanan" och
	"Sarg syd"). Läktarlärdomen (#114) var att rendering och logik inte
	får ha var sin uppfattning om var något står; att räkna om ridhusets
	origo här hade varit exakt det felet igen.

	[antagande] Att UBRF:s instruktör står just vid C är inte belagt i
	referensmaterialet — se motiveringen i src/larare.js. Ytan finns
	verifierat: den fysiska ridytan fortsätter 5,5 m bortom
	dressyrlayoutens C-linje, så hon står på golv som är mätt, inte på
	golv som är hittat på.
]]

local RidKanon = require(game:GetService("ReplicatedStorage").HorseCore.RidKanon)

local UgnetaGestalt = {}

local M = 3                              -- studs per meter, som BuildKit
local function studs(m: number): number return m * M end

--[[ Färgerna är webbfigurens, så hon är samma person på båda ytorna. ]]
local KAVAJ   = Color3.fromRGB(75, 90, 82)
local ANSIKTE = Color3.fromRGB(226, 192, 162)
local HAR     = Color3.fromRGB(201, 205, 210)   -- grått
local GLAS    = Color3.fromRGB(43, 46, 52)

local modell: Model? = nil

local function del(mor: Model, namn: string, storlek: Vector3, pos: Vector3,
	farg: Color3): Part
	local p = Instance.new("Part")
	p.Name = namn
	p.Anchored = true
	p.CanCollide = false                  -- hon ska aldrig stoppa en häst
	p.Size = storlek
	p.CFrame = CFrame.new(pos)
	p.Color = farg
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = mor
	return p
end

--[[ VAR STÅR HON? Räknas ur de byggda delarna:

	  "Ridbanan"  ger banans mitt och mått,
	  "Sarg syd"  ger A-änden, och därmed VILKET håll som är C.

	Utan den andra delen hade tecknet på längdaxeln varit en gissning om
	hur ridhuset råkar vara vridet i världen. Nu kommer riktningen ur
	geometrin själv. ]]
export type Plats = { pos: Vector3, motC: Vector3 }

function UgnetaGestalt.plats(ridhus: Instance?): Plats?
	if not ridhus then return nil end
	--[[ Grunt uppslag: BuildKit.box hänger delarna direkt under byggnadens
	     Model, så det är där de står. En rekursiv sökning hade letat efter
	     en struktur produktionen inte har. ]]
	local bana = ridhus:FindFirstChild("Ridbanan")
	local syd = ridhus:FindFirstChild("Sarg syd")
	if not bana or not syd then return nil end
	local b = bana :: BasePart
	local a = syd :: BasePart
	local langs = b.Position - a.Position
	if langs.Magnitude < 1e-3 then return nil end
	local motC = langs.Unit                     -- från A mot C

	local P = RidKanon.UGNETA.PLATS
	--[[ Dressyrlayouten är förankrad i A och `P.langd` meter lång; hon står
	     `P.bortomC` meter bortom dess C-linje. Den fysiska ridytan
	     fortsätter förbi den linjen, vilket är just varför punkten finns
	     i huset — se modulhuvudet. ]]
	local fot = a.Position + motC * studs(P.langd + P.bortomC)
	--[[ Höjd: sandens överkant, så hon står PÅ golvet i stället för i det. ]]
	local golv = b.Position.Y + b.Size.Y / 2
	return { pos = Vector3.new(fot.X, golv, fot.Z), motC = motC }
end

--[[ Bygger gestalten. Måtten är webbfigurens (src/scen3d.js: kavaj som
	klot 0,20 × 0,33 × 0,18 m, ansikte r 0,132, hår strax ovanför,
	glasögonbågar fram) omsatta till lådor och klot i husets stil. ]]
function UgnetaGestalt.visa(ridhus: Instance?): Model?
	local plats = UgnetaGestalt.plats(ridhus)
	if not plats then return nil end
	UgnetaGestalt.dolj()
	local m = Instance.new("Model")
	m.Name = "Ugneta"
	m:SetAttribute("Roll", "ridinstruktor")
	m:SetAttribute("Fidelity", "ANTAGANDE")
	m.Parent = workspace

	local p = plats.pos
	--[[ Hon tittar mot A, dit ekipaget rider — alltså är ansiktets
	     framsida -motC. Riktningen räknas ur geometrin, inte ur en
	     CFrames LookVector: vektormatematiken är densamma i Studio och i
	     bänken, och platsen är just det ett prov ska kunna mäta. ]]
	local fram = -plats.motC
	local function vid(dy: number) return Vector3.new(p.X, p.Y + studs(dy), p.Z) end

	del(m, "Kavaj", Vector3.new(studs(0.40), studs(0.66), studs(0.36)),
		vid(0.55), KAVAJ)
	del(m, "Ansikte", Vector3.new(studs(0.26), studs(0.26), studs(0.26)),
		vid(0.99), ANSIKTE)
	--[[ GRÅTT HÅR OCH GLASÖGON är hela igenkänningen. Utan dem är hon en
	     figur i kavaj, vilket var precis vad blockern gällde. ]]
	del(m, "Grått hår", Vector3.new(studs(0.30), studs(0.23), studs(0.30)),
		vid(1.045), HAR)
	del(m, "Glasögon", Vector3.new(studs(0.24), studs(0.05), studs(0.03)),
		vid(0.985) + fram * studs(0.12), GLAS)

	m.PrimaryPart = m:FindFirstChild("Kavaj") :: BasePart?
	modell = m
	return m
end

function UgnetaGestalt.dolj()
	if modell then
		modell:Destroy()
		modell = nil
	end
end

function UgnetaGestalt.finns(): boolean
	return modell ~= nil
end

return UgnetaGestalt
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
</roblox>
