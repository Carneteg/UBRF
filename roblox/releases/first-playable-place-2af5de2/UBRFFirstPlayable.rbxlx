				typ = "ben",
			},
		},
		redskap = {
			{
				id = "skrapa",
				namn = "Gummiskrapa",
				kort = "cirklar",
				farg = Color3.fromRGB(127, 180, 137),
				text = "Cirklar på musklerna. Aldrig över ben eller huvud.",
			},
			{
