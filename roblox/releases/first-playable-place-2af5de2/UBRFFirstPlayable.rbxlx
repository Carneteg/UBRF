RidKanon.SVAR_FALT = { "balans", "energi", "fokus", "mjukhet", "paradAlder", "paradKvalitet", "spanning", "svarAlder", "svarstid" }

--[[ HÄSTENS SVAR (G02-B punkt 2, src/riding/svar.js).

