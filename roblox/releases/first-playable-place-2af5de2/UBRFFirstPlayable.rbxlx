				namn = "Kardborste",
				kort = "korta drag",
				farg = Color3.fromRGB(214, 174, 60),
				text = "Korta drag med hårets riktning — bakåt.",
			},
			{
				id = "mjuk",
				namn = "Mjuk borste",
				kort = "långa drag",
				farg = Color3.fromRGB(191, 212, 222),
				text = "Långa drag, hela kroppen och benen.",
			},
		},
		krav = {
			kropp = {
				"skrapa",
