			<Item class="ModuleScript" referent="RBX13">
				<Properties>
					<string name="Name">RigAdapter</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Riggadaptern — den enda plats som vet hur en hästmodell ser ut inuti.

	All annan kod tar emot en Rig och rör aldrig modellen direkt. Det är
	det som gör att hästmodellen går att byta utan att ridlogiken skrivs om.

	Adaptern kräver INTE att en köpt modell döps om. Varje sökt namn kan
	pekas om med ett attribut på modellen, t.ex.

	    Map_Saddle       = "SeatPart"
	    Map_HumanoidRoot = "Body"
	    Map_Head         = "Bone_Head_01"

	Hittas inget alls gissar den på klass och position i stället, och
	rapporterar vad den gissade. Det som saknas rapporteras som fel med
	namn — systemet ska aldrig halvfungera tyst.
]]

local Types = require(script.Parent.Types)

local RigAdapter = {}

--[[ Attachment-punkter. Alla frivilliga utom Saddle. ]]
local ATTACHMENTS = {
	"RiderSeat", "SaddleAttachment", "Saddle",
	"LeftReinAttachment", "RightReinAttachment",
	"LeftStirrupAttachment", "RightStirrupAttachment",
	"LeadRope", "HoofFL", "HoofFR", "HoofRL", "HoofRR",
}

--[[ Ben som koden får röra procedurellt. Alla frivilliga — animationen
     bär rörelsen, de här är bara till för blick, öron och svans. Saknas
     de tappar man polish, inget mer. ]]
local BONES = {
	"Root", "Pelvis", "Spine01", "Spine02", "Chest",
	"Neck01", "Neck02", "Head", "Jaw",
	"TailBase", "Tail01", "Tail02", "Tail03",
	"Mane01", "Mane02", "Mane03", "LeftEar", "RightEar",
}

--[[ Namnet att leta efter: attributet Map_<nyckel> vinner, annars nyckeln. ]]
local function mapped(model: Model, key: string): string
	local override = model:GetAttribute("Map_" .. key)
	if typeof(override) == "string" and override ~= "" then
		return override
	end
	return key
end

local function findByName(model: Model, key: string): Instance?
	return model:FindFirstChild(mapped(model, key), true)
end

--[[ Kroppens kollisionsdel. Aldrig nätet självt: ett skinnat nät har en
     hölje-hitbox som ändrar form med animationen, och då studsar hästen
     mot marken när benen rör sig. ]]
local function resolveRoot(model: Model): BasePart?
	--[[ `HumanoidRootPart` FÖRST: det är namnet Roblox själv binder
	     `Humanoid.RootPart` till, och sedan #162:s locomotion-P0 är det
	     också namnet `HastRigg` bygger. `BodyCollider` ligger kvar för
	     externt byggda riggar som följer HORSE-MODEL-SPEC:s äldre namn. ]]
	for _, key in { "HumanoidRootPart", "BodyCollider", "Root" } do
		local found = findByName(model, key)
		if found and found:IsA("BasePart") then
			return found
		end
	end
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	-- Sista utväg: största delen som inte är ett skinnat nät.
	local best, bestVolume = nil, 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and not (d:IsA("MeshPart") and #d:GetChildren() > 0) then
			local v = d.Size.X * d.Size.Y * d.Size.Z
			if v > bestVolume then best, bestVolume = d, v end
		end
	end
	return best
end

--[[ Bygger en Rig ur en hästmodell. Returnerar nil + skäl om något
     obligatoriskt saknas. ]]
function RigAdapter.build(model: Model): (Types.Rig?, string?)
	if not model:IsA("Model") then
		return nil, "Hästen måste vara en Model"
	end

	local root = resolveRoot(model)
	if not root then
		return nil, "Hittar ingen kroppsdel att räkna som rot. Döp en osynlig "
			.. "låda till BodyCollider, eller sätt Map_BodyCollider på modellen."
	end
	if model.PrimaryPart == nil then
		model.PrimaryPart = root
	end

	--[[ Humanoid ger markkontakt, lutning, trappor och hopp gratis och är
	     därför standardvägen. AnimationController fungerar för animationer
	     men kräver egen fysik, som det här systemet inte levererar. ]]
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local controller = model:FindFirstChildOfClass("AnimationController")
	local host: Instance? = humanoid or controller
	if not host then
		return nil, "Saknar Humanoid (rekommenderat) eller AnimationController"
	end

	local animator = host:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = host
	end

	local attachments: { [string]: Attachment } = {}
	for _, key in ATTACHMENTS do
		local found = findByName(model, key)
		if found and found:IsA("Attachment") then
			attachments[key] = found
		end
	end
	-- Saddle och SaddleAttachment är samma sak; låt båda namnen fungera.
	attachments.Saddle = attachments.Saddle or attachments.SaddleAttachment or attachments.RiderSeat

	local bones: { [string]: Bone } = {}
	for _, key in BONES do
		local found = findByName(model, key)
		if found and found:IsA("Bone") then
			bones[key] = found
		end
	end

	local seatInstance = findByName(model, "RiderSeat")
	local seat: Seat? = if seatInstance and seatInstance:IsA("Seat") then seatInstance else nil

	local rootJoint = findByName(model, "RootJoint")
	local riderJoint = findByName(model, "RiderJoint")

	return {
		model = model,
		root = root,
		animator = animator :: Animator,
		humanoid = humanoid,
		controller = controller,
		rootJoint = if rootJoint and rootJoint:IsA("Motor6D") then rootJoint else nil,
		riderJoint = if riderJoint and riderJoint:IsA("Motor6D") then riderJoint else nil,
		seat = seat,
		attachments = attachments,
		bones = bones,
		stats = findByName(model, "HorseStats") :: Configuration?,
		gaitConfig = findByName(model, "GaitConfig") :: Configuration?,
		animConfig = findByName(model, "AnimationConfig") :: Configuration?,
	}, nil
end

--[[ Vad adaptern faktiskt hittade — för /horsedebug och för felsökning när
     en inköpt modell har egna namn. ]]
function RigAdapter.describe(rig: Types.Rig): string
	local a, b = {}, {}
	for name in rig.attachments do table.insert(a, name) end
	for name in rig.bones do table.insert(b, name) end
	table.sort(a); table.sort(b)
	return ("rot=%s  fysik=%s  attachments=[%s]  ben=[%s]"):format(
		rig.root.Name,
		if rig.humanoid then "Humanoid" else "AnimationController",
		table.concat(a, ", "),
		table.concat(b, ", "))
end

--[[ Kroppens lutning — rollen i svängar och nickningen i backar — läggs på
     leden mellan roten och det synliga nätet, aldrig på roten själv. Lutar
     man roten lutar också kollisionen, och markkontakten börjar bråka.
     Saknas leden hoppas lutningen över; hästen rider fortfarande, den lutar
     bara inte. Det är rätt sorts degradering: polish försvinner, spel inte. ]]
function RigAdapter.setBodyTilt(rig: Types.Rig, roll: number, pitch: number)
	local joint = rig.rootJoint
	if not joint then return end
	local base = joint:GetAttribute("BaseC0")
	if base == nil then
		joint:SetAttribute("BaseC0", joint.C0)
		base = joint.C0
	end
	joint.C0 = (base :: CFrame) * CFrame.Angles(pitch, 0, -roll)
end

--[[ Ryttarens sekundärrörelse. Samma mönster som setBodyTilt: en
     bas-CFrame sparas första gången och offseten läggs ovanpå, så att
     sitsanimationen aldrig skrivs över utan bara vinklas.

     Sätet är den led ryttaren sitter i. Saknas den händer ingenting —
     ryttaren sitter kvar i sin vanliga pose, vilket är rätt sorts
     degradering: en saknad led ska inte kunna krascha ridningen. ]]
function RigAdapter.setRiderLean(rig: Types.Rig, roll: number, pitch: number)
	--[[ #162: den här funktionen läste och skrev `rig.seat.C0`. `rig.seat`
	     är en Roblox `Seat` — en BasePart, som inte har någon `C0`. Mot en
	     riktig rigg hade raden kastat på FÖRSTA ridbildrutan, och `release()`
	     hade kastat igen.

	     Att det aldrig syntes har en obehaglig orsak: `rider.spec` stubbade
	     `rig.seat` som en LED med `C0`. Testet var alltså byggt efter den
	     buggiga koden i stället för efter Roblox API, och blev grönt på ett
	     fel som gjorde ridningen omöjlig. Att ingen rigg fanns i placen
	     gjorde att ingen körning kunde motbevisa det.

	     Lutningen ligger nu på en egen `Motor6D` (`RiderJoint`), precis som
	     kroppslutningen ligger på `RootJoint`. Saknas leden hoppas
	     lutningen över — samma degradering som `setBodyTilt`: polish
	     försvinner, spel inte. Sätet rörs inte. ]]
	local joint = rig.riderJoint
	if not joint then return end
	local base = joint:GetAttribute("BaseRiderC0")
	if base == nil then
		joint:SetAttribute("BaseRiderC0", joint.C0)
		base = joint.C0
	end
	joint.C0 = (base :: CFrame) * CFrame.Angles(pitch, 0, -roll)
end

--[[ Procedurell påbyggnad ovanpå animationen: huvudet vrids något mot
     svängen, svansen följer farten. Skrivs efter att animationen har
     uppdaterat benen, annars skriver klippet över den. Aldrig så mycket
     att den tar över — det här är krydda, inte rörelse. ]]
function RigAdapter.setBoneOffset(rig: Types.Rig, name: string, offset: CFrame)
	local bone = rig.bones[name]
	if not bone then return end
	local base = bone:GetAttribute("BaseTransform")
	if base == nil then
		bone:SetAttribute("BaseTransform", bone.Transform)
		base = bone.Transform
	end
	bone.Transform = (base :: CFrame) * offset
end

function RigAdapter.saddleCFrame(rig: Types.Rig): CFrame
	local a = rig.attachments.Saddle
	if a then return a.WorldCFrame end
	if rig.seat then return rig.seat.CFrame end
	return rig.root.CFrame * CFrame.new(0, 1.6, 0)
end

return RigAdapter
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX14">
				<Properties>
					<string name="Name">Sparning</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[ SPARNINGEN — vad som får överleva att spelaren stänger klienten.

	Ren logik. Ingen `DataStoreService` här inne, ingen `Player`, ingen
	pcall. Samma val som `Preparation.luau` och `Stallet.luau` gör, och av
	samma skäl: schemat, migrationen och idempotensen ÄR reglerna, och
	regler ska gå att fälla i bänken utan att någon startar en Roblox-server
	med ett riktigt datalager. `SparService.luau` äger nyckeln, nätet,
	retryn och felen.

	── VAD SOM SPARAS ───────────────────────────────────────────────

	Bara det som behövs för att återuppta rätt, enligt #161:

	  · `pass`        antal AVSLUTADE pass — spelarens progression,
	  · `passId`      kvitton, för att samma pass aldrig ska räknas två gånger,
	  · `forstaDagen` om första dagen är avklarad och på vilken häst,
	  · `hastar`      hästminnet: relation och aktiv skada/vila.

	Och inget annat. Ingen input, ingen kamera, ingen replaypanel, ingen
	tillfällig UI-state. Det är inte en storleksfråga — det är att en
	sparfil som bär presentationslager blir omöjlig att migrera den dag
	presentationen ändras.

	── HÄSTMINNETS FORM ÄR INTE VALD HÄR ────────────────────────────

	`hastar[id] = { skada = { passKvar = n } }` är EXAKT den form
	`Stallet.vilandeHastar` redan läser (PR #154), som i sin tur är webbens
	form i `src/ryttare.js`. Att välja en egen form här och konvertera i
	`StallService` hade varit en tredje sanning om samma sak.

	── VERSIONEN ────────────────────────────────────────────────────

	`v` finns för att schemat SKA kunna ändras. Två fall, och de är olika:

	  · äldre `v` → `migrera` fyller i det som saknas och lämnar resten,
	  · nyare `v` → vi förstår den inte. Då returneras en tom save MED
	    flaggan `framtida`, och `SparService` vägrar skriva över. Att i
	    stället starta om från noll hade raderat en spelares framsteg för
	    att servern var gammal.

	Ett trasigt värde ger aldrig gratis progression: `migrera` faller alltid
	tillbaka till NOLL pass, aldrig till "alla pass klara".
]]

local Sparning = {}

Sparning.VERSION = 1

--[[ Taken finns för att en sparfil inte ska kunna växa obegränsat. Ett
	kvitto per pass, och de äldsta faller av först. 200 pass är långt bortom
	vad ett familjespel hinner, och en DataStore-nyckel har 4 MB. ]]
local MAX_KVITTON = 200

export type Skada = {
	passKvar: number,
	vad: string?,
}

export type Hastminne = {
	relation: number,
	skada: Skada?,
}

export type Save = {
	v: number,
	--[[ REVISIONEN. Monoton räknare som ökar vid varje lyckad skrivning,
		och som är HELT skild från `v`: `v` är schemaversionen, `rev` är
		"hur många gånger den här sparfilen har skrivits".

		Den finns för omreviewens fynd 1 (#162). Sammanslagningen i
		`SparService.skriv` behöll den LÄNGSTA vilan, så en nedräkning från
		2 till 1 aldrig gick fram — lagrets 2 vann över minnets 1, och en
		häst kunde vila för evigt. Att bara byta `>` mot `<` hade bytt buggen
		mot dess spegelbild: en gammal server hade då kunnat korta en färsk
		skada.

		Med `rev` behövs ingen sådan gissning. Servern jämför den rad som
		ligger i lagret med den den själv läste: är lagret NYARE har någon
		annan skrivit, och då avbryts skrivningen i stället för att slås
		ihop. Är den inte nyare är den här sessionen den enda som ändrat
		något sedan läsningen, och då äger minnet vilan. ]]
	rev: number,
	pass: number,
	passId: { [string]: number },
	forstaDagen: { klar: boolean, hastId: string? },
	hastar: { [string]: Hastminne },
}

function Sparning.tom(): Save
	return {
		v = Sparning.VERSION,
		rev = 0,
		pass = 0,
		passId = {},
		forstaDagen = { klar = false, hastId = nil },
		hastar = {},
	}
end

local function tal(v: any, standard: number): number
	local n = tonumber(v)
	if n == nil or n ~= n then return standard end
	return n
end

--[[ Läser en rad ur datalagret och gör den till en Save vi litar på.

	Returnerar (save, anmarkning). `anmarkning` är nil när allt var i
	ordning, annars ett av:

	  "tom"       ingen tidigare save — ny spelare,
	  "trasig"    raden fanns men gick inte att läsa som en save,
	  "framtida"  raden är skriven av en NYARE version än den här servern.

	Anropen får aldrig strunta i `anmarkning`. "framtida" betyder att
	servern ska köra sessionen men INTE spara — se filhuvudet. ]]
function Sparning.migrera(rad: any): (Save, string?)
	if rad == nil then
		return Sparning.tom(), "tom"
	end
	if type(rad) ~= "table" then
		return Sparning.tom(), "trasig"
	end

	local v = tal(rad.v, 0)
	if v > Sparning.VERSION then
		return Sparning.tom(), "spar.framtida_sparfil"
	end
	if v < 1 then
		--[[ En tabell utan igenkännbar version. Den kan vara en tidig
			handskriven rad eller skräp; vi vet inte, och att gissa åt en
			spelares fördel är precis den fail-open vi inte får ha. ]]
		return Sparning.tom(), "trasig"
	end

	local ut = Sparning.tom()
	--[[ Revisionen läses med 0 som standard, så rader skrivna före #162
		går in som rev 0 och nästa skrivning blir rev 1. Ingen migrering
		behövs; en saknad räknare ÄR noll skrivningar. ]]
	ut.rev = math.max(0, math.floor(tal(rad.rev, 0)))
	ut.pass = math.max(0, math.floor(tal(rad.pass, 0)))

	if type(rad.passId) == "table" then
		for id, nar in pairs(rad.passId) do
			if type(id) == "string" then
				ut.passId[id] = math.floor(tal(nar, 0))
			end
		end
	end

	if type(rad.forstaDagen) == "table" then
		ut.forstaDagen.klar = rad.forstaDagen.klar == true
		if type(rad.forstaDagen.hastId) == "string" then
			ut.forstaDagen.hastId = rad.forstaDagen.hastId
		end
	end

	if type(rad.hastar) == "table" then
		for id, m in pairs(rad.hastar) do
			if type(id) == "string" and type(m) == "table" then
				local minne: Hastminne = {
					relation = math.clamp(tal(m.relation, 0), 0, 1),
					skada = nil,
				}
				if type(m.skada) == "table" then
					local kvar = math.floor(tal(m.skada.passKvar, 0))
					--[[ Bara en LEVANDE skada bärs vidare. En utläkt
						(`passKvar <= 0`) skrivs inte tillbaka, så att
						sparfilen inte samlar på sig gamla krämpor. ]]
					if kvar > 0 then
						minne.skada = {
							passKvar = kvar,
							vad = if type(m.skada.vad) == "string" then m.skada.vad else nil,
						}
					end
				end
				ut.hastar[id] = minne
			end
		end
	end

	ut.v = Sparning.VERSION
	return ut, nil
end

--[[ ── PASSEN ──────────────────────────────────────────────────────

	`registreraPass` är idempotent, och det är hela dess uppgift.

	Ett avslutat pass kan nå servern mer än en gång: klienten kan skicka om,
	`PlayerRemoving` kan komma ovanpå ett avslut som redan sparats, och en
	retry efter ett DataStore-fel kan lyckas efter att det första försöket
	i själva verket gick fram. Utan ett kvitto blir varje sådan gång ett
	pass till, och progressionen skulle gå att pumpa genom att koppla ned.

	Nyckeln är `passId`, som sätts EN gång när passet börjar (se
	`Pass.luau`). Räknas den om vid avslutet blir varje försök ett nytt id
	och kvittot värdelöst. ]]
function Sparning.harPass(save: Save, passId: string): boolean
	return type(passId) == "string" and save.passId[passId] ~= nil
end

--[[ Returnerar true om passet var NYTT och räknades, false om det redan
	fanns. Ingen av grenarna är ett fel — den andra är precis det skydd
	funktionen finns för. ]]
function Sparning.registreraPass(save: Save, passId: string, nar: number?): boolean
	if type(passId) ~= "string" or passId == "" then return false end
	if save.passId[passId] ~= nil then return false end
	save.passId[passId] = math.floor(tal(nar, 0))
	save.pass += 1

	--[[ Rensa de äldsta kvittona när de blir för många. Ordningen är
		tidsstämpeln; kvitton utan tid (0) faller först, och det är rätt
		ordning — de är från en gammal skrivning. ]]
	local antal = 0
	for _ in pairs(save.passId) do antal += 1 end
	if antal > MAX_KVITTON then
		local lista = {}
		for id, t in pairs(save.passId) do table.insert(lista, { id = id, t = t }) end
		table.sort(lista, function(a, b)
			if a.t == b.t then return a.id < b.id end
			return a.t < b.t
		end)
		for i = 1, antal - MAX_KVITTON do
			save.passId[lista[i].id] = nil
		end
	end
	return true
end

--[[ ── HÄSTMINNET ──────────────────────────────────────────────────── ]]

function Sparning.hastminne(save: Save, hastId: string): Hastminne
	local m = save.hastar[hastId]
	if not m then
		m = { relation = 0, skada = nil }
		save.hastar[hastId] = m
	end
	return m
end

--[[ Formen `Stallet.vilandeHastar` läser. Returneras direkt ur sparfilen
	utan konvertering — se filhuvudet om varför den formen inte väljs här. ]]
function Sparning.hastminnen(save: Save): { [string]: Hastminne }
	return save.hastar
end

function Sparning.vilar(save: Save, hastId: string): boolean
	local m = save.hastar[hastId]
	return m ~= nil and m.skada ~= nil and m.skada.passKvar > 0
end

--[[ Sätter en skada. Höjer ALDRIG hälsan: en ny skada på en häst som redan
	vilar förlänger vilan, den ersätter den inte med ett kortare tal.

	Det är samma hål som PR #154 stängde på webben, fast i andra änden.
	Där gjorde `delete ny.skada` hästen frisk av att ha arbetat; här skulle
	ett `passKvar = 1` ovanpå ett `passKvar = 4` göra henne nästan frisk av
	att bli skadad igen. ]]
function Sparning.satSkada(save: Save, hastId: string, passKvar: number, vad: string?)
	local kvar = math.max(0, math.floor(tal(passKvar, 0)))
	if kvar <= 0 then return end
	local m = Sparning.hastminne(save, hastId)
	if m.skada and m.skada.passKvar >= kvar then
		--[[ Redan minst så länge. Uppdatera bara beskrivningen om vi fick
			en ny; talet rörs inte. ]]
		if vad then m.skada.vad = vad end
		return
	end
	m.skada = { passKvar = kvar, vad = vad }
end

--[[ Ett pass har gått. Vilan räknas ner för ALLA hästar med en aktiv skada.

	VIKTIGT: nedräkningen hänger på att TID GÅTT, inte på att den skadade
	hästen arbetat. Hade den hängt på arbetet vore vilan självupphävande —
	att rida en halt häst skulle göra henne frisk — och det är exakt den
	buggen #154 hittade i webbens `delete ny.skada`. En häst som vilar går
	inte att tilldela (`Stallet.vilandeHastar`), så hon KAN inte arbeta av
	sig frisk här. ]]
function Sparning.raknaNerVila(save: Save)
	for _, m in pairs(save.hastar) do
		if m.skada then
			m.skada.passKvar -= 1
			if m.skada.passKvar <= 0 then
				m.skada = nil
			end
		end
	end
end

function Sparning.hojRelation(save: Save, hastId: string, delta: number)
	local m = Sparning.hastminne(save, hastId)
	m.relation = math.clamp(m.relation + tal(delta, 0), 0, 1)
end

--[[ ── FÖRSTA DAGEN ───────────────────────────────────────────────── ]]

function Sparning.forstaDagen(save: Save): boolean
	return save.forstaDagen.klar ~= true
end

function Sparning.markeraForstaDagen(save: Save, hastId: string)
	if save.forstaDagen.klar then return end
	save.forstaDagen.klar = true
	save.forstaDagen.hastId = hastId
end

--[[ Passnumret för det pass som just NU pågår — alltså avslutade pass plus
	ett. `Preparation.nyState` behöver det för att veta om dagen är första
	dagen (som alltid är fri från fynd). ]]
function Sparning.aktuelltPass(save: Save): number
	return save.pass + 1
end

--[[ ── UT TILL DATALAGRET ──────────────────────────────────────────

	En ren tabell utan metatabeller och utan funktioner. DataStore
	serialiserar inte annat, och en save som tyst tappar ett fält vid
	skrivning är svårare att upptäcka än en som vägrar. ]]
function Sparning.tillRad(save: Save): any
	local hastar = {}
	for id, m in pairs(save.hastar) do
		local rad: any = { relation = m.relation }
		if m.skada and m.skada.passKvar > 0 then
			rad.skada = { passKvar = m.skada.passKvar, vad = m.skada.vad }
		end
		hastar[id] = rad
	end
	local passId = {}
	for id, t in pairs(save.passId) do passId[id] = t end
	return {
		v = save.v,
		rev = save.rev,
		pass = save.pass,
		passId = passId,
		forstaDagen = { klar = save.forstaDagen.klar, hastId = save.forstaDagen.hastId },
		hastar = hastar,
	}
end

return Sparning
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX15">
				<Properties>
					<string name="Name">Sprak</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	SPRÅKET — spelarens text, svenska eller engelska, ur en källa.

	Produktkravet i #162: svenska för svenska spelare, engelska annars, och
	ingen hårdkodad spelartext i logiken. Den här modulen är UPPSLAGET;
	texten själv ligger i `ReplicatedStorage.UBRFSprak`, som genereras ur
	`src/spel/sprak.js` — samma källa som webben läser. Skälet är detsamma
	som för hästdatan: en spelare som byter plattform ska läsa samma ord.

	REGELN, på ett ställe: en locale som börjar på `sv` ger svenska, allt
	annat ger engelska. Roblox svarar med strängar som `sv-se` och `en-us`;
	`sprakFor` bryr sig bara om de två första tecknen, så `sv-fi` läser
	också svenska.

	FALLBACKEN ÄR SVENSKA, INTE TOMHET. Saknas en engelsk text visas den
	svenska — och `saknade("en")` räknar dem, så en lucka syns i grinden i
	stället för att bli ett tomt HUD-fält hos spelaren. Det finns dessutom
	en redovisad översättningsskuld: hästarnas verkliga beskrivningar och
	skötselkanonens undervisande text är svenska och får inte
	maskinöversättas av en builder (se `Sprak.backlog`).

	KLIENTEN översätter. Servern äger reglerna och skickar nycklar där den
	kan; texten sätts där spelarens locale är känd. Anropas modulen på
	servern utan spelare faller den tillbaka på serverns egen locale, och
	det är en medveten degradering: en logg får bli engelsk, en HUD får
	inte bli fel.
]]

local RS = game:GetService("ReplicatedStorage")

local Sprak = {}

--[[ Texttabellen laddas LAT och i två steg, och båda stegen har ett skäl:

	  · `require(RS.UBRFSprak)` är den snabba vägen och den enda formen
	    testbänken kan foga ihop (build.py skriver om just det uttrycket
	    till modulnamnet). Indexeringen kan kasta på en klient som hunnit
	    starta före replikeringen.
	  · `WaitForChild` är då den riktiga vägen, och den blockerar bara den
	    första gången.

	Faller båda blir tabellen tom, och varje uppslag svarar med sin nyckel.
	Det är avsiktligt fult: en HUD som visar `hud.du_rider` säger att
	texttabellen inte kom med i bygget, medan ett tomt fält inte säger
	någonting alls. ]]
local data: any = nil
local function tabell(): any
	if data then return data end
	local ok, modul = pcall(function()
		return require(RS.UBRFSprak)
	end)
	if not ok then
		ok, modul = pcall(function()
			return require((RS :: any):WaitForChild("UBRFSprak"))
		end)
	end
	data = if ok and type(modul) == "table" then modul else { text = {}, backlog = {} }
	return data
end

--[[ Språkvalet ur en locale-sträng. Samma regel som webbens `sprakFor`. ]]
function Sprak.sprakFor(localeId: string?): string
	local kod = string.lower(tostring(localeId or ""))
	return if string.sub(kod, 1, 2) == "sv" then "sv" else "en"
end

--[[ Spelarens språk. `player.LocaleId` är spelarens EGET val i Roblox och
	finns på både klient och server, vilket är det som gör att servern kan
	svara rätt spelare på rätt språk när den måste. ]]
function Sprak.sprakForSpelare(player: Player?): string
	if player then
		local ok, locale = pcall(function() return (player :: any).LocaleId end)
		if ok and type(locale) == "string" and locale ~= "" then
			return Sprak.sprakFor(locale)
		end
	end
	return Sprak.sprakFor(Sprak._locale)
end

--[[ Klientens eget språk, ur `LocalizationService`. Läses en gång och
	sparas: den ändras inte mitt i en session. ]]
local eget: string? = nil
function Sprak.eget(): string
	if eget then return eget end
	if Sprak._locale then
		eget = Sprak.sprakFor(Sprak._locale)
		return eget
	end
	local ok, locale = pcall(function()
		return game:GetService("LocalizationService").RobloxLocaleId
	end)
	eget = Sprak.sprakFor(if ok then locale else "sv-se")
	return eget
end

--[[ Provkrok OCH felsökningsknapp: sätter locale rakt. Grinden kör hela
	HUD:en på `sv-se` och `en-us` med den, och utan en sådan väg vore
	kravet oprövbart utanför två olika Roblox-konton. ]]
function Sprak.satLocale(localeId: string?)
	Sprak._locale = localeId
	eget = nil
end

--[[ Slår upp och formaterar. Okänd nyckel returnerar NYCKELN, inte tom
	sträng: ett stavfel ska synas som `hud.gor_i_ordnign` i HUD:en och i
	grinden, inte som ett tomt fält. ]]
function Sprak.iSprak(sprak: string, nyckel: string, ...): string
	local post = tabell().text[nyckel]
	if not post then return nyckel end
	local text = post[sprak] or post.sv or nyckel
	if select("#", ...) > 0 then
		local ok, formaterad = pcall(string.format, text, ...)
		if ok then return formaterad end
	end
	return text
end

--[[ Kortformen klienten använder: spelarens eget språk. ]]
function Sprak.t(nyckel: string, ...): string
	return Sprak.iSprak(Sprak.eget(), nyckel, ...)
end

--[[ Serverns form när den vet vem den talar till. ]]
function Sprak.forSpelare(player: Player?, nyckel: string, ...): string
	return Sprak.iSprak(Sprak.sprakForSpelare(player), nyckel, ...)
end

function Sprak.finns(nyckel: string): boolean
	return tabell().text[nyckel] ~= nil
end

function Sprak.nycklar(): { string }
	local ut = {}
	for nyckel in pairs(tabell().text) do table.insert(ut, nyckel) end
	table.sort(ut)
	return ut
end

--[[ Nycklar som saknar text i ett språk. Grinden kräver noll. ]]
function Sprak.saknade(sprak: string): { string }
	local ut = {}
	for nyckel, post in pairs(tabell().text) do
		local text = post[sprak]
		if type(text) ~= "string" or text == "" then table.insert(ut, nyckel) end
	end
	table.sort(ut)
	return ut
end

function Sprak.backlog(): any
	return tabell().backlog or {}
end

return Sprak
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX16">
				<Properties>
					<string name="Name">StateMachine</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Tillståndsmaskinen.

	Skild från rörelsen med flit: den här modulen räknar aldrig fysik och
	rör aldrig en Instance. Den tar tempo, mark och avsikt in, och ger ett
	tillstånd ut. Det gör den testbar utan att spelet körs, och det gör att
	animationslagret kan lita på ett enda fält i stället för att gissa ur
	hastighetsvektorer.
]]

local Gaits = require(script.Parent.Gaits)

local StateMachine = {}
StateMachine.__index = StateMachine

export type State =
	"Idle" | "Walk" | "Trot" | "Canter" | "Gallop"
	| "Jump" | "Landing" | "Stopping" | "BackingUp" | "TurningInPlace"

local GAIT_STATE: { [string]: State } = {
	halt = "Idle", walk = "Walk", trot = "Trot",
	canter = "Canter", gallop = "Gallop",
}

--[[ Hur länge ett övergångstillstånd hålls kvar även om villkoret släpper.
     Utan dem blinkar Landing förbi på en bildruta och syns aldrig. ]]
local MIN_HOLD: { [string]: number } = {
	Jump = 0.10, Landing = 0.28, Stopping = 0.35, TurningInPlace = 0.20,
}

function StateMachine.new()
	return setmetatable({
		state = "Idle" :: State,
		gait = "halt",
		_held = 0,
		_wasAirborne = false,
	}, StateMachine)
end

export type Input = {
	speed: number,        -- m/s framåt, negativ vid backning
	turnRate: number,     -- rad/s
	airborne: boolean,
	braking: boolean,     -- ryttaren begär stopp
	jumpFired: boolean,
	gait: string?,        -- den FAKTISKA gångarten, om anroparen vet den
}

function StateMachine:step(input: Input, dt: number): State
	self._held = math.max(0, self._held - dt)

	local landed = self._wasAirborne and not input.airborne
	self._wasAirborne = input.airborne

	--[[ GÅNGARTEN KOMMER UTIFRÅN NÄR ANROPAREN VET DEN.

	     Maskinen härledde den förut alltid ur tempot. Under ett
	     gångartsbyte är det fel källa: förloppet byter gångart vid
	     Transition.switchAt, alltså 55 % in, medan tempot passerar
	     bandgränsen tidigare. Maskinen satte då Trot medan resten av
	     spelet — kamera, telemetri, sväng — fortfarande sa skritt, och
	     travanimationen började för tidigt.

	     Uppmätt skillnad: bandet ~0,31 / 0,39 / 0,50 s mot förloppets
	     0,44 / 0,52 / 0,66 s. Det är en intern dubbel-sanning, och den
	     sortens sak är hela poängen med G02-A.

	     Tempot är kvar som källa när ingen gångart skickas in — då
	     gäller hysteresen i forSpeed, precis som förut. Tillstånden för
	     HÄNDELSER (Jump, Landing, Stopping, BackingUp, TurningInPlace)
	     rörs inte av det här: de avgörs nedan av mark, avsikt och tempo
	     och har företräde framför gångartstillståndet. ]]
	self.gait = input.gait or Gaits.forSpeed(math.abs(input.speed), self.gait)

	local next: State? = nil

	if input.jumpFired or input.airborne then
		next = "Jump"
	elseif landed then
		next = "Landing"
	elseif input.speed < -0.15 then
		next = "BackingUp"
	elseif input.braking and math.abs(input.speed) > 0.6 then
		next = "Stopping"
	elseif math.abs(input.speed) < 0.25 then
		next = if math.abs(input.turnRate) > 0.25 then "TurningInPlace" else "Idle"
	else
		next = GAIT_STATE[self.gait] or "Idle"
	end

	-- Ett tillstånd med minimitid får inte avbrytas i förtid, utom av hopp.
	if self._held > 0 and next ~= "Jump" then
		return self.state
	end

	if next ~= self.state then
		self.state = next :: State
		self._held = MIN_HOLD[next] or 0
	end
	return self.state
end

return StateMachine
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX17">
				<Properties>
					<string name="Name">Svar</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	G02-B punkt 2 — HÄSTENS SVAR, Roblox-sidan.

	Motsvarigheten till src/riding/svar.js. Samma formler, och talen läses
	ur RidKanon.SVAR och RidKanon.PROFILER — genererade ur webbens modul,
	inte avskrivna. Ändras en konstant på webben ändras den här, och
	paritetsspecen faller om exporten inte körts.

MJUKHET, SPÄNNING OCH FOKUS FINNS HÄR sedan senior review av #87.

	De tre stod förut som deklarerade luckor med G02-C som hem. Reviewen
	underkände det: #83 kräver balans, fokus, spänning och energi i
	G02-B, och plattformsspecifik input får skilja sig — produkten får
	inte sakna själva beteendet.

	Formlerna är webbens, och talen läses ur RidKanon.SVAR. För att det
	skulle gå fick spänningens literaler i src/model.js namn (SP_*) och
	flyttade till kanonen; ingen siffra ändrades, och paritetsspecens
	golden-rader bevakar att de två räknar lika.

	FEM INGÅNGAR SAKNAR KÄLLA PÅ ROBLOX, och de fylls inte med gissningar
	utan anropas med sina NEUTRALA element, var och en namngiven:

	  stallro    1  — ingen stallro-modell finns; termen blir noll
	  sadellage  1  — ingen sadelpassning finns
	  underlag   1  — inget underlagssystem finns
	  dagsform   0  — bidrar bara till lugnet, som då blir mindre
	  spö        av — inget spö finns på Roblox

	Skillnaden mot webben är därmed en känd och deklarerad förskjutning i
	spänningens nivå, inte i dess form. Att fylla dem med konstanter för
	att få identiska tal hade gett paritet i siffran och inte i
	upplevelsen.
]]

local RidKanon = require(script.Parent.RidKanon)

local Svar = {}

Svar.PROFILER = RidKanon.PROFILER

--[[ SVAR.SAKNAS är BETEENDEluckor: en storhet i svarsmodellen som
     Roblox inte räknar alls. Tom sedan #87:s första review — mjukhet,
     spänning och fokus räknas här nu. Listan står kvar som kontrakt:
     nästa storhet utan implementation ska deklareras här. ]]
Svar.SAKNAS = {}

--[[ ══ CONTEXTKÄLLORNA (senior re-review av #87, blocker 2) ═════════

     Reviewen: "Om vissa externa contextkällor medvetet saknas på Roblox
     ska de deklareras separat och får inte samtidigt passera som `inga
     svarsluckor`." Det var precis vad som hände. `Svar.SAKNAS` var tom
     och ett test KRÄVDE att den skulle vara det, medan modellen i själva
     verket kördes med flera ingångar på sina neutrala element. Kontraktet
     var därmed grönare än verkligheten.

     Nu är det två listor med två olika betydelser:

       SAKNAS          en STORHET som inte räknas alls  (tom)
       KONTEXT_SAKNAS  en INGÅNG utan källa på Roblox   (nio)

     Unionen av KONTEXT_HAR och KONTEXT_SAKNAS ska vara exakt
     RidKanon.KONTEXT_KALLOR — den lista exporten MÄTTE ur webbens
     stepRide. Paritetsspecen faller annars, åt båda hållen: en ny
     webbkälla utan hem, och en deklarerad lucka som inte finns.

     Vad luckorna är VÄRDA står inte som gissning utan är uppmätt:
     RidKanon.SCENARIO kör samma ritt med Roblox context och med
     webbens, och skillnaden är siffran. ]]
Svar.KONTEXT_HAR = {
	"a.parad",        -- F / ButtonB / HALVHALT
	"a.sits",         -- Z/C / ButtonL2 / DJUP SITS
	"a.skankel",      -- framåtaxeln kring SKANKEL_NEUTRAL
	"a.styrning",     -- styraxeln
	"a.tygel",        -- Q / ButtonR2 / TYGEL
	"ctx.svangradie", -- ur kurvaturen, samma uttryck som webben
	"ctx.utomhus",    -- ridhus eller ute
	"s.dagsform",     -- RidKanon.START.DAGSFORM
	"s.rang",         -- växer under ritten, Svar.rangSteg
	"s.sadellage",    -- RidKanon.START.SADELLAGE
}

--[[ NIO INGÅNGAR UTAN KÄLLA. De körs på sina NEUTRALA element — inte
     på gissningar — och var och en har en orsak som är ett system som
     inte finns, inte en glömska:

       a.spo                  inget spö på Roblox
       ctx.stallro            ingen stallro-modell
       ctx.underlag           inget underlagssystem
       ctx.avdrift            ingen humör-/avdriftsmodell
       ctx.fard.tygelband     ryttarens färdigheter finns inte som
       ctx.fard.skygghet        system på Roblox; hela `fard`-blocket
       ctx.fard.lugn            är webbens färdighetsprofil
       ctx.fard.hhAmplitud
       ctx.fard.spanningFall

     Skillnaden mot webben är därmed en känd och MÄTT förskjutning i
     spänningens och energins nivå, inte i deras form. Att fylla dem med
     konstanter för att få identiska tal hade gett paritet i siffran och
     inte i upplevelsen. ]]
Svar.KONTEXT_SAKNAS = {
	"a.spo",
	"ctx.avdrift",
	"ctx.fard.hhAmplitud",
	"ctx.fard.lugn",
	"ctx.fard.skygghet",
	"ctx.fard.spanningFall",
	"ctx.fard.tygelband",
	"ctx.stallro",
	"ctx.underlag",
}

--[[ Utgångsläget, ur kanonen. Roblox startade förut spänning 0, energi 1
     och mjukhet 1 medan webben startade 0,15 / 0,835 / 0,5 — samma
     formler på olika ritt. ]]
Svar.START = RidKanon.START

local function kl(v: number, lo: number, hi: number): number
	return math.clamp(v, lo, hi)
end

--[[ Hästens profil, med `skolhast` som fallback. Att fallbacken är
     utgångsläget och inte ett fel är avsiktligt: en häst utan tilldelad
     profil ska bete sig som modellen alltid gjort. ]]
function Svar.profil(h: { [string]: any }?): { [string]: any }
	--[[ Två stavningar med flit: `profil` är hästdatans fältnamn
	     (UBRFSpelData, samma som webbens), `Profil` är Roblox
	     attributnamn i Config.STATS. Samma värde, två vägar in, och
	     ingen av dem ska behöva skrivas om för att den andra finns. ]]
	local namn = if h then (h.profil or h.Profil) else nil
	return (namn and Svar.PROFILER[namn]) or Svar.PROFILER.skolhast
end

--[[ Hästens KÄNSLIGHET, 0–1.

     HÄSTENS EGET TAL FÖRST (`Kanslighet` i Config.STATS, satt ur
     UBRFSpelData av Stallet.statsFor). Härledningen ur temperamentets
     `reactGain` finns kvar som fallback för en häst som bara är
     konfigurerad i Studio, men den KVANTISERAR: hela spannet 0,70–1,00
     blir "Sensitive" och därmed 1,00. Cross-platform-scenariot mätte
     följden — crokino fick spänning 0,28 på Roblox mot 0,16 på webben
     med exakt samma ritt — och det är därför talet nu går hela vägen.

     Fallback-spannet är temperamentstabellens eget: Brave 0,70 lägst,
     Sensitive 1,35 högst. ]]
function Svar.kanslighet(temperament: { [string]: any }?,
	stats: { [string]: any }?): number
	local eget = if stats then stats.Kanslighet else nil
	if type(eget) == "number" then return kl(eget, 0, 1) end
	local g = if temperament then (temperament.reactGain or 1) else 1
	return kl((g - 0.70) / (1.35 - 0.70), 0, 1)
end

--[[ Svarstiden för EN hjälp, i sekunder. `kanslighet` är hästens egen,
     `klarhet` hur samordnad hjälpen var (0–1).

     Profilen skalar SUMMAN, inte varje term för sig, och avdraget för
     tydlighet läggs efter skalningen — annars hade en trög häst också
     blivit den som tjänar mest på en tydlig hjälp, alltså motsatsen till
     vad profilen säger. Identiskt med webben. ]]
function Svar.svarstid(h: { [string]: any }?, kanslighet: number, fokus: number,
	energi: number, klarhet: number): number
	local S = RidKanon.SVAR
	local P = Svar.profil(h)
	local t = (S.SVAR_BAS
		+ S.SVAR_TROG * (1 - kl(kanslighet, 0, 1))
		+ S.SVAR_FOKUS * (1 - kl(fokus, 0, 1))
		+ S.SVAR_ENERGI * (1 - kl(energi, 0, 1))) * P.svar
		- S.SVAR_KLAR * P.klar * kl(klarhet, 0, 1)
	return kl(t, S.SVAR_MIN, S.SVAR_MAX)
end

--[[ Sitsens stöd i svängen, 0–1: hur mycket av vägen från neutral sits
     till den djupa paradsitsen ryttaren sitter. Samma funktion som
     webbens svarSitsStod. ]]
function Svar.sitsStod(sits: number): number
	local KN = RidKanon.KONTAKT
	return kl(((sits or 0) - KN.SITS_NEUTRAL) / (KN.SITS_PARAD - KN.SITS_NEUTRAL), 0, 1)
end

--[[ Balansens målvärde. `bojkrav` 0–1 av fullt styrutslag, `ytterstod`
     ur hjälpsemantiken, `fartkrav` svängens centripetalkrav normaliserat
     som på webben, `sits` hjälpsemantikens sits.

     SÄTET ÄR EN BALANSMODIFIERARE (senior review #87): sitter ryttaren
     ned i bågen bär hon hästen, sitter hon lätt får hästen bära den
     själv. Termen biter bara när det finns en båge att stödja. ]]
function Svar.balansMal(h: { [string]: any }?, utbildning: number, bojkrav: number,
	ytterstod: number, fartkrav: number, iOvergang: boolean,
	spanning: number, sits: number): number
	local S = RidKanon.SVAR
	local avdrag = S.BALANS_YTTER * kl(bojkrav, 0, 1) * (1 - kl(ytterstod, 0, 1))
		+ S.BALANS_VIKT * kl(bojkrav, 0, 1) * (1 - Svar.sitsStod(sits))
		+ S.BALANS_FART * kl(fartkrav, 0, 1)
		+ (if iOvergang then S.BALANS_OVERGANG else 0)
		+ S.BALANS_SPANNING * kl(spanning or 0, 0, 1)
	local damp = 1 - S.BALANS_UTB * kl(utbildning, 0, 1)
	return kl(1 - avdrag * damp * Svar.profil(h).balans, 0, 1)
end

--[[ FOKUSENS MÅLVÄRDE. Webbens formel, talen ur kanonen. `paradLyft` är
     0–1 och läggs på när en halvhalt just lästes. ]]
function Svar.fokusMal(mjukhet: number, spanning: number, utomhus: boolean,
	paradLyft: number, h: { [string]: any }?): number
	local S = RidKanon.SVAR
	return kl(S.FOKUS_BAS + S.FOKUS_MJUK * kl(mjukhet, 0, 1)
		+ S.FOKUS_LUGN * (1 - kl(spanning, 0, 1))
		- (if utomhus then S.FOKUS_UTE else 0)
		+ S.FOKUS_PARAD * Svar.profil(h).fokus * kl(paradLyft or 0, 0, 1), 0, 1)
end

--[[ MJUKHETEN — handens stadga över tid. Webbens formel: hjälpernas
     avvikelse från sitt eget glidande medel, filtrerad.

     `medel` är anroparens lilla tabell {skankel,tygel,sits,styrning} som
     modulen uppdaterar. Att den ligger hos anroparen och inte här är för
     att modulen ska förbli tillståndslös och gå att prova rad för rad. ]]
function Svar.mjukhet(nuv: number, medel: { [string]: number },
	a: { [string]: number }, dt: number): number
	local KN = RidKanon.KONTAKT
	local beta = kl(dt / KN.AIDS_TAU, 0, 1)
	local avvik = math.abs((a.skankel or 0) - medel.skankel)
		+ math.abs((a.tygel or 0) - medel.tygel)
		+ 0.7 * math.abs((a.sits or 0) - medel.sits)
		+ 0.7 * math.abs((a.styrning or 0) - medel.styrning)
	medel.skankel += ((a.skankel or 0) - medel.skankel) * beta
	medel.tygel += ((a.tygel or 0) - medel.tygel) * beta
	medel.sits += ((a.sits or 0) - medel.sits) * beta
	medel.styrning += ((a.styrning or 0) - medel.styrning) * beta
	local kvot = avvik / KN.AMPLITUD_SKALA
	local tick = 1 / (1 + kvot * kvot)
	return nuv + (tick - nuv) * kl(KN.MJUKHET_EMA * dt, 0, 1)
end

--[[ SPÄNNINGENS MÅLVÄRDE. Webbens formel, talen ur kanonen.

     `ctx` bär de fem ingångar Roblox saknar källa till; anroparen skickar
     deras neutrala element och modulen räknar med dem som vilka andra
     som helst. Se modulhuvudet för vilka och varför. ]]
function Svar.spanningMal(a: { [string]: number }, hast: { [string]: any },
	mjukhet: number, rang: number, gangart: string, ctx: { [string]: any }): number
	local S, KN = RidKanon.SVAR, RidKanon.KONTAKT
	local kf = S.SP_KANSL_BAS + S.SP_KANSL * kl(hast.kanslighet or 0.5, 0, 1)
	local press = 0
	local tygel = a.tygel or 0
	if tygel > KN.TYGEL_HART then
		press += (tygel - KN.TYGEL_HART) * S.SP_HART
	elseif tygel > KN.TYGEL_BAND_MAX then
		press += (tygel - KN.TYGEL_BAND_MAX) * S.SP_BAND
	end
	press += (1 - kl(mjukhet, 0, 1)) * S.SP_OMJUK
	if (a.skankel or 0) > KN.SKANKEL_FOR_MYCKET then
		press += ((a.skankel or 0) - KN.SKANKEL_FOR_MYCKET) * S.SP_SKANKEL
	end
	if (a.sits or 0) > S.SP_SITS_TROSKEL and gangart == "galopp" then
		press += ((a.sits or 0) - S.SP_SITS_TROSKEL) * S.SP_SITS_GALOPP
	end
	press += (1 - (ctx.stallro or 1)) * S.SP_STALLRO
		+ (1 - (ctx.sadellage or 1)) * S.SP_SADEL
		+ (1 - (ctx.underlag or 1)) * S.SP_UNDERLAG
	press += kl(hast.skygghet or 0.2, 0, 1) * S.SP_SKYGG
		* (if ctx.utomhus then S.SP_SKYGG_UTE else 1)
	local lugn = kl(rang, 0, 1) * S.SP_LUGN_RANG
		+ kl(hast.forlatande or 0.6, 0, 1) * S.SP_LUGN_FORLAT
		+ kl(mjukhet, 0, 1) * S.SP_LUGN_MJUK
		+ kl(ctx.dagsform or 0, 0, 1) * S.SP_LUGN_DAGSFORM
	return kl(press * kf - lugn * S.SP_LUGN_VIKT, 0, 1)
end

--[[ Spänningens rörelse mot målet. Stiger med känsligheten, faller med
     förlåtandet — webbens approach(), samma tal. ]]
function Svar.spanningSteg(nuv: number, mal: number, hast: { [string]: any },
	dt: number): number
	local S, KN = RidKanon.SVAR, RidKanon.KONTAKT
	local upp = KN.SPANNING_STIGNING
		* (S.SP_STIG_BAS + S.SP_STIG_KANSL * kl(hast.kanslighet or 0.5, 0, 1))
	local ner = KN.SPANNING_FALL
		* (S.SP_FALL_BAS + S.SP_FALL_FORLAT * kl(hast.forlatande or 0.6, 0, 1))
	if mal > nuv then return nuv + math.min(mal - nuv, upp * dt) end
	return nuv - math.min(nuv - mal, ner * dt)
end

--[[ Hur mycket snävare bågen blir än den ryttaren bad om, som en faktor
     på kurvaturen. 0 vid full balans, 0 på rakt spår. ]]
function Svar.infall(balans: number, bojkrav: number): number
	local S = RidKanon.SVAR
	return S.INFALL_MAX * (1 - kl(balans, 0, 1)) * kl(bojkrav, 0, 1)
end

--[[ Energins ändring per sekund. Positiv = hämtar sig. `gangart` är
     WEBBENS namn — anroparen översätter Roblox gångartsnamn med
     RidKanon.MOTSVARIGHET, så tabellen inte behöver finnas i två
     nyckelrymder.

     Spänningen tär på webben; här finns den inte, och termen anropas
     därför med 0. Det är samma frånvaro som i balansen. ]]
function Svar.energiTakt(gangart: string, spanning: number, h: { [string]: any }?): number
	local S = RidKanon.SVAR
	local P = Svar.profil(h)
	local tapp = (S.ENERGI_TAPP[gangart] or 0) * (1 + S.ENERGI_SPANN * (spanning or 0)) * P.tapp
	local ater = (S.ENERGI_ATER[gangart] or 0) * P.ater
	return ater - tapp
end

--[[ Energin en häst går ut med. Webben räknar den ur dagsformen; Roblox
     har ingen dagsform, så en utvilad häst startar på full energi — det
     är webbens värde vid dagsform 1,0 och alltså ingen egen konstant. ]]
--[[ Energin vid uppsittning, ur hästens dagsform — samma uttryck som
     webbens svarStartEnergi(). Returnerade 1 före blocker 2, alltså en
     annan häst än den webben satte upp på. ]]
function Svar.startEnergi(dagsform: number?): number
	local S = RidKanon.START
	local d = if dagsform ~= nil then dagsform else S.DAGSFORM
	return math.clamp(S.ENERGI_BAS + S.ENERGI_DAG * d, 0, 1)
end

--[[ Rangens ändring per sekund. Ryttaren förtjänar den med handen och
     förlorar den på spänning. Roblox höll den låst på 0,5 hela ritten,
     och eftersom spänningen läser rangen var det en tyst skillnad i hela
     spänningsmodellen — inte bara i ett starttal. ]]
function Svar.rangSteg(rang: number, mjukhet: number, spanning: number, dt: number): number
	local S = RidKanon.START
	local d = (mjukhet - S.RANG_PIVOT) * S.RANG_MJUK - (spanning or 0) * S.RANG_SPANN
	return math.clamp(rang + d * dt, 0, 1)
end

return Svar
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX18">
				<Properties>
					<string name="Name">Telemetri</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	G02-A — RIDNINGENS TELEMETRI OCH TILLSTÅNDSKONTRAKT, Roblox-sidan.

	Motsvarigheten till src/riding/telemetri.js. Samma tre uppgifter, samma
	fältnamn, samma ärlighet om vad som är mätt och vad som är härlett:

	1. LÄSER ut telemetrin G02-B/C behöver ur tillstånd som redan finns i
	   MovementController. Ren avläsning — modulen räknar ingen fysik, rör
	   ingen Instance och kan alltså inte påverka ridkänslan.
	2. Namnger UPPSUTTEN/AVSUTTEN som ett riktigt tillstånd i stället för
	   något som bara framgår av om en Seat råkar vara ockuperad.
	3. Skriver ned gångartsövergångarnas kontrakt, så att ett olagligt hopp
	   går att UPPTÄCKA. Gångarten kommer fortsatt ur Gaits.forSpeed med
	   hysteres — kontraktet dömer, det styr inte.

	G02-B GAV DEM RIKTIGA KÄLLOR. Modulen skrev tidigare att spänning,
	mjukhet och hjälplagret saknades på Roblox — rörelsekärnan tog bara
	`forward`/`steer`. Efter G02-B har den tygel, sits och parad som egna
	axlar, och mjukhet, spänning, fokus, balans och energi räknas med
	webbens formler och webbens tal ur RidKanon. SAKNAS är därför tom.
]]

local Gaits = require(script.Parent.Gaits)
local RidKanon = require(script.Parent.RidKanon)
local Hjalper = require(script.Parent.Hjalper)

local Telemetri = {}

--[[ Kontraktets fältnamn — SAMMA namn som webben, hämtade ur den
     genererade kanonen så att de två inte kan driva isär. ]]
Telemetri.FALT = RidKanon.TELEMETRI_FALT

--[[ Fält som är härledda, inte mätta. Speglar webbens `_harledda`. ]]
Telemetri.HARLEDDA = RidKanon.HARLEDDA

--[[ KONTRAKTET G02-C LÄSER (G02-B punkt 5). `HJALP_FALT` är vad ryttaren
     gör, `SVAR_FALT` vad hästen svarar. Indelningen kommer ur kanonen,
     alltså ur webbens moduler — inte ur en handskriven uppräkning här.
     En läsare som vill veta "vad bad ryttaren om, och vad gjorde hon av
     det" behöver inte gissa vilka fält som är vilka. ]]
Telemetri.HJALP_FALT = RidKanon.HJALP_FALT
Telemetri.SVAR_FALT = RidKanon.SVAR_FALT

--[[ Fält utan källa på Roblox ännu. Deklarerad lucka, inte en bugg som
     ska tystas: paritetsspecen kräver att listan stämmer exakt, så ett
     nytt hål blir rött och ett igenfyllt hål tvingar fram en ändring här. ]]
--[[ G02-B punkt 1 la till paradKvalitet och paradAlder i kontraktet:
     webben läser nu HUR en halvhalt reds, inte bara att den gavs.
     Roblox har ingen parad alls ännu — ingen kanal, ingen läsning —
     så de två är luckor av exakt samma slag som hjälplagret. ]]
--[[ Tomt sedan senior review av #87. Sitsen fick en egen axel, och
     mjukhet, spänning och fokus räknas nu på Roblox med webbens formler
     och webbens tal. Listan står kvar som kontrakt: ett fält utan källa
     ska deklareras här och inte utelämnas tyst. ]]
Telemetri.SAKNAS = {}

--[[ Lagliga gångartsbyten: grannsteg i ordningen, plus halt från vad som
     helst (en häst kan stanna ur galopp). Ordningen är Roblox egen — den
     har fyrsprånget som webben saknar — men de fyra första stegen är
     desamma, vilket paritetsspecen kontrollerar. ]]
function Telemetri.lagligtByte(fran: string, till: string): boolean
	if fran == till then return true end
	if till == "halt" then return true end
	local i, j = Gaits.index(fran), Gaits.index(till)
	return math.abs(i - j) == 1
end

export type Ritt = {
	uppsutten: boolean,
	hast: string?,
	plats: string?,
	gangart: string,
	glapp: number,
}

function Telemetri.nyRitt(): Ritt
	return { uppsutten = false, hast = nil, plats = nil, gangart = "halt", glapp = 0 }
end

function Telemetri.sittUpp(ritt: Ritt, hastId: string?, plats: string?): Ritt
	ritt.uppsutten = true
	ritt.hast = hastId
	ritt.plats = plats
	ritt.gangart = "halt"
	ritt.glapp = 0
	return ritt
end

function Telemetri.sittAv(ritt: Ritt): Ritt
	ritt.uppsutten = false
	ritt.hast = nil
	ritt.plats = nil
	return ritt
end

--[[ Följ gångarten och räkna glapp. Anropas av den som redan stegar
     ritten; dömer, styr inte. ]]
function Telemetri.foljGangart(ritt: Ritt, gangart: string): string
	if gangart ~= ritt.gangart and not Telemetri.lagligtByte(ritt.gangart, gangart) then
		ritt.glapp += 1
	end
	ritt.gangart = gangart
	return gangart
end

--[[ TELEMETRIN. `loco` är MovementControllerns Locomotion, `kurvatur`
     dess `self.curvature` (1/m, tecknad).

     Notera identiteten: MovementController skriver redan
     `loco.turnRate = curvature * speed`, alltså exakt webbens
     `vridhastighet = kurvatur × tempo`. Den läses ut, den räknas inte om. ]]
function Telemetri.las(ritt: Ritt, loco: { [string]: any }, kurvatur: number,
	hjalper: { [string]: any }?): { [string]: any }
	local k = kurvatur or 0
	return {
		uppsutten = ritt.uppsutten,
		hast = ritt.hast,
		gangart = loco.gait,
		gangartGlapp = ritt.glapp,
		fart = loco.speed,
		onskadFart = Gaits.get(loco.targetGait).norm,
		kurvatur = k,
		svangradie = if math.abs(k) > 0.002 then 1 / math.abs(k) else math.huge,
		vridhastighet = loco.turnRate,
		rytm = loco.phase,
		steglangd = Gaits.cycleLength(loco.gait),
		--[[ CUE-FÄLTEN. Roblox hade redan modellen webben nu fått: spelaren
		     väljer gångart, inte tempo (se MovementController:_targetGait —
		     "det är skillnaden mot en gaspedal"). `targetGait` ÄR alltså den
		     beddna gångarten, och fälten har riktiga källor här, inte
		     härledda. ]]
		--[[ G02-B punkt 2: `beddGangart` är vad ryttaren BAD om,
		     `gangart`/`targetGait` vad hästen svarat på. Under svarstiden
		     skiljer de sig utan att `iOvergang` är sant — hon har hört,
		     men inte börjat. ]]
		beddGangart = loco.beddGangart or loco.targetGait,
		cue = loco.cue,
		cueAlder = if loco.cueTid then math.max(0, (loco.tid or 0) - loco.cueTid) else nil,
		--[[ TRE TIDER, TRE LÅSTA BETYDELSER (senior review #87). Samma
		     kontrakt som webbens: svarstid = begäran → svar,
		     overgangstid = förloppets faktiska längd, etableringstid =
		     begäran → gångarten ÄR den beddna. ]]
		overgangstid = loco.overgangstid or 0,
		etableringstid = loco.etableringstid or 0,
		iOvergang = loco.gait ~= loco.targetGait,
		--[[ ── HÄSTENS SVAR OCH RYTTARENS HJÄLPER (G02-B) ───────────
		     Samma fältnamn och samma tal som webben. `hjalper` kommer ur
		     den delade semantiken i HorseCore.Hjalper, som läser
		     RidKanon.HJALP — inga tal skrivs av här.

		     `sits` och `vikt` saknas i hjälperna av det skäl som står i
		     Hjalper.SAKNAS: Shift och Ctrl är gångartsknappar på Roblox
		     sedan Gate 01, och att flytta dem är en inputändring utanför
		     G02-B. Fälten utelämnas hellre än fylls. ]]
		balans = loco.balans,
		energi = loco.energi,
		--[[ Senior review #87: de tre som stod som luckor har källor nu.
		     `mjukhet` är handens stadga över tid, `spanning` webbens
		     formel med Roblox egna hästdata, `fokus` bygger på de två. ]]
		mjukhet = loco.mjukhet,
		spanning = loco.spanning,
		fokus = loco.fokus,
		svarstid = loco.svarstid or 0,
		svarAlder = if loco.svarTid then math.max(0, (loco.tid or 0) - loco.svarTid) else nil,
		paradKvalitet = loco.paradKvalitet or 0,
		paradAlder = if loco.paradTid then math.max(0, (loco.tid or 0) - loco.paradTid) else nil,
		hjalper = hjalper,
	}
end

return Telemetri
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX19">
				<Properties>
					<string name="Name">Types</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Typerna som resten av systemet talar i.

	Poängen med att ha dem här: controllern rör aldrig ett MeshPart, ett
	Bone eller ett AnimationTrack direkt. Den ser bara Rig, Intent och
	State. Det är det som gör att hästmodellen går att byta ut utan att
	ridlogiken skrivs om.
]]

export type GaitName = "halt" | "walk" | "trot" | "canter" | "gallop"

export type State =
	"Idle" | "Walk" | "Trot" | "Canter" | "Gallop"
	| "Jump" | "Landing" | "Stopping" | "BackingUp" | "TurningInPlace"

--[[ Vad ryttaren ber om. Aldrig ett kommando — hästen förhandlar. ]]
export type Intent = {
	forward: number,     -- -1..1, W framåt, S ned i gångart och bakåt
	steer: number,       -- -1..1, vänster..höger
	gaitUp: boolean,     -- begär högre gångart
	gaitDown: boolean,
	jump: boolean,
	--[[ G02-B punkt 1: TYGELN och PARADEN som egna avsikter.

	     `rein` är kontakten ryttaren håller, 0 lös … 1 tagen. Den är
	     analog med flit: på gamepad ligger den på en riktig trigger, så
	     halva utslaget ger halv kontakt. Yttertygelstödet — och därmed
	     hästens balans i svängen — hänger på den.

	     `parad` är halvhalten som EGEN signal, inte tre hjälper som
	     knuffas samtidigt. Kanalen är en impuls: flanken uppåt startar
	     förloppet, och att hålla knappen ger inte en oändlig parad.

	     Båda är valfria i typen så att äldre anropare (specar,
	     autopilot) inte behöver skrivas om för att kompilera; de läses
	     med `or 0`. ]]
	rein: number?,
	parad: number?,
	--[[ Sitsen: −1 lätt (avlastad), 0 normal, 1 djup. Analog på vänster
	     avtryckare. Den är hästens balansmodifierare i en båge — se
	     SVAR.BALANS_VIKT. ]]
	seat: number?,
}

--[[ Hästens rörelsetillstånd. Simuleras hos den som äger nätverket. ]]
export type Locomotion = {
	speed: number,       -- m/s framåt, negativ vid backning
	heading: number,     -- radianer, world Y
	turnRate: number,    -- rad/s, filtrerad
	lean: number,        -- radianer roll, positiv = lutar in i högersväng
	gait: GaitName,
	targetGait: GaitName,
	state: State,
	phase: number,       -- 0..1 inom gångartens cykel, driver ljud och damm
	airborne: boolean,
	grounded: boolean,
	slope: Vector3,      -- markens normal, utjämnad
	stamina: number,     -- 0..MaxStamina
	--[[ G02-B punkt 2: hästens svar. Valfria i typen eftersom en rig som
	     stegas av en äldre spec inte fyller dem; Telemetri deklarerar de
	     som saknar källa. ]]
	balans: number?,
	energi: number?,
	mjukhet: number?,
	spanning: number?,
	fokus: number?,
	svarstid: number?,
	beddGangart: GaitName?,
	paradKvalitet: number?,
}

--[[ Hästmodellen, upplöst till det systemet behöver. Allt utom model,
     root och animator får saknas. ]]
export type Rig = {
	model: Model,
	root: BasePart,
	animator: Animator,
	humanoid: Humanoid?,
	controller: AnimationController?,
	rootJoint: Motor6D?,             -- bär lutningen i svängar
	--[[ #162: ryttarlutningen har sin EGEN led. Förut lades den på `seat`,
	     som är en Roblox `Seat` — en BasePart utan `C0`. Den raden hade
	     kastat på första ridbildrutan mot en riktig rigg, och syntes inte
	     eftersom rider.spec stubbade sätet som en led. Sätet är en sits;
	     leder är leder. ]]
	riderJoint: Motor6D?,            -- bär ryttarens lutning, om riggen har en
	seat: Seat?,
	attachments: { [string]: Attachment },
	bones: { [string]: Bone },
	stats: Configuration?,
	gaitConfig: Configuration?,
	animConfig: Configuration?,
}

return nil
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX20">
				<Properties>
					<string name="Name">Ugneta</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	UGNETA — G02-C:s bedömningskontrakt på Roblox-sidan.

	Ingen egen sanning. Dimensionerna per övning, listan över dimensioner
	och taket för antal observationer läses ur RidKanon.UGNETA, som
	genereras ur webbens src/larare.js av tools/exportera-ridkanon.mjs.
	Skulle webben ändra vad en 20 m volt bedöms på följer Roblox med i
	samma commit, och paritetsspecen blir röd om filen inte regenererats.

	Kvalitetsmåtten kommer ur samma telemetri som webben läser
	(HorseCore/Telemetri) — den här modulen räknar inte om något själv,
	den väljer bara ut och rangordnar.
]]

local RidKanon = require(script.Parent.RidKanon)

local Ugneta = {}

Ugneta.MAX_OBSERVATIONER = RidKanon.UGNETA.MAX_OBSERVATIONER
Ugneta.DIMENSIONER = RidKanon.UGNETA.DIMENSIONER

--[[ Trösklarna som avgör VAD hon säger. De stod förut som literaler här
     — avskrivna ur webbens ugnetaJamfor/ugnetaForstaForsok, alltså en
     andra sanning som kunde glida utan att något blev rött. Nu kommer de
     ur samma kanon som allt annat i den här modulen. ]]
local KV = RidKanon.UGNETA.KVALITET

--[[ Vilka dimensioner bedöms den här övningen på? Okänd övning ger
     samma reserv som webben: rytm, balans och mjukhet. ]]
function Ugneta.dimensionerFor(ovningId: string): { string }
	local d = RidKanon.UGNETA.OVNING[ovningId]
	if d then return d end
	return { "rytm", "balans", "mjukhet" }
end

--[[ Efter ett försök: högst MAX_OBSERVATIONER prioriterade observationer.
     `fore` är nil på första försöket. Samma ordning som webben:
     förbättringen först, därefter det som är svagast kvar. ]]
function Ugneta.observationer(ovningId: string,
	nu: { [string]: number }, fore: { [string]: number }?): { { dim: string, sort: string, varde: number } }
	local dims = Ugneta.dimensionerFor(ovningId)
	local ut = {}
	--[[ EN OMÄTT DIMENSION ÄR INTE EN DÅLIG DIMENSION. `nu[k]` som är nil
	     betyder att ytan saknar källa för den (HorseCore/Lektion.SAKNAS:
	     Roblox har ingen utbildningsskala och mäter därför ingen rytm).
	     Tidigare lästes den som 0, och då blev den automatiskt svagast i
	     varje 20 m volt — Ugneta hade tjatat om en takt hon aldrig sett.
	     Den hoppas nu över, och det syns i observationerna att den inte
	     bedömdes i stället för att den bedömdes till noll. ]]
	if fore then
		local bast, bastD = nil, KV.BATTRE
		for _, k in dims do
			if nu[k] ~= nil and fore[k] ~= nil then
				local d = nu[k] - fore[k]
				if d >= bastD then bast, bastD = k, d end
			end
		end
		if bast then table.insert(ut, { dim = bast, sort = "battre", varde = nu[bast] }) end
		local svag, svagV = nil, KV.SVAG
		for _, k in dims do
			local v = nu[k]
			if v ~= nil and k ~= bast and v < svagV then svag, svagV = k, v end
		end
		if svag then table.insert(ut, { dim = svag, sort = "kvar", varde = nu[svag] }) end
	else
		local bast, bastV = nil, KV.BRA
		for _, k in dims do
			local v = nu[k]
			if v ~= nil and v >= bastV then bast, bastV = k, v end
		end
		if bast then table.insert(ut, { dim = bast, sort = "bra", varde = nu[bast] }) end
		local svag, svagV = nil, math.huge
		for _, k in dims do
			local v = nu[k]
			if v ~= nil and k ~= bast and v < svagV then svag, svagV = k, v end
		end
		if svag then table.insert(ut, { dim = svag, sort = "forbattra", varde = nu[svag] }) end
	end
	--[[ Taket är ett skyddsnät, inte det som håller regeln i dag: varje
	     gren lägger till högst en förbättring och en kvarvarande, alltså
	     högst två. En falsifiering som tar bort raden ändrar därför
	     ingenting — det är inte en lucka i provet utan en mutation utan
	     verkan. Raden står kvar för den dag en gren till läggs till. ]]
	while #ut > Ugneta.MAX_OBSERVATIONER do table.remove(ut) end
	return ut
end

return Ugneta
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="ModuleScript" referent="RBX21">
			<Properties>
				<string name="Name">UBRFSpelData</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[ GENERERAD av tools/exportera-spel.js ur src/spel/hastar.js.
     Ändra inte här — ändra i källan och kör om exporten.
     Verklighetsfakta är grindade mot references/data/ubrf-hastar-2026-09-01.json. ]]

local bas = {kanslighet=0.5,framatbjudning=0.5,forlatande=0.6,skygghet=0.2,hoppkapacitet=0.6,hopplust=0.6,tyngd=0.4,utbildning=0.6,maxhojd=0.8,farg=Color3.fromRGB(114, 83, 59),man=Color3.fromRGB(47, 33, 24),profil="skolhast"}
local raw = {air={namn="Air Italia",typ="hast",fodd=2011,ras="Danskt varmblod",mankhojd=165,import=nil,kategori="hast",besk="Air är en valack som kom till ridskolan 2018. Han har landat bra i verksamheten och kan gå med i alla slags grupper.",beskEn="Air is a gelding who came to the riding school in 2018. He has settled in well and can join any kind of group.",kanslighet=0.45,forlatande=0.72,hopplust=0.65,utbildning=0.65,farg=Color3.fromRGB(138, 106, 76),man=Color3.fromRGB(74, 56, 38)},allan={namn="Allan",typ="hast",fodd=2015,ras="Svenskt varmblod",mankhojd=178,import=nil,kategori="hast",besk="Allan är en trevlig valack som går bra i både hoppning och dressyr.",beskEn="Allan is a pleasant gelding who goes well in both jumping and dressage.",profil="arbetsvillig"},berra={namn="BERRA (Irco MencoBoy)",typ="hast",fodd=2016,ras=nil,mankhojd=nil,import=nil,kategori="hast",besk="Hoppar jättefint. Även trevlig i dressyren. Har ett lite skarpare temperament i stallet.",beskEn="Jumps beautifully. Pleasant in dressage too. Has a slightly sharper temperament in the stable."},bing={namn="Bing",typ="hast",fodd=2006,ras="Holländskt varmblod, KWPN",mankhojd=166,import=nil,kategori="hast",besk="Bing är en valack med fin gång men som inte hoppar. Han har startat LB/LA i dressyr.",beskEn="Bing is a gelding with lovely paces who does not jump. He has competed at LB/LA level in dressage.",hoppkapacitet=0,flaggor={hoppar_inte=true}},conor={namn="Conor",typ="hast",fodd=2016,ras="Ungerskt halvblod",mankhojd=165,import=nil,kategori="hast",besk="En trevlig häst som kräver en mjuk balanserad ryttare.",beskEn="A pleasant horse who needs a soft, balanced rider.",kanslighet=0.88,framatbjudning=0.55,forlatande=0.32,skygghet=0.28,hoppkapacitet=0.7,hopplust=0.7,tyngd=0.22,utbildning=0.7,maxhojd=0.85,farg=Color3.fromRGB(92, 64, 48),man=Color3.fromRGB(43, 30, 21),profil="kanslig"},cosmo={namn="Cosmo M Z",typ="hast",fodd=2012,ras="Belgiskt varmblod, Zangersheide",mankhojd=170,import=nil,kategori="hast",besk="Cosmo är en snäll och okomplicerad valack som är grundutbildad i både dressyr och hoppning.",beskEn="Cosmo is a kind, uncomplicated gelding with basic schooling in both dressage and jumping.",kanslighet=0.42,forlatande=0.8,skygghet=0.15,hoppkapacitet=0.72,hopplust=0.75,tyngd=0.42,utbildning=0.68,maxhojd=0.9,farg=Color3.fromRGB(110, 79, 53),man=Color3.fromRGB(58, 42, 28),tecken={blas=true,strumpor={0,1,0,1}}},crokino={namn="Crokino",typ="hast",fodd=2011,ras="Holländskt varmblod. KWPN",mankhojd=177,import=nil,kategori="hast",besk="Crokino är en större, lite känsligare häst men som är lättriden trots sin storlek. Han är rädd för spö så låt bli det när du sitter upp.",beskEn="Crokino is a bigger, slightly more sensitive horse, but easy to ride despite his size. He is afraid of the whip, so leave it alone when you are riding him.",kanslighet=0.78,framatbjudning=0.52,forlatande=0.55,skygghet=0.42,hoppkapacitet=0.68,hopplust=0.62,tyngd=0.38,utbildning=0.72,maxhojd=0.85,farg=Color3.fromRGB(59, 46, 36),man=Color3.fromRGB(28, 21, 16),profil="kanslig",flaggor={radd_for_spo=true}},curiretto={namn="Curiretto",typ="hast",fodd=2006,ras="Svenskt varmblod, SWB",mankhojd=nil,import=nil,kategori="hast",besk="Curre är en äldre gentleman som tidigare tävlat hoppning. Har även tävlat en del dressyr. Lite åt det tyngre hållet.",beskEn="Curre is an older gentleman who used to compete in jumping. He has also done some dressage. A little on the heavier side.",profil="tung"},fay={namn="Fay",typ="hast",fodd=2018,ras=nil,mankhojd=nil,import="Irland",kategori="hast",besk="Mer info kommer.",beskEn="More information to come."},hjartat={namn="Guipsy / \"Hjärtat\"",typ="hast",fodd=2010,ras="Freiberger",mankhojd=nil,import=nil,kategori="hast",besk="Hjärtat är en häst med positiv inställning till arbetet. Alltid ambitiös. Ska inte hoppa så mycket längre.",beskEn="Hjärtat is a horse with a positive attitude to work. Always willing. Should not jump much any more.",profil="arbetsvillig"},hamilton={namn="Hamilton",typ="hast",fodd=2011,ras="Holländskt varmblod. KWPN",mankhojd=169,import=nil,kategori="hast",besk="Hamilton är en arbetsvillig valack som gillar det mesta. Han är en känsligare individ.",beskEn="Hamilton is a willing gelding who likes most things. He is one of the more sensitive ones.",kanslighet=0.75,framatbjudning=0.62,forlatande=0.5,skygghet=0.35,hoppkapacitet=0.72,hopplust=0.75,tyngd=0.32,utbildning=0.72,maxhojd=0.9,farg=Color3.fromRGB(122, 91, 62),man=Color3.fromRGB(51, 36, 26),profil="kanslig",tecken={blas=false,strumpor={0,0,1,1}}},kay_z={namn="Kay z",typ="hast",fodd=2014,ras="Belgiskt varmblod, Zangersheide",mankhojd=nil,import=nil,kategori="hast",besk="En allroundhäst av den större modellen. Går både hoppning och dressyr.",beskEn="An all-rounder of the larger sort. Goes both jumping and dressage.",profil="tung"},larry={namn="Larry",typ="hast",fodd=2016,ras="Irländsk Sporthäst",mankhojd=nil,import="Irland",kategori="hast",besk="En riktig \"tjejhäst\". Hoppar bra och går även bra i dressyren.",beskEn="A real \"girls' horse\". Jumps well and goes well in dressage too.",kanslighet=0.55,framatbjudning=0.58,forlatande=0.7,skygghet=0.18,hoppkapacitet=0.8,hopplust=0.8,tyngd=0.35,utbildning=0.72,maxhojd=0.95,farg=Color3.fromRGB(76, 53, 39),man=Color3.fromRGB(36, 24, 18),tecken={blas=true,strumpor={1,0,0,1}}},lothar={namn="Lothar's eagle",typ="hast",fodd=2017,ras=nil,mankhojd=nil,import="Irland",kategori="hast",besk="En gudomligt snäll häst som kan gå med på alla typer av lektioner.",beskEn="A wonderfully kind horse who can join any type of lesson."},oska={namn="Oska",typ="hast",fodd=2018,ras=nil,mankhojd=163,import="Irland",kategori="hast",besk="Snäll, bussig häst som slussas in i verksamheten samtidigt som han utbildas vidare.",beskEn="A kind, good-natured horse who is being eased into the school's work while his schooling continues."},puma={namn="Puma ( Ashdale cougar )",typ="hast",fodd=2019,ras="Irländsk Sporthäst",mankhojd=164,import="Irland",kategori="hast",besk="Puma är ett ädlare sto som ska sättas igång, utbildas och slussas in i verksamheten. Mer info kommer.",beskEn="Puma is a finer-bred mare who is to be started, schooled and eased into the school's work. More information to come."},sune={namn="Sune",typ="hast",fodd=2018,ras="Irländsk Sporthäst",mankhojd=166,import="Irland",kategori="hast",besk="Mer info kommer.",beskEn="More information to come."},tess={namn="Tess",typ="hast",fodd=2019,ras=nil,mankhojd=nil,import=nil,kategori="hast",besk="Tess är hos Petra & Mira på utbildning.",beskEn="Tess is away with Petra & Mira for schooling."},blackrock_jack={namn="Blackrock Jack",typ="ponny",fodd=2011,ras=nil,mankhojd=nil,import=nil,kategori="D",besk="Jack är en valack som är importerad från Irland. Han är en lite känsligare ponny och han är populär. Han hoppar trevligt. Har även tävlat lite dressyr.",beskEn="Jack is a gelding imported from Ireland. He is one of the more sensitive ponies, and a popular one. He jumps nicely. He has also competed a little in dressage.",profil="kanslig"},lydia={namn="Bränntomts Lydia",typ="ponny",fodd=2003,ras="Connemara",mankhojd=nil,import=nil,kategori="D",besk="Lydia har tidigare tävlat hoppning med sin förra ryttare. Lydia är en väldigt bra barnponny.",beskEn="Lydia used to compete in jumping with her previous rider. Lydia is a very good children's pony.",kanslighet=0.3,framatbjudning=0.45,forlatande=0.95,skygghet=0.06,hoppkapacitet=0.72,hopplust=0.82,tyngd=0.42,utbildning=0.8,maxhojd=0.75,farg=Color3.fromRGB(169, 162, 154),man=Color3.fromRGB(217, 212, 204),fjader=true,tecken={blas=false,strumpor={1,1,0,0}}},dante={namn="Dante",typ="ponny",fodd=nil,ras=nil,mankhojd=nil,import=nil,kategori="C",besk="En ung ponny som är under utbildning. Slussas försiktigt in i verksamheten. Snäll men lite försiktig i all hantering.",beskEn="A young pony still being schooled. Being eased carefully into the school's work. Kind, but a little wary of being handled.",profil="kanslig"},dexter={namn="Dexter",typ="ponny",fodd=2015,ras=nil,mankhojd=nil,import="Polen",kategori="D",besk="En ponny med lite mer fart. Duktig på att hoppa.",beskEn="A pony with a bit more go. Good at jumping.",kanslighet=0.6,framatbjudning=0.9,forlatande=0.52,skygghet=0.22,hoppkapacitet=0.88,hopplust=0.9,tyngd=0.18,utbildning=0.62,maxhojd=1,farg=Color3.fromRGB(46, 42, 38),man=Color3.fromRGB(21, 19, 17),profil="arbetsvillig",tecken={blas=false,strumpor={1,0,1,0}}},garnit={namn="Garnit Parasido",typ="ponny",fodd=2007,ras="New Forest",mankhojd=nil,import="Holland",kategori="C",besk="Garanit är en söt valack importerad från Holland. Han hoppar bra.",beskEn="Garanit is a sweet gelding imported from the Netherlands. He jumps well."},jessy={namn="Jessy",typ="ponny",fodd=2015,ras=nil,mankhojd=nil,import=nil,kategori="D",besk="En snäll ponny som ännu så länge är ny i verksamheten. Är mest riden i skog och mark tidigare. Utbildas vidare här på ridskolan.",beskEn="A kind pony who is still new to the school's work. Has mostly been ridden out in the woods and fields before. Her schooling continues here at the riding school."},kennedy={namn="Kennedy",typ="ponny",fodd=2019,ras=nil,mankhojd=nil,import=nil,kategori="D",besk="Mer info kommer.",beskEn="More information to come."},lady={namn="Lady",typ="ponny",fodd=2011,ras="Connemara",mankhojd=nil,import=nil,kategori="D",besk="Ett sto med lite integritet. Mjuk och behaglig i sina rörelser. Allroundponny.",beskEn="A mare with a mind of her own. Soft and comfortable in her movement. An all-round pony."},mac_kenzie={namn="Mac Kenzie",typ="ponny",fodd=2002,ras=nil,mankhojd=nil,import=nil,kategori="D",besk="Mac Kenzie är en fin, snäll gentleman som dock är lite försiktig i hoppningen.",beskEn="Mac Kenzie is a fine, kind gentleman, though a little careful over jumps.",profil="tung"},marabou={namn="Marabou",typ="ponny",fodd=2007,ras="Svensk Ridponny",mankhojd=nil,import=nil,kategori="B",besk="Marabou är en arbetsvillig liten valack som hoppar fint. Har tävlat mycket dressyr med tidigare ryttare.",beskEn="Marabou is a willing little gelding who jumps nicely. He has competed a lot in dressage with a previous rider.",profil="arbetsvillig"},replay={namn="Replay",typ="ponny",fodd=2012,ras="Connemara",mankhojd=nil,import="Irland",kategori="D",besk="Mjuk ponny som hoppar med bra teknik men är lite försiktig. Kräver sin ryttare för att jobba bra.",beskEn="A soft pony who jumps with good technique but is a little careful. Needs the right rider to work well.",profil="tung"},toblerone={namn="Toblerone",typ="ponny",fodd=2007,ras="Fjordhäst",mankhojd=nil,import=nil,kategori="C",besk="Toblerone är en snäll, välutbildad och populär fjordvalack. Han kom till ridskolan i augusti 2014 och har tidigare tävlat i både hoppning samt dressyr.",beskEn="Toblerone is a kind, well-schooled and popular Fjord gelding. He came to the riding school in August 2014 and has previously competed in both jumping and dressage.",kanslighet=0.35,framatbjudning=0.42,forlatande=0.95,skygghet=0.05,hoppkapacitet=0.72,hopplust=0.78,tyngd=0.62,utbildning=0.9,maxhojd=0.75,farg=Color3.fromRGB(200, 169, 107),man=Color3.fromRGB(237, 227, 206),profil="tung",fjader=true,tecken={blas=false,strumpor={0,0,0,0}}},trixie={namn="Trixie",typ="ponny",fodd=2007,ras="Connemara",mankhojd=nil,import="Irland",kategori="D",besk="Trixie är väldigt snäll men lite känslig. Hon går på alla slags lektioner. Hon kramas gärna i stallet.",beskEn="Trixie is very kind but a little sensitive. She joins all kinds of lessons. She likes a hug in the stable.",profil="kanslig"},troy={namn="Troy",typ="ponny",fodd=2016,ras=nil,mankhojd=nil,import="Irland",kategori="C",besk="Välriden ponny som kan \"lite av varje\". Vill inte alltid bli fångad i hagen.",beskEn="A well-ridden pony who can do \"a bit of everything\". Does not always want to be caught in the paddock."},westside={namn="Westside",typ="ponny",fodd=2009,ras="Haflinger",mankhojd=nil,import="Holland",kategori="C",besk="Westside är en snäll valack. Han kräver sin ryttare.",beskEn="Westside is a kind gelding. He needs the right rider.",profil="tung"}}
local hastar = {}
for id, h in pairs(raw) do
	local v = {}
	for k, x in pairs(bas) do v[k] = x end
	for k, x in pairs(h) do v[k] = x end
	if v.flaggor == nil then v.flaggor = {} end
	hastar[id] = v
end

local ordning = {"air","allan","berra","bing","conor","cosmo","crokino","curiretto","fay","hjartat","hamilton","kay_z","larry","lothar","oska","puma","sune","tess","blackrock_jack","lydia","dante","dexter","garnit","jessy","kennedy","lady","mac_kenzie","marabou","replay","toblerone","trixie","troy","westside"}
local foder = {}
local foderOverrides = {air={ho=2,kraft="betfor"},conor={ho=2,kraft="betfor"},cosmo={ho=3,kraft="müsli"},crokino={ho=3,kraft="pellets"},hamilton={ho=2,kraft="müsli"},larry={ho=3,kraft="müsli"},dexter={ho=2,kraft="pellets"},kennedy={ho=2,kraft="müsli"},westside={ho=3,kraft="pellets"}}
for _, id in ipairs(ordning) do
	local o = foderOverrides[id]
	foder[id] = {
		ho = if o then o.ho else 2,
		kraft = if o then o.kraft else "inget",
		status = "ASSUMPTION",
		notis = "Övningsvärde i spelet — verklig UBRF-giva är inte verifierad.",
	}
end

return {
	hastar = hastar,
	foder = foder,
	kraftval = {"inget","müsli","betfor","pellets"},
	ordning = ordning,
}
]]></ProtectedString>
			</Properties>
		</Item>
