	<Item class="ReplicatedStorage" referent="RBX1">
		<Properties>
			<string name="Name">ReplicatedStorage</string>
		</Properties>
		<Item class="ModuleScript" referent="RBX2">
			<Properties>
				<string name="Name">HorseCore</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	HorseCore — samlad ingång till de delade modulerna.

	    local Horse = require(ReplicatedStorage.HorseCore)
	    local gait = Horse.Gaits.forSpeed(speed, current)
]]

--[[ Types ligger medvetet utanför tabellen: modulen returnerar nil och
     finns bara för typkontrollen. Requira den direkt där typerna behövs. ]]
return {
	Config = require(script.Config),
	Gaits = require(script.Gaits),
	StateMachine = require(script.StateMachine),
	RigAdapter = require(script.RigAdapter),
	Networking = require(script.Networking),
	Telemetri = require(script.Telemetri),
	RidKanon = require(script.RidKanon),
	Hjalper = require(script.Hjalper),
	Svar = require(script.Svar),
	Kameralage = require(script.Kameralage),
	--[[ #161. Preparation ligger MEDVETET utanför: den require:as direkt
	     som `HorseCore.Preparation` av både server och klient, och att
	     lägga den här hade gjort require-ordningen cirkulär i bänkbygget.
	     Pass och Sparning är rena datamoduler utan sådana beroenden. ]]
	Pass = require(script.Pass),
	Sparning = require(script.Sparning),
}
]]></ProtectedString>
			</Properties>
			<Item class="ModuleScript" referent="RBX3">
				<Properties>
					<string name="Name">Config</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Konfigurationen — hästens siffror, raserna och animations-id:na.

	Ingen siffra för en enskild häst finns hårdkodad i logiken. Allt läses
	ur Configuration-instanser på modellen, med värdena här som fallback.
	Det är det som gör att en ny ras eller en ny modell fungerar direkt, och
	att en enskild häst går att trimma i Studio utan att kod ändras.

	Tre konfigurationsblock, som i den föreslagna hierarkin:
	  HorseStats      — lynne och förmåga
	  GaitConfig      — avvikelser från standardgångarterna
	  AnimationConfig — animations-id per tillstånd
]]

local Config = {}

--[[ ── HorseStats ────────────────────────────────────────────────────
     Normaliserade 0..1 där inget annat anges. Fälten är samma som den
     befintliga hästdatan använder, så en häst går att flytta över utan
     att värdena tolkas om. ]]
Config.STATS = {
	HorseName = "Namnlös",
	Breed = "Warmblood",
	Level = 1,

	Speed = 0.50,         -- skalar gångarternas maxtempo
	Acceleration = 0.50,  -- skalar accel/retard
	Agility = 0.50,       -- skalar svarvheten
	Endurance = 0.50,     -- skalar uthållighetens storlek och återhämtning
	JumpStrength = 0.50,
	Temperament = "Calm", -- Calm | Energetic | Sensitive | Brave | Stubborn

	--[[ G02-B punkt 3: SKOLHÄSTPROFILEN. Namnet slås upp i
	     RidKanon.PROFILER och avgör hur hästen svarar — fördröjning, hur
	     mycket hon bryr sig om att hjälpen är tydlig, hur lätt hon tappar
	     balansen, hur mycket hon orkar.

	     Värdet kommer från UBRFSpelData (fältet `profil`), tilldelat ur
	     ridskolans egna beskrivningar av hästarna. Som attribut går det
	     att sätta per modell i Studio, precis som Breed. `skolhast` är
	     utgångsläget: en häst utan profil beter sig som modellen alltid
	     gjort. ]]
	Profil = "skolhast",

	--[[ Senior review #87: FÖRLÅTANDE och SKYGGHET som riktiga stats.
	     Spänningen behöver dem, och hästdatan i UBRFSpelData har dem
	     redan per häst — de saknades bara här. Defaultvärdena är samma
	     som webbens BAS_GAMEPLAY. ]]
	Forlatande = 0.60,
	Skygghet = 0.20,

	--[[ Senior re-review #87, blocker 2: KÄNSLIGHET som riktig stat.
	     Den räknades förut ur Temperament, och det KVANTISERADE hästen:
	     0,78 och 0,71 blev båda "Sensitive" och därmed 1,00. Cross-
	     platform-scenariot mätte upp följden — samma ritt gav crokino
	     spänning 0,28 på Roblox mot 0,16 på webben, och mac_kenzie
	     svarade 0,067 s för segt. Temperamentet finns kvar och styr
	     fortfarande accelBias och animation; känsligheten läser hästens
	     eget tal när det finns. Defaulten är webbens BAS_GAMEPLAY. ]]
	Kanslighet = 0.50,

	MaxStamina = 100,
	BondLevel = 0,
}

--[[ ── Rörelse ──────────────────────────────────────────────────────── ]]
Config.MOVEMENT = {
	--[[ ── Svängen som kurvatur ──────────────────────────────────────
	     Styraxeln ber om en KURVATUR i 1/meter — hur snävt hästen böjer
	     sig — och vridhastigheten faller ut som kurvatur × tempo. Det
	     betyder att svängradien blir 1/kurvatur oavsett fart, alltså att
	     en snabbare gångart automatiskt ger en vidare båge.

	     Förut räknades vridhastigheten direkt och växte med farten
	     (TurnRateBase + TurnRateGain × tempo, tak 2,20 rad/s). I
	     fyrsprång gav det 126 grader i sekunden, vilket gör att man viker
	     hästen genom en sväng i stället för att rida den. De gamla
	     fälten är borta; gångartens turn-faktor lever kvar och skalar
	     kurvaturtaket i stället för vridhastigheten.

	     CurvatureMax är satt så att full styrning i skritt ger 2,4 m
	     radie, samma som webbens kanon. Meningen ovanför sa tidigare
	     3,3 m och "samma som webbversionens modell" — den var sann före
	     harmoniseringen och motsade sedan raden rakt under. ]]
	-- HARMONISERAT MOT WEBBENS KANON (PO-beslut 2026-09-05): A är kanon,
	-- och Roblox följer den i stället för att bära en egen produktfysik.
	-- Var 0.30 (3,3 m radie i skritt), nu 0.42 (2,4 m) som webben.
	CurvatureMax = 0.42,   -- 1/m vid full styrning i skritt
	CurvatureTauPress = 0.13,   -- sekunder att lägga sig i bågen
	CurvatureTauRelease = 0.19, -- längre: att räta upp sig tar tid
	--[[ Sekunder från rakt till full båge (G02-A.1 P4). Ett TAK på hur
	     fort kurvaturen får ändras: gångartens kurvaturtak delat med den
	     här tiden. En vanlig insvängning ligger under taket och rörs
	     inte; ett riktningsbyte, som annars sveper bågen igenom snabbare
	     än hästen någonsin lägger sig i en, begränsas.
	     Samma tal som RidKanon.KAPPA_RAT_TID på webben. ]]
	CurvatureRateTime = 0.32,
	--[[ ÖVERGÅNGSFÖRLOPPET (senior review 2026-09-05).

	     Ett gångartsbyte är ett FÖRLOPP, inte en ny måltempo som
	     approach() rör sig mot. Tempot följer mjukstegskurvan u²(3−2u)
	     från det tempo hästen faktiskt har till den nya gångartens, över
	     en längd som beror på riktningen och på hur bestämt ryttaren ber.

	     Roblox körde tidigare bara linjär approach() med accel/retard.
	     Tabellerna hade paritet men KÄNSLAN hade det inte — ett byte tog
	     olika lång tid och hade olika form på de två ytorna. Det är
	     kärnrörelse, och kärnrörelse får inte vara plattformsspecifik.

	     Sekunder för en NEUTRAL häst. Samma tal som RidKanon.OVERGANG,
	     och paritetsspecen faller om de glider isär. ]]
	Transition = {
		walk = 0.80, trot = 0.95, canter = 1.20,   -- uppåt, per gångart man går TILL
		downSoft = 0.98,                            -- nedåt när ryttaren bara håller emot
		downFirm = 0.78,                            -- nedåt vid full broms
		switchAt = 0.55,                            -- var i förloppet ETIKETTEN byter
	},
	TurnAccel = 6.0,       -- hur snabbt svängen får fäste, rad/s²

	--[[ Vändning på stället. Kurvaturmodellen ger noll vridning vid noll
	     fart — omega är kurvatur GÅNGER tempo — och det är rätt under
	     ritt: en häst i rörelse ska inte kunna snurra på fläcken. Men en
	     häst som STÅR ska kunna vrida sig, och tillståndsmaskinen har ett
	     eget läge för det. Den här termen blandas in där farten är låg
	     och tonas ut helt när hästen går. ]]
	TurnInPlaceRate = 0.85,   -- rad/s vid full styrning från stillastående
	TurnInPlaceBelow = 0.55,  -- m/s: över detta finns den inte alls

	--[[ Rampen på styrutslaget, sekunder. En tangent är av eller på, så
	     utan den finns bara tre lägen: helt vänster, rakt, helt höger.
	     Press är kortare än Release: svängen ska ta direkt men lämnas
	     mjukt. Hålls tiderna under ~0,2 s känns styrningen fortfarande
	     omedelbar — över det börjar den kännas trög. ]]
	SteerTauPress = 0.11,
	SteerTauRelease = 0.17,

	--[[ Lutningen samordnad med webbversionen. Signalen är densamma på
	     båda — centripetalkraften, alltså vridhastighet × tempo, vilket
	     är samma storhet som kurvatur × tempo² — men Roblox tillät 0,26
	     rad (15°) mot webbens 0,075 (4,3°). Femton grader läser som
	     motorcykel; en häst lutar sig knappt. ]]
	LeanMax = 0.075,       -- radianer roll i skarp sväng ≈ 4,3°
	LeanGain = 0.012,      -- roll per (rad/s × m/s)
	LeanTau = 0.16,        -- utjämning, sekunder

	ReverseSpeed = 1.1,    -- m/s bakåt
	BrakeExtra = 2.4,      -- m/s² extra retardation vid begärt stopp

	JumpPower = 42,        -- studs/s uppåt
	JumpMinSpeed = 1.6,
	JumpCooldown = 0.85,
	JumpStamina = 6,

	SlopeAlign = 0.55,     -- hur mycket av markens lutning kroppen tar
	SlopeTau = 0.25,       -- utjämning, sekunder — utan den skakar hästen
	ProbeDepth = 8,        -- studs, markavkänningens räckvidd
}

--[[ ── Studs per meter ──────────────────────────────────────────────
     All spellogik räknar i meter för att matcha den befintliga
     ridmodellen. Roblox räknar i studs. Omräkningen sker på ett ställe. ]]
--[[ ── RÄCKVIDD FÖR SKÖTSELMOMENT ───────────────────────────────────
     Så nära hästen man måste stå för att få göra ett steg, i studs.

     Talet låg i `GameplayService` och var serverns ensamma sanning — och
     det var rätt så länge bara servern behövde det. P0-3 i Tobias andra
     Studio-test ändrade det: HUD:en visade "Greet her calmly" medan
     spelaren stod någon annanstans, alltså lovade den en handling servern
     samtidigt nekade. För att HUD:en ska kunna säga sanningen måste
     klienten känna SAMMA gräns, och två kopior av ett tal är en gräns som
     glider.

     12 studs är valt: närmare än uppsittningens 14, och samma tal som den
     tidigare S2-specen använde. Game feel avgörs i Studio, inte här. ]]
Config.STEG_RACKVIDD = 12

Config.STUDS_PER_METRE = 3.0

function Config.toStuds(metres: number): number
	return metres * Config.STUDS_PER_METRE
end

function Config.toMetres(studs: number): number
	return studs / Config.STUDS_PER_METRE
end

--[[ ── Raser ─────────────────────────────────────────────────────────
     En ras är enbart data. Ingen ras får egen controllerkod — behöver en
     ras något systemet inte kan, är det systemet som ska växa. ]]
Config.BREEDS = {
	Arabian      = { Speed = .62, Acceleration = .66, Agility = .74, Endurance = .78, JumpStrength = .55, Temperament = "Sensitive", Height = 1.52 },
	Thoroughbred = { Speed = .84, Acceleration = .74, Agility = .52, Endurance = .58, JumpStrength = .62, Temperament = "Energetic", Height = 1.63 },
	Friesian     = { Speed = .48, Acceleration = .42, Agility = .46, Endurance = .56, JumpStrength = .48, Temperament = "Calm",      Height = 1.65 },
	Icelandic    = { Speed = .44, Acceleration = .58, Agility = .70, Endurance = .82, JumpStrength = .40, Temperament = "Brave",     Height = 1.38 },
	Warmblood    = { Speed = .58, Acceleration = .55, Agility = .58, Endurance = .62, JumpStrength = .72, Temperament = "Calm",      Height = 1.66 },
	QuarterHorse = { Speed = .66, Acceleration = .82, Agility = .68, Endurance = .54, JumpStrength = .50, Temperament = "Calm",      Height = 1.52 },
	Andalusian   = { Speed = .54, Acceleration = .60, Agility = .66, Endurance = .60, JumpStrength = .54, Temperament = "Brave",     Height = 1.60 },
	Mustang      = { Speed = .60, Acceleration = .64, Agility = .72, Endurance = .74, JumpStrength = .56, Temperament = "Stubborn",  Height = 1.50 },
	Shetland     = { Speed = .30, Acceleration = .52, Agility = .76, Endurance = .70, JumpStrength = .30, Temperament = "Stubborn",  Height = 1.02 },
}

--[[ Lynnet styr uttryck, inte svårighet. Det ska märkas på hur hästen
     beter sig när den står still — aldrig på att den blir jobbig att rida. ]]
Config.TEMPERAMENTS = {
	Calm      = { idleInterval = 9.0, reactGain = 0.80, accelBias = 1.00, soundRate = 0.6 },
	Energetic = { idleInterval = 5.0, reactGain = 1.25, accelBias = 1.08, soundRate = 1.3 },
	Sensitive = { idleInterval = 6.0, reactGain = 1.35, accelBias = 1.04, soundRate = 1.1 },
	Brave     = { idleInterval = 10.0, reactGain = 0.70, accelBias = 1.02, soundRate = 0.5 },
	Stubborn  = { idleInterval = 8.0, reactGain = 0.90, accelBias = 0.92, soundRate = 0.8 },
}

--[[ ── Animationer ───────────────────────────────────────────────────
     Namnen är nycklar, inte id:n. De verkliga rbxassetid-strängarna sätts
     som attribut på AnimationConfig i modellen, så att varje ras kan ha
     egna klipp utan att koden vet om det. ]]
Config.ANIMATION_KEYS = {
	"Idle", "IdleLookAround", "IdleTailSwish", "IdleEarFlick", "IdlePawGround",
	"Walk", "Trot", "Canter", "Gallop",
	"JumpStart", "JumpAir", "JumpLand",
	"Stop", "BackUp", "TurnLeft", "TurnRight",
	"Rear", "Graze",
}

--[[ Vilket klipp ett tillstånd spelar, och hur lång övertoningen är.
     Övertoningarna är olika långa med flit: uppåt i gångart går snabbt
     (hästen tar i), nedåt går mjukare (den rullar ut). ]]
--[[ `phase = true` betyder att klippet INTE spelas av sin egen klocka utan
     spolas av `loco.phase`, alltså av tillryggalagd sträcka. Se
     `AnimationController:step` för varför, och `HASTRIGG-KRAVSPEC.md` § 4.

     Bara de fyra cykliska gångarterna är fasdrivna. `Jump`, `Landing`,
     `Stopping` och `TurningInPlace` är händelser: de ska ta lika lång tid
     varje gång oavsett hur långt hästen kom under dem, och en fas som
     inte tickar när hästen står still skulle låsa dem i första bildrutan.
     `BackingUp` lämnas på klockan därför att fasen bara växer med
     `moved`, som är en längd utan tecken — baklänges ser ut som framåt. ]]
Config.STATE_ANIMATION = {
	Idle           = { key = "Idle",      fade = 0.35, looped = true },
	Walk           = { key = "Walk",      fade = 0.30, looped = true, phase = true },
	Trot           = { key = "Trot",      fade = 0.22, looped = true, phase = true },
	Canter         = { key = "Canter",    fade = 0.20, looped = true, phase = true },
	Gallop         = { key = "Gallop",    fade = 0.18, looped = true, phase = true },
	Jump           = { key = "JumpAir",   fade = 0.12, looped = true },
	Landing        = { key = "JumpLand",  fade = 0.10, looped = false },
	Stopping       = { key = "Stop",      fade = 0.16, looped = false },
	BackingUp      = { key = "BackUp",    fade = 0.25, looped = true },
	TurningInPlace = { key = "TurnLeft",  fade = 0.28, looped = true },
}

Config.IDLE_VARIANTS = { "IdleLookAround", "IdleTailSwish", "IdleEarFlick", "IdlePawGround" }

--[[ ── Kamera ────────────────────────────────────────────────────────
     Basvärden; gångarterna lägger till sina egna avstånd och fov. ]]
Config.CAMERA = {
	BaseFov = 70,
	MaxFov = 80,
	Tau = 0.35,          -- hur trögt kameran följer gångartsbytet
	YawTau = 0.13,       -- hur trögt kameran följer hästens kurs
	                     -- Kort: hästen ska svänga först och bilden hinna
	                     -- ifatt. Över ~0,2 s tappar man känslan av att
	                     -- styra, under ~0,08 s rycker bilden igen.
	Shoulder = 2.0,      -- studs åt sidan
	LookAhead = 6.0,     -- studs framför hästen som kameran siktar mot
}

--[[ ── Sadelkameran (G02-E del 1, issue #150) ────────────────────────
     Ridningens STANDARDVY. Config.CAMERA ovan beskriver inte längre hur
     ridningen ser ut — den beskriver den utifrånvy som lånas ut som
     feedbackvinkel `utifran`. Talen där är oförändrade; det är
     betydelsen som flyttat.

     TRE AV TALEN HÄR BÄR PARITETEN mot webbens KAM_SADEL i
     src/scen3d.js och är därför enhetslösa — sekunder är sekunder, och
     en kvot är en kvot:

       YawTau, TauXZ, TauY   sekunder, identiska med webben
       FovKvot               × basfov, identisk med webben
       NedKvot               fall delat med siktavstånd = 3,5° under
                             horisonten, identisk med webben

     LÄNGDERNA kan inte vara lika — webben räknar i meter, Roblox i
     studs — och räknas därför ur den här ytans EGNA bomvärden i stället
     för att kopieras: siktavståndet är en multipel av CAMERA.LookAhead,
     och fallet är siktavståndet gånger NedKvot. Det gör att blickens
     VINKEL blir densamma på båda ytorna, vilket är det man känner.

     INGEN SKAKNING. Kommentaren överst i CameraController gäller dubbelt
     nära förstaperson: sadelvyn lägger inte till någon rörelse alls, den
     DÄMPAR den riggen redan har. ]]
Config.CAMERA.Saddle = {
	YawTau = 0.10,       -- s  — blicken hinner ifatt hästens kurs
	TauXZ = 0.05,        -- s  — ögat sitter nästan stelt i sadeln i sidled
	TauY = 0.30,         -- s  — taktens studs dämpas hårt i höjdled
	CapY = 0.40,         -- studs — ögat får aldrig glida längre från huvudet
	FovKvot = 1.128,     -- × BaseFov: hals, öron OCH väg ska rymmas
	BlickKvot = 5.38,    -- × LookAhead
	NedKvot = 0.0607,    -- fall / siktavstånd = 3,5° under horisonten
}

--[[ Längderna HÄRLEDS ur den här ytans egna bomvärden i stället för att
     kopieras från webben. Det är hela paritetstricket: kvoterna är lika,
     alltså blir synfältet och blickens vinkel lika, medan studs förblir
     studs och meter förblir meter. Räknas här och inte i kameran, så att
     det finns ett enda ställe att läsa dem på. ]]
Config.CAMERA.Saddle.Fov = Config.CAMERA.BaseFov * Config.CAMERA.Saddle.FovKvot
Config.CAMERA.Saddle.LookAhead = Config.CAMERA.LookAhead * Config.CAMERA.Saddle.BlickKvot
Config.CAMERA.Saddle.Fall = Config.CAMERA.Saddle.LookAhead * Config.CAMERA.Saddle.NedKvot

--[[ ── Uthållighet ───────────────────────────────────────────────────
     Får aldrig tvinga hästen till stopp. Den sänker taket, hästen rullar
     ned en gångart, och spelaren ser varför i HUD:en. ]]
Config.STAMINA = {
	LowThreshold = 0.35,   -- under detta börjar taket sjunka
	FloorGait = "trot",    -- lägsta tak uthållighet kan pressa ned till
	RecoveryDelay = 1.2,   -- sekunder efter ansträngning innan påfyllning
}

--[[ Läser ett attribut ur en Configuration med fallback och typkontroll.
     Fel typ i Studio ska aldrig krascha spelet — då används standardvärdet
     och en varning skrivs en gång per nyckel. ]]
local warned: { [string]: boolean } = {}

function Config.attr(container: Instance?, key: string, fallback: any): any
	if not container then return fallback end
	local value = container:GetAttribute(key)
	if value == nil then return fallback end
	if typeof(value) ~= typeof(fallback) then
		if not warned[key] then
			warned[key] = true
			warn(("[Horse] %s är %s, förväntade %s. Använder standardvärdet.")
				:format(key, typeof(value), typeof(fallback)))
		end
		return fallback
	end
	return value
end

--[[ Slår ihop ras och individ till en färdig statistiktabell. Individens
     attribut vinner över rasens; rasens vinner över standard. ]]
function Config.resolveStats(statsConfig: Instance?): { [string]: any }
	local out = table.clone(Config.STATS)

	local breed = Config.attr(statsConfig, "Breed", out.Breed)
	local breedRow = Config.BREEDS[breed]
	if breedRow then
		out.Breed = breed
		for key, value in breedRow do
			out[key] = value
		end
	end

	for key, fallback in out do
		out[key] = Config.attr(statsConfig, key, fallback)
	end
	return out
end

--[[ Fyller en Configuration med de attribut som saknas, så att allt går
     att se och skruva i Studio i stället för att ligga dolt i kod. ]]
function Config.writeDefaults(container: Configuration, source: { [string]: any })
	for key, value in source do
		if container:GetAttribute(key) == nil and typeof(value) ~= "table" then
			container:SetAttribute(key, value)
		end
	end
end

return Config
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX4">
				<Properties>
					<string name="Name">Gaits</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Gångarterna — en rad per gångart, och allt som skiljer dem åt.

	Tempobanden är portade rakt av från den befintliga ridmodellen. De är
	intrimmade mot hur en häst faktiskt rör sig; ändra dem inte för att en
	animation känns fel, justera animationens hastighet i stället.

	Fyrsprånget är tillagt ovanpå den gamla galoppen genom att dela dess
	övre band. Allt annat i tabellen — acceleration, svarvhet, uthållighet,
	kamera, hovtakt — är nytt och satt för spelkänsla, inte för realism.
]]

local Gaits = {}

--[[ En rad i tabellen. Explicit typad: utan den härleder Luau
     "number | string" ur den blandade tabellen och varje jämförelse
     mot min/max blir ett typfel. ]]
export type Gait = {
	name: string, label: string,
	min: number, max: number, norm: number,
	cycles: number, steps: number,
	accel: number, retard: number, turn: number, svangTau: number,
	camera: { dist: number, height: number, fov: number },
}

Gaits.ORDER = { "halt", "walk", "trot", "canter", "gallop" }

--[[ HÖGSTA SPELBARA GÅNGART I G02-A.

     Fyrsprånget finns kvar som DATA — tempoband, kamera, uthållighet —
     men en spelare ska inte kunna nå det, därför att webben inte har
     gångarten. Efter PO-beslutet 2026-09-05 är webbens A-modell kanon
     och den slutar vid galopp; en femte spelbar gångart på bara den ena
     ytan är precis en sådan plattformsspecifik kärnregel som #82
     förbjuder.

     Taket läses av MovementController (spelarens stege), av
     HorseService (uthållighetstaket och valideringen av vad klienten
     påstår) och av paritetsspecen. Det står HÄR och ingen annanstans,
     så att en yta inte kan öppna gångarten av misstag.

     Att öppna fyrsprånget igen är ett produktbeslut som kräver att
     webben får motsvarande gångart först. ]]
Gaits.SPELBAR_TOPP = "canter"

--[[ steps  = hovnedslag per cykel (skritt fyra, trav två, galopp tre)
     accel  = m/s² uppåt   retard = m/s² nedåt
     turn   = andel av grundsvarvheten; hög fart ger vidare sväng
     svangTau = hur TRÖGT kurvaturen följer styrningen (G02-A.1 P3).
                turn säger hur snävt hon KAN svänga, svangTau hur snabbt
                bågen ändras. Skritten rättar sig kvickast, galoppen
                lägger sig i bågen långsammare och känns vidare.
                Samma tal som RID_KANON.SVANGTAU på webben.
     camera = { avstånd, höjd, fov-tillägg } ]]
Gaits.BY_NAME = ({
	halt = {
		name = "halt", label = "Halt", min = 0.00, max = 0.20,
		norm = 0.00, cycles = 0.00, steps = 0,
		accel = 3.2, retard = 5.5, turn = 1.00, svangTau = 1.00,
		camera = { dist = 14, height = 5.0, fov = 0 },
	},
	walk = {
		name = "walk", label = "Skritt", min = 0.90, max = 2.00,
		norm = 1.45, cycles = 0.900621, steps = 4,
		accel = 2.6, retard = 3.4, turn = 1.00, svangTau = 0.85,
		camera = { dist = 15, height = 5.2, fov = 0 },
	},
	trot = {
		name = "trot", label = "Trav", min = 2.40, max = 4.30,
		norm = 3.20, cycles = 1.451247, steps = 2,
		accel = 2.9, retard = 3.6, turn = 0.82, svangTau = 1.00,
		camera = { dist = 17, height = 5.6, fov = 1 },
	},
	canter = {
		name = "canter", label = "Galopp", min = 4.60, max = 8.00,
		norm = 5.60, cycles = 1.6, steps = 3,
		accel = 3.4, retard = 3.2, turn = 0.52, svangTau = 1.45,
		camera = { dist = 19, height = 6.0, fov = 4 },
	},
	gallop = {
		name = "gallop", label = "Fyrsprång", min = 8.20, max = 11.0,
		norm = 8.60, cycles = 2.05, steps = 4,
		accel = 3.0, retard = 2.6, turn = 0.42, svangTau = 1.60,
		camera = { dist = 23, height = 6.4, fov = 8 },
	},
} :: { [string]: Gait })

--[[ Hysteres: hur långt utanför sitt band en gångart får leva kvar.
     Utan den flimrar animationen fram och tillbaka vid varje gräns. ]]
Gaits.HYSTERESIS = 0.35

--[[ Trösklarna som gäller när nuvarande gångart inte längre räcker.
     Medvetet lagda mellan banden, inte på dem. ]]
local THRESHOLDS: { { under: number, gait: string } } = {
	{ under = 0.25, gait = "halt" },
	{ under = 2.20, gait = "walk" },
	{ under = 4.45, gait = "trot" },
	{ under = 7.10, gait = "canter" },
}

function Gaits.get(name: string): Gait
	return Gaits.BY_NAME[name] or Gaits.BY_NAME.halt
end

function Gaits.index(name: string): number
	for i, n in Gaits.ORDER do
		if n == name then return i end
	end
	return 1
end

function Gaits.byIndex(i: number): string
	return Gaits.ORDER[math.clamp(i, 1, #Gaits.ORDER)]
end

--[[ Vilken gångart ett tempo hör till, givet vilken vi är i nu. ]]
function Gaits.forSpeed(speed: number, current: string?): string
	local h = Gaits.HYSTERESIS
	if current then
		local g = Gaits.BY_NAME[current]
		if g and speed >= g.min - h and speed <= g.max + h then
			return current
		end
	end
	for _, row in THRESHOLDS do
		if speed < row.under then
			return row.gait
		end
	end
	return "gallop"
end

--[[ Hur snabbt animationsklippet ska spelas för att hovarna ska landa där
     marken är. Klippet är gjort för gångartens norm-tempo. Klampningen är
     medveten: sträcks ett klipp mer än så ska gångarten byta i stället,
     annars ser hästen ut att åka skridskor. ]]
function Gaits.playbackRate(name: string, speed: number): number
	local g = Gaits.get(name)
	if g.norm <= 0 then return 1 end
	return math.clamp(speed / g.norm, 0.72, 1.32)
end

--[[ Hur långt hästen går på en hel rörelsecykel, i meter.

     Fasen ska följa MARKEN, inte klockan: samma sträcka i samma gångart
     ska ge samma antal hovnedslag oavsett hur tempot råkade variera på
     vägen. Cykellängden räknas ur gångartens hemtempo delat med dess
     cykelfrekvens — det bevarar dagens takt vid normtempo och gör den
     distanslåst över resten av bandet.

     DET FANNS ETT stride-FÄLT HÄR. Det är borta, och skälet bör stå kvar.

     Fältet bar värdena 0,46 / 0,63 / 1,00 / 1,28 och en kommentar som sa att
     animationslagret använde dem som enskild steglängd i meter. Ingen av de två
     uppgifterna var sann. Fältet lästes inte av någon modul, och värdena var
     inte meter.

     Värdena är webbmodellens `steg`-fält i `src/model.js`, och där är de
     DIMENSIONSLÖSA FAKTORER. Webben räknar
     `SPRANG[kategori] × steg × modulering`, med `SPRANG.hast = 3,50 m`.
     Vid porteringen till Luau följde faktorerna med men multiplikatorn
     lämnades kvar. En faktor utan sin bas ser ut som ett mått och är det inte.

     Konsekvensen om någon hade trott på kommentaren: hovavtryck lagda på
     0,63 m i trav mot en verklig cykellängd på 2,13 m är 41 % fel, alltså
     precis den hovglidning som är förbjuden i acceptanskraven för riggen.

     Cykellängden är `Gaits.cycleLength`, och den är det enda bindande måttet.

     HARMONISERAD MOT WEBBEN (PO-beslut 2026-09-05). `cycles` är satt så att
     norm ÷ cycles ger webbens cykellängd, alltså SPRANG("hast") 3,50 gånger
     gångartens stegfaktor: skritt 1,61 m, trav 2,205 m, galopp 3,50 m. Var
     1,45 / 2,133 / 3,20. Det ändrar takten i animationen, och det är just
     vad harmoniseringen innebär — två produktfysiker blir en.

     Raden om att webben och Roblox INTE är överens stod kvar här efter
     harmoniseringen och motsade koden ovan. Den är borta; paritetsspecen
     mäter numera att cykellängderna är identiska. `HASTRIGG-KRAVSPEC.md`
     § 4 beskriver den gamla avvikelsen som historik. ]]
function Gaits.cycleLength(name: string): number
	local g = Gaits.get(name)
	if g.cycles <= 0 or g.norm <= 0 then return 0 end
	return g.norm / g.cycles
end

--[[ Hovnedslag per sekund — driver ljud och damm. ]]
function Gaits.beatRate(name: string, speed: number): number
	local g = Gaits.get(name)
	if g.steps == 0 or g.norm <= 0 then return 0 end
	return g.cycles * g.steps * (speed / g.norm)
end

return Gaits
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX5">
				<Properties>
					<string name="Name">Hjalper</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	G02-B punkt 1 — RYTTARENS HJÄLPER SOM SEMANTIK, Roblox-sidan.

	Motsvarigheten till src/riding/hjalper.js. Samma översättning, samma
	tal — och talen SKRIVS INTE AV: de läses ur RidKanon.HJALP, som
	genereras ur webbens modul av tools/exportera-ridkanon.mjs. Ändras de
	på webben ändras de här, och paritetsspecen faller om exporten inte
	körts.

	Axlarna är enhetens språk, orden är ridningens:

	  skänkel     framåtdrivande hjälp        (Roblox `intent.forward`)
	  styrning    hur mycket böjning som begärs (`intent.steer`)
	  tygel       kontakten ryttaren håller    (`intent.rein`, ny i G02-B)
	  innertygel  tygel + styrutslagets begäran
	  yttertygel  tygel − styrutslagets eftergift
	  yttertygelstöd  hur stor del av böjningen yttertygeln bär
	  parad       halvhalten som EGEN signal   (`intent.parad`)

	  sits        hur djupt ryttaren sitter    (`intent.seat`, ny)
	  vikt        bågens sida × sitsens djup

	SITSEN FICK EN EGEN AXEL efter senior review av #87. Shift och Ctrl är
	gångartsknappar sedan Gate 01 och rörs inte; sitsen ligger på Z och C,
	och analogt på vänster avtryckare. Att den saknades var inte ett
	scope-beslut utan ett hål: #83 kräver vikt/säte som balansmodifierare,
	och den delen av modellen gick då inte att ha på Roblox alls.
]]

local RidKanon = require(script.Parent.RidKanon)

local Hjalper = {}

--[[ Fältnamnen är kontraktet, hämtade ur kanonen så att de två ytorna
     inte kan publicera olika ord för samma sak. ]]
Hjalper.FALT = RidKanon.HJALP_FALT
Hjalper.HARLEDDA = RidKanon.HJALP_HARLEDDA

--[[ Tomt sedan senior review av #87 gav sitsen en egen axel. Listan står
     kvar som kontrakt: nästa hjälp utan källa ska deklareras här och
     inte utelämnas tyst. ]]
Hjalper.SAKNAS = {}

local function kl(v: number, lo: number, hi: number): number
	return math.clamp(v, lo, hi)
end

--[[ En bildrutas hjälper → ridningens ord. `a` har fälten skankel, tygel
     och styrning i samma skalor som webbens: skänkel och tygel 0–1 kring
     sina neutrallägen, styrning −1..1. ]]
function Hjalper.semantik(a: { [string]: number }): { [string]: any }
	local H = RidKanon.HJALP
	local t = kl(a.tygel or 0, 0, 1)
	local sb = kl(a.styrning or 0, -1, 1)
	local s = math.abs(sb)
	local innerTygel = kl(t + s * H.INNER_BER * (1 - t), 0, 1)
	local ytterTygel = kl(t - s * H.YTTER_SLAPP * t, 0, 1)
	--[[ Rakt fram är `ber` noll och stödet därmed 1 — på ett rakt spår
	     finns ingen inner- och yttersida att göra fel med. Formen faller
	     ut i 1 av sig själv i stället för att behöva en gräns som stänger
	     av termen. Identisk med webbens. ]]
	local ber = kl(s / H.STYR_FULLT, 0, 1)
	local behov = H.TYGEL_NEUTRAL + H.STOD_KRAV * ber
	local bar = kl(ytterTygel / behov, 0, 1)
	local sits = a.sits or 0
	return {
		skankel = a.skankel or 0,
		tygel = t,
		sits = sits,
		styrning = sb,
		innerTygel = innerTygel,
		ytterTygel = ytterTygel,
		ytterstod = 1 - ber * (1 - bar),
		bojSida = if s > H.BOJ_TROSKEL then (if sb > 0 then 1 else -1) else 0,
		--[[ Vikten följer bågen, som på webben: sitsen säger hur djupt
		     ryttaren sitter, bågen åt vilket håll vikten går. ]]
		vikt = (if s > H.BOJ_TROSKEL then (if sb > 0 then 1 else -1) else 0)
			* math.min(1, s * 1.4),
		parad = kl(a.parad or 0, 0, 1),
	}
end

--[[ Paradens kvalitet i det ögonblick den ges: hästen ska vara framför
     skänkeln och handen i kontaktbandet.

     BÅDA YTORNA VÄGER TVÅ HJÄLPER: skänkeln mot tröskeln och handen mot
     kontaktbandet. Sitsen ingår inte i formeln på någondera ytan.

     Den här kommentaren påstod tidigare att webben väger tre — det var
     fel, och senior review av #87 fångade det. src/riding/hjalper.js har
     alltid vägt två. Paritetsspecen jämför formlerna mot webbens egna
     golden-rader, så talen var aldrig i osynk; det var beskrivningen. ]]
function Hjalper.paradKvalitet(a: { [string]: number }): number
	local H = RidKanon.HJALP
	local K = RidKanon.KONTAKT
	local driv = kl(((a.skankel or 0) - K.SKANKEL_TROSKEL) / 0.30, 0, 1)
	local mitt = (K.TYGEL_BAND_MIN + K.TYGEL_BAND_MAX) / 2
	local halv = (K.TYGEL_BAND_MAX - K.TYGEL_BAND_MIN) / 2
	local iband = kl(1 - math.abs((a.tygel or 0) - mitt) / (halv * 1.6), 0, 1)
	return kl(H.PARAD_GOLV + H.PARAD_DRIV * driv + H.PARAD_BAND * iband, 0, 1)
end

return Hjalper
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX6">
				<Properties>
					<string name="Name">Inspelning</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	INSPELNINGEN — spelarens faktiska ritt, en gång.

	G02-D (#137): "Record the player's actual ride once and reuse it for
	playback, comparison and assessment. Do not create a separate scoring
	model for replay."

	Därför gör den här modulen EN sak: den skriver ned vad som hände. Den
	bedömer ingenting. Betygen kommer ur HorseCore/Lektion och
	HorseCore/Ugneta som förut, ur samma telemetri som matar inspelningen.
	Det finns ingen andra bedömningsväg och ska inte finnas.

	MOTOROBEROENDE. Ingen Instance, ingen RunService, ingen GUI. Modulen
	tar emot dt, ett telemetriobjekt och en pose, och lämnar ifrån sig en
	post. Den speglar src/riding/inspelning.js på webben fält för fält.

	TIDPOLICY: `sim`. Tiden är ACKUMULERAD dt ur klientens RenderStepped,
	inte os.clock(). En ritt inspelad på 30 fps och en på 120 fps ska
	beskriva samma ritt, och en klient som tappar en bildruta ska inte
	spela in ett hål.

	TALEN KOMMER UR KANONEN. Sampeltakt, tak och varje övnings
	definitionsversion läses ur RidKanon.INSPELNING, som
	tools/exportera-ridkanon.mjs skriver ur src/riding/ovningsdef.js och
	src/riding/inspelning.js. En handskriven kopia här hade kunnat glida
	ifrån webben utan att någon grind blev röd.

	PRESTANDA: `sampla` anropas varje bildruta men skriver bara var 1/20 s.
	Övriga anrop faller på en jämförelse och returnerar. Ingenting skrivs
	till DataStore under ritten.
]]

local RidKanon = require(game:GetService("ReplicatedStorage").HorseCore.RidKanon)

local Inspelning = {}

local KANON = RidKanon.INSPELNING
Inspelning.SCHEMA = KANON.SCHEMA
Inspelning.HZ = KANON.HZ
Inspelning.MAX_SEK = KANON.MAX_SEK
Inspelning.MAX_SAMPEL = KANON.MAX_SEK * KANON.HZ
Inspelning.MAX_HANDELSER = 200

local DT = 1 / KANON.HZ

export type Sampel = {
	t: number,
	x: number?, z: number?, yaw: number?,
	gangart: string?,
	fart: number?, balans: number?, kurvatur: number?,
}

export type Handelse = { t: number, typ: string, data: any }

export type Post = {
	schema: number,
	ovning: string,
	ovningVersion: number,
	ram: string?,
	hast: string?,
	klocka: string,
	hz: number,
	sekunder: number,
	trunkerad: boolean,
	sampel: { Sampel },
	handelser: { Handelse },
}

export type Recorder = { post: Post, aktiv: boolean, t: number, nasta: number }

--[[ Ett tal som får skrivas ned. Samma disciplin som HorseCore/Lektion.tal
     och webbens insTal: saknat, NaN och oändlighet är INTE noll. Ett fält
     som inte gick att mäta blir nil i posten, och den som läser posten får
     veta att det saknades i stället för att tro på en nolla. ]]
local function tal(v: any): number?
	if type(v) ~= "number" then return nil end
	if v ~= v then return nil end                      -- NaN
	if v == math.huge or v == -math.huge then return nil end
	return v
end

--[[ Spelas den här övningen in?

     G02-D:s leverans är de TVÅ övningar som faktiskt har en definition med
     version och mätlista i kanonen. Att spela in en övning utan definition
     hade gett en post som ingen kan säga vad den betyder — och att hitta på
     en version åt den vore precis den påhittade referens beställningen
     förbjuder. Listan kommer ur kanonen, inte ur en if-sats här. ]]
function Inspelning.spelasIn(ovning: string?): boolean
	if type(ovning) ~= "string" then return false end
	return KANON.OVNING[ovning] ~= nil
end

function Inspelning.version(ovning: string): number?
	local d = KANON.OVNING[ovning]
	return d and d.version or nil
end

--[[ Kan den här posten läsas av koden som kör nu?

     Tre svar, aldrig ett tyst ja — samma tre som webbens inspelningLasbar:
     "ok" när schema och övningsversion stämmer, "gammal" när posten är
     läsbar men äldre än definitionen (en jämförelse mot den ska MÄRKAS),
     och "nej" med skäl när den inte får tolkas alls. ]]
function Inspelning.lasbar(post: any): { ok: boolean, lage: string, skal: string }
	if type(post) ~= "table" then
		return { ok = false, lage = "nej", skal = "ingen post" }
	end
	if post.schema ~= Inspelning.SCHEMA then
		return { ok = false, lage = "nej",
			skal = `schema {tostring(post.schema)} mot {Inspelning.SCHEMA}` }
	end
	local d = if type(post.ovning) == "string" then KANON.OVNING[post.ovning] else nil
	if not d then
		return { ok = false, lage = "nej", skal = `okänd övning {tostring(post.ovning)}` }
	end
	if post.ovningVersion ~= d.version then
		return { ok = true, lage = "gammal",
			skal = `övningsversion {tostring(post.ovningVersion)} mot {d.version}` }
	end
	return { ok = true, lage = "ok", skal = "" }
end

--[[ Startar en inspelning. Returnerar nil för en övning utan definition —
     hellre ingen post än en post utan betydelse. ]]
function Inspelning.ny(ovning: string, hast: string?): Recorder?
	local d = if type(ovning) == "string" then KANON.OVNING[ovning] else nil
	if not d then return nil end
	return {
		aktiv = true, t = 0, nasta = 0,
		post = {
			schema = Inspelning.SCHEMA,
			ovning = ovning,
			ovningVersion = d.version,
			ram = d.ram,
			hast = hast,
			klocka = "sim",
			hz = Inspelning.HZ,
			sekunder = 0,
			trunkerad = false,
			sampel = {},
			handelser = {},
		},
	}
end

--[[ POSEN, VALIDERAD FÄLT FÖR FÄLT.

     Det här är rättelsen som beställningen ber om uttryckligen: en pose
     där x eller z är trasig men yaw är ett riktigt tal ska behålla YAW.
     Ett tidigare utkast kastade hela posen så fort ett fält inte höll —
     och då förlorade uppspelningen hästens riktning i varje bildruta där
     positionen råkade vara omätbar, trots att riktningen var mätt.

     Motsatsen vore lika fel: att fylla i noll för det som saknas. Noll är
     ett läge och en riktning, inte "vet inte". Fältet blir nil. ]]
local function pose(p: any): (number?, number?, number?)
	if type(p) ~= "table" then return nil, nil, nil end
	return tal(p.x), tal(p.z), tal(p.yaw)
end

--[[ Ett steg ur ridloopen. Anropas varje bildruta; skriver var 1/20 s.

     `dt` måste vara ett riktigt positivt tal inom rimliga gränser. En
     klient som återvänder från bakgrunden med dt = 4,2 s ska inte skriva
     ett sampel som påstår att hästen teleporterade. ]]
function Inspelning.sampla(r: Recorder?, dt: any, tm: { [string]: any }?, p: any): boolean
	if not r or not r.aktiv then return false end
	local d = tal(dt)
	if d == nil or d <= 0 or d > 0.5 then return false end

	r.t += d
	if r.t < r.nasta then return false end
	--[[ Nästa sampel schemaläggs från FÖRRA MÅLET, inte från nu. Skrevs
	     `r.nasta = r.t + DT` blev intervallet en bildruta för långt varje
	     gång och takten drev. Har vi hamnat efter — en lång bildruta —
	     resynkas i stället för att skriva en skur av sampel i kapp. ]]
	r.nasta += DT
	if r.nasta <= r.t then r.nasta = r.t + DT end

	if #r.post.sampel >= Inspelning.MAX_SAMPEL then
		r.post.trunkerad = true
		r.aktiv = false
		return false
	end

	local x, z, yaw = pose(p)
	local t = if type(tm) == "table" then tm else {}
	table.insert(r.post.sampel, {
		t = math.floor(r.t * 1000 + 0.5) / 1000,
		x = x, z = z, yaw = yaw,
		gangart = if type(t.gangart) == "string" then t.gangart else nil,
		fart = tal(t.fart),
		balans = tal(t.balans),
		kurvatur = tal(t.kurvatur),
	})
	r.post.sekunder = r.post.sampel[#r.post.sampel].t
	return true
end

--[[ En diskret händelse — gångartsbyte, avbrott, avsittning. Samma
     simklocka som samplen, så att de går att lägga bredvid varandra. ]]
function Inspelning.handelse(r: Recorder?, typ: string?, data: any): boolean
	if not r or not r.aktiv or type(typ) ~= "string" or typ == "" then return false end
	if #r.post.handelser >= Inspelning.MAX_HANDELSER then return false end
	table.insert(r.post.handelser, {
		t = math.floor(r.t * 1000 + 0.5) / 1000, typ = typ, data = data,
	})
	return true
end

--[[ Avslutar och lämnar posten. Efter det här är inspelaren stängd: ett
     sent `sampla` från en bildruta som redan var i luften kan inte skriva
     in sig i en avslutad ritt. ]]
function Inspelning.avsluta(r: Recorder?): Post?
	if not r then return nil end
	r.aktiv = false
	return r.post
end

--[[ ── UPPSPELNINGEN ────────────────────────────────────────────────
     Läser en post. Ändrar den ALDRIG, och rör ingenting levande: ingen
     häst, ingen progression, inget serverauktoritativt tillstånd.

     Interpolationen vägrar interpolera mellan sampel den inte litar på:
     saknas ett tal i något av de två grannsamplen blir svaret nil för just
     det fältet, i stället för ett halvvägs-tal mellan ett mätvärde och
     ingenting. ]]
local function lerp(a: number?, b: number?, k: number): number?
	if a == nil or b == nil then return nil end
	return a + (b - a) * k
end

--[[ Vinklar interpoleras kortaste vägen — annars snurrar hästen ett helt
     varv när yaw passerar π. ]]
local function lerpVinkel(a: number?, b: number?, k: number): number?
	if a == nil or b == nil then return nil end
	local d = b - a
	while d > math.pi do d -= 2 * math.pi end
	while d < -math.pi do d += 2 * math.pi end
	return a + d * k
end

--[[ Tillståndet vid en tidpunkt. nil när posten är tom — en uppspelning
     utan sampel ska inte låtsas ha ett läge. ]]
function Inspelning.vid(post: Post?, tid: any): Sampel?
	if type(post) ~= "table" then return nil end
	local S = post.sampel
	if type(S) ~= "table" or #S == 0 then return nil end
	local n = tal(tid) or 0
	local t = math.max(0, math.min(post.sekunder, n))

	--[[ Binärsökning: en uppspelning ska inte bli långsammare ju längre
	     ritten var. ]]
	local lo, hi = 1, #S
	while lo < hi - 1 do
		local m = (lo + hi) // 2
		if S[m].t <= t then lo = m else hi = m end
	end
	local a, b = S[lo], S[hi]
	if a == b or b.t <= a.t then return a end
	local k = math.max(0, math.min(1, (t - a.t) / (b.t - a.t)))
	return {
		t = t,
		x = lerp(a.x, b.x, k),
		z = lerp(a.z, b.z, k),
		yaw = lerpVinkel(a.yaw, b.yaw, k),
		--[[ Gångarten är DISKRET. Halvvägs mellan trav och skritt finns
		     ingen gångart; närmaste sampel gäller. ]]
		gangart = if k < 0.5 then a.gangart else b.gangart,
		fart = lerp(a.fart, b.fart, k),
		balans = lerp(a.balans, b.balans, k),
		kurvatur = lerp(a.kurvatur, b.kurvatur, k),
	}
end

return Inspelning
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX7">
				<Properties>
					<string name="Name">Kameralage</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	KAMERALÄGET UNDER RITTEN — G02-E del 1 (issue #150).

	Tobias produktbeslut 2026-09-08: när spelaren rider ska standard-
	kameran vara RYTTARENS perspektiv — vyn från sadeln, med hästens hals
	och öron och vägen framåt. När feedback ges får spelet TILLFÄLLIGT
	visa en annan relevant vinkel, och sedan ska kameran återgå. Mjukt,
	kort, och utan att störa kontrollkänslan.

	VAD SOM FAKTISKT FANNS INNAN. Ingen av ytorna hade ett ryttar-
	perspektiv. CameraController la ögat på Gaits.camera.dist studs BAKOM
	hästen — 14 i skritt, 23 i fyrsprång — och webbens s3Kamera gjorde
	detsamma med 3,78–5,13 m. Båda är tredjepersonskameror. Den gamla
	vyn är inte kastad; den är DEGRADERAD till feedbackvinkeln `utifran`,
	där den hör hemma: att se sig själv utifrån är pedagogiskt, men det
	är inte att rida.

	Den här modulen är webbens src/riding/kameralage.js, tal för tal och
	regel för regel. Den äger LÄGET — inte kameran. CameraController
	frågar den vad som gäller och interpolerar mellan sadeln (vikt 0) och
	vinkeln (vikt 1); modulen rör ingen Instance, ingen rörelse och ingen
	input, och kan alltså inte ändra ridkänslan.

	Reglerna, identiska med webbens:

	  1. SADELN ÄR STANDARD. Läget börjar i `ryttare` och faller alltid
	     tillbaka dit.
	  2. EN FEEDBACKVINKEL ÅT GÅNGEN, aldrig köad. En begäran tas emot
	     eller avvisas på plats — ingen begäran kan tändas senare.
	  3. TIDEN ÄR BEGRÄNSAD I KODEN. In-, håll- och uttoning, validerad
	     summa, och ett hårt tak ovanpå.
	  4. VIKTEN ÄR MJUK OCH DETERMINISTISK — smoothstep av ackumulerad
	     dt, aldrig väggklocka.

	VINKLARNA ÄR RELATIVA TILL HÄSTEN: yaw i radianer plus fyra
	MULTIPLIKATORER på den gångartsburna bom som redan finns. Därför bär
	Roblox och webben EXAKT samma tal trots studs mot meter och grader mot
	radianer. Det är samma paritetsregel som redan gäller Gaits.camera.
]]

local Kameralage = {}

export type Vinkel = {
	yaw: number, bak: number, hojd: number, fov: number, blick: number,
	["in"]: number, hall: number, ut: number,
}

export type Lage = {
	lage: string, id: string?, fas: string,
	t: number, total: number, vikt: number, startVikt: number, orsak: string?,
}

export type Upplost = {
	lage: string, id: string?, vikt: number,
	yaw: number, bak: number, hojd: number, fov: number, blick: number,
}

--[[ Neutralläget = sadelvyn. Vikt 0 betyder "ingen feedbackvinkel alls".
     Att sadeln är FRÅNVARON av en vinkel och inte ett eget specialfall är
     avsikt: går läget sönder är ryttarperspektivet kvar. ]]
Kameralage.NEUTRAL = { yaw = 0, bak = 1, hojd = 1, fov = 1, blick = 1 }

--[[ Hårda gränser. En konfiguration utanför dem registreras inte alls —
     hellre ingen vinkel än en som ställer kameran inuti hästen eller
     håller kvar bilden i en kvart. ]]
local GRANS = {
	yaw = { -math.pi, math.pi },
	bak = { 0.35, 3.0 },
	hojd = { 0.40, 4.0 },
	fov = { 0.75, 1.35 },
	blick = { -1.5, 2.5 },
	["in"] = { 0.15, 1.2 },
	hall = { 0.20, 4.0 },
	ut = { 0.15, 1.5 },
}
Kameralage.GRANS = GRANS

local MAX_TOTAL = 6.0
local MAX_UT = 1.5
local DT_TAK = 0.1
Kameralage.MAX_TOTAL = MAX_TOTAL

--[[ ── Vinklarna ─────────────────────────────────────────────────────
     Samma fyra som webben, samma tal. Fler hör till del 2 och ska in när
     det är bestämt VILKEN händelse som ska visa vad.

     Talen är DERIVED — spelkänsla, inte UBRF-fakta. ]]
local VINKLAR: { [string]: Vinkel } = {
	--[[ DEN GAMLA TREDJEPERSONSVYN, oförändrad: yaw 0 och alla
	     multiplikatorer 1 ger exakt den bom Gaits.camera beskriver. Kvar
	     som den bästa översiktsbilden vi har — men som en LÅNAD vy, inte
	     som ridningens standard. ]]
	utifran = { yaw = 0, bak = 1.00, hojd = 1.00, fov = 1.00, blick = 1.00,
		["in"] = 0.45, hall = 1.80, ut = 0.55 },
	--[[ SITSEN OCH HÄSTENS FORM. Från sidan, blicken på ekipaget. ]]
	sits = { yaw = math.pi / 2, bak = 0.95, hojd = 0.92, fov = 0.94, blick = 0.10,
		["in"] = 0.40, hall = 1.60, ut = 0.50 },
	--[[ VÄGVALET OCH AVSTÅNDET. Högre och längre bak, blicken längre fram. ]]
	vagval = { yaw = 0, bak = 1.90, hojd = 2.40, fov = 1.08, blick = 1.30,
		["in"] = 0.45, hall = 1.70, ut = 0.55 },
	--[[ HINDERANSATSEN OCH TAJMINGEN. Framifrån, låg, blicken bakom hästen
	     så att hon står mellan kameran och siktpunkten. ]]
	ansats = { yaw = math.pi, bak = 1.25, hojd = 1.05, fov = 1.00, blick = -0.35,
		["in"] = 0.40, hall = 1.50, ut = 0.50 },
}

--[[ ── Validering ────────────────────────────────────────────────────
     Körs en gång vid inläsning. En vinkel som inte håller måtten tas BORT
     i stället för att klampas: en tyst korrigering hade gjort att felet
     aldrig upptäcktes. ]]
local FALT = { "yaw", "bak", "hojd", "fov", "blick", "in", "hall", "ut" }

local function inom(v: any, g: { number }): boolean
	return typeof(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
		and v >= g[1] and v <= g[2]
end

function Kameralage.validera(_id: string, v: any): string?
	if typeof(v) ~= "table" then return "ingen tabell" end
	for _, namn in FALT do
		if not inom(v[namn], GRANS[namn]) then
			return string.format("%s=%s utanför [%s, %s]", namn, tostring(v[namn]),
				tostring(GRANS[namn][1]), tostring(GRANS[namn][2]))
		end
	end
	local total = v["in"] + v.hall + v.ut
	if total > MAX_TOTAL then
		return string.format("in+håll+ut = %.2f s över taket %.1f s", total, MAX_TOTAL)
	end
	return nil
end

do
	local bort = {}
	for id, v in VINKLAR do
		local fel = Kameralage.validera(id, v)
		if fel then
			warn(("[Kameralage] vinkeln \"%s\" registrerades inte — %s"):format(id, fel))
			table.insert(bort, id)
		end
	end
	for _, id in bort do VINKLAR[id] = nil end
end

Kameralage.VINKLAR = VINKLAR

function Kameralage.giltig(id: any): boolean
	return typeof(id) == "string" and VINKLAR[id] ~= nil
end

function Kameralage.vinkel(id: any): Vinkel?
	if typeof(id) ~= "string" then return nil end
	return VINKLAR[id]
end

--[[ ── Tillståndet ───────────────────────────────────────────────────
     `fas` är den enda sanningen om var i övergången vi är:
       vila  — sadelvyn, vikt 0, ingen vinkel utlånad
       in    — vikten stiger mot den begärda vinkeln
       hall  — vinkeln ligger stilla på full vikt
       ut    — vikten faller tillbaka mot sadeln
     Det finns AVSIKTLIGT ingen femte fas och ingen kö. ]]
function Kameralage.skapa(): Lage
	return { lage = "ryttare", id = nil, fas = "vila",
		t = 0, total = 0, vikt = 0, startVikt = 0, orsak = nil }
end

local function mjuk(p: number): number
	local w = if p < 0 then 0 elseif p > 1 then 1 else p
	return w * w * (3 - 2 * w)
end

--[[ Begär en tillfällig feedbackvinkel.

     Returnerar true om begäran togs emot, annars false UTAN att röra
     tillståndet. Avvisning är regel, inte undantag:

     - Okänd vinkel avvisas.
     - En ANNAN vinkel medan en redan är uppe avvisas. Att byta vinkel
       mitt i en pågående vikt hade flyttat kameran ett halvt varv i en
       bildruta — ett klipp mitt i styrningen. Anroparen får släppa den
       pågående vyn först.
     - SAMMA vinkel medan den är uppe tas emot och startar om från
       nuvarande vikt; offseten är identisk, så det syns ingen skarv.

     `total` NOLLSTÄLLS BARA VID EN RIKTIGT NY BEGÄRAN (fas var "vila").
     En upprepad begäran om SAMMA vinkel medan den redan är uppe rör
     inte `total` — annars kunde en anropare som råkar begära om samma
     vinkel varje bildruta hålla kvar feedbackvyn för evigt genom att
     varje anrop nollställde klockan som MAX_TOTAL/nödbromsen läser. Den
     ORIGINALA deadlinen, räknad från första begäran, gäller oavsett hur
     många gånger samma vinkel begärs på nytt. ]]
function Kameralage.begar(st: Lage, id: any, orsak: string?): boolean
	if not st or not Kameralage.giltig(id) then return false end
	local nyBegaran = st.fas == "vila"
	if not nyBegaran and st.id ~= id then return false end
	st.lage = "feedback"
	st.id = id
	st.fas = "in"
	st.t = 0
	if nyBegaran then st.total = 0 end
	st.startVikt = st.vikt
	st.orsak = orsak
	return true
end

--[[ Släpp vyn i förtid — mjukt. Sammanhanget tog slut men spelaren rider
     vidare: uttoningen körs, och sedan är sadeln tillbaka. ]]
function Kameralage.slapp(st: Lage, orsak: string?): boolean
	if not st or st.fas == "vila" or st.fas == "ut" then return false end
	st.fas = "ut"
	st.t = 0
	st.startVikt = st.vikt
	if orsak then st.orsak = orsak end
	return true
end

--[[ Nollställ HÅRT och omedelbart — ingen uttoning.

     Scenbytet, avsittningen, overlayen och lektionsstarten. I samtliga
     fall är bilden ändå på väg att bytas ut eller täckas, och en mjuk
     uttoning över ett scenbyte hade bara betytt att den gamla vyn levde
     vidare en halv sekund in i den nya. Efter det här anropet finns ingen
     begäran kvar som kan tändas senare. ]]
function Kameralage.nollstall(st: Lage, orsak: string?): boolean
	if not st then return false end
	local varAktiv = st.fas ~= "vila"
	st.lage = "ryttare"
	st.id = nil
	st.fas = "vila"
	st.t = 0
	st.total = 0
	st.vikt = 0
	st.startVikt = 0
	st.orsak = orsak
	return varAktiv
end

function Kameralage.aktiv(st: Lage?): boolean
	return st ~= nil and (st :: Lage).fas ~= "vila"
end

--[[ Vad kameran ska använda just nu. Ren avläsning — stegar ingenting. ]]
function Kameralage.las(st: Lage?): Upplost
	local v = if st and st.vikt > 0 then Kameralage.vinkel(st.id) else nil
	if not v then
		local N = Kameralage.NEUTRAL
		return { lage = "ryttare", id = nil, vikt = 0,
			yaw = N.yaw, bak = N.bak, hojd = N.hojd, fov = N.fov, blick = N.blick }
	end
	local s = st :: Lage
	return { lage = "feedback", id = s.id, vikt = s.vikt,
		yaw = v.yaw, bak = v.bak, hojd = v.hojd, fov = v.fov, blick = v.blick }
end

--[[ Stega övergången en bildruta och lämna tillbaka det upplösta läget.

     All tid som styr faserna kommer HÄRIFRÅN. Ingen os.clock, ingen
     tick(): samma dt-följd ger samma vy, vilket är vad "deterministisk
     återgång" betyder i praktiken och vad specen mäter. ]]
function Kameralage.stega(st: Lage, dt: number): Upplost
	if not st then return Kameralage.las(nil) end
	local d = if typeof(dt) == "number" and dt == dt then dt else 0
	if d < 0 then d = 0 elseif d > DT_TAK then d = DT_TAK end

	if st.fas ~= "vila" then
		local v = Kameralage.vinkel(st.id)
		--[[ Vinkeln försvann under körning. Då är sadeln rätt svar, direkt. ]]
		if not v then
			Kameralage.nollstall(st, "vinkel-borta")
			return Kameralage.las(st)
		end
		local vv = v :: Vinkel

		st.t += d
		st.total += d

		--[[ Nödbromsen först, så att en trasig konfiguration inte kan hålla
		     kvar bilden bara för att dess egna faser aldrig tar slut. ]]
		if st.total >= MAX_TOTAL + MAX_UT then
			Kameralage.nollstall(st, "tidstak")
			return Kameralage.las(st)
		end
		if st.total >= MAX_TOTAL and st.fas ~= "ut" then
			st.fas = "ut"; st.t = 0; st.startVikt = st.vikt
		end

		if st.fas == "in" then
			local p = if vv["in"] > 0 then st.t / vv["in"] else 1
			st.vikt = st.startVikt + (1 - st.startVikt) * mjuk(p)
			if p >= 1 then st.vikt = 1; st.fas = "hall"; st.t = 0 end
		elseif st.fas == "hall" then
			st.vikt = 1
			if st.t >= vv.hall then st.fas = "ut"; st.t = 0; st.startVikt = 1 end
		end
		if st.fas == "ut" then
			local p = if vv.ut > 0 then st.t / vv.ut else 1
			st.vikt = st.startVikt * (1 - mjuk(p))
			--[[ Uttoningen når exakt noll, och DÄR nollställs allt. Ett
			     "nästan noll" hade lämnat en vinkel registrerad som inte
			     syns — ett stall-läge som senare kunde vakna. ]]
			if p >= 1 then Kameralage.nollstall(st, "atergang") end
		end
	end
	return Kameralage.las(st)
end

return Kameralage
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX8">
				<Properties>
					<string name="Name">Lektion</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	LEKTIONEN — G02-C:s försökslifecycle på Roblox.

	Det här är modulen som saknades. Roblox hade Ugnetas bedömnings-
	KONTRAKT (HorseCore/Ugneta) och en HUD (UgnetaController), men inget
	som faktiskt körde en lektion: ingen mätning per bildruta, inget
	försök 1 → 2, ingen som avgjorde när kortet skulle upp. Provet kunde
	därför bara visa att HUD:en gick att anropa — inte att en spelare som
	rider en ritt får undervisningen. Det är precis läktarfelet (#114):
	hjälpfunktionen grön, produktionskedjan oansluten.

	Modulen är REN: inga Instances, ingen RunService, inga globala
	tillstånd. Den tar telemetri in och ger händelser ut, vilket är just
	det som gör att bänken kan spela upp en hel ritt.

	INGEN EGEN SANNING. Övningarnas ordning och text, dimensionerna,
	live-ordförrådet, trösklarna och kvalitetsformelns tal läses ur
	RidKanon.UGNETA, som genereras ur webbens src/larare.js. Ändrar
	webben en tröskel följer Roblox med i samma commit.
]]

local RidKanon = require(script.Parent.RidKanon)
local Ugneta = require(script.Parent.Ugneta)

local Lektion = {}

local UG = RidKanon.UGNETA
local KV = UG.KVALITET

Lektion.ORDNING = UG.ORDNING
Lektion.OVNINGAR = UG.OVNINGAR

--[[ VAD SOM INTE GÅR ATT MÄTA HÄR — deklarerat, inte tigit ihjäl.

	Webbens `rytm` och halva `linje` kommer ur utbildningsskalan
	(`G.ride.skala.takt` / `.rakriktning`), en modell som bara finns i
	src/model.js. Roblox har ingen utbildningsskala. Två val fanns:
	räkna fram något eget som SER ut som takt, eller säga att den inte
	är mätt. Det första hade varit en påhittad siffra i en pedagogik som
	påstår sig komma ur riktig telemetri, så det andra gäller.

	En omätt dimension är `nil` — inte 0. Skillnaden är hela poängen:
	en nolla hade gjort rytmen till den svagaste dimensionen i varje
	20 m volt, och Ugneta hade tjatat om takten hon aldrig sett. ]]
Lektion.SAKNAS = { "rytm" }

--[[ DEKLARERADE SKILLNADER mot webben. Står som data så att en spec kan
	kräva att listan stämmer — en skillnad som växer fram i tysthet är
	en parallell sanning, en som står uppräknad är ett beslut. ]]
Lektion.SKILLNAD = {
	--[[ Webben väljer live-cue ur passets fokus (LARARE.fokus), som i sin
	     tur väljs ur ryttarens färdigheter (`fard()`). Roblox har ingen
	     ryttarmodell ännu, så cue:n väljs ur den svagaste MÄTTA
	     dimensionen i övningens kontrakt. Samma ordförråd
	     (RidKanon.UGNETA.LIVE), samma koppling (DIM_CUE), annan ingång. ]]
	"live-cue väljs ur svagaste mätta dimension, inte ur passets fokus",
	--[[ Rytmen, se SAKNAS. ]]
	"rytm är inte mätt på Roblox och räknas inte in i bedömningen",
}

local function klamp(v: number?): number
	if v == nil or v ~= v then return 0 end
	if v < 0 then return 0 end
	if v > 1 then return 1 end
	return v
end

--[[ OKÄNT ÄR INTE NOLL (senior review av b303530, punkt 2).

	Förut lästes varje fält som `tonumber(x) or 0`. Följden var att ett
	SAKNAT mätvärde blev en giltig siffra: en telemetri som bara sa
	`{uppsutten = true}` gav balans 0 och mjukhet 0 — alltså "dålig
	ritt" — medan `lugn = 1 - klamp(spänning)` blev 1 och tempo blev 1,
	alltså beröm. Båda är påhitt om en ritt som aldrig mättes.

	`tal` skiljer de två fallen: ett verkligt uppmätt 0 är en siffra,
	ett saknat eller ogiltigt fält är `nil`. NaN och oändligheter räknas
	som saknade — de är mätfel, inte mätvärden. ]]
local function tal(v: any): number?
	local n = tonumber(v)
	if n == nil then return nil end
	if n ~= n then return nil end                 -- NaN
	if n == math.huge or n == -math.huge then return nil end
	return n
end

--[[ KVALITETEN, ur telemetrin och ingenting annat.

	Samma formel som webbens `ugnetaKvalitet` med samma tal, hämtade ur
	RidKanon.UGNETA.KVALITET. `tm` är exakt det HorseCore/Telemetri.las
	returnerar — modulen läser inte hästen, den läser mätningen. ]]
function Lektion.kvalitet(tm: { [string]: any }): { [string]: number? }
	local radie: number
	local r = tm.svangradie
	if type(r) == "number" and r == r and r ~= math.huge then
		radie = klamp(1 - math.abs(r - KV.VOLT_RADIE) / KV.VOLT_SPANN)
	else
		--[[ Rak linje: ingen radie att bedöma. Webben faller tillbaka på
		     rakriktningen ur utbildningsskalan; den finns inte här, så
		     linjen är omätt i det ögonblicket i stället för påhittad. ]]
		radie = -1
	end
	--[[ Delkomponenterna. `mattes` räknar hur många av dem som faktiskt
	     kom ur telemetrin — en sammansatt dimension där INGEN del är mätt
	     får inte bli en siffra bara för att de neutrala fallbacksen råkar
	     summera till något. ]]
	local svarstidV, etabV = tal(tm.svarstid), tal(tm.etableringstid)
	local paradV, fokusV, spanningV = tal(tm.paradKvalitet), tal(tm.fokus), tal(tm.spanning)
	local fart, onskad = tal(tm.fart), tal(tm.onskadFart)

	--[[ KV.OMATT är den deklarerade neutralen för en delkomponent som
	     inte mätts. Den behålls — formeln är verifierad — men den får
	     inte ensam bära en dimension. ]]
	local svar = if svarstidV ~= nil and svarstidV > 0
		then klamp(1 - svarstidV / KV.SVARSTID_TAK) else KV.OMATT
	local etablering = if etabV ~= nil and etabV > 0
		then klamp(1 - etabV / KV.ETABLERING_TAK) else KV.OMATT
	local parad = if paradV ~= nil then klamp(paradV) else KV.OMATT
	local fokus = if fokusV ~= nil then klamp(fokusV) else KV.OMATT
	local lugn = if spanningV ~= nil then 1 - klamp(spanningV) else KV.OMATT

	local timingMatt = (svarstidV ~= nil and svarstidV > 0)
		or (etabV ~= nil and etabV > 0) or paradV ~= nil
	local responsMatt = fokusV ~= nil or spanningV ~= nil
		or (svarstidV ~= nil and svarstidV > 0)

	--[[ TEMPO kräver att den önskade farten faktiskt är mätt. Förut föll
	     `onskad` tillbaka på `fart`, och då blev avvikelsen noll och
	     tempot 1,0 — full pott ur ingenting. Saknas önskad fart är
	     tempot okänt. Är den mätt men under golvet finns inget tempokrav
	     att missa, och 1,0 är då ett riktigt svar, inte ett påhitt. ]]
	local tempo: number? = nil
	if onskad ~= nil then
		if onskad <= KV.TEMPO_GOLV then
			tempo = 1
		elseif fart ~= nil then
			tempo = klamp(1 - math.abs(fart - onskad) / math.max(onskad, KV.TEMPO_NAMNARE))
		end
	end

	local balansV, mjukhetV = tal(tm.balans), tal(tm.mjukhet)
	return {
		--[[ Bara radietermen. Webbens andra halva (LINJE_RAK ×
		     rakriktning) har ingen källa här; att skala upp radien till
		     1,0 hade gett en bättre linje än den som faktiskt mätts. ]]
		linje = if radie >= 0 then klamp(radie) else nil,
		rytm = nil,                       -- se Lektion.SAKNAS
		balans = if balansV ~= nil then klamp(balansV) else nil,
		mjukhet = if mjukhetV ~= nil then klamp(mjukhetV) else nil,
		--[[ Formlerna är oförändrade. Det enda som tillkommit är kravet
		     att minst en delkomponent verkligen mättes. ]]
		timing = if timingMatt
			then klamp(KV.TIMING_SVAR * svar + KV.TIMING_ETABLERING * etablering
				+ KV.TIMING_PARAD * parad)
			else nil,
		respons = if responsMatt
			then klamp(KV.RESPONS_FOKUS * fokus + KV.RESPONS_LUGN * lugn
				+ KV.RESPONS_SVAR * svar)
			else nil,
		tempo = tempo,
	}
end

--[[ ── Passet ──────────────────────────────────────────────────────
	Sex övningar i kanonens ordning, två försök på var och en. Samma
	lifecycle som webbens `stegaLektion`: betyget hör till sista
	försöket, och ett nytt försök NOLLSTÄLLER mätningen explicit i stället
	för att patchas i nästa bildruta. ]]
export type Prov = { n: number, sum: { [string]: number }, matt: { [string]: number },
	sek: { [string]: number } }
export type Pass = {
	ix: number,
	forsokNr: number,
	tid: number,
	prov: Prov,
	historik: { [string]: { { [string]: number } } },
	klar: boolean,
}

--[[ Hur länge ett försök rids innan det bedöms. Webbens moment har en
     egen tid per övning; Roblox har ingen momentbank ännu, så längden
     är EN siffra här och deklareras som spelbeslut, inte som mätning. ]]
Lektion.FORSOK_SEK = 22

--[[ HUR MYCKET UNDERLAG SOM KRÄVS INNAN NÅGOT BEDÖMS.

	Förut räckte två bildrutor för hela försöket, och `prov.n` räknades
	upp för varje uppsutten bildruta oavsett om något faktiskt mättes.
	Två saker föll ut av det: ett försök kunde bedömas på underlag som
	inte fanns, och täckningen berodde på bildfrekvensen — 120 fps gav
	dubbelt så många "mätningar" som 60 fps på samma ritt.

	Kraven ställs därför per dimension och i SEKUNDER, inte i bildrutor.
	Antalet prov behålls som ett golv mot enstaka utstickare. ]]
Lektion.MIN_MATNINGAR = 2
Lektion.MIN_DIM_SEK = 1.0

local function tomtProv(): Prov
	return { n = 0, sum = {}, matt = {}, sek = {} }
end

function Lektion.nyttPass(): Pass
	return { ix = 1, forsokNr = 1, tid = 0, prov = tomtProv(),
		historik = {}, klar = false }
end

function Lektion.ovningId(pass: Pass): string?
	return Lektion.ORDNING[pass.ix]
end

function Lektion.ovning(pass: Pass): { rubrik: string, punkter: { string } }?
	local id = Lektion.ovningId(pass)
	if not id then return nil end
	return Lektion.OVNINGAR[id]
end

--[[ Ett prov per bildruta. Bara mätta dimensioner räknas — `matt`
	håller reda på hur många prov varje dimension faktiskt fått, så en
	dimension som var omätt halva försöket inte får ett medelvärde
	utspätt med nollor. ]]
--[[ Ett prov per bildruta. `dt` gör täckningen bildfrekvensoberoende:
	en dimension räknas i uppmätta SEKUNDER, inte i hur ofta loopen råkade
	titta. Saknas `dt` bidrar provet med antal men ingen tid, och kan då
	aldrig ensamt nå tidskravet — det är avsiktligt. ]]
function Lektion.matning(pass: Pass, tm: { [string]: any }, dt: number?)
	local q = Lektion.kvalitet(tm)
	local p = pass.prov
	local steg = tal(dt)
	if steg == nil or steg < 0 then steg = 0 end
	p.n += 1
	for k, v in q do
		if v ~= nil then
			p.sum[k] = (p.sum[k] or 0) + v
			p.matt[k] = (p.matt[k] or 0) + 1
			p.sek[k] = (p.sek[k] or 0) + steg
		end
	end
end

--[[ Medelvärdet för de dimensioner som har TILLRÄCKLIGT underlag. En
	dimension som bara snuddades vid under en bråkdel av försöket lämnas
	utanför i stället för att bäras fram som ett omdöme. ]]
function Lektion.medel(pass: Pass): { [string]: number }
	local ut = {}
	for k, s in pass.prov.sum do
		local n = pass.prov.matt[k] or 0
		local sek = pass.prov.sek[k] or 0
		if n >= Lektion.MIN_MATNINGAR and sek >= Lektion.MIN_DIM_SEK then
			ut[k] = s / n
		end
	end
	return ut
end

--[[ Avsluta försöket och lämna underlaget till Ugneta. `fore` är nil på
	första försöket — det är den skillnaden hela UX-variant 3 hänger på. ]]
export type Handelse = {
	ovningId: string,
	nu: { [string]: number },
	fore: { [string]: number }?,
	forsokNr: number,
	sista: boolean,
}

function Lektion.avslutaForsok(pass: Pass): Handelse?
	local id = Lektion.ovningId(pass)
	if not id then return nil end
	--[[ INGEN BEDÖMNING UTAN UNDERLAG. `medel` returnerar bara de
	     dimensioner som klarat kraven; är den tom fanns det ingenting att
	     uttala sig om, och då lämnas inget omdöme alls. ]]
	local nu = Lektion.medel(pass)
	if next(nu) == nil then return nil end
	local lista = pass.historik[id]
	if not lista then lista = {}; pass.historik[id] = lista end
	local fore = lista[#lista]
	table.insert(lista, nu)
	local sista = pass.forsokNr >= 2
	return { ovningId = id, nu = nu, fore = fore, forsokNr = pass.forsokNr,
		sista = sista }
end

--[[ Vidare: nästa försök på samma övning, eller nästa övning. Mätningen
	byts HÄR, inte i nästa bildruta. ]]
function Lektion.vidare(pass: Pass)
	if pass.forsokNr < 2 then
		pass.forsokNr += 1
	else
		pass.ix += 1
		pass.forsokNr = 1
		if pass.ix > #Lektion.ORDNING then pass.klar = true end
	end
	pass.tid = 0
	pass.prov = tomtProv()
end

--[[ ── Live-cue ────────────────────────────────────────────────────
	Några ord, inte ett kort. Väljs ur den svagaste MÄTTA dimensionen i
	övningens kontrakt — se Lektion.SKILLNAD för varför ingången är en
	annan än webbens. Ordförrådet är kanonens. ]]
--[[ SPELAREN NÖJER SIG MED FÖRSÖKET (G02-D).

	Skillnaden mot `vidare` är EN sak: det andra försöket hoppas över.
	Momentet är redan bedömt — `avslutaForsok` kördes när försöket tog
	slut och skrev in medelvärdena i historiken. Den här funktionen
	bedömer INGENTING igen, och får inte göra det: en andra bedömning av
	samma ritt hade räknat in övningen två gånger i historiken och tyst
	flyttat vad "bättre än förra gången" betyder.

	Den ligger här och inte i controllern av samma skäl som `vidare`: hur
	ett pass rör sig framåt är lifecyclens regel, inte HUD:ens. ]]
function Lektion.hoppaOver(pass: Pass)
	pass.ix += 1
	pass.forsokNr = 1
	if pass.ix > #Lektion.ORDNING then pass.klar = true end
	pass.tid = 0
	pass.prov = tomtProv()
end

function Lektion.liveCue(pass: Pass, q: { [string]: number? }): (string, boolean)
	local id = Lektion.ovningId(pass)
	if not id then return "", false end
	local svag, svagV = nil, math.huge
	for _, k in Ugneta.dimensionerFor(id) do
		local v = q[k]
		if v ~= nil and v < svagV then svag, svagV = k, v end
	end
	if not svag then return "", false end
	local cue = UG.DIM_CUE[svag]
	if not cue then return "", false end
	local bra = svagV >= KV.SVAG
	local rad = UG.LIVE[cue]
	if not rad then return "", false end
	return (if bra then rad.bra else rad.fel), bra
end

--[[ ── Platsen vid sargen ──────────────────────────────────────────
	Uttryckt i BANANS egna mått, precis som webbens `ugnetaPlats()`:
	`u` är andel av bredden, `bortomC` meter bortom dressyrlayoutens
	C-linje. Den som bygger gestalten löser upp den mot den byggda
	banan — ingen andra uppfattning om var sargen går. ]]
Lektion.PLATS = UG.PLATS

return Lektion
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX9">
				<Properties>
					<string name="Name">Networking</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	Nätverkslagret.

	Ett ställe som skapar och hittar fjärrobjekten, så att varken servern
	eller klienten letar i ReplicatedStorage på egen hand. Servern skapar
	dem; klienten väntar in dem.

	Regeln för vad som får skickas: klienten skickar *avsikt* och sin egen
	simulerade position. Servern skickar *sanning* om ägarskap, uppsittning
	och uthållighet. Klienten får aldrig sätta ett värde som andra spelare
	påverkas av.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Networking = {}

local FOLDER_NAME = "HorseRemotes"

local DEFINITIONS = {
	MountRequest = "RemoteFunction",    -- klient → server: får jag sitta upp?
	DismountRequest = "RemoteFunction",
	MountChanged = "RemoteEvent",       -- server → alla: vem rider vad
	StateSync = "RemoteEvent",          -- klient → server: tempo och gångart
	StaminaSync = "RemoteEvent",        -- server → ägaren: uthållighet
	HorseReaction = "RemoteEvent",      -- server → alla: gnägg, stegring, reaktion
	PreparationStep = "RemoteFunction",  -- klient → server: jag vill göra det här steget
	PreparationSync = "RemoteEvent",     -- server → ägaren: hela förberedelsens sanning
	PreparationHello = "RemoteFunction", -- klient → server: listenern är ansluten, ge mig nuläget
	--[[ #161. Skötselns MOMENT och passets eftervård.

	     Alla tre är avsikter — "jag vill krafsa vänster fram", "jag säger
	     till ridläraren", "jag lossar gjorden" — och inget av dem bär ett
	     resultat. Det finns med flit ingen remote som tar emot ett
	     saveobjekt, ett passtal eller ett hästminne: servern äger varje
	     skrivning, och en klient som inte KAN skicka ett tillstånd kan
	     heller inte fejka ett. ]]
	PreparationMoment = "RemoteFunction",  -- klient → server: jag utför det här momentet
	PreparationSvar = "RemoteFunction",    -- klient → server: mitt svar på ett fynd
	PassSync = "RemoteEvent",              -- server → ägaren: passets läge och eftervård
	PassMoment = "RemoteFunction",         -- klient → server: ett eftervårdsmoment
	--[[ Utrustningen på boxfronten. Avsikten är "jag vill ta DEN DÄR
	     saken" — en modell, inte ett tillstånd. Servern avgör om det är
	     rätt hästs sak, om spelaren står vid den, och vad det betyder. ]]
	HamtaUtrustning = "RemoteFunction",    -- klient → server: jag plockar ner den här
	--[[ Ledningen. Samma princip: en avsikt, aldrig ett tillstånd. ]]
	LedBorja = "RemoteFunction",           -- klient → server: jag börjar leda den här hästen
	LedSlapp = "RemoteFunction",           -- klient → server: jag släpper
	LedSync = "RemoteEvent",               -- server → ägaren: leder jag, och hur långt har hon kommit
}

local cache: { [string]: Instance } = {}

local function folder(): Folder
	local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if existing then
		return existing :: Folder
	end
	if RunService:IsServer() then
		local f = Instance.new("Folder")
		f.Name = FOLDER_NAME
		f.Parent = ReplicatedStorage
		return f
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME, 30) :: Folder
end

function Networking.get(name: string): any
	if cache[name] then
		return cache[name]
	end
	local class = DEFINITIONS[name]
	assert(class, ("[Horse] Okänt fjärrobjekt %q"):format(name))

	local parent = folder()
	local existing = parent:FindFirstChild(name)
	if not existing and RunService:IsServer() then
		existing = Instance.new(class)
		existing.Name = name
		existing.Parent = parent
	elseif not existing then
		existing = parent:WaitForChild(name, 30)
	end
	cache[name] = existing :: Instance
	return existing
end

--[[ Servern kallar den här en gång vid start så att allt finns innan
     första klienten frågar efter det. ]]
function Networking.init()
	assert(RunService:IsServer(), "Networking.init körs bara på servern")
	for name in DEFINITIONS do
		Networking.get(name)
	end
end

return Networking
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX10">
				<Properties>
					<string name="Name">Pass</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[ PASSET — dagen från uppsittning till att hästen är omhändertagen.

	Ren logik, som `Preparation.luau`. `GameplayService` äger instanserna
	och nätet; den här modulen äger frågan "var i passet är spelaren, och
	vad får hon göra härnäst".

	── VARFÖR EN EGEN MODUL ─────────────────────────────────────────

	`Preparation` slutar där uppsittningen börjar. Den frågan — "är hästen
	i ordning?" — är klar när man sitter i sadeln, och att bygga in
	eftervården i samma tillstånd hade gjort `redo` tvetydigt: redo att
	sitta upp, eller redo att gå hem?

	Passet är den andra halvan, och den halvan är precis det `CLAUDE.md`
	menar med att ansvaret kring hästen ÄR gameplay:

	    sitt upp → rid → sitt av → eftervård → passet räknas

	Det sista ledet hänger på det näst sista. Ett pass går INTE att avsluta
	genom att sitta av och logga ut — `farAvsluta` är fail-closed tills
	varje eftervårdsmoment är gjort. Annars vore eftervården en
	avslutningsskärm att klicka bort, och då hade den lika gärna kunnat
	strykas.

	── EFTERVÅRDEN ÄR KANON ─────────────────────────────────────────

	Momenten hittas inte på här. De är `UBRFSkotsel.eftervard`, genererad
	ur `src/spel/skotsel.js` — samma fil som fasordningen och ryktningen
	kommer ur. Ordningen (gjord → sadel → träns, och benen medan de är
	varma) vaktas av exportgrinden i `tools/exportera-spel.js`.

	── PASSID ───────────────────────────────────────────────────────

	`passId` sätts EN gång, när passet skapas, och ändras aldrig. Det är
	kvittot `Sparning.registreraPass` slår upp, och hela idempotensen
	hänger på att det inte räknas om vid avslutet. Räknades det om vore
	varje omsändning ett nytt pass.
]]

local RS = game:GetService("ReplicatedStorage")
local Skotsel = require(RS.UBRFSkotsel)

local Pass = {}

--[[ Samma `kanon:`-konvention som `Preparation` använder. Den ligger i båda
	modulerna med flit: `Pass` får inte require:a `Preparation` (det blir
	cirkulärt i bänkbygget), och en delad tredje modul för fyra rader vore
	dyrare än duplicerad konvention. Prefixet är kontraktet, inte koden. ]]
local Kanon = {}
Kanon.PREFIX = "kanon:"
function Kanon.kanontext(text: string?): string?
	if text == nil then return nil end
	return Kanon.PREFIX .. tostring(text)
end
Pass.kanontext = Kanon.kanontext
function Pass.arKanontext(skal: any): boolean
	return type(skal) == "string" and string.sub(skal, 1, #Kanon.PREFIX) == Kanon.PREFIX
end

Pass.EFTERVARD = Skotsel.eftervard

--[[ Lägena, i den ordning de kommer. Engelska av samma skäl som
	`Preparation.STATUS`: statusorden går över nätet och namnges så i
	arbetsordern; texten spelaren ser är svensk och kommer ur kanonen. ]]
Pass.LAGE = {
	FORE = "before_ride",       -- passet finns, ritten har inte börjat
	RIDER = "riding",
	EFTERVARD = "aftercare",    -- avsutten, hästen inte omhändertagen än
	KLART = "done",             -- allt gjort, passet får räknas
	RAKNAT = "recorded",        -- passet ÄR räknat och sparat
}

export type State = {
	hastId: string,
	passId: string,
	lage: string,
	gjorda: { [string]: boolean },
	--[[ Sant när passet stoppats av välfärdsskäl i stället för ritt.
		Ett stoppat pass räknas ändå som en dag — spelaren gjorde rätt —
		men det får aldrig se ut som en genomförd ritt. ]]
	stoppad: boolean,
}

--[[ `passId` byggs av servern ur spelarens id, hästen och passnumret.
	Ligger här och inte i tjänsten för att formen ska gå att prova: två
	pass i rad på samma häst måste ge OLIKA id, och samma pass måste ge
	samma id hur många gånger det än frågas. ]]
function Pass.byggId(userId: number, hastId: string, passnummer: number): string
	return ("%d:%s:%d"):format(userId, hastId, passnummer)
end

function Pass.nyState(hastId: string, passId: string): State
	return {
		hastId = hastId,
		passId = passId,
		lage = Pass.LAGE.FORE,
		gjorda = {},
		stoppad = false,
	}
end

--[[ Eftervårdens moment, i kanonens ordning och i samma form som
	`Preparation.moment` — så att HUD:en kan rita båda med samma kod. ]]
local momentCache: any = nil

function Pass.moment()
	if momentCache then return momentCache end
	local ut = {}
	for i, e in ipairs(Pass.EFTERVARD) do
		table.insert(ut, { id = e.id, namn = e.namn, text = e.text, steg = i })
	end
	momentCache = ut
	return ut
end

function Pass.nastaMoment(state: State)
	for _, m in ipairs(Pass.moment()) do
		if not state.gjorda[m.id] then return m end
	end
	return nil
end

--[[ ── ÖVERGÅNGARNA ──────────────────────────────────────────────── ]]

--[[ Har eftervården börjat? Ett enda avbockat moment räknas: då är
	hästen på väg att bli omhändertagen och dagen är i sitt slutskede. ]]
function Pass.eftervardBorjad(state: State): boolean
	for _, gjort in pairs(state.gjorda) do
		if gjort then return true end
	end
	return false
end

--[[ FÅR HON SITTA UPP?

	Regeln var "en gång per dag, punkt": allt utom läget FÖRE nekades. Den
	gjorde dagen OSPELBAR i ett fall som inte är ovanligt — ryttaren dör
	eller tappar sin karaktär mitt i ritten. `HorseService` städar då
	korrekt, passet går till eftervård, och spelaren stod kvar med en häst
	hon inte fick sitta upp på och en eftervård hon inte hade ridit fram
	till. END_TO_END_PLAYABILITY_GATE punkt 10 kräver uttryckligen att
	respawn följs av UPPSITTNING igen.

	Regeln är därför: dagen slutar när hästen börjar bli omhändertagen,
	inte första gången ryttarens fötter når marken. Har inget
	eftervårdsmoment gjorts får hon sitta upp igen — hur hon än kom av.
	Har eftervården börjat, eller är passet klart/räknat, är dagen slut.

	Passet räknas fortfarande EXAKT en gång: kvittot `passId` ändras inte
	av att man sitter upp två gånger.

	[PRODUKTBESLUT som behöver ChatGPT/Tobias: gränsen "innan eftervården
	börjat" är MIN läsning av punkt 10. Alternativen är att bara döden ger
	en ny uppsittning, eller att antalet uppsittningar per dag är fritt.
	Regeln ligger i EN funktion just för att den ska gå att flytta.] ]]
function Pass.farSittaUpp(state: State): (boolean, string?)
	if state.lage == Pass.LAGE.FORE then
		return true, nil
	end
	if state.lage == Pass.LAGE.RIDER then
		return false, "pass.sitter_redan"
	end
	if state.lage == Pass.LAGE.EFTERVARD and not Pass.eftervardBorjad(state) then
		return true, nil
	end
	return false, "spel.redan_ridit"
end

function Pass.vidUppsittning(state: State): (boolean, string?)
	local far, skal = Pass.farSittaUpp(state)
	if not far then
		return false, skal or "pass.redan_igang"
	end
	state.lage = Pass.LAGE.RIDER
	return true, nil
end

--[[ Avsittningen. Den ENDA vägen in i eftervården, och den kräver att man
	faktiskt suttit upp: annars kunde en spelare hoppa direkt till
	eftervården, bocka av fem moment och få ett pass utan att ha ridit. ]]
function Pass.vidAvsittning(state: State): (boolean, string?)
	if state.lage == Pass.LAGE.EFTERVARD then
		--[[ Dubbel avsittning är inget fel — `HorseService.dismount` kan nås
			från karaktärens död, från E och från utloggning — men den får
			inte nollställa eftervården. ]]
		return true, nil
	end
	if state.lage ~= Pass.LAGE.RIDER then
		return false, "pass.rider_inte"
	end
	state.lage = Pass.LAGE.EFTERVARD
	return true, nil
end

--[[ Ett välfärdsstopp avslutar passet utan ritt. Hästen är redan
	omhändertagen av ridläraren, så eftervården hoppas över — men passet
	måste fortfarande RÄKNAS, annars straffas spelaren för att ha gjort
	rätt. ]]
function Pass.vidValfardsstopp(state: State): (boolean, string?)
	if state.lage == Pass.LAGE.RAKNAT then
		return false, "pass.redan_raknat"
	end
	state.stoppad = true
	state.lage = Pass.LAGE.KLART
	return true, nil
end

--[[ Ett eftervårdsmoment. Samma tre nej som förberedelsens moment, av
	samma skäl: fel läge, redan gjort, fel tur. ]]
function Pass.utfor(state: State, momentId: string): (boolean, string?)
	if state.lage ~= Pass.LAGE.EFTERVARD then
		if state.lage == Pass.LAGE.RIDER then
			return false, "pass.sitt_av_forst"
		end
		return false, "pass.inte_dags"
	end
	local moment = nil
	for _, m in ipairs(Pass.moment()) do
		if m.id == momentId then moment = m end
	end
	if not moment then
		return false, "pass.okant_moment"
	end
	if state.gjorda[momentId] then
		return false, "pass.redan_gjort"
	end
	local pa_tur = Pass.nastaMoment(state)
	if pa_tur and pa_tur.id ~= momentId then
		--[[ Fasens/momentets namn kommer ur skötselkanonen och är alltså
			innehåll, inte gränssnitt. Det taggas `kanon:` så att
			språkgrinden kan skilja "engelsk ram runt redovisad svensk
			kanontext" från "rå svenska som ingen deklarerat". ]]
		return false, "pass.fel_tur", Kanon.kanontext(pa_tur.namn)
	end
	state.gjorda[momentId] = true
	if Pass.nastaMoment(state) == nil then
		state.lage = Pass.LAGE.KLART
	end
	return true, nil
end

--[[ Får passet avslutas och räknas? FAIL-CLOSED: bara i KLART.

	Alla andra lägen är nej, och det inkluderar att sitta av och gå. Det är
	acceptanskravet "Avsittning leder till faktisk eftervård innan passet
	kan avslutas" — och det enda sättet att göra eftervården till gameplay
	i stället för en ruta som visas på vägen ut. ]]
function Pass.farAvsluta(state: State): (boolean, string?)
	if state.lage == Pass.LAGE.RAKNAT then
		return false, "pass.redan_raknat"
	end
	if state.lage ~= Pass.LAGE.KLART then
		local m = Pass.nastaMoment(state)
		if state.lage == Pass.LAGE.RIDER then
			return false, "pass.sitter_fortfarande"
		end
		if state.lage == Pass.LAGE.FORE then
			return false, "pass.inte_ridit"
		end
		return false, "pass.aterstar", Kanon.kanontext(if m then m.namn else nil)
	end
	return true, nil
end

--[[ Markerar passet som räknat. Skild från `farAvsluta` för att servern
	ska hinna spara MELLAN de två: räknas passet i minnet först och
	sparningen sedan faller, hade spelaren förlorat passet utan att kunna
	göra om det. ]]
function Pass.markeraRaknat(state: State)
	state.lage = Pass.LAGE.RAKNAT
end

--[[ Det klienten ska visa av passet. Samma princip som
	`Preparation.vy`: servern skickar hela sanningen, klienten räknar
	inget själv. ]]
function Pass.vy(state: State?, rev: number?)
	if not state then
		return { lage = nil, moment = {}, nastaMoment = nil, klar = false,
			stoppad = false, rev = rev or 0 }
	end
	local moment = {}
	for _, m in ipairs(Pass.moment()) do
		table.insert(moment, {
			id = m.id,
			namn = m.namn,
			text = m.text,
			klar = state.gjorda[m.id] == true,
		})
	end
	local pa_tur = Pass.nastaMoment(state)
	return {
		lage = state.lage,
		hastId = state.hastId,
		moment = moment,
		nastaMoment = pa_tur and pa_tur.id or nil,
		klar = state.lage == Pass.LAGE.KLART or state.lage == Pass.LAGE.RAKNAT,
		stoppad = state.stoppad,
		rev = rev or 0,
	}
end

return Pass
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX11">
				<Properties>
					<string name="Name">Preparation</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[ FÖRBEREDELSEN — reglerna för att göra i ordning en häst, som ren logik.

	Ingen Roblox-anrop här inne. Det är samma val som `Stallet.luau` gör och
	av samma skäl: det här ÄR reglerna, och regler ska gå att falsifiera utan
	Studio. `GameplayService` äger instanserna, nätverket och avstånden.

	Faserna hittas inte på här. De kommer ur `UBRFSkotsel.faser`, som
	genereras ur `src/spel/skotsel.js` — samma källa som webben lär ut. Den
	gamla Roblox-sidan hade en egen lista med fyra etiketter utan innehåll,
	och det var precis den dubbla sanningen som S2a fanns till för att ta
	bort. Läs aldrig fasordningen från något annat än den här modulen.

	Tillståndet är ett rent värde: `GameplayService` håller ett per spelare,
	provet håller sina egna. Modulen har medvetet inget eget minne — hade den
	haft det gick den inte att prova två spelare samtidigt i samma process.

	── MOMENTEN (#161) ──────────────────────────────────────────────

	Fram till First Playable kvitterades en fas med ETT tryck: `utfor(s,
	"rykta")` och hästen var ryktad. Det var en checklista, inte gameplay,
	och issue #161 säger rakt ut att skötseln ska vara det senare.

	Varje fas har nu MOMENT — de faktiska handlingarna. De hittas inte på
	här heller: de HÄRLEDS ur `UBRFSkotsel`, alltså ur samma
	`src/spel/skotsel.js` som webben lär ut. Ryktningens moment är
	`rykt.krav` läst per redskap, visitationens är `visitation.punkter`,
	hovarna är `hovar`, utrustningen är `sadelfaser` och hälsningen är
	`halsning`. Lägger någon till en visitpunkt i JS-källan dyker den upp
	som ett moment här utan att en rad Luau ändras — och gör den inte det
	är det en bugg, inte en frihet.

	`steg` är ordningskravet, och det är EN siffra av ett skäl: allt är
	inte lika strikt. Att ta kardborsten före gummiskrapan är fel
	hästkunskap; att ta kroppen före benen med samma borste är bara en
	smaksak. Moment med samma `steg` får därför göras i valfri ordning,
	medan ett högre `steg` kräver att alla lägre är klara. Hade ordningen
	varit total hade modulen lärt ut pedanteri som om det vore kunskap.

	── VÄLFÄRDSSTOPPET ──────────────────────────────────────────────

	Visitationen kan ge ett FYND, precis som på webben. Rapporteras det
	rätt — "Säg till ridläraren" — STOPPAS arbetet. Hästen sätts inte i
	arbete med en varm sena, och det är inte en förlust: det är momentet
	som lärs ut. Spärren är fail-closed hela vägen upp genom
	`provaUppsittning`, så ingen väg runt den går genom att sitta upp ändå.
]]

local RS = game:GetService("ReplicatedStorage")
local Skotsel = require(RS.UBRFSkotsel)
--[[ Språkkatalogen. Preparation äger REGLERNA och behöver normalt inget
	språk — men utrustningsstegets namn är en räknare ("Utrustning 2/4"),
	alltså gränssnitt och inte kanon, och den hör hemma i katalogen.
	`Sprak` är ett löv: det kräver bara datatabellen, så ingen cykel. ]]
local Sprak = require(script.Parent.Sprak)

local Preparation = {}

Preparation.FASER = Skotsel.faser

--[[ Statusorden går ut till klienten och in i provet. De är engelska för att
	arbetsordern (issue #58) namnger dem så; texten spelaren ser är svensk
	och kommer ur fasernas `namn`/`text`. ]]
Preparation.STATUS = {
	VANTAR_MODELL = "waiting_model",   -- identiteten är tilldelad, riggen saknas
	FORBEREDER = "preparing",
	REDO = "ready_to_mount",
	RIDER = "riding",
	--[[ Välfärdsstoppet (#161). Eget statusord och inte "preparing med ett
		felmeddelande": HUD:en ska säga något helt annat, och en klient som
		inte känner igen ordet ska inte råka rita en halvfärdig förberedelse
		som om arbetet kunde fortsätta. ]]
	STOPPAD = "welfare_stop",
}

export type State = {
	hastId: string,
	klara: { [string]: boolean },
	--[[ fasId → momentId → true. Skilt från `klara` med flit: `klara` är
		"fasen är avklarad", `gjorda` är "de här handlingarna är utförda".
		En fas kvitteras aldrig annat än genom att dess moment blir klara,
		men de två frågorna ställs på olika ställen. ]]
	gjorda: { [string]: { [string]: boolean } },
	--[[ Visitpunkten med ett fynd den här dagen, eller nil. Sätts av
		`nyState` ur hästen och passnumret, aldrig av klienten. ]]
	fynd: string?,
	fyndSett: boolean,
	fyndRapporterat: boolean,
	--[[ Välfärdsstoppet: texten om varför arbetet är avbrutet. Icke-nil
		betyder att hästen inte får sättas i arbete. ]]
	stoppad: string?,
	--[[ Vad spelaren FAKTISKT har hämtat och bär på. Sätts bara av servern
		när hon plockat ner saken från sin hästs boxfront; klienten kan inte
		skicka den. Utan den här går sadelstegen och ledandet inte att göra
		— se `kraverUtrustning`. ]]
	utrustning: { [string]: boolean },
}

--[[ Index i fasordningen, eller nil för ett okänt id. Slås upp linjärt över
	fasordningen; en tabell hade varit snabbare och svårare att läsa. ]]
function Preparation.fasIndex(fasId: string): number?
	for i, f in ipairs(Preparation.FASER) do
		if f.id == fasId then return i end
	end
	return nil
end

function Preparation.fas(fasId: string)
	local i = Preparation.fasIndex(fasId)
	return i and Preparation.FASER[i] or nil
end

--[[ Faserna som faktiskt utförs — alla utom den avslutande uppsittningen.
	Uppsittningen är inte ett moment i förberedelsen, den är det man får göra
	NÄR förberedelsen är klar. Räknas den som ett steg blir hästen redo att
	sitta upp på först efter att man redan suttit upp. ]]
function Preparation.stegFaser()
	local ut = {}
	for _, f in ipairs(Preparation.FASER) do
		if not f.sitt then table.insert(ut, f) end
	end
	return ut
end

--[[ ── MOMENTEN ────────────────────────────────────────────────────

	Härledda ur skötselkanonen, aldrig skrivna av. Varje moment är

	    { id, namn, text, steg, fel? }

	`fel = true` märker ett alternativ som ÄR valbart men som är fel svar —
	hälsningens "rakt bakifrån" och fyndets "det går nog bra idag". De
	ligger med för att de är själva lärandet: ett alternativ man inte kan
	välja lär inte ut någonting. ]]

local function halsMoment()
	local ut = {}
	for i, h in ipairs(Skotsel.halsning or {}) do
		table.insert(ut, {
			id = "halsa" .. i,
			namn = h.t,
			text = h.svar,
			steg = 1,
			fel = not h.ratt,
		})
	end
	return ut
end

local function visitMoment()
	local ut = {}
	--[[ Punkterna tas i tur och ordning, framifrån och bakåt — samma regel
		som webbens `visitNasta`. Därför ETT steg per punkt: här är
		ordningen hela poängen, inte en smaksak. ]]
	for i, p in ipairs(Skotsel.visitation.punkter) do
		table.insert(ut, { id = "vis:" .. p.id, namn = p.namn, text = p.ok, steg = i })
	end
	return ut
end

--[[ Zontyperna i den ordning de först dyker upp i `rykt.zoner`. Läses ur
	zonlistan i stället för att skrivas som { "kropp", "huvud", "ben" }: en
	ny zontyp i JS-källan ska bli ett moment, inte försvinna tyst. ]]
local function zontyper()
	local sedda, ut = {}, {}
	for _, z in ipairs(Skotsel.rykt.zoner) do
		if not sedda[z.typ] then
			sedda[z.typ] = true
			table.insert(ut, z.typ)
		end
	end
	return ut
end

local function ryktMoment()
	local ut = {}
	--[[ Redskapen i kanonens ordning — skrapa, kardborste, mjuk borste —
		och för varje redskap de zoner som kräver det. Steget är REDSKAPETS
		index: att ta kardborsten före gummiskrapan är fel hästkunskap och
		spärras, men kropp före ben med samma borste är fritt. Huvudet dyker
		bara upp under den mjuka borsten, för det är det enda
		`rykt.krav.huvud` innehåller. ]]
	local typer = zontyper()
	for redskapIndex, r in ipairs(Skotsel.rykt.redskap) do
		for _, typ in ipairs(typer) do
			local kravd = false
			for _, id in ipairs(Skotsel.rykt.krav[typ] or {}) do
				if id == r.id then kravd = true end
			end
			if kravd then
				table.insert(ut, {
					id = "rykt:" .. r.id .. ":" .. typ,
					namn = r.namn .. " — " .. typ,
					text = r.text,
					steg = redskapIndex,
				})
			end
		end
	end
	return ut
end

local function iordningMoment()
	local ut = {}
	--[[ Hovarna först, ETT varv runt hästen, ett steg var: ordningen är
		kanon (`vf, vb, hb, hf`) och skyddad av exportgrinden. ]]
	for i, h in ipairs(Skotsel.hovar or {}) do
		table.insert(ut, { id = "hov:" .. h.id, namn = h.namn, text = h.text, steg = i })
	end
	--[[ ...sedan utrustningen. `sadelfaser` har ingen egen id-kolumn i
		källan — den är en ordnad lista med text — så id:t är dess index.
		Stegen fortsätter efter hovarna: sadeln läggs inte på innan hovarna
		är gjorda, för då står hon sadlad och väntar medan man kryper under
		henne. ]]
	local efterHovar = #ut
	for i, f in ipairs(Skotsel.sadelfaser) do
		table.insert(ut, {
			id = "utr:" .. i,
			namn = Sprak.iSprak("sv", "forb.utrustning_steg", i, #Skotsel.sadelfaser),
			text = f.t,
			steg = efterHovar + i,
		})
	end
	return ut
end

local momentCache: { [string]: any } = {}

--[[ Momenten för en fas. Cachad för att listan är ren härledning ur en
	oföränderlig kanon — men cachen är per fas-id, inte per spelare, så den
	kan aldrig bära något spelartillstånd. ]]
function Preparation.moment(fasId: string)
	local cachad = momentCache[fasId]
	if cachad then return cachad end
	local fas = Preparation.fas(fasId)
	if not fas then return {} end
	local ut
	if fasId == "halsa" then ut = halsMoment()
	elseif fasId == "visitera" then ut = visitMoment()
	elseif fasId == "rykta" then ut = ryktMoment()
	elseif fasId == "iordning" then ut = iordningMoment()
	else
		--[[ En fas utan egen härledning får ETT moment med fasens egen
			text — så är `leda` byggd, och det är med flit: källan säger hur
			man leder, inte i hur många tag, och att dela upp den hade varit
			att hitta på. En NY fas i JS-källan blir därmed spelbar direkt i
			stället för att bli osynlig. Uppsittningsfasen kommer aldrig hit;
			`stegFaser` sorterar bort den. ]]
		ut = { { id = fasId, namn = fas.namn, text = fas.text, steg = 1 } }
	end
	momentCache[fasId] = ut
	return ut
end

--[[ Är fasens moment ALTERNATIV eller en checklista?

	Hälsningen är ett val: man går fram framifrån ELLER från sidan vid
	bogen, inte båda, och det tredje sättet är fel. Ryktningen är motsatsen
	— varje redskap ska användas, inget är ett alternativ till ett annat.

	Skillnaden HÄRLEDS ur kanonen i stället för att listas här: bara ett
	val har ett felaktigt alternativ, för det är det ett `ratt`-fält i
	`src/spel/skotsel.js` betyder. En checklista har inget fel steg, bara
	steg. Skrivs skillnaden som `if fasId == "halsa"` i stället, måste den
	raden hittas och ändras varje gång källan får ett nytt val — och den
	dagen den missas blir hälsningen tyst en checklista där spelaren måste
	gå fram till hästen på tre sätt i rad. ]]
function Preparation.arVal(fasId: string): boolean
	for _, m in ipairs(Preparation.moment(fasId)) do
		if m.fel then return true end
	end
	return false
end

--[[ Har spelaren gjort ett riktigt val i fasen? Bara meningsfullt för en
	val-fas; för en checklista är svaret "hon har gjort minst ett steg". ]]
local function harValt(state: State, fasId: string): boolean
	local gjort = state.gjorda[fasId] or {}
	for _, m in ipairs(Preparation.moment(fasId)) do
		if not m.fel and gjort[m.id] then return true end
	end
	return false
end

--[[ Det moment som står på tur i fasen, eller nil när fasen är klar.
	Felaktiga alternativ räknas aldrig som något att göra. ]]
function Preparation.nastaMoment(state: State, fasId: string)
	if Preparation.arVal(fasId) and harValt(state, fasId) then
		--[[ Valet är gjort. Att peka ut ett moment till hade gjort
			alternativen till en checklista. ]]
		return nil
	end
	local gjort = state.gjorda[fasId] or {}
	for _, m in ipairs(Preparation.moment(fasId)) do
		if not m.fel and not gjort[m.id] then return m end
	end
	return nil
end

--[[ Är fasen klar? För en checklista: varje moment som inte är ett
	felaktigt alternativ är gjort. För ett val: ett riktigt alternativ är
	valt. ]]
function Preparation.fasKlar(state: State, fasId: string): boolean
	return Preparation.nastaMoment(state, fasId) == nil
end

--[[ ── FYNDET ──────────────────────────────────────────────────────

	Vilken visitpunkt bär ett fynd idag? Deterministiskt ur hästen och
	passnumret, så samma dag på samma häst ger samma svar hur många gånger
	man än ansluter om — det är samma krav som webbens `momentFro`, och
	utan det kunde en spelare rulla om fyndet genom att lämna och komma
	tillbaka.

	FÖRSTA PASSET ÄR ALLTID RENT. Produktbeslutet i docs/FIRST-DAY-HORSE.md
	ger nybörjaren Jack, och #161 säger att Jack fortfarande måste vara
	tjänstbar. Ett fynd på första passet hade stoppat arbetet innan
	spelaren ens ryktat en häst — tutorialdagen hade slutat med en tom
	spilta. Från pass 2 gäller webbens egen frekvens.

	`LCG` är Numerical Recipes-konstanterna. Kvaliteten spelar ingen roll —
	det som krävs är att den är REPRODUCERBAR och inte beror på os.time.  ]]
local FYNDCHANS = 0.42

--[[ En vanlig multiplikativ strängsumma. Luau har inga bitoperatorer —
	`~` är ett syntaxfel, inte XOR — så FNV går inte att skriva rakt av, och
	`bit32.bxor` hade bara gjort raden svårare att läsa för en hash vars enda
	krav är att den är REPRODUCERBAR. 31 och 104729 är primtal; talet
	behöver inte vara jämnt fördelat, det behöver vara samma varje gång. ]]
local function fro(hastId: string, pass: number): number
	local h = 2166136261
	for i = 1, #hastId do
		h = (h * 31 + string.byte(hastId, i)) % 4294967296
	end
	return (h + pass * 104729) % 4294967296
end

local function nasta(f: number): number
	return (1664525 * f + 1013904223) % 4294967296
end

function Preparation.fyndFor(hastId: string, pass: number): string?
	if type(hastId) ~= "string" or hastId == "" then return nil end
	if type(pass) ~= "number" or pass < 1 then return nil end
	if pass <= 1 then return nil end
	local f = nasta(fro(hastId, pass))
	if f / 4294967296 >= FYNDCHANS then return nil end
	f = nasta(f)
	local punkter = Skotsel.visitation.punkter
	local i = math.floor(f / 4294967296 * #punkter) + 1
	local p = punkter[math.clamp(i, 1, #punkter)]
	return p and p.id or nil
end

--[[ Svarsalternativen på ett fynd, som moment. Samma form som fasernas
	moment så att klienten kan rita dem med samma kod. ]]
function Preparation.fyndSvar()
	local ut = {}
	for i, s in ipairs(Skotsel.visitation.svar) do
		table.insert(ut, {
			id = "svar:" .. i,
			namn = s.t,
			text = "",
			steg = 1,
			fel = not s.ratt,
		})
	end
	return ut
end

--[[ `pass` är spelarens passnummer, 1 för första dagen. Det kommer ur det
	sparade läget och är serverns tal, aldrig klientens. ]]
function Preparation.nyState(hastId: string, pass: number?): State
	local p = if type(pass) == "number" and pass >= 1 then pass else 1
	return {
		hastId = hastId,
		klara = {},
		gjorda = {},
		fynd = Preparation.fyndFor(hastId, p),
		fyndSett = false,
		fyndRapporterat = false,
		stoppad = nil,
		utrustning = {},
	}
end

--[[ Nästa fas som ska göras, eller nil när alla steg är klara. Ordningen är
	fasernas ordning — det finns ingen valfrihet och ska inte finnas. ]]
function Preparation.nasta(state: State)
	for _, f in ipairs(Preparation.stegFaser()) do
		if not state.klara[f.id] then return f end
	end
	return nil
end

function Preparation.redo(state: State): boolean
	--[[ Ett välfärdsstopp gör aldrig hästen redo, hur många faser som än är
		avbockade. Regeln står HÄR och inte bara i `provaUppsittning`, för
		`redo` är det HUD och status läser. ]]
	if state.stoppad then return false end
	return Preparation.nasta(state) == nil
end

--[[ Får spelaren utföra `fasId` på hästen `hastId` just nu?

	Fem nej, i den ordning de ska prövas:
	  1. arbetet är stoppat av välfärdsskäl,
	  2. fel häst — förberedelsen gäller EN tilldelad identitet,
	  3. ett fynd står obesvarat,
	  4. okänd eller redan gjord fas,
	  5. fel tur.

	ORDNINGEN ÄR SJÄLVA MEDDELANDET, inte en implementationsdetalj. Står
	man vid fel häst ska man få veta det, inte att "det är inte din tur att
	rykta". Och har man just hittat en varm sena ska man få veta att DET är
	det som stoppar en — inte att visitationen står på tur.

	Det tredje ledet låg först i `provaMoment`, alltså EFTER turordningen,
	och det gjorde spärren obevisbar: ett försök att rykta avvisades med
	"fel tur" ändå, så fyndspärren gick att ta bort utan att något prov
	blev rött. Falsifieringspasset fällde det. ]]
--[[ KANONTEXT SOM SKÄL.

	Nästan alla nej går över nätet som SPRÅKNYCKLAR ("pass.fel_tur") som
	klienten skriver ut i spelarens språk. Två skäl kan inte göra det:
	välfärdsstoppets mening och ett moments egen förklaring kommer ur
	skötselkanonen, alltså ur undervisningstexten.

	De skickas därför med prefixet `kanon:`. Det är AVSIKTLIGT synligt:
	klienten vet att texten är innehåll och inte en nyckel, och
	språkgrinden kan skilja redovisad kanontext från rå svenska.

	SEDAN PRODUKTBESLUTET (#162, punkt 3) HAR KANONEN ENGELSKA POSTER.
	Meningen som går över nätet är fortfarande den SVENSKA — den är
	kanonens stabila identitet, och att byta den mot ett id hade ändrat
	kontraktet och ett femtiotal påståenden utan att spelaren märkte
	något. Klienten slår i stället upp den engelska syskontexten här,
	genom ett index som HÄRLEDS ur kanonen. Saknas en engelsk post står
	den svenska kvar — synligt, och grinden räknar den. ]]
local KANON = "kanon:"

function Preparation.kanontext(text: string?): string?
	if text == nil then return nil end
	return KANON .. tostring(text)
end

function Preparation.arKanontext(skal: string?): boolean
	return type(skal) == "string" and string.sub(skal, 1, #KANON) == KANON
end

function Preparation.utanKanonprefix(skal: string): string
	return if Preparation.arKanontext(skal) then string.sub(skal, #KANON + 1) else skal
end

--[[ Ett kanonfält på ett språk. `namn` → `namnEn`, `text` → `textEn`.
	Saknas syskonet faller den tillbaka på svenskan; det är HELA
	fallbackregeln och den ligger på ett ställe. ]]
function Preparation.kanonfalt(rec: any, falt: string, sprak: string?): string?
	if sprak == "en" and type(rec) == "table" then
		local v = rec[falt .. "En"]
		if type(v) == "string" and v ~= "" then return v end
	end
	return if type(rec) == "table" then rec[falt] else nil
end

--[[ Index svenska → engelska, härlett ur kanonen. Byggs en gång.

	EN TVETYDIG SVENSK MENING ÖVERSÄTTS INTE. Står samma svenska sträng
	på två ställen med olika engelska syskon vet indexet inte vilken som
	menas, och då är svenskan rätt svar: en felöversatt varning om en
	häst är värre än en oöversatt. ]]
local kanonIndex: { [string]: string }? = nil

local function laggPar(ix, tvetydiga, sv, en)
	if type(sv) ~= "string" or type(en) ~= "string" or sv == "" or en == "" then return end
	if ix[sv] ~= nil and ix[sv] ~= en then tvetydiga[sv] = true end
	ix[sv] = en
end

local function byggKanonIndex()
	if kanonIndex then return kanonIndex end
	local ix, tvetydiga = {}, {}
	local function lista(rader, falt)
		for _, r in ipairs(rader or {}) do
			laggPar(ix, tvetydiga, r[falt], r[falt .. "En"])
		end
	end
	local function karta(sv, en)
		for nyckel, text in pairs(sv or {}) do
			laggPar(ix, tvetydiga, text, (en or {})[nyckel])
		end
	end
	lista(Skotsel.faser, "namn"); lista(Skotsel.faser, "text")
	lista(Skotsel.halsning, "t"); lista(Skotsel.halsning, "svar")
	lista(Skotsel.hovar, "namn"); lista(Skotsel.hovar, "text")
	lista(Skotsel.eftervard, "namn"); lista(Skotsel.eftervard, "text")
	lista(Skotsel.sadelfaser, "t")
	local rykt = Skotsel.rykt or {}
	lista(rykt.redskap, "namn"); lista(rykt.redskap, "kort"); lista(rykt.redskap, "text")
	karta(rykt.zonnamn, rykt.zonnamnEn)
	local vis = Skotsel.visitation or {}
	lista(vis.punkter, "namn"); lista(vis.punkter, "ok")
	lista(vis.svar, "t")
	karta(vis.fynd, vis.fyndEn)
	for sv in pairs(tvetydiga) do ix[sv] = nil end
	kanonIndex = ix
	return ix
end

--[[ Kanontexten på spelarens språk. Okänd text lämnas orörd: den kan
	komma ur en gren indexet inte känner, och då är det bättre att
	spelaren läser svenskan än ingenting. ]]
function Preparation.kanonPaSprak(text: string?, sprak: string?): string?
	if sprak ~= "en" or type(text) ~= "string" then return text end
	return byggKanonIndex()[text] or text
end

--[[ Testkrok: tvingar fram en ombyggnad efter att kanonen bytts i bänken. ]]
function Preparation.glomKanonIndex()
	kanonIndex = nil
end

--[[ ── MOMENTRADEN PÅ SPELARENS SPRÅK ────────────────────────────────

	Servern skickar momentet med kanonens svenska text. Klienten byter
	språk här, på VÄG UT I VYN, för det är först där spelarens locale
	finns. Två moment kan inte gå genom strängindexet:

	  · ryktmomentets namn är SATT SAMMAN ("Gummiskrapa — kropp"), och en
	    sammansättning står inte i kanonen som en egen mening,
	  · utrustningsstegets namn är en räknare ("Utrustning 2/4") och alltså
	    gränssnitt, inte kanon — den ligger i språkkatalogen.

	Båda plockas isär på momentets ID i stället för att gissas ur texten.

	`%N` ÄR HÄSTENS NAMN. Visitationens godkända text skrivs `%N ser dig i
	ögonen` i kanonen, och webben har alltid bytt ut den (`moment.js`).
	Roblox gjorde det aldrig — spelaren läste ett bokstavligt "%N" i
	HUD:en. Bytet sker här, på båda språken, och egennamnet översätts
	förstås inte. ]]
function Preparation.momentPaSprak(m: any, sprak: string?, hastnamn: string?)
	if type(m) ~= "table" then return m end
	local namn, text = m.namn, m.text
	local id = tostring(m.id or "")

	local redskapId, zonTyp = string.match(id, "^rykt:([^:]+):(.+)$")
	if redskapId then
		local rykt = Skotsel.rykt or {}
		for _, r in ipairs(rykt.redskap or {}) do
			if r.id == redskapId then
				local zon = if sprak == "en" then (rykt.zonnamnEn or {})[zonTyp]
					else (rykt.zonnamn or {})[zonTyp]
				namn = Preparation.kanonfalt(r, "namn", sprak) .. " — " .. (zon or zonTyp)
				text = Preparation.kanonfalt(r, "text", sprak)
			end
		end
	else
		local utrIndex = tonumber(string.match(id, "^utr:(%d+)$"))
		if utrIndex then
			namn = Sprak.iSprak(sprak or "sv", "forb.utrustning_steg",
				utrIndex, #Skotsel.sadelfaser)
			local f = Skotsel.sadelfaser[utrIndex]
			if f then text = Preparation.kanonfalt(f, "t", sprak) end
		else
			namn = Preparation.kanonPaSprak(namn, sprak)
			text = Preparation.kanonPaSprak(text, sprak)
		end
	end

	if hastnamn and hastnamn ~= "" then
		if type(namn) == "string" then namn = string.gsub(namn, "%%N", hastnamn) end
		if type(text) == "string" then text = string.gsub(text, "%%N", hastnamn) end
	end

	local ut = table.clone(m)
	ut.namn = namn
	ut.text = text
	return ut
end

--[[ Fasraden på spelarens språk. Samma regel, men fasen har inga
	sammansatta namn — den går rakt genom kanonfältet. ]]
function Preparation.stegPaSprak(steg: any, sprak: string?)
	if type(steg) ~= "table" then return steg end
	local fas = Preparation.fas(tostring(steg.id or ""))
	if not fas then return steg end
	local ut = table.clone(steg)
	ut.namn = Preparation.kanonfalt(fas, "namn", sprak)
	ut.text = Preparation.kanonfalt(fas, "text", sprak)
	return ut
end

function Preparation.provaSteg(state: State, fasId: string, hastId: string): (boolean, string?)
	if state.stoppad then
		return false, "forb.lararen_tar_over", Preparation.kanontext(state.stoppad)
	end
	if hastId ~= state.hastId then
		return false, "forb.fel_hast"
	end
	--[[ Ett fynd som setts men inte rapporterats blockerar allt annat. Det
		är hela poängen med momentet: man går inte vidare och sadlar över en
		varm sena för att listan säger att ryktningen står på tur. ]]
	if state.fyndSett and not state.fyndRapporterat then
		return false, "forb.oppet_fynd"
	end
	local fas = Preparation.fas(fasId)
	if not fas then
		return false, "forb.okand_fas"
	end
	if fas.sitt then
		return false, "forb.uppsittning_inte_steg"
	end
	if state.klara[fasId] then
		return false, "forb.redan_gjort"
	end
	local nastaFas = Preparation.nasta(state)
	if not nastaFas or nastaFas.id ~= fasId then
		return false, "forb.fel_tur", Preparation.kanontext(if nastaFas then nastaFas.namn else nil)
	end
	return true, nil
end

--[[ ── UTRUSTNINGEN SOM ETT FYSISKT VILLKOR ────────────────────────

	Före det här var sadlingen ett abstrakt tillståndsbyte: spelaren stod
	vid hästen, tryckte på ett HUD-steg, och sadeln fanns. Ingen sadel hade
	rörts, ingen hade hämtats, och steget gick lika bra att kvittera av en
	spelare som aldrig sett en sadel.

	Nu KRÄVER två saker att spelaren bär med sig rätt sak:

	  · sadelstegen i `iordning` (`utr:1..4`) kräver SADELN,
	  · ledandet (`leda`) kräver TRÄNSET.

	Att tränset hänger på ledandet och inte på ett eget sadelsteg är läst ur
	kanonen, inte hittat på: `src/spel/skotsel.js` har inget påtagningssteg
	för tränset, men eftervården har "Ta av tränset" med meningen "Grimma på
	först, sedan tränset av. Hon ska aldrig stå lös i gången." Tränset sitter
	alltså på när hon leds. Ett nytt undervisningssteg hade varit att skriva
	om skötselkanonen, och det är ett produktbeslut, inte en integration.

	Regeln är ren och står här och inte i tjänsten: den ska gå att fälla
	utan Studio. ]]
function Preparation.kraverUtrustning(fasId: string, momentId: string): string?
	if fasId == "iordning" and string.match(tostring(momentId), "^utr:%d+$") then
		return "sadel"
	end
	if fasId == "leda" then
		return "trans"
	end
	return nil
end

function Preparation.barUtrustning(state: State, sort: string): boolean
	local u = state.utrustning
	return type(u) == "table" and u[sort] == true
end

--[[ Nejet när saken inte är hämtad, eller nil när det inte finns något att
	säga. Bor här och inte på de två ställen som frågar — `provaMoment` och
	tjänstens `leda`-grind — så att nyckeln inte kan glida isär mellan dem. ]]
function Preparation.utrustningsavslag(state: State, fasId: string,
	momentId: string): string?
	local kravd = Preparation.kraverUtrustning(fasId, momentId)
	if kravd == nil or Preparation.barUtrustning(state, kravd) then return nil end
	return if kravd == "sadel" then "forb.sadeln_inte_hamtad"
		else "forb.transet_inte_hamtat"
end

--[[ Plockar upp en sak. Returnerar (ok, skäl): servern äger AVSTÅNDET och
	VILKEN häst saken hör till — det kräver instanser — men "bär jag den
	redan?" är en regel och bor här, så dubbelinteraktionen går att fälla
	i bänken. ]]
function Preparation.taUtrustning(state: State, sort: string): (boolean, string?)
	if sort ~= "sadel" and sort ~= "trans" then
		return false, "utr.okand_sak"
	end
	if Preparation.barUtrustning(state, sort) then
		return false, "utr.redan_hamtad"
	end
	state.utrustning = state.utrustning or {}
	state.utrustning[sort] = true
	return true, nil
end

--[[ ── MOMENTPROVNINGEN ────────────────────────────────────────────

	Den här är den som klienten faktiskt kör mot, och den är därför också
	den som varje bypass-försök går emot. Nejen i ordning:

	  1–5. allt `provaSteg` säger nej till (stopp, fel häst, öppet fynd,
	       okänd fas, fel tur),
	  6.   okänt moment-id,
	  7.   redan gjort — dubbeltryck flyttar ingenting,
	  8.   fel tur INOM fasen, alltså ett högre `steg` än det lägsta ogjorda. ]]
function Preparation.provaMoment(state: State, fasId: string, momentId: string,
	hastId: string): (boolean, string?, any?)
	local ok, skal = Preparation.provaSteg(state, fasId, hastId)
	if not ok then return false, skal, nil end

	local moment = nil
	for _, m in ipairs(Preparation.moment(fasId)) do
		if m.id == momentId then moment = m end
	end
	if not moment then
		return false, "forb.okant_moment", nil
	end

	local gjort = state.gjorda[fasId] or {}
	if gjort[momentId] then
		return false, "forb.redan_gjort", nil
	end

	--[[ Ett felaktigt alternativ får VÄLJAS — det är så det lär ut — men
		det flyttar ingenting framåt. Texten är kanonens egen konsekvens,
		inte en tillrättavisning skriven här. ]]
	if moment.fel then
		return false, Preparation.kanontext(moment.text), moment
	end

	local lagsta = nil
	for _, m in ipairs(Preparation.moment(fasId)) do
		if not m.fel and not gjort[m.id] then
			if lagsta == nil or m.steg < lagsta then lagsta = m.steg end
		end
	end
	if lagsta and moment.steg > lagsta then
		local pa_tur = Preparation.nastaMoment(state, fasId)
		return false, "forb.fel_tur", Preparation.kanontext(if pa_tur then pa_tur.namn else nil)
	end

	--[[ 9. UTRUSTNINGEN MÅSTE VARA HÄMTAD. Sist av nejen med flit: hit
		kommer bara ett försök som redan är rätt häst, rätt fas, rätt tur
		och rätt moment, och då är "du har inte sadeln med dig" det enda
		som återstår att säga. Låg den tidigare hade den varit oprovbar —
		turordningen hade avvisat försöket ändå, precis som fyndspärren en
		gång var dold bakom "fel tur". ]]
	local utr = Preparation.utrustningsavslag(state, fasId, momentId)
	if utr then
		return false, utr, moment
	end

	return true, nil, moment
end

--[[ Utför momentet. Muterar `state` bara när provningen gick igenom, så ett
	avvisat försök aldrig kan flytta fram förberedelsen halvvägs.

	Returnerar (ok, skäl, handelse) där `handelse` är "fynd" när
	visitationen just avslöjade något. Servern behöver veta det för att
	kunna skicka svarsalternativen. ]]
function Preparation.utforMoment(state: State, fasId: string, momentId: string,
	hastId: string): (boolean, string?, string?)
	local ok, skal, moment = Preparation.provaMoment(state, fasId, momentId, hastId)
	if not ok then return false, skal, nil end

	state.gjorda[fasId] = state.gjorda[fasId] or {}
	state.gjorda[fasId][momentId] = true

	--[[ Avslöjade det här momentet fyndet? Visitpunktens moment-id är
		`vis:<punkt>`, och fyndet bär punktens id. ]]
	local handelse = nil
	if fasId == "visitera" and state.fynd and momentId == "vis:" .. state.fynd then
		state.fyndSett = true
		handelse = "fynd"
	end

	if Preparation.fasKlar(state, fasId) then
		--[[ En visitation med ett OSETT fynd kan inte vara klar — men det
			kan den heller inte vara, för fyndets punkt är ett moment som
			måste göras. Kontrollen står ändå kvar: hittar någon en väg dit
			ska fasen inte kvitteras. ]]
		if fasId == "visitera" and state.fynd and not state.fyndRapporterat then
			return true, nil, handelse
		end
		state.klara[fasId] = true
	end
	return true, nil, handelse
end

--[[ Svaret på ett fynd. Rätt svar STOPPAR arbetet — det är inte ett fel,
	det är momentet. Fel svar avvisas och fyndet står kvar öppet. ]]
function Preparation.svaraFynd(state: State, svarId: string): (boolean, string?)
	if not state.fyndSett then
		return false, "forb.inget_att_rapportera"
	end
	if state.fyndRapporterat then
		return false, "forb.redan_rapporterat"
	end
	local valt = nil
	for _, s in ipairs(Preparation.fyndSvar()) do
		if s.id == svarId then valt = s end
	end
	if not valt then
		return false, "forb.okant_svar"
	end
	if valt.fel then
		--[[ "Det går nog bra idag" och "lös det själv" avvisas och fyndet
			står kvar. Att låta dem gå igenom med en sämre poäng hade gjort
			dem till en genväg; här finns ingen genväg, bara ett rätt svar. ]]
		return false, "forb.inte_ditt_beslut"
	end
	state.fyndRapporterat = true
	--[[ #162 lokalisering: `stoppad` bär numera BARA kanonmeningen — fyndet
		ur skötselkanonen. Ramen runt den ("Ridläraren tar över …") är
		gränssnittstext och kommer ur språkkanonen (`forb.lararen_tar_over`)
		när texten skrivs, alltså i spelarens språk. Förut satt ramen ihop
		här, på svenska, och då kunde ingen engelsk spelare få den. ]]
	state.stoppad = Skotsel.visitation.fynd[state.fynd or ""] or "forb.nagot_ar_fel"
	return true, nil
end

--[[ Får spelaren sitta upp? Egen fråga, inte `redo` — uppsittningen prövas
	mot BÅDE förberedelsen och hästens identitet, och den som frågar sitter i
	`GameplayService` med en modell i handen. ]]
function Preparation.provaUppsittning(state: State, hastId: string): (boolean, string?)
	if hastId ~= state.hastId then
		return false, "forb.inte_din_hast"
	end
	--[[ FAIL-CLOSED. Välfärdsstoppet prövas före allt annat och kan inte
		kringgås av att faserna råkar vara avbockade. ]]
	if state.stoppad then
		return false, "forb.lararen_tar_over", Preparation.kanontext(state.stoppad)
	end
	--[[ En fas som står som klar men vars moment inte är gjorda får inte
		heller släppa igenom. `klara` sätts bara av `utforMoment`, men
		grinden kostar en loop och stänger vägen för alla framtida sätt att
		sätta flaggan. ]]
	for _, f in ipairs(Preparation.stegFaser()) do
		if not Preparation.fasKlar(state, f.id) then
			return false, "pass.aterstar", Preparation.kanontext(f.namn)
		end
	end
	local nastaFas = Preparation.nasta(state)
	if nastaFas then
		return false, "pass.aterstar", Preparation.kanontext(nastaFas.namn)
	end
	return true, nil
end

--[[ Får klienten rita `ny` när den redan ritat revisionen `senasteRev`?

	Regeln är ett enda `>`, men den bor här och inte i klienten av samma skäl
	som allt annat i modulen: den ska gå att fälla utan Studio. Utan den kan
	handskakningens svar landa efter en nyare spontan sync och backa HUD:en
	till ett äldre läge — krav 10. ]]
function Preparation.farRita(senasteRev: number?, ny): boolean
	if type(ny) ~= "table" or type(ny.rev) ~= "number" then return false end
	if senasteRev == nil then return true end
	return ny.rev > senasteRev
end

--[[ ── Bindningen ──────────────────────────────────────────────────

	Valet av modell är också en REGEL, inte instanshantering, så den bor
	här och inte i `GameplayService`. Tjänsten samlar ihop kandidaterna ur
	`CollectionService` och frågar; den letar aldrig själv.

	Uppdelningen finns av samma skäl som i riggkontraktet: hade tjänsten
	haft en egen kopia av villkoret gick regeln bara att prova genom att
	starta en server, och då provas den aldrig. ]]

--[[ Väljer den modell vars id är EXAKT det tilldelade och som ingen annan
	spelare håller.

	`kandidater` är { { id = <HorseId>, modell = <valfritt> } }.
	`upptagna` är { [modell] = true } för modeller andra redan bundit.

	Ingen närmast-häst-fallback, med flit. Att binda närmaste Horse-taggade
	modell gör att något alltid händer — och att spelaren gör i ordning fel
	individ utan att få veta det. Hellre nil, som blir `waiting_model`. ]]
function Preparation.valjModell(kandidater, hastId: string, upptagna)
	local taget = upptagna or {}
	for _, kandidat in ipairs(kandidater or {}) do
		if kandidat.id == hastId and not taget[kandidat.modell] then
			return kandidat.modell
		end
	end
	return nil
end

--[[ Får spelaren sitta upp på en modell vars HorseId är `modellHastId`?

	Krav 6 och 7 i ett: rätt identitet OCH färdig förberedelse. Identiteten
	prövas först — en fullt förberedd spelare som står vid någon annans häst
	ska få veta att det är fel häst, inte att något återstår. ]]
function Preparation.provaModell(state: State?, modellHastId): (boolean, string?)
	if not state then
		return false, "spel.ingen_hast"
	end
	if modellHastId ~= state.hastId then
		return false, "spel.inte_din_hast"
	end
	return Preparation.provaUppsittning(state, state.hastId)
end

--[[ Det klienten ska visa. Servern skickar hela den här tabellen; klienten
	räknar inte ut någon del av den själv.

	`rev` är ett strikt växande serienummer per spelare. Det finns för krav
	10: handskakningens svar och en spontan `PreparationSync` kan komma i
	vilken ordning som helst över nätet, och utan serienummer kan det äldre
	svaret skriva över det nyare. ]]
--[[ `hastnamn` är hästens EGENNAMN och följer med vyn av ett enda skäl:
	visitationens godkända text skrivs `%N ser dig i ögonen` i kanonen, och
	klienten måste kunna sätta in namnet. Webben har alltid gjort det
	(`moment.js`); Roblox gjorde det aldrig, så spelaren läste ett
	bokstavligt "%N" i HUD:en. Namnet översätts inte — det är verklighetens
	namn på en verklig häst. ]]
function Preparation.vy(state: State?, status: string, rev: number?, hastnamn: string?)
	if not state then
		return { status = status, hastId = nil, hastnamn = nil, steg = {}, nasta = nil,
			moment = {}, nastaMoment = nil, fynd = nil, svar = {},
			stoppad = nil, redo = false, rev = rev or 0,
			utrustning = {}, kraver = nil }
	end
	local steg = {}
	for _, f in ipairs(Preparation.stegFaser()) do
		table.insert(steg, {
			id = f.id,
			namn = f.namn,
			text = f.text,
			klar = state.klara[f.id] == true,
		})
	end
	local nastaFas = Preparation.nasta(state)

	--[[ Bara den AKTUELLA fasens moment går över nätet. Att skicka alla
		faser gånger alla moment vore ett par hundra rader per sync för en
		HUD som ändå bara ritar en fas i taget. ]]
	local moment = {}
	local nastaM = nil
	if nastaFas then
		local gjort = state.gjorda[nastaFas.id] or {}
		for _, m in ipairs(Preparation.moment(nastaFas.id)) do
			table.insert(moment, {
				id = m.id,
				namn = m.namn,
				text = m.text,
				fel = m.fel == true,
				klar = gjort[m.id] == true,
			})
		end
		local pa_tur = Preparation.nastaMoment(state, nastaFas.id)
		nastaM = pa_tur and pa_tur.id or nil
	end

	--[[ Svarsalternativen skickas bara när det finns ett obesvarat fynd.
		Ligger de alltid i vyn kan en klient rita dem när det inte finns
		något att svara på. ]]
	local svar = {}
	local fyndtext = nil
	if state.fyndSett and not state.fyndRapporterat then
		svar = Preparation.fyndSvar()
		fyndtext = Skotsel.visitation.fynd[state.fynd or ""]
	end

	return {
		status = status,
		hastId = state.hastId,
		hastnamn = hastnamn,
		steg = steg,
		nasta = nastaFas and nastaFas.id or nil,
		moment = moment,
		nastaMoment = nastaM,
		fynd = fyndtext,
		svar = svar,
		stoppad = state.stoppad,
		redo = Preparation.redo(state),
		rev = rev or 0,
		--[[ Vad spelaren BÄR, och vad steget på tur KRÄVER att hon bär.
			HUD:en ska kunna säga "hämta sadeln på hennes boxfront" utan att
			själv veta vilka moment som kräver vad — regeln står på ett
			ställe, här, och vyn bär svaret. ]]
		utrustning = {
			sadel = Preparation.barUtrustning(state, "sadel"),
			trans = Preparation.barUtrustning(state, "trans"),
		},
		kraver = if nastaFas then Preparation.kraverUtrustning(nastaFas.id,
			tostring(nastaM or nastaFas.id)) else nil,
	}
end

return Preparation
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX12">
				<Properties>
					<string name="Name">RidKanon</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	GENERERAD FIL — handredigera inte.

	Skrivs av tools/exportera-ridkanon.mjs ur webbens src/model.js och
	src/riding/telemetri.js. Det här är WEBBENS ridkanon, exporterad så att
	Roblox-sidan har något exakt att mäta sig mot i stället för att två
	uppsättningar siffror driver isär i tysthet.

	Modulen STYR ingenting i Roblox — Gaits.luau är fortfarande Roblox
	egna, intrimmade tabell. Den här filen används av
	roblox/tests/paritet.spec.luau för att jämföra, och för att lista de
	avvikelser som faktiskt finns. Att jämna ut en avvikelse är ett
	produktbeslut och ändrar ridkänslan; det görs aldrig av en export.

	Kör om med:  node tools/exportera-ridkanon.mjs
]]

local RidKanon = {}

--[[ Webbens gångartsordning. Roblox har en gångart till (fyrsprång);
     paritetsspecen kräver att den här är ett PREFIX av Roblox ordning. ]]
RidKanon.ORDNING = { "halt", "skritt", "trav", "galopp" }

--[[ Vilken Roblox-gångart varje webbgångart motsvarar. ]]
RidKanon.MOTSVARIGHET = {
	halt = "halt",
	skritt = "walk",
	trav = "trot",
	galopp = "canter",
}

--[[ Gångartsbanden ur src/model.js (Gait.G). min/max i m/s, norm är
     gångartens normaltempo, steg är webbens steglängdsfaktor.

     upp/ner är G02-A.1 P3: hur många m/s² hon tar respektive släpper
     INOM gångarten. De är Roblox egna accel/retard, portade till
     webben — inte en andra uppsättning tal. Paritetsspecen kräver
     att de fortfarande är identiska, och att de skiljer sig åt
     mellan gångarterna: en gemensam siffra vore just den vikt per
     gångart som P3 införde. ]]
RidKanon.BAND = {
	halt = { min = 0, max = 0.2, norm = 0, steg = 0, upp = 3.2, ner = 5.5 },
	skritt = { min = 0.9, max = 2, norm = 1.45, steg = 0.46, upp = 2.6, ner = 3.4 },
	trav = { min = 2.4, max = 4.3, norm = 3.2, steg = 0.63, upp = 2.9, ner = 3.6 },
	galopp = { min = 4.6, max = 8, norm = 5.6, steg = 1, upp = 3.4, ner = 3.2 },
}

--[[ ÖVERGÅNGSFÖRLOPPET (G02-A.1 P2/P5, harmoniserat efter senior
     review 2026-09-05). Sekunder för en NEUTRAL häst; hästens egen
     tyngd respektive acceleration skalar därifrån med 1,0 i mitten.

     upp     per gångart man går TILL
     nerMjuk längden när ryttaren bara håller emot
     nerHart  längden vid full parad — bestämdheten interpolerar
     bytpunkt hur långt in i förloppet gångartsETIKETTEN byter

     Kurvan är samma på båda ytorna: mjukstegskurvan u²(3−2u),
     som börjar och slutar med noll lutning. Roblox har talen i
     Config.MOVEMENT.Transition och paritetsspecen jämför dem. ]]
RidKanon.OVERGANG = {
	upp = {
		skritt = 0.8,
		trav = 0.95,
		galopp = 1.2,
	},
	nerMjuk = 0.98,
	nerHart = 0.78,
	bytpunkt = 0.55,
}

--[[ Hysteres: hur långt utanför sitt band en gångart får leva kvar. ]]
RidKanon.HYSTERES = 0.35

--[[ Trösklarna, MÄTTA ur Gait.forTempo — inte avskrivna. ]]
RidKanon.TROSKLAR = {
	{ under = 0.25, gangart = "skritt" },
	{ under = 2.2, gangart = "trav" },
	{ under = 4.45, gangart = "galopp" },
}

--[[ STYRKANONEN ur stegaRitt() i src/game.js. Kurvaturtaket i 1/m vid
     full styrning, gångarternas svängfaktorer, och tidskonstanterna för
     att lägga sig i respektive räta upp sig ur en båge. ]]
RidKanon.KAPPA_MAX = 0.42
RidKanon.KAPPA_TAU_LAGG = 0.13
RidKanon.KAPPA_TAU_RATA = 0.19
RidKanon.SVANGFAKTOR = {
	halt = 1,
	skritt = 1,
	trav = 0.82,
	galopp = 0.52,
}

--[[ Gångartens TRÖGHET i styrningen (G02-A.1 P3). Multiplikator på
     KAPPA_TAU_LAGG/RATA. SVANGFAKTOR säger hur snävt hon KAN svänga,
     den här hur snabbt bågen ändras. Speglas i Gaits.svangTau. ]]
RidKanon.SVANGTAU = {
	halt = 1,
	skritt = 0.85,
	trav = 1,
	galopp = 1.45,
}

--[[ Sekunder från rakt till full båge (G02-A.1 P4). Kurvaturen får
     inte ändras fortare än gångartens kurvaturtak delat med den här
     tiden. Speglas i Config.MOVEMENT.CurvatureRateTime. ]]
RidKanon.KAPPA_RAT_TID = 0.32

--[[ Bomkameran per gångart ur src/scen3d.js (G02-A.1 P6). bak i
     meter bakom hästen, hojd i meter, fov som tillägg i radianer.

     BETYDELSEN ÄNDRADES I G02-E DEL 1 (#150). Talen är oförändrade,
     men de beskriver INTE LÄNGRE ridningens standardvy. Standarden är
     sadeln — ryttarens eget perspektiv, se RidKanon.SADELKAMERA. Den
     här tabellen beskriver den UTIFRÅNVY som lånas ut som
     feedbackvinkeln `utifran`, och som de andra vinklarna skalar.

     ABSOLUTA tal ska INTE vara lika på de två ytorna — rendering får
     vara plattformsspecifik. FÖRHÅLLANDET mellan gångarterna ska det,
     för det är förhållandet man känner. Paritetsspecen jämför därför
     kvoter mot skritt, inte tal mot tal. ]]
RidKanon.KAMERA = {
	halt = { bak = 3.78, hojd = 1.88, fov = 0 },
	skritt = { bak = 4.05, hojd = 1.95, fov = 0 },
	trav = { bak = 4.59, hojd = 2.1, fov = 0.017 },
	galopp = { bak = 5.13, hojd = 2.25, fov = 0.07 },
}

--[[ SADELKAMERAN — ridningens standardvy (G02-E del 1, #150).

     Tobias produktbeslut 2026-09-08: när spelaren rider ska kameran
     vara ryttarens perspektiv. Ögonpunkten hämtas på varje yta ur
     dess EGEN rigg — webbens s3Sits/s3OgaMatris, Roblox karaktärens
     Head — och kan därför inte exporteras som ett tal.

     Det som DÄREMOT måste vara lika är de enhetslösa talen: sekunder
     är sekunder, och en kvot är en kvot. Längderna räknas på varje
     yta ur dess egna bomvärden, så att blickens VINKEL och synfältet
     blir desamma i meter som i studs. Speglas i Config.CAMERA.Saddle. ]]
RidKanon.SADELKAMERA = {
	YAW_TAU = 0.1,
	TAU_XZ = 0.05,
	TAU_Y = 0.3,
	FOV_KVOT = 1.128,
	NED_KVOT = 0.0607,
	BLICK_KVOT = 5.38,
}

--[[ FEEDBACKVINKLARNA (G02-E del 1, #150), ur
     src/riding/kameralage.js efter modulens egen validering.

     En tillfällig vinkel som lånas ut när feedback ges, och som
     ALLTID återgår till sadeln. yaw i radianer runt hästen; bak, hojd,
     fov och blick som multiplikatorer på bomkameran ovan; in, hall och
     ut i sekunder.

     Talen är enhetslösa och ska därför vara IDENTISKA på båda ytorna,
     inte bara i förhållande. Paritetsspecen jämför tal mot tal.

     `utifran` är den gamla tredjepersonskameran, oförändrad: yaw 0 och
     alla multiplikatorer 1. Den finns kvar som en LÅNAD vy. ]]
RidKanon.KAMERALAGE = {
	ansats = { yaw = 3.141593, bak = 1.25, hojd = 1.05, fov = 1, blick = -0.35, ["in"] = 0.4, hall = 1.5, ut = 0.5 },
	sits = { yaw = 1.570796, bak = 0.95, hojd = 0.92, fov = 0.94, blick = 0.1, ["in"] = 0.4, hall = 1.6, ut = 0.5 },
	utifran = { yaw = 0, bak = 1, hojd = 1, fov = 1, blick = 1, ["in"] = 0.45, hall = 1.8, ut = 0.55 },
	vagval = { yaw = 0, bak = 1.9, hojd = 2.4, fov = 1.08, blick = 1.3, ["in"] = 0.45, hall = 1.7, ut = 0.55 },
}

--[[ Telemetrins fältnamn, lästa ur ett riktigt anrop av ridTelemetri. ]]
RidKanon.TELEMETRI_FALT = { "balans", "beddGangart", "cue", "cueAlder", "energi", "etableringstid", "fart", "fokus", "gangart", "gangartGlapp", "hast", "hjalper", "iOvergang", "kurvatur", "mjukhet", "onskadFart", "overgangstid", "paradAlder", "paradKvalitet", "rytm", "spanning", "steglangd", "svangradie", "svarAlder", "svarstid", "uppsutten", "vridhastighet" }

--[[ Fält som är HÄRLEDDA, inte mätta. Ärlig märkning för G02-B. ]]
RidKanon.HARLEDDA = {  }

--[[ HJÄLPERNAS SEMANTIK (G02-B punkt 1, src/riding/hjalper.js).

     Webbens ridning har fyra AXLAR — skänkel, styrning, tygel, sits —
     och ovanpå dem ridningens ord: innertygel, yttertygel, yttertygel-
     stöd, böjsida, vikt och paraden som en EGEN signal. Inner och
     ytter härleds ur styr- och tygelaxeln, så ingen ny kontroll behövs
     på någon yta; talen nedan är översättningen.

     Roblox rörelsekärna har ännu inget hjälplager alls (se
     Telemetri.SAKNAS). Kanonen exporteras hit FÖRE implementationen
     med flit: när Roblox-sidan bygger sina hjälper ska den läsa de här
     talen, inte skriva av dem. ]]
RidKanon.HJALP = {
	INNER_BER = 0.55,
	YTTER_SLAPP = 0.35,
	STYR_FULLT = 0.72,
	STOD_KRAV = 0.3,
	TYGEL_NEUTRAL = 0.34,
	BOJ_TROSKEL = 0.05,
	PARAD_GOLV = 0.2,
	PARAD_DRIV = 0.5,
	PARAD_BAND = 0.4,
	PARAD_TROSKEL = 0.05,
}

--[[ Hjälpernas fältnamn, lästa ur ett riktigt anrop av ridTelemetri. ]]
RidKanon.HJALP_FALT = { "bojSida", "innerTygel", "parad", "sits", "skankel", "styrning", "tygel", "vikt", "ytterTygel", "ytterstod" }

--[[ Hjälpfält som är HÄRLEDDA ur axlarna, inte egna kontroller. ]]
RidKanon.HJALP_HARLEDDA = { "innerTygel", "vikt", "ytterTygel", "ytterstod" }

--[[ KONTRAKTET G02-C LÄSER (G02-B punkt 5).

     Telemetrin ska exponera BÅDE hjälpen och responsen, och en
     läsare måste kunna se vilka fält som är vad. HJALP_FALT är vad
     ryttaren gör, SVAR_FALT vad hästen svarar. Listorna kommer ur
     webbens moduler, inte ur en handskriven uppräkning. ]]
RidKanon.SVAR_FALT = { "balans", "energi", "fokus", "mjukhet", "paradAlder", "paradKvalitet", "spanning", "svarAlder", "svarstid" }

--[[ HÄSTENS SVAR (G02-B punkt 2, src/riding/svar.js).

     Fördröjning, fokus, balans och energi som riktiga storheter. Webben
     har dem i modellen; Roblox har dem inte alls ännu, och det står som
     LUCKA i paritetsspecen i stället för att fyllas med gissningar.

     ENERGI_TAPP/ENERGI_ATER är per sekund och per gångart, med webbens
     namn. Roblox gångartsnamn översätts av RidKanon.MOTSVARIGHET. ]]
--[[ KONTAKTEN — modellens K-konstanter som hjälpsemantiken behöver.

     Skänkelns tröskel och tygelns kontaktband ÄGS av src/model.js och
     läses härifrån av Roblox-sidan i stället för att skrivas av. Det är
     samma tal som avgör om en halvhalt är välriden på webben. ]]
RidKanon.KONTAKT = {
	SKANKEL_TROSKEL = 0.28,
	SKANKEL_FOR_MYCKET = 0.85,
	SKANKEL_NEUTRAL = 0.42,
	TYGEL_BAND_MIN = 0.22,
	TYGEL_BAND_MAX = 0.58,
	TYGEL_NEUTRAL = 0.34,
	TYGEL_MAX = 0.8,
	TYGEL_HART = 0.72,
	SITS_NEUTRAL = 0.2,
	SITS_PARAD = 0.78,
	SITS_MAX = 0.85,
	AIDS_TAU = 0.3,
	AMPLITUD_SKALA = 0.22,
	MJUKHET_EMA = 3,
	SPANNING_STIGNING = 1.1,
	SPANNING_FALL = 0.42,
}

--[[ SKOLHÄSTPROFILERNA (G02-B punkt 3). Multiplikatorer på SVAR
     ovan — INTE egna kodvägar. `skolhast` är 1,00 rakt igenom och
     därmed modellens utgångsläge; varje annan profil mäts mot den.

     Vilken häst som har vilken profil ligger i UBRFSpelData
     (fältet `profil`), tilldelad ur ridskolans egna beskrivningar.
     Se src/spel/hastar.js för citaten. ]]
RidKanon.PROFILER = {
	skolhast = { namn = "Skolhäst", kort = "pålitlig, går med i alla grupper", svar = 1, klar = 1, balans = 1, fokus = 1, tapp = 1, ater = 1 },
	kanslig = { namn = "Känslig", kort = "svarar på lite, kräver en mjuk hand", svar = 0.72, klar = 1.45, balans = 1.35, fokus = 1.25, tapp = 1.15, ater = 1 },
	tung = { namn = "Tyngre modell", kort = "tar tid, står stadigt, vill ha tydlighet", svar = 1.38, klar = 1.3, balans = 0.7, fokus = 0.85, tapp = 1.25, ater = 0.85 },
	arbetsvillig = { namn = "Arbetsvillig", kort = "bjuder till och orkar länge", svar = 0.86, klar = 0.85, balans = 0.9, fokus = 1.05, tapp = 0.8, ater = 1.2 },
}

RidKanon.SVAR = {
	SVAR_BAS = 0.12,
	SVAR_TROG = 0.14,
	SVAR_FOKUS = 0.12,
	SVAR_ENERGI = 0.1,
	SVAR_KLAR = 0.1,
	SVAR_MIN = 0.06,
	SVAR_MAX = 0.48,
